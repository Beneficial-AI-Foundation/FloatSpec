      -- Now prove: firstNP ≤ m₂' * beta^e₂'
      have hNormalLower : firstNP ≤ (m₂' : ℝ) * (beta : ℝ) ^ e₂' := by
        -- firstNP = radix^(p-1) * radix^(-dExp)
