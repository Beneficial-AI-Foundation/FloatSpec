/-- Coq: `mZlist_correct_rev1` — membership implies lower bound `p ≤ r`. -/
theorem mZlist_correct_rev1 (p q r : Int) :
    ⦃⌜List.Mem r (mZlist p q)⌝⦄
    (pure (mZlist_correct_rev1_check p q r) : Id Unit)
    ⦃⇓_ => ⌜p ≤ r⌝⦄ := by
  intro hmem
