    let upperExp : Int := (precision : Int) + z
    let upper : FloatSpec.Core.Defs.FlocqFloat radix := ⟨bo.vNum - 1, upperExp⟩
    have hupperBounded : Fbounded (beta:=radix) bo upper := by
