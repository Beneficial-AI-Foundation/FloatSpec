-- Minimal positive and digit infrastructure used by digit lemmas.
-- The Lean `Positive` compatibility wrapper stores a unary countdown rather
-- than Coq's binary `positive`; this fuel recursion mirrors the Coq
-- stop/continue condition over that available representation.
noncomputable def pos_length (p : Positive) : Nat := nat_of_P p

noncomputable def digitAuxFuel (n v : Int) : Int → Nat → Nat
  | r, 0 => 0
  | r, Nat.succ q =>
      if r > v then 0 else Nat.succ (digitAuxFuel n v (n * r) q)

noncomputable def digitAux (n v r : Int) (q : Positive) : Nat :=
  digitAuxFuel n v r (pos_length q)

private theorem digitAuxFuel_less (n v r : Int) (q : Nat) :
    match digitAuxFuel n v r q with
    | Nat.succ r' => Zpower_nat n r' * r ≤ v
    | 0 => True := by
  induction q generalizing r with
  | zero =>
      simp [digitAuxFuel]
  | succ q ih =>
      simp only [digitAuxFuel]
      by_cases hgt : r > v
      · simp [hgt]
      · simp [hgt]
        cases haux : digitAuxFuel n v (n * r) q with
        | zero =>
            simp [Zpower_nat]
            omega
        | succ r' =>
            have hrec :
                Zpower_nat n r' * (n * r) ≤ v := by
              simpa [haux] using ih (n * r)
            have hpow :
                Zpower_nat n (Nat.succ r') * r =
                  Zpower_nat n r' * (n * r) := by
              simp [Zpower_nat, pow_succ]
              ring
            simpa [hpow] using hrec

-- Coq: `digitAuxLess`
noncomputable def digitAuxLess_check (n : Int) (v r : Int) (q : Positive) : Unit :=
  ()

theorem digitAuxLess (n : Int) (v r : Int) (q : Positive) :
    ⦃⌜True⌝⦄
    (pure (digitAuxLess_check n v r q) : Id Unit)
    ⦃⇓_ => ⌜match digitAux n v r q with
            | Nat.succ r' => Zpower_nat n r' * r ≤ v
            | 0 => True⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, digitAuxLess_check, Id.run,
    ULift.up_down]
  simpa [digitAux] using digitAuxFuel_less n v r (pos_length q)

-- Coq: `digitLess` — if q ≠ 0 then Zpower_nat n (pred (digit q)) ≤ |q|
noncomputable def digitLess_check (n : Int) (q : Int) : Unit :=
  ()

-- `digit` is defined earlier near its first use (NotDividesDigit).

theorem digitLess (n : Int) (q : Int) :
    ⦃⌜1 < n ∧ q ≠ 0⌝⦄
    (pure (digitLess_check n q) : Id Unit)
    ⦃⇓_ => ⌜Zpower_nat n (Nat.pred (digit n q)) ≤ |q|⌝⦄ := by
  intro ⟨hn, hq⟩
  simp only [wp, PostCond.noThrow, pure, digitLess_check, Id.run,
    ULift.up_down]
  have hbounds := FloatSpec.Core.Digits.Zdigits_correct n q hn hq
  let d := FloatSpec.Core.Digits.Zdigits n q
  have hgt : 0 < d := by
    simpa [d] using FloatSpec.Core.Digits.Zdigits_gt_0 n q hn hq
  have hpred_cast : ((Nat.pred d.toNat : Nat) : Int) = d - 1 := by
    have hdto : (d.toNat : Int) = d := Int.toNat_of_nonneg (le_of_lt hgt)
    cases hd : d.toNat with
    | zero =>
        rw [hd] at hdto
        omega
    | succ k =>
        simp only [Nat.pred_succ]
        rw [hd] at hdto
        omega
  have hpred :
      (d - 1).natAbs = Nat.pred d.toNat := by
    apply Nat.cast_injective (R := Int)
    rw [Int.natAbs_of_nonneg (by omega : 0 ≤ d - 1)]
    exact hpred_cast.symm
  simpa [digit, Zpower_nat, d, hpred] using hbounds.1

-- Coq: `pos_length_pow` — Zpos p < Zpower_nat n (S (pos_length p))
noncomputable def pos_length_pow_check (n : Int) (p : Positive) : Unit :=
  ()

theorem pos_length_pow (n : Int) (p : Positive) :
    ⦃⌜1 < n⌝⦄
    (pure (pos_length_pow_check n p) : Id Unit)
    ⦃⇓_ => ⌜Int.ofNat (nat_of_P p) < Zpower_nat n (Nat.succ (pos_length p))⌝⦄ := by
  intro hn
  simp only [wp, PostCond.noThrow, pure, pos_length_pow_check,
    Id.run, ULift.up_down]
  unfold pos_length
  set k := nat_of_P p
  have hn_plain : 1 < n := hn
  have hn2 : (2 : Int) ≤ n := by omega
  have h2pow : ∀ k : Nat, (k : Int) < (2 : Int) ^ (k + 1) := by
    intro k
    induction k with
    | zero => norm_num
    | succ k ih =>
        calc
          ((Nat.succ k : Nat) : Int) = (k : Int) + 1 := by simp
          _ < 2 ^ (k + 1) + 1 := by linarith
          _ ≤ 2 ^ (k + 1) + 2 ^ (k + 1) := by
              have hpow_ge_one : (1 : Int) ≤ 2 ^ (k + 1) := by
                have hpow_pos : (0 : Int) < 2 ^ (k + 1) :=
                  pow_pos (by norm_num : (0 : Int) < 2) _
                omega
              linarith
          _ = 2 ^ (Nat.succ k + 1) := by
              simp [pow_succ]
              ring
  have hpow_mono : (2 : Int) ^ (k + 1) ≤ n ^ (k + 1) :=
    pow_le_pow_left₀ (by norm_num : (0 : Int) ≤ 2) hn2 _
  have hk_lt : (k : Int) < n ^ (k + 1) := lt_of_lt_of_le (h2pow k) hpow_mono
  simpa [Zpower_nat, k] using hk_lt

-- Coq: `digitMore` — |q| < Zpower_nat n (digit q)
noncomputable def digitMore_check (n : Int) (q : Int) : Unit :=
  ()

theorem digitMore (n : Int) (q : Int) :
    ⦃⌜1 < n⌝⦄
    (pure (digitMore_check n q) : Id Unit)
    ⦃⇓_ => ⌜|q| < Zpower_nat n (digit n q)⌝⦄ := by
  intro hn
  simp only [wp, PostCond.noThrow, pure, digitMore_check, Id.run,
    ULift.up_down]
  by_cases hq : q = 0
  · subst q
    simp [digit, Zpower_nat, FloatSpec.Core.Digits.Zdigits]
  · have hbounds := FloatSpec.Core.Digits.Zdigits_correct n q hn hq
    have hnonneg : 0 ≤ FloatSpec.Core.Digits.Zdigits n q :=
      FloatSpec.Core.Digits.Zdigits_ge_0 n q trivial
    have hnat :
        (FloatSpec.Core.Digits.Zdigits n q).natAbs =
          (FloatSpec.Core.Digits.Zdigits n q).toNat := by
      apply Nat.cast_injective (R := Int)
      rw [Int.natAbs_of_nonneg hnonneg, Int.toNat_of_nonneg hnonneg]
    simpa [digit, Zpower_nat, hnat] using hbounds.2

private theorem digitAuxFuel_more (n v r : Int) (q : Nat)
    (hn : 1 < n) (hr : 0 < r)
    (hbound : v < Zpower_nat n q * r) :
    v < Zpower_nat n (digitAuxFuel n v r q) * r := by
  induction q generalizing r with
  | zero =>
      simpa [digitAuxFuel] using hbound
  | succ q ih =>
      simp only [digitAuxFuel]
      by_cases hgt : r > v
      · simp [hgt, Zpower_nat]
      · simp [hgt]
        have hr_le : r ≤ v := by omega
        have hn_pos : 0 < n := by omega
        have hnr : 0 < n * r := by nlinarith
        have hbound' : v < Zpower_nat n q * (n * r) := by
          have hpow :
              Zpower_nat n (Nat.succ q) * r =
                Zpower_nat n q * (n * r) := by
            simp [Zpower_nat, pow_succ]
            ring
          simpa [hpow] using hbound
        have hrec := ih (n * r) hnr hbound'
        have hpow :
            Zpower_nat n (Nat.succ (digitAuxFuel n v (n * r) q)) * r =
              Zpower_nat n (digitAuxFuel n v (n * r) q) * (n * r) := by
          simp [Zpower_nat, pow_succ]
          ring
        simpa [hpow] using hrec

-- Coq: `digitAuxMore` — complementary case for digit auxiliary
noncomputable def digitAuxMore_check (n : Int) (v r : Int) (p : Positive) : Unit :=
  ()

theorem digitAuxMore (n : Int) (v r : Int) (p : Positive) :
    ⦃⌜1 < n ∧ 0 < r ∧ v < Zpower_nat n (pos_length p) * r⌝⦄
    (pure (digitAuxMore_check n v r p) : Id Unit)
    ⦃⇓_ => ⌜v < Zpower_nat n (digitAux n v r p) * r⌝⦄ := by
  intro ⟨hn, hr, hbound⟩
  simp only [wp, PostCond.noThrow, pure, digitAuxMore_check, Id.run,
    ULift.up_down]
  simpa [digitAux] using digitAuxFuel_more n v r (pos_length p) hn hr hbound

-- Coq: `digitInv` — if n^(pred r) ≤ |q| < n^r then digit n q = r
noncomputable def digitInv_check (n : Int) (q : Int) (r : Nat) : Unit :=
  ()

theorem digitInv (n : Int) (q : Int) (r : Nat) :
    ⦃⌜1 < n ∧ Zpower_nat n (Nat.pred r) ≤ |q| ∧ |q| < Zpower_nat n r⌝⦄
    (pure (digitInv_check n q r) : Id Unit)
    ⦃⇓_ => ⌜digit n q = r⌝⦄ := by
  intro ⟨hn, hlow, hupp⟩
  simp only [wp, PostCond.noThrow, pure, digitInv_check, Id.run,
    ULift.up_down]
  by_cases hr0 : r = 0
  · subst r
    simp [Zpower_nat] at hlow hupp
    subst q
    simp at hlow
  · have hrpos : 0 < r := Nat.pos_of_ne_zero hr0
    have hpred :
        (((r : Int) - 1).natAbs) = Nat.pred r := by
      apply Nat.cast_injective (R := Int)
      rw [Int.natAbs_of_nonneg (by omega : 0 ≤ (r : Int) - 1)]
      cases r with
      | zero => contradiction
      | succ k => simp
    have hr_natAbs : ((r : Int).natAbs) = r := by
      simp
    have hq_ne : q ≠ 0 := by
      intro hq0
      subst q
      simp [Zpower_nat] at hlow hupp
      have hn_pos : 0 < n := by omega
      have hpow_pos : 0 < n ^ Nat.pred r := pow_pos hn_pos _
      have hpow_pos' : 0 < n ^ (r - 1) := by
        simpa using hpow_pos
      linarith
    have hpre :
        q ≠ 0 ∧
          n ^ (((r : Int) - 1).natAbs) ≤ (q.natAbs : Int) ∧
          (q.natAbs : Int) < n ^ ((r : Int).natAbs) := by
      refine ⟨hq_ne, ?_, ?_⟩
      · rw [hpred]
        change n ^ Nat.pred r ≤ (q.natAbs : Int)
        rw [← Int.abs_eq_natAbs q]
        simpa [Zpower_nat] using hlow
      · rw [hr_natAbs]
        change (q.natAbs : Int) < n ^ r
        rw [← Int.abs_eq_natAbs q]
        simpa [Zpower_nat] using hupp
    have hzd :=
      (FloatSpec.Core.Digits.Zdigits_unique
        (beta := n) (h_beta := hn) (n := q) (e := (r : Int)) (hβ := hn)) hpre
    simp only [wp, PostCond.noThrow, pure, Id.run] at hzd
    unfold digit
    rw [hzd]
    simp

-- Coq: `digit_monotone` — if |p| ≤ |q| then digit n p ≤ digit n q
noncomputable def digit_monotone_check (n : Int) (p q : Int) : Unit :=
  ()

theorem digit_monotone (n : Int) (p q : Int) :
    ⦃⌜1 < n ∧ |p| ≤ |q|⌝⦄
    (pure (digit_monotone_check n p q) : Id Unit)
    ⦃⇓_ => ⌜digit n p ≤ digit n q⌝⦄ := by
  intro ⟨hn, hpq⟩
  simp only [wp, PostCond.noThrow, pure, digit_monotone_check, Id.run,
    ULift.up_down]
  by_cases hp0 : p = 0
  · subst p
    simp [digit, FloatSpec.Core.Digits.Zdigits]
  · have hpq_nat : p.natAbs ≤ q.natAbs := by
      rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs] at hpq
      exact_mod_cast hpq
    have hpre : p ≠ 0 ∧ p.natAbs ≤ q.natAbs :=
      ⟨hp0, hpq_nat⟩
    have hle_pack :=
      (FloatSpec.Core.Digits.Zdigits_le
        (beta := n) (h_beta := hn) (n := p) (m := q) (hβ := hn)) hpre
    simp only [wp, PostCond.noThrow, pure, Id.run] at hle_pack
    rcases hle_pack with ⟨dq, hdq, hle_int⟩
    have hp_nonneg : 0 ≤ FloatSpec.Core.Digits.Zdigits n p :=
      FloatSpec.Core.Digits.Zdigits_ge_0 n p trivial
    have hq_nonneg : 0 ≤ FloatSpec.Core.Digits.Zdigits n q :=
      FloatSpec.Core.Digits.Zdigits_ge_0 n q trivial
    unfold digit
    have hle_toNat_int :
        ((FloatSpec.Core.Digits.Zdigits n p).toNat : Int) ≤
          ((FloatSpec.Core.Digits.Zdigits n q).toNat : Int) := by
      rw [Int.toNat_of_nonneg hp_nonneg, Int.toNat_of_nonneg hq_nonneg]
      simpa [hdq] using hle_int
    exact_mod_cast hle_toNat_int

-- Coq: `digitNotZero` — if q ≠ 0 then 0 < digit n q
noncomputable def digitNotZero_check (n : Int) (q : Int) : Unit :=
  ()

theorem digitNotZero (n : Int) (q : Int) :
    ⦃⌜1 < n ∧ q ≠ 0⌝⦄
    (pure (digitNotZero_check n q) : Id Unit)
    ⦃⇓_ => ⌜0 < digit n q⌝⦄ := by
  intro ⟨hn, hq⟩
  simp only [wp, PostCond.noThrow, pure, digitNotZero_check, Id.run,
    ULift.up_down]
  unfold digit
  have hgt : 0 < FloatSpec.Core.Digits.Zdigits n q :=
    FloatSpec.Core.Digits.Zdigits_gt_0 n q hn hq
  have hnonneg : 0 ≤ FloatSpec.Core.Digits.Zdigits n q := le_of_lt hgt
  have htoNat :
      ((FloatSpec.Core.Digits.Zdigits n q).toNat : Int) =
        FloatSpec.Core.Digits.Zdigits n q :=
    Int.toNat_of_nonneg hnonneg
  have hpos_int :
      (0 : Int) < (FloatSpec.Core.Digits.Zdigits n q).toNat := by
    rw [htoNat]
    exact hgt
  exact_mod_cast hpos_int

/-- Coq: `MSB_le_abs` — the unit at the most significant bit is below the
absolute value of a nonzero float. -/
theorem MSB_le_abs {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    beta = radix →
    1 < radix →
    ¬ is_Fzero x →
    _root_.F2R (beta:=beta)
        (⟨1, MSB (beta:=beta) radix x⟩ : FloatSpec.Core.Defs.FlocqFloat beta) ≤
      _root_.F2R (beta:=beta) (Fabs (beta:=beta) x) := by
  intro hbeta_radix hradix hx_nonzero
  have hbeta : 1 < beta := by omega
  have hxnum : x.Fnum ≠ 0 := by
    simpa [is_Fzero] using hx_nonzero
  let d : Nat := Fdigit (beta:=beta) radix x
  have hd_pos : 0 < d := by
    simpa [d, Fdigit, digit] using (digitNotZero radix x.Fnum) ⟨hradix, hxnum⟩
  have hpred_cast : ((Nat.pred d : Nat) : Int) = (d : Int) - 1 := by
    have hsucc : Nat.succ (Nat.pred d) = d := Nat.succ_pred_eq_of_pos hd_pos
    have hcast :
        ((Nat.succ (Nat.pred d) : Nat) : Int) =
          ((Nat.pred d : Nat) : Int) + 1 := by
      simp
    omega
  have hmsb :
      MSB (beta:=beta) radix x = ((Nat.pred d : Nat) : Int) + x.Fexp := by
    unfold MSB
    have hd : Fdigit (beta:=beta) radix x = d := rfl
    rw [hd, hpred_cast]
    simp [Int.pred]
    omega
  have hpow_le_int : Zpower_nat radix (Nat.pred d) ≤ |x.Fnum| := by
    simpa [d, Fdigit] using (digitLess radix x.Fnum) ⟨hradix, hxnum⟩
  have hpow_le_real :
      (radix : ℝ) ^ (((Nat.pred d : Nat) : Int)) ≤ (|x.Fnum| : ℝ) := by
    have hbridge := (Zpower_nat_Z_powerRZ radix (Nat.pred d)) trivial
    have hcast : ((Zpower_nat radix (Nat.pred d) : Int) : ℝ) ≤ (|x.Fnum| : ℝ) := by
      exact_mod_cast hpow_le_int
    rw [hbridge] at hcast
    exact hcast
  have hradix_pos_int : 0 < radix := by omega
  have hradix_pos_real : 0 < (radix : ℝ) := by exact_mod_cast hradix_pos_int
  have hradix_ne_real : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos_real
  have hscale_pos : 0 < (radix : ℝ) ^ x.Fexp := zpow_pos hradix_pos_real x.Fexp
  have hscaled :
      (radix : ℝ) ^ (((Nat.pred d : Nat) : Int)) * (radix : ℝ) ^ x.Fexp ≤
        (|x.Fnum| : ℝ) * (radix : ℝ) ^ x.Fexp :=
    mul_le_mul_of_nonneg_right hpow_le_real (le_of_lt hscale_pos)
  have htarget :
      (radix : ℝ) ^ (((Nat.pred d : Nat) : Int) + x.Fexp) ≤
        |_root_.F2R (beta:=beta) x| := by
    calc
      (radix : ℝ) ^ (((Nat.pred d : Nat) : Int) + x.Fexp)
          = (radix : ℝ) ^ (((Nat.pred d : Nat) : Int)) *
              (radix : ℝ) ^ x.Fexp := by
            exact zpow_add₀ hradix_ne_real (((Nat.pred d : Nat) : Int)) x.Fexp
      _ ≤ (|x.Fnum| : ℝ) * (radix : ℝ) ^ x.Fexp := hscaled
      _ = |_root_.F2R (beta:=beta) x| := by
            simp [_root_.F2R, FloatSpec.Core.Defs.F2R, hbeta_radix,
              abs_mul, abs_of_pos hscale_pos]
  have hleft :
      _root_.F2R (beta:=beta)
          (⟨1, MSB (beta:=beta) radix x⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) =
        (radix : ℝ) ^ (((Nat.pred d : Nat) : Int) + x.Fexp) := by
    simp [_root_.F2R, FloatSpec.Core.Defs.F2R, hbeta_radix, hmsb]
  have hright :
      _root_.F2R (beta:=beta) (Fabs (beta:=beta) x) =
        |_root_.F2R (beta:=beta) x| :=
    (Fabs_correct (beta:=beta) x) hbeta
  rw [hleft, hright]
  exact htarget

/-- Coq: `LSB_le_abs` — the unit at the least significant bit is below the
absolute value of a nonzero float. -/
theorem LSB_le_abs {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    beta = radix →
    1 < radix →
    ¬ is_Fzero x →
    _root_.F2R (beta:=beta)
        (⟨1, LSB (beta:=beta) radix x⟩ : FloatSpec.Core.Defs.FlocqFloat beta) ≤
      _root_.F2R (beta:=beta) (Fabs (beta:=beta) x) := by
  intro hbeta_radix hradix hx_nonzero
  have hbeta : 1 < beta := by omega
  have hlsb_msb : LSB (beta:=beta) radix x ≤ MSB (beta:=beta) radix x :=
    (LSB_le_MSB (beta:=beta) radix x) ⟨hradix, hx_nonzero⟩
  have hunit_le :
      _root_.F2R (beta:=beta)
          (⟨1, LSB (beta:=beta) radix x⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) ≤
        _root_.F2R (beta:=beta)
          (⟨1, MSB (beta:=beta) radix x⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) :=
    (oneExp_le (beta:=beta) (LSB (beta:=beta) radix x)
      (MSB (beta:=beta) radix x)) ⟨hbeta, hlsb_msb⟩
  exact le_trans hunit_le (MSB_le_abs (beta:=beta) radix x
    hbeta_radix hradix hx_nonzero)

/-- Coq: `abs_lt_MSB` — the absolute value of a float is strictly below the
unit just above its most significant bit. -/
theorem abs_lt_MSB {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    beta = radix →
    1 < radix →
    _root_.F2R (beta:=beta) (Fabs (beta:=beta) x) <
      _root_.F2R (beta:=beta)
        (⟨1, Int.succ (MSB (beta:=beta) radix x)⟩ :
          FloatSpec.Core.Defs.FlocqFloat beta) := by
  intro hbeta_radix hradix
  have hbeta : 1 < beta := by omega
  have hradix_pos_int : 0 < radix := by omega
  have hradix_pos_real : 0 < (radix : ℝ) := by exact_mod_cast hradix_pos_int
  have hradix_ne_real : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos_real
  by_cases hxnum : x.Fnum = 0
  · have hleft :
        _root_.F2R (beta:=beta) (Fabs (beta:=beta) x) = 0 := by
      simp [Fabs, FloatSpec.Calc.Operations.Fabs, _root_.F2R,
        FloatSpec.Core.Defs.F2R, hxnum]
    have hright_pos :
        0 <
          _root_.F2R (beta:=beta)
            (⟨1, Int.succ (MSB (beta:=beta) radix x)⟩ :
              FloatSpec.Core.Defs.FlocqFloat beta) := by
      simp [_root_.F2R, FloatSpec.Core.Defs.F2R, hbeta_radix,
        zpow_pos hradix_pos_real]
    rw [hleft]
    exact hright_pos
  · let d : Nat := Fdigit (beta:=beta) radix x
    have hsucc_msb :
        Int.succ (MSB (beta:=beta) radix x) = (d : Int) + x.Fexp := by
      unfold MSB
      have hd : Fdigit (beta:=beta) radix x = d := rfl
      rw [hd]
      simp [Int.pred, Int.succ]
    have hpow_lt_int : |x.Fnum| < Zpower_nat radix d := by
      simpa [d, Fdigit, digit] using (digitMore radix x.Fnum) hradix
    have hpow_lt_real :
        (|x.Fnum| : ℝ) < (radix : ℝ) ^ (d : Int) := by
      have hbridge := (Zpower_nat_Z_powerRZ radix d) trivial
      have hcast : (|x.Fnum| : ℝ) < ((Zpower_nat radix d : Int) : ℝ) := by
        exact_mod_cast hpow_lt_int
      rw [hbridge] at hcast
      exact hcast
    have hscale_pos : 0 < (radix : ℝ) ^ x.Fexp := zpow_pos hradix_pos_real x.Fexp
    have hscaled :
        (|x.Fnum| : ℝ) * (radix : ℝ) ^ x.Fexp <
          (radix : ℝ) ^ (d : Int) * (radix : ℝ) ^ x.Fexp :=
      mul_lt_mul_of_pos_right hpow_lt_real hscale_pos
    have hleft_abs :
        _root_.F2R (beta:=beta) (Fabs (beta:=beta) x) =
          |_root_.F2R (beta:=beta) x| :=
      (Fabs_correct (beta:=beta) x) hbeta
    calc
      _root_.F2R (beta:=beta) (Fabs (beta:=beta) x)
          = |_root_.F2R (beta:=beta) x| := hleft_abs
      _ = (|x.Fnum| : ℝ) * (radix : ℝ) ^ x.Fexp := by
            simp [_root_.F2R, FloatSpec.Core.Defs.F2R, hbeta_radix,
              abs_mul, abs_of_pos hscale_pos]
      _ < (radix : ℝ) ^ (d : Int) * (radix : ℝ) ^ x.Fexp := hscaled
      _ = (radix : ℝ) ^ ((d : Int) + x.Fexp) := by
            rw [← zpow_add₀ hradix_ne_real (d : Int) x.Fexp]
      _ = _root_.F2R (beta:=beta)
            (⟨1, Int.succ (MSB (beta:=beta) radix x)⟩ :
              FloatSpec.Core.Defs.FlocqFloat beta) := by
            simp [_root_.F2R, FloatSpec.Core.Defs.F2R, hbeta_radix,
              hsucc_msb]

/-- Coq: `MSB_monotoneAux` — with equal exponents, monotonicity of absolute
values implies monotonicity of most significant bit positions. -/
theorem MSB_monotoneAux {beta : Int}
    (radix : Int)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) :
    beta = radix →
    1 < radix →
    _root_.F2R (beta:=beta) (Fabs (beta:=beta) x) ≤
      _root_.F2R (beta:=beta) (Fabs (beta:=beta) y) →
    x.Fexp = y.Fexp →
    MSB (beta:=beta) radix x ≤ MSB (beta:=beta) radix y := by
  intro hbeta_radix hradix hle hExp
  have hbeta : 1 < beta := by omega
  have hradix_pos_int : 0 < radix := by omega
  have hradix_pos_real : 0 < (radix : ℝ) := by exact_mod_cast hradix_pos_int
  have hscale_pos : 0 < (radix : ℝ) ^ x.Fexp := zpow_pos hradix_pos_real x.Fexp
  have hscale_pos_y : 0 < (radix : ℝ) ^ y.Fexp := zpow_pos hradix_pos_real y.Fexp
  have hxabs :
      _root_.F2R (beta:=beta) (Fabs (beta:=beta) x) =
        |_root_.F2R (beta:=beta) x| :=
    (Fabs_correct (beta:=beta) x) hbeta
  have hyabs :
      _root_.F2R (beta:=beta) (Fabs (beta:=beta) y) =
        |_root_.F2R (beta:=beta) y| :=
    (Fabs_correct (beta:=beta) y) hbeta
  have hnum_scaled_y :
      (|x.Fnum| : ℝ) * (radix : ℝ) ^ y.Fexp ≤
        (|y.Fnum| : ℝ) * (radix : ℝ) ^ y.Fexp := by
    have hle_abs : |_root_.F2R (beta:=beta) x| ≤
        |_root_.F2R (beta:=beta) y| := by
      simpa [hxabs, hyabs] using hle
    simpa [_root_.F2R, FloatSpec.Core.Defs.F2R, hbeta_radix, hExp,
      abs_mul, abs_of_pos hscale_pos_y, abs_of_pos hradix_pos_real] using hle_abs
  have hnum_scaled :
      (|x.Fnum| : ℝ) * (radix : ℝ) ^ x.Fexp ≤
        (|y.Fnum| : ℝ) * (radix : ℝ) ^ x.Fexp := by
    simpa [hExp] using hnum_scaled_y
  have hnum_le_real : (|x.Fnum| : ℝ) ≤ (|y.Fnum| : ℝ) := by
    nlinarith [hnum_scaled, hscale_pos]
  have hnum_le_int : |x.Fnum| ≤ |y.Fnum| := by
    exact_mod_cast hnum_le_real
  have hdigit :
      Fdigit (beta:=beta) radix x ≤ Fdigit (beta:=beta) radix y := by
    simpa [Fdigit, digit] using
      (digit_monotone radix x.Fnum y.Fnum) ⟨hradix, hnum_le_int⟩
  unfold MSB
  rw [hExp]
  have hdigit_int :
      (Fdigit (beta:=beta) radix x : Int) ≤
        (Fdigit (beta:=beta) radix y : Int) := by
    exact_mod_cast hdigit
  simp [Int.pred]
  omega

/-- Coq: `MSB_monotone` — absolute-value order preserves most significant bit
positions for nonzero floats. -/
theorem MSB_monotone {beta : Int}
    (radix : Int)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) :
    beta = radix →
    1 < radix →
    ¬ is_Fzero x →
    ¬ is_Fzero y →
    _root_.F2R (beta:=beta) (Fabs (beta:=beta) x) ≤
      _root_.F2R (beta:=beta) (Fabs (beta:=beta) y) →
    MSB (beta:=beta) radix x ≤ MSB (beta:=beta) radix y := by
  intro hbeta_radix hradix hx_nonzero hy_nonzero hle_abs
  have hbeta : 1 < beta := by omega
  have hx_unit_le_abs :
      _root_.F2R (beta:=beta)
          (⟨1, MSB (beta:=beta) radix x⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) ≤
        _root_.F2R (beta:=beta) (Fabs (beta:=beta) x) :=
    MSB_le_abs (beta:=beta) radix x hbeta_radix hradix hx_nonzero
  have hy_abs_lt_next :
      _root_.F2R (beta:=beta) (Fabs (beta:=beta) y) <
        _root_.F2R (beta:=beta)
          (⟨1, Int.succ (MSB (beta:=beta) radix y)⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) :=
    abs_lt_MSB (beta:=beta) radix y hbeta_radix hradix
  have hstrict :
      _root_.F2R (beta:=beta)
          (⟨1, MSB (beta:=beta) radix x⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) <
        _root_.F2R (beta:=beta)
          (⟨1, Int.succ (MSB (beta:=beta) radix y)⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) :=
    lt_of_le_of_lt (le_trans hx_unit_le_abs hle_abs) hy_abs_lt_next
  have hlt_succ :
      MSB (beta:=beta) radix x < Int.succ (MSB (beta:=beta) radix y) :=
    (oneExp_Zlt (beta:=beta)
        (MSB (beta:=beta) radix x)
        (Int.succ (MSB (beta:=beta) radix y)))
      ⟨hbeta, hstrict⟩
  simpa [Int.succ] using hlt_succ

private lemma abs_F2R_repr_at_lsb {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta_radix : beta = radix) (hradix : 1 < radix) :
    ∃ z : Int,
      |_root_.F2R (beta:=beta) x| =
        (z : ℝ) * (radix : ℝ) ^ (LSB (beta:=beta) radix x) := by
  have hbeta : 1 < beta := by omega
  have habs :
      _root_.F2R (beta:=beta) (Fabs (beta:=beta) x) =
        |_root_.F2R (beta:=beta) x| := by
    have h := Fabs_correct (beta:=beta) x
    simpa only [wp, PostCond.noThrow, pure, Fabs_correct_check, Id.run,
      ULift.up_down] using h hbeta
  have hlsb_abs :
      LSB (beta:=beta) radix x =
        LSB (beta:=beta) radix (Fabs (beta:=beta) x) :=
    (LSB_abs (beta:=beta) radix x) trivial
  rcases (LSB_rep_min (beta:=beta) radix (Fabs (beta:=beta) x))
      ⟨hbeta_radix, hradix⟩ with ⟨z, hz⟩
  refine ⟨z, ?_⟩
  calc
    |_root_.F2R (beta:=beta) x|
        = _root_.F2R (beta:=beta) (Fabs (beta:=beta) x) := habs.symm
    _ = _root_.F2R (beta:=beta)
          (⟨z, LSB (beta:=beta) radix (Fabs (beta:=beta) x)⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) := hz
    _ = (z : ℝ) * (radix : ℝ) ^ (LSB (beta:=beta) radix x) := by
          simp [_root_.F2R, FloatSpec.Core.Defs.F2R, hbeta_radix,
            ← hlsb_abs]

private lemma abs_F2R_repr_at {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) (e : Int)
    (hbeta_radix : beta = radix) (hradix : 1 < radix)
    (he : e ≤ LSB (beta:=beta) radix x) :
    ∃ z : Int,
      |_root_.F2R (beta:=beta) x| =
        (z : ℝ) * (radix : ℝ) ^ e := by
  rcases abs_F2R_repr_at_lsb (beta:=beta) radix x hbeta_radix hradix with
    ⟨z, hz⟩
  let k : Nat := Int.toNat (LSB (beta:=beta) radix x - e)
  let scale : Int := Zpower_nat radix k
  refine ⟨z * scale, ?_⟩
  have hradix_pos_int : 0 < radix := by omega
  have hradix_pos_real : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradix_pos_int
  have hradix_ne_real : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos_real
  have hdiff_nonneg : 0 ≤ LSB (beta:=beta) radix x - e := by omega
  have hk_cast :
      (k : Int) = LSB (beta:=beta) radix x - e := by
    simpa [k] using Int.toNat_of_nonneg hdiff_nonneg
  have hscale :
      (scale : ℝ) =
        (radix : ℝ) ^ (LSB (beta:=beta) radix x - e) := by
    have hbridge := (Zpower_nat_Z_powerRZ radix k) trivial
    simpa [scale, hk_cast] using hbridge
  have hsplit :
      (radix : ℝ) ^ (LSB (beta:=beta) radix x) =
        (radix : ℝ) ^ (LSB (beta:=beta) radix x - e) *
          (radix : ℝ) ^ e := by
    calc
      (radix : ℝ) ^ (LSB (beta:=beta) radix x)
          = (radix : ℝ) ^ ((LSB (beta:=beta) radix x - e) + e) := by
              congr 1
              ring
      _ = (radix : ℝ) ^ (LSB (beta:=beta) radix x - e) *
            (radix : ℝ) ^ e :=
              zpow_add₀ hradix_ne_real (LSB (beta:=beta) radix x - e) e
  calc
    |_root_.F2R (beta:=beta) x|
        = (z : ℝ) * (radix : ℝ) ^ (LSB (beta:=beta) radix x) := hz
    _ = (z : ℝ) *
          ((radix : ℝ) ^ (LSB (beta:=beta) radix x - e) *
            (radix : ℝ) ^ e) := by rw [hsplit]
    _ = ((z * scale : Int) : ℝ) * (radix : ℝ) ^ e := by
          rw [Int.cast_mul, hscale]
          ring

noncomputable def LSB_Pred_check {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `LSB_Pred`.

If two floats are ordered by absolute value and the least significant bit of
`x` is no larger than that of `y`, then `|x|` is at least one `LSB x` unit
below `|y|`.  The precondition carries the upstream `GenericC` section
assumptions. -/
theorem LSB_Pred {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧
        b.vNum = Zpower_nat radix precision ∧ 1 < precision ∧ Even radix ∧
        |_root_.F2R (beta:=beta) x| < |_root_.F2R (beta:=beta) y| ∧
        LSB (beta:=beta) radix x ≤ LSB (beta:=beta) radix y⌝⦄
    (pure (LSB_Pred_check (beta:=beta) b radix precision x y) : Id Unit)
    ⦃⇓_ => ⌜|_root_.F2R (beta:=beta) x| ≤
        |_root_.F2R (beta:=beta) y| -
          (radix : ℝ) ^ (LSB (beta:=beta) radix x)⌝⦄ := by
  intro h
  rcases h with
    ⟨hbeta_radix, hradix, _hvnum, _hprecision, _heven, hlt_abs, hlsb⟩
  simp only [wp, PostCond.noThrow, pure, LSB_Pred_check, Id.run,
    ULift.up_down]
  let e : Int := LSB (beta:=beta) radix x
  rcases abs_F2R_repr_at (beta:=beta) radix x e hbeta_radix hradix
      (by simp [e]) with ⟨nx, hx_repr⟩
  rcases abs_F2R_repr_at (beta:=beta) radix y e hbeta_radix hradix
      (by simpa [e] using hlsb) with ⟨ny, hy_repr⟩
  have hradix_pos_int : 0 < radix := by omega
  have hradix_pos_real : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradix_pos_int
  have hunit_pos : 0 < (radix : ℝ) ^ e := zpow_pos hradix_pos_real e
  have hnx_lt_ny_real : (nx : ℝ) < (ny : ℝ) := by
    have hscaled :
        (nx : ℝ) * (radix : ℝ) ^ e <
          (ny : ℝ) * (radix : ℝ) ^ e := by
      simpa [hx_repr, hy_repr] using hlt_abs
    exact lt_of_mul_lt_mul_right hscaled (le_of_lt hunit_pos)
  have hnx_succ_le_ny : nx + 1 ≤ ny := by
    have hnx_lt_ny : nx < ny := Int.cast_lt.mp hnx_lt_ny_real
    omega
  have hcoeff :
      ((nx : ℝ) + 1) * (radix : ℝ) ^ e ≤
        (ny : ℝ) * (radix : ℝ) ^ e := by
    have hcoeff_le : (nx : ℝ) + 1 ≤ (ny : ℝ) := by
      exact_mod_cast hnx_succ_le_ny
    exact mul_le_mul_of_nonneg_right hcoeff_le (le_of_lt hunit_pos)
  calc
    |_root_.F2R (beta:=beta) x|
        = (nx : ℝ) * (radix : ℝ) ^ e := hx_repr
    _ ≤ (ny : ℝ) * (radix : ℝ) ^ e - (radix : ℝ) ^ e := by
          nlinarith
    _ = |_root_.F2R (beta:=beta) y| - (radix : ℝ) ^ e := by
          rw [hy_repr]
    _ = |_root_.F2R (beta:=beta) y| -
          (radix : ℝ) ^ (LSB (beta:=beta) radix x) := by
          simp [e]

/-- Coq: `isMinComp` — a lower rounded value remains the lower bound for any
intermediate real strictly between the same min/max pair. -/
theorem isMinComp {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (r1 r2 : ℝ) (min max : FloatSpec.Core.Defs.FlocqFloat beta) :
    isMin' (beta:=beta) b radix r1 min →
    isMax' (beta:=beta) b radix r1 max →
    _root_.F2R (beta:=beta) min < r2 →
    r2 < _root_.F2R (beta:=beta) max →
    isMin' (beta:=beta) b radix r2 min := by
  intro hmin hmax hmin_lt hlt_max
  rcases hmin with ⟨hmin_bounded, hmin_le, hgreatest⟩
  rcases hmax with ⟨hmax_bounded, hmax_ge, hleast⟩
  constructor
  · exact hmin_bounded
  constructor
  · exact le_of_lt hmin_lt
  · intro f hfbounded hf_le_r2
    by_cases hf_le_r1 : _root_.F2R (beta:=beta) f ≤ r1
    · exact hgreatest f hfbounded hf_le_r1
    · have hr1_lt_f : r1 < _root_.F2R (beta:=beta) f := lt_of_not_ge hf_le_r1
      have hmax_le_f : _root_.F2R (beta:=beta) max ≤ _root_.F2R (beta:=beta) f :=
        hleast f hfbounded (le_of_lt hr1_lt_f)
      have hf_lt_max : _root_.F2R (beta:=beta) f < _root_.F2R (beta:=beta) max :=
        lt_of_le_of_lt hf_le_r2 hlt_max
      exact False.elim ((not_lt_of_ge hmax_le_f) hf_lt_max)

/-- Coq: `isMaxComp` — an upper rounded value remains the upper bound for any
intermediate real strictly between the same min/max pair. -/
theorem isMaxComp {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (r1 r2 : ℝ) (min max : FloatSpec.Core.Defs.FlocqFloat beta) :
    isMin' (beta:=beta) b radix r1 min →
    isMax' (beta:=beta) b radix r1 max →
    _root_.F2R (beta:=beta) min < r2 →
    r2 < _root_.F2R (beta:=beta) max →
    isMax' (beta:=beta) b radix r2 max := by
  intro hmin hmax hmin_lt hlt_max
  rcases hmin with ⟨hmin_bounded, hmin_le, hgreatest⟩
  rcases hmax with ⟨hmax_bounded, hmax_ge, hleast⟩
  constructor
  · exact hmax_bounded
  constructor
  · exact le_of_lt hlt_max
  · intro f hfbounded hr2_le_f
    by_cases hr1_le_f : r1 ≤ _root_.F2R (beta:=beta) f
    · exact hleast f hfbounded hr1_le_f
    · have hf_lt_r1 : _root_.F2R (beta:=beta) f < r1 := lt_of_not_ge hr1_le_f
      have hf_le_min : _root_.F2R (beta:=beta) f ≤ _root_.F2R (beta:=beta) min :=
        hgreatest f hfbounded (le_of_lt hf_lt_r1)
      have hmin_lt_f : _root_.F2R (beta:=beta) min < _root_.F2R (beta:=beta) f :=
        lt_of_lt_of_le hmin_lt hr2_le_f
      exact False.elim ((not_lt_of_ge hf_le_min) hmin_lt_f)

-- Coq: `digitAdd` — digit n (q * n^r) = digit n q + r for q ≠ 0
noncomputable def digitAdd_check (n : Int) (q : Int) (r : Nat) : Unit :=
  ()

theorem digitAdd (n : Int) (q : Int) (r : Nat) :
    ⦃⌜1 < n ∧ q ≠ 0⌝⦄
    (pure (digitAdd_check n q r) : Id Unit)
    ⦃⇓_ => ⌜digit n (q * Zpower_nat n r) = digit n q + r⌝⦄ := by
  intro ⟨hn, hq⟩
  simp only [wp, PostCond.noThrow, pure, digitAdd_check, Id.run,
    ULift.up_down]
  unfold digit
  have hr_nonneg : 0 ≤ (r : Int) := by exact_mod_cast Nat.zero_le r
  have hmul :=
    (FloatSpec.Core.Digits.Zdigits_mult_Zpower
      (beta := n) (n := q) (k := (r : Int)) (h_beta := hn))
      ⟨hq, hr_nonneg⟩
  rcases hmul with ⟨dq, hdq, hres⟩
  have hdq_nonneg : 0 ≤ FloatSpec.Core.Digits.Zdigits n q :=
    FloatSpec.Core.Digits.Zdigits_ge_0 n q trivial
  have hpow_arg : q * n ^ (r : Int).natAbs = q * Zpower_nat n r := by
    simp [Zpower_nat]
  have hres' :
      FloatSpec.Core.Digits.Zdigits n (q * Zpower_nat n r) =
        FloatSpec.Core.Digits.Zdigits n q + (r : Int) := by
    simpa [hpow_arg, hdq] using hres
  rw [hres']
  rw [Int.toNat_add hdq_nonneg hr_nonneg]
  simp

private lemma maxDiv_ge_of_dvd (radix v : Int) (k p : Nat)
    (hkp : k ≤ p) (hdiv : Zdivides v (Zpower_nat radix k)) :
    k ≤ maxDiv radix v p := by
  induction p generalizing k with
  | zero =>
      have hk0 : k = 0 := by omega
      subst k
      simp [maxDiv]
  | succ p ih =>
      letI : Decidable (Zdivides v (Zpower_nat radix (Nat.succ p))) :=
        Classical.propDecidable (Zdivides v (Zpower_nat radix (Nat.succ p)))
      classical
      by_cases htop : Zdivides v (Zpower_nat radix (Nat.succ p))
      · simp [maxDiv, htop, hkp]
      · simp [maxDiv, htop]
        have hk_le_p : k ≤ p := by
          by_contra hnot
          have hk_eq : k = Nat.succ p := by omega
          subst k
          exact htop hdiv
        exact ih k hk_le_p hdiv

/-- Coq: `maxDivSimplAux` — if `p` is already the maximal divisor exponent
inside a larger `S (q + p)` search range, it is also the result in the
minimal `S p` search range. -/
theorem maxDivSimplAux (radix v : Int) (p q : Nat) :
    p = maxDiv radix v (Nat.succ (q + p)) →
    p = maxDiv radix v (Nat.succ p) := by
  intro hbig
  apply le_antisymm
  · have hdiv_big :
        Zdivides v (Zpower_nat radix (maxDiv radix v (Nat.succ (q + p)))) := by
      exact (maxDivCorrect radix v (Nat.succ (q + p))) trivial
    have hdiv_p : Zdivides v (Zpower_nat radix p) := by
      simpa [← hbig] using hdiv_big
    exact maxDiv_ge_of_dvd radix v p (Nat.succ p) (Nat.le_succ p) hdiv_p
  · have hle : maxDiv radix v (Nat.succ p) ≤ Nat.succ p := by
      exact (maxDivLess radix v (Nat.succ p)) trivial
    have hne : maxDiv radix v (Nat.succ p) ≠ Nat.succ p := by
      intro hsmall_top
      have hdiv_small :
          Zdivides v (Zpower_nat radix (maxDiv radix v (Nat.succ p))) := by
        exact (maxDivCorrect radix v (Nat.succ p)) trivial
      have hdiv_succ : Zdivides v (Zpower_nat radix (Nat.succ p)) := by
        simpa [hsmall_top] using hdiv_small
      have hsucc_le_big :
          Nat.succ p ≤ maxDiv radix v (Nat.succ (q + p)) := by
        apply maxDiv_ge_of_dvd radix v (Nat.succ p) (Nat.succ (q + p))
        · omega
        · exact hdiv_succ
      omega
    omega

/-- Coq: `maxDivSimpl` — the previous auxiliary simplification for any
strictly larger search bound. -/
theorem maxDivSimpl (radix v : Int) (p q : Nat) :
    p < q →
    p = maxDiv radix v q →
    p = maxDiv radix v (Nat.succ p) := by
  intro hpq hq
  have hq_shape : q = Nat.succ ((q - Nat.succ p) + p) := by
    omega
  apply maxDivSimplAux (radix:=radix) (v:=v) (p:=p)
      (q:=q - Nat.succ p)
  rw [← hq_shape]
  exact hq

/-- Coq: `maxDivUnique` — the simplified maximum exponent is exactly the
last exponent where divisibility holds. -/
theorem maxDivUnique (radix v : Int) (p : Nat) :
    p = maxDiv radix v (Nat.succ p) →
    Zdivides v (Zpower_nat radix p) ∧
      ¬ Zdivides v (Zpower_nat radix (Nat.succ p)) := by
  intro hp
  constructor
  · have hdiv :
        Zdivides v (Zpower_nat radix (maxDiv radix v (Nat.succ p))) := by
      exact (maxDivCorrect radix v (Nat.succ p)) trivial
    simpa [← hp] using hdiv
  · intro hdiv_succ
    have htop : maxDiv radix v (Nat.succ p) = Nat.succ p := by
      simp [maxDiv, hdiv_succ]
    omega

private lemma Zdivides_pow_le (radix v : Int) (a b : Nat)
    (hab : a ≤ b) (hdiv : Zdivides v (Zpower_nat radix b)) :
    Zdivides v (Zpower_nat radix a) := by
  rcases hdiv with ⟨q, hq⟩
  refine ⟨radix ^ (b - a) * q, ?_⟩
  have hb : a + (b - a) = b := Nat.add_sub_of_le hab
  calc
    v = Zpower_nat radix b * q := hq
    _ = (radix ^ a * radix ^ (b - a)) * q := by
        simp [Zpower_nat, ← pow_add, hb]
    _ = Zpower_nat radix a * (radix ^ (b - a) * q) := by
        simp [Zpower_nat]
        ring

private lemma Zdivides_mul_pow (radix v : Int) (a n : Nat)
    (hdiv : Zdivides v (Zpower_nat radix a)) :
    Zdivides (v * Zpower_nat radix n) (Zpower_nat radix (a + n)) := by
  rcases hdiv with ⟨q, hq⟩
  refine ⟨q, ?_⟩
  calc
    v * Zpower_nat radix n = (Zpower_nat radix a * q) * Zpower_nat radix n := by
      rw [hq]
    _ = Zpower_nat radix (a + n) * q := by
      simp [Zpower_nat, pow_add]
      ring

private lemma Zdivides_cancel_pow (radix v : Int) (a n : Nat)
    (hradix : 1 < radix)
    (hdiv : Zdivides (v * Zpower_nat radix n) (Zpower_nat radix (a + n))) :
    Zdivides v (Zpower_nat radix a) := by
  have hradix_pos : 0 < radix := by omega
  have hpow_ne : Zpower_nat radix n ≠ 0 := by
    exact ne_of_gt (by simpa [Zpower_nat] using pow_pos hradix_pos n)
  have hdiv' :
      Zdivides (Zpower_nat radix n * v)
        (Zpower_nat radix n * Zpower_nat radix a) := by
    rcases hdiv with ⟨q, hq⟩
    refine ⟨q, ?_⟩
    calc
      Zpower_nat radix n * v = v * Zpower_nat radix n := by ring
      _ = Zpower_nat radix (a + n) * q := hq
      _ = (Zpower_nat radix n * Zpower_nat radix a) * q := by
        have hp :
            Zpower_nat radix (a + n) =
              Zpower_nat radix n * Zpower_nat radix a := by
          simp [Zpower_nat, pow_add, mul_comm, mul_left_comm, mul_assoc]
        rw [hp]
  exact (ZdividesDiv v (Zpower_nat radix a) (Zpower_nat radix n)) ⟨hpow_ne, hdiv'⟩

/-- Coq: `maxDivSimplInvAux` — the inverse direction of
`maxDivSimplAux`. -/
theorem maxDivSimplInvAux (radix v : Int) (p q : Nat) :
    p = maxDiv radix v (Nat.succ p) →
    p = maxDiv radix v (Nat.succ (q + p)) := by
  intro hp
  have huniq := maxDivUnique radix v p hp
  rcases huniq with ⟨hdiv_p, hnot_succ⟩
  apply le_antisymm
  · apply maxDiv_ge_of_dvd radix v p (Nat.succ (q + p))
    · omega
    · exact hdiv_p
  · have hle_big : maxDiv radix v (Nat.succ (q + p)) ≤ Nat.succ (q + p) := by
      exact (maxDivLess radix v (Nat.succ (q + p))) trivial
    by_contra hnot
    have hsucc_le : Nat.succ p ≤ maxDiv radix v (Nat.succ (q + p)) := by
      omega
    have hdiv_big :
        Zdivides v (Zpower_nat radix (maxDiv radix v (Nat.succ (q + p)))) := by
      exact (maxDivCorrect radix v (Nat.succ (q + p))) trivial
    exact hnot_succ
      (Zdivides_pow_le radix v (Nat.succ p)
        (maxDiv radix v (Nat.succ (q + p))) hsucc_le hdiv_big)

/-- Coq: `maxDivSimplInv` — the inverse simplification for any larger search
bound. -/
theorem maxDivSimplInv (radix v : Int) (p q : Nat) :
    p < q →
    p = maxDiv radix v (Nat.succ p) →
    p = maxDiv radix v q := by
  intro hpq hp
  have hq_shape : q = Nat.succ ((q - Nat.succ p) + p) := by
    omega
  rw [hq_shape]
  exact maxDivSimplInvAux radix v p (q - Nat.succ p) hp

/-- Coq: `maxDivUniqueInverse` — divisibility at `p` and failure at
`S p` characterize the simplified maximum. -/
theorem maxDivUniqueInverse (radix v : Int) (p : Nat) :
    Zdivides v (Zpower_nat radix p) →
    ¬ Zdivides v (Zpower_nat radix (Nat.succ p)) →
    p = maxDiv radix v (Nat.succ p) := by
  intro hdiv_p hnot_succ
  apply le_antisymm
  · exact maxDiv_ge_of_dvd radix v p (Nat.succ p) (Nat.le_succ p) hdiv_p
  · have hle : maxDiv radix v (Nat.succ p) ≤ Nat.succ p := by
      exact (maxDivLess radix v (Nat.succ p)) trivial
    by_contra hnot
    have htop : maxDiv radix v (Nat.succ p) = Nat.succ p := by
      omega
    have hdiv_top :
        Zdivides v (Zpower_nat radix (maxDiv radix v (Nat.succ p))) := by
      exact (maxDivCorrect radix v (Nat.succ p)) trivial
    exact hnot_succ (by simpa [htop] using hdiv_top)

/-- Coq: `maxDivUniqueDigit` — the maximum divisor below the digit bound is
the last exponent where divisibility by `v` holds. -/
theorem maxDivUniqueDigit (radix v : Int) :
    1 < radix →
    v ≠ 0 →
    Zdivides v (Zpower_nat radix (maxDiv radix v (digit radix v))) ∧
      ¬ Zdivides v
          (Zpower_nat radix (Nat.succ (maxDiv radix v (digit radix v)))) := by
  intro hradix hv
  apply maxDivUnique
  apply maxDivSimpl (radix:=radix) (v:=v)
      (p:=maxDiv radix v (digit radix v)) (q:=digit radix v)
  · have hnot_digit :
        ¬ Zdivides v (Zpower_nat radix (digit radix v)) := by
      simpa using (NotDividesDigit radix v) ⟨hradix, hv⟩
    simpa using (maxDivLt radix v (digit radix v)) hnot_digit
  · rfl

/-- Coq: `maxDivUniqueInverseDigit` — divisibility/failure at adjacent
exponents characterizes the maximum divisor below the digit bound. -/
theorem maxDivUniqueInverseDigit (radix v : Int) (p : Nat) :
    1 < radix →
    v ≠ 0 →
    Zdivides v (Zpower_nat radix p) →
    ¬ Zdivides v (Zpower_nat radix (Nat.succ p)) →
    p = maxDiv radix v (digit radix v) := by
  intro hradix hv hdiv hnot_succ
  apply maxDivSimplInv (radix:=radix) (v:=v) (p:=p)
      (q:=digit radix v)
  · have hradix_nonneg : 0 ≤ radix := by omega
    have hpow_nonneg : 0 ≤ Zpower_nat radix p := by
      simpa [Zpower_nat] using (Zpower_NR0 radix p) hradix_nonneg
    have hdiv_le : |Zpower_nat radix p| ≤ |v| := by
      simpa using (ZDividesLe v (Zpower_nat radix p)) ⟨hv, hdiv⟩
    have hdigit_more : |v| < Zpower_nat radix (digit radix v) := by
      simpa using (digitMore radix v) hradix
    have hpow_lt :
        Zpower_nat radix p < Zpower_nat radix (digit radix v) := by
      calc
        Zpower_nat radix p = |Zpower_nat radix p| := by
          exact (abs_of_nonneg hpow_nonneg).symm
        _ ≤ |v| := hdiv_le
        _ < Zpower_nat radix (digit radix v) := hdigit_more
    simpa [Zpower_nat] using
      (Zpower_nat_anti_monotone_lt radix p (digit radix v))
        ⟨hradix, by simpa [Zpower_nat] using hpow_lt⟩
  · exact maxDivUniqueInverse radix v p hdiv hnot_succ

-- Coq: `maxDivPlus` — multiplicative stability of maxDiv against n-th power of radix
noncomputable def maxDivPlus_check (radix : Int) (v : Int) (n : Nat) : Unit :=
  ()

theorem maxDivPlus (radix : Int) (v : Int) (n : Nat) :
    ⦃⌜1 < radix ∧ v ≠ 0⌝⦄
    (pure (maxDivPlus_check radix v n) : Id Unit)
    ⦃⇓_ => ⌜maxDiv radix (v * Zpower_nat radix n) (digit radix v + n) =
            maxDiv radix v (digit radix v) + n⌝⦄ := by
  intro ⟨hradix, hv⟩
  simp only [wp, PostCond.noThrow, pure, maxDivPlus_check, Id.run,
    ULift.up_down]
  set d := digit radix v
  set md := maxDiv radix v d
  set prod := v * Zpower_nat radix n
  set mprod := maxDiv radix prod (d + n)
  have hmd_le_d : md ≤ d := by
    simpa [md, d] using (maxDivLess radix v (digit radix v)) trivial
  have hmd_div : Zdivides v (Zpower_nat radix md) := by
    simpa [md, d] using (maxDivCorrect radix v (digit radix v)) trivial
  have hprod_div : Zdivides prod (Zpower_nat radix (md + n)) := by
    simpa [prod] using Zdivides_mul_pow radix v md n hmd_div
  have hlower : md + n ≤ mprod := by
    have hlimit : md + n ≤ d + n := by omega
    simpa [mprod, prod] using
      maxDiv_ge_of_dvd radix prod (md + n) (d + n) hlimit hprod_div
  have hnot_digit : ¬ Zdivides v (Zpower_nat radix d) := by
    simpa [d] using (NotDividesDigit radix v) ⟨hradix, hv⟩
  have hmd_lt_d : md < d := by
    simpa [md, d] using (maxDivLt radix v d) hnot_digit
  have hnot_step : ¬ Zdivides v (Zpower_nat radix (Nat.succ md)) := by
    intro hstep
    have hsucc_le_d : Nat.succ md ≤ d := Nat.succ_le_iff.mpr hmd_lt_d
    have hle_md : Nat.succ md ≤ md :=
      maxDiv_ge_of_dvd radix v (Nat.succ md) d hsucc_le_d hstep
    omega
  have hupper : mprod ≤ md + n := by
    by_contra hnot
    have hgt : md + n < mprod := Nat.lt_of_not_ge hnot
    have hsucc_le_mprod : Nat.succ (md + n) ≤ mprod := Nat.succ_le_iff.mpr hgt
    have hmprod_div : Zdivides prod (Zpower_nat radix mprod) := by
      simpa [mprod, prod] using (maxDivCorrect radix prod (d + n)) trivial
    have hdiv_succ_sum :
        Zdivides prod (Zpower_nat radix (Nat.succ (md + n))) :=
      Zdivides_pow_le radix prod (Nat.succ (md + n)) mprod hsucc_le_mprod hmprod_div
    have hsucc_sum_eq : Nat.succ (md + n) = Nat.succ md + n := by omega
    have hdiv_succ_sum' :
        Zdivides prod (Zpower_nat radix (Nat.succ md + n)) := by
      rw [← hsucc_sum_eq]
      exact hdiv_succ_sum
    have hdiv_cancel :
        Zdivides v (Zpower_nat radix (Nat.succ md)) := by
      apply Zdivides_cancel_pow radix v (Nat.succ md) n hradix
      simpa [prod] using hdiv_succ_sum'
    exact hnot_step hdiv_cancel
  have heq : mprod = md + n := le_antisymm hupper hlower
  simpa [mprod, prod, md, d] using heq

theorem LSB_shift {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) (n : Nat) :
    ⦃⌜1 < radix ∧ ¬ is_Fzero x⌝⦄
    (pure (LSB_shift_check (beta:=beta) radix x n) : Id Unit)
    ⦃⇓_ => ⌜LSB (beta:=beta) radix x = LSB (beta:=beta) radix (Fshift (beta:=beta) radix n x)⌝⦄ := by
  intro ⟨_hradix, hx_nonzero⟩
  simp only [wp, PostCond.noThrow, pure, LSB_shift_check, Id.run,
    ULift.up_down]
  show LSB radix x = LSB radix (Fshift radix n x)
  cases x with
  | mk m e =>
    change Int.ofNat (maxDiv radix m (digit radix m)) + e =
      Int.ofNat (maxDiv radix (m * Zpower_nat radix n)
        (digit radix (m * Zpower_nat radix n))) + (e - (n : Int))
    have hdigit :
        digit radix (m * Zpower_nat radix n) = digit radix m + n :=
      (digitAdd radix m n) ⟨_hradix, hx_nonzero⟩
    have hmax :
        maxDiv radix (m * Zpower_nat radix n) (digit radix m + n) =
          maxDiv radix m (digit radix m) + n :=
      (maxDivPlus radix m n) ⟨_hradix, hx_nonzero⟩
    rw [hdigit, hmax]
    change ((maxDiv radix m (digit radix m) : Nat) : Int) + e =
      ((maxDiv radix m (digit radix m) + n : Nat) : Int) + (e - (n : Int))
    rw [Nat.cast_add]
    omega

theorem LSB_comp {beta : Int}
    (radix : Int)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) (n : Nat) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ ¬ is_Fzero x ∧ _root_.F2R x = _root_.F2R y⌝⦄
    (pure (LSB_comp_check (beta:=beta) radix x y n) : Id Unit)
    ⦃⇓_ => ⌜LSB (beta:=beta) radix x = LSB (beta:=beta) radix y⌝⦄ := by
  intro ⟨hbeta_radix, hradix, hx_nonzero, hxy⟩
  simp only [wp, PostCond.noThrow, pure, LSB_comp_check, Id.run,
    ULift.up_down]
  have hbeta : 1 < beta := by omega
  have hy_nonzero : ¬ is_Fzero y :=
    (NisFzeroComp (beta:=beta) x y) ⟨hbeta, hx_nonzero, hxy⟩
  rcases (FshiftCorrectSym (beta:=beta) radix x y)
      ⟨hbeta_radix, hradix, hxy⟩ with ⟨nx, ny, hshift⟩
  have hx_lsb :
      LSB (beta:=beta) radix x =
        LSB (beta:=beta) radix (Fshift (beta:=beta) radix nx x) :=
    (LSB_shift (beta:=beta) radix x nx) ⟨hradix, hx_nonzero⟩
  have hy_lsb :
      LSB (beta:=beta) radix y =
        LSB (beta:=beta) radix (Fshift (beta:=beta) radix ny y) :=
    (LSB_shift (beta:=beta) radix y ny) ⟨hradix, hy_nonzero⟩
  rw [hx_lsb, hshift, ← hy_lsb]
  rfl

noncomputable def MSBroundLSB_check {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop)
    (f1 f2 : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `MSBroundLSB`.

For a nonzero rounding error, the most significant bit of the error lies
strictly below the least significant bit of the rounded value. -/
theorem MSBroundLSB {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop)
    (f1 f2 : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ precision ≠ 0 ∧
        b.vNum = Zpower_nat radix precision ∧
        RoundedModeP_float (beta:=beta) b radix P ∧
        P (_root_.F2R (beta:=beta) f1) f2 ∧
        ¬ is_Fzero (Fminus (beta:=beta) f1 f2)⌝⦄
    (pure (MSBroundLSB_check (beta:=beta) b radix precision P f1 f2) : Id Unit)
    ⦃⇓_ => ⌜MSB (beta:=beta) radix (Fminus (beta:=beta) f1 f2) <
      LSB (beta:=beta) radix f2⌝⦄ := by
  intro h
  rcases h with
    ⟨hbeta, hradix, hprecision, hvNum, hRounded, hP, hdiff_nonzero⟩
  simp only [wp, PostCond.noThrow, pure, MSBroundLSB_check, Id.run,
    ULift.up_down]
  let d := Fminus (beta:=beta) f1 f2
  have hβ : 1 < beta := by omega
  have hf2_bounded : Fbounded (beta:=beta) b f2 := by
    rcases hRounded.2.2.1 (_root_.F2R (beta:=beta) f1) f2 hP with hMin | hMax
    · exact hMin.1
    · exact hMax.1
  have hmsb_le_abs :
      _root_.F2R (beta:=beta)
          (⟨1, MSB (beta:=beta) radix d⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) ≤
        _root_.F2R (beta:=beta) (Fabs (beta:=beta) d) :=
    MSB_le_abs (beta:=beta) radix d hbeta hradix
      (by simpa [d] using hdiff_nonzero)
  have habs_eq :
      _root_.F2R (beta:=beta) (Fabs (beta:=beta) d) =
        |_root_.F2R (beta:=beta) d| := by
    have h := Fabs_correct (beta:=beta) d
    simpa only [wp, PostCond.noThrow, pure, Fabs_correct_check, Id.run,
      ULift.up_down] using h hβ
  have hminus_eq :
      _root_.F2R (beta:=beta) d =
        _root_.F2R (beta:=beta) f1 - _root_.F2R (beta:=beta) f2 := by
    have h := Fminus_correct (beta:=beta) f1 f2
    simpa only [wp, PostCond.noThrow, pure, Fminus_correct_check, Id.run,
      ULift.up_down, d, Fminus] using h hβ
  have hround_ulp :
      |_root_.F2R (beta:=beta) f1 - _root_.F2R (beta:=beta) f2| <
        Fulp (beta:=beta) b radix precision f2 := by
    have h := RoundedModeUlp (beta:=beta) b radix precision P
      (_root_.F2R (beta:=beta) f1) f2
    simpa only [wp, PostCond.noThrow, pure, RoundedModeUlp_check, Id.run,
      ULift.up_down] using
      h ⟨hRounded, hP, hbeta, hradix, hprecision, hvNum⟩
  have hfulp_lsb :
      Fulp (beta:=beta) b radix precision f2 ≤
        _root_.F2R (beta:=beta)
          (⟨1, LSB (beta:=beta) radix f2⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) :=
    FUlp_Le_LSigB (beta:=beta) b radix precision f2 hbeta hradix hf2_bounded
  have hunit_lt :
      _root_.F2R (beta:=beta)
          (⟨1, MSB (beta:=beta) radix d⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) <
        _root_.F2R (beta:=beta)
          (⟨1, LSB (beta:=beta) radix f2⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) := by
    calc
      _root_.F2R (beta:=beta)
          (⟨1, MSB (beta:=beta) radix d⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta)
          ≤ _root_.F2R (beta:=beta) (Fabs (beta:=beta) d) := hmsb_le_abs
      _ = |_root_.F2R (beta:=beta) d| := habs_eq
      _ = |_root_.F2R (beta:=beta) f1 - _root_.F2R (beta:=beta) f2| := by
            rw [hminus_eq]
      _ < Fulp (beta:=beta) b radix precision f2 := hround_ulp
      _ ≤ _root_.F2R (beta:=beta)
          (⟨1, LSB (beta:=beta) radix f2⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) := hfulp_lsb
  exact
    (oneExp_Zlt (beta:=beta) (MSB (beta:=beta) radix d)
      (LSB (beta:=beta) radix f2)) ⟨hβ, hunit_lt⟩

-- Coq: `LSBMinus`.
noncomputable def LSBMinus_check {beta : Int}
    (radix : Int)
    (p q : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

theorem LSBMinus {beta : Int}
    (radix : Int)
    (p q : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧
        ¬ is_Fzero (FloatSpec.Calc.Operations.Fminus (beta:=beta) p q)⌝⦄
    (pure (LSBMinus_check (beta:=beta) radix p q) : Id Unit)
    ⦃⇓_ => ⌜min (LSB (beta:=beta) radix p) (LSB (beta:=beta) radix q) ≤
        LSB (beta:=beta) radix
          (FloatSpec.Calc.Operations.Fminus (beta:=beta) p q)⌝⦄ := by
  intro ⟨hbeta_radix, hradix, hnonzero⟩
  simp only [wp, PostCond.noThrow, pure, LSBMinus_check, Id.run,
    ULift.up_down]
  let p' : FloatSpec.Core.Defs.FlocqFloat beta :=
    ⟨Classical.choose ((LSB_rep_min (beta:=beta) radix p) ⟨hbeta_radix, hradix⟩),
      LSB (beta:=beta) radix p⟩
  let q' : FloatSpec.Core.Defs.FlocqFloat beta :=
    ⟨Classical.choose ((LSB_rep_min (beta:=beta) radix q) ⟨hbeta_radix, hradix⟩),
      LSB (beta:=beta) radix q⟩
  have hp_rep :
      _root_.F2R (beta:=beta) p = _root_.F2R (beta:=beta) p' :=
    Classical.choose_spec ((LSB_rep_min (beta:=beta) radix p) ⟨hbeta_radix, hradix⟩)
  have hq_rep :
      _root_.F2R (beta:=beta) q = _root_.F2R (beta:=beta) q' :=
    Classical.choose_spec ((LSB_rep_min (beta:=beta) radix q) ⟨hbeta_radix, hradix⟩)
  have hbeta : 1 < beta := by omega
  have hminus_pq :
      _root_.F2R (FloatSpec.Calc.Operations.Fminus (beta:=beta) p q) =
        _root_.F2R p - _root_.F2R q :=
    (Fminus_correct (beta:=beta) p q) hbeta
  have hminus_rep :
      _root_.F2R (FloatSpec.Calc.Operations.Fminus (beta:=beta) p' q') =
        _root_.F2R p' - _root_.F2R q' :=
    (Fminus_correct (beta:=beta) p' q') hbeta
  have hreal :
      _root_.F2R (FloatSpec.Calc.Operations.Fminus (beta:=beta) p q) =
        _root_.F2R (FloatSpec.Calc.Operations.Fminus (beta:=beta) p' q') := by
    calc
      _root_.F2R (FloatSpec.Calc.Operations.Fminus (beta:=beta) p q)
          = _root_.F2R p - _root_.F2R q := hminus_pq
      _ = _root_.F2R p' - _root_.F2R q' := by rw [hp_rep, hq_rep]
      _ = _root_.F2R (FloatSpec.Calc.Operations.Fminus (beta:=beta) p' q') :=
          hminus_rep.symm
  have hlsb :
      LSB (beta:=beta) radix
          (FloatSpec.Calc.Operations.Fminus (beta:=beta) p q) =
        LSB (beta:=beta) radix
          (FloatSpec.Calc.Operations.Fminus (beta:=beta) p' q') :=
    (LSB_comp (beta:=beta) radix
      (FloatSpec.Calc.Operations.Fminus (beta:=beta) p q)
      (FloatSpec.Calc.Operations.Fminus (beta:=beta) p' q') 0)
      ⟨hbeta_radix, hradix, hnonzero, hreal⟩
  have hle :
      (FloatSpec.Calc.Operations.Fminus (beta:=beta) p' q').Fexp ≤
        LSB (beta:=beta) radix
          (FloatSpec.Calc.Operations.Fminus (beta:=beta) p' q') :=
    (Fexp_le_LSB (beta:=beta) radix
      (FloatSpec.Calc.Operations.Fminus (beta:=beta) p' q')) trivial
  have hexp :
      (FloatSpec.Calc.Operations.Fminus (beta:=beta) p' q').Fexp =
        min (LSB (beta:=beta) radix p) (LSB (beta:=beta) radix q) := by
    by_cases hle_lsb :
        LSB (beta:=beta) radix p ≤ LSB (beta:=beta) radix q
    · simp [p', q', FloatSpec.Calc.Operations.Fminus,
        FloatSpec.Calc.Operations.Fplus, FloatSpec.Calc.Operations.Fopp,
        FloatSpec.Calc.Operations.Falign, hle_lsb, min_eq_left hle_lsb]
    · have hq_le :
          LSB (beta:=beta) radix q ≤ LSB (beta:=beta) radix p :=
        le_of_lt (lt_of_not_ge hle_lsb)
      simp [p', q', FloatSpec.Calc.Operations.Fminus,
        FloatSpec.Calc.Operations.Fplus, FloatSpec.Calc.Operations.Fopp,
        FloatSpec.Calc.Operations.Falign, hle_lsb, min_eq_right hq_le]
  rw [hlsb]
  simpa [hexp] using hle

-- Coq: `LSBPlus`.
noncomputable def LSBPlus_check {beta : Int}
    (radix : Int)
    (p q : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

theorem LSBPlus {beta : Int}
    (radix : Int)
    (p q : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ ¬ is_Fzero (Fplus (beta:=beta) p q)⌝⦄
    (pure (LSBPlus_check (beta:=beta) radix p q) : Id Unit)
    ⦃⇓_ => ⌜min (LSB (beta:=beta) radix p) (LSB (beta:=beta) radix q) ≤
        LSB (beta:=beta) radix (Fplus (beta:=beta) p q)⌝⦄ := by
  intro ⟨hbeta_radix, hradix, hnonzero⟩
  simp only [wp, PostCond.noThrow, pure, LSBPlus_check, Id.run,
    ULift.up_down]
  let p' : FloatSpec.Core.Defs.FlocqFloat beta :=
    ⟨Classical.choose ((LSB_rep_min (beta:=beta) radix p) ⟨hbeta_radix, hradix⟩),
      LSB (beta:=beta) radix p⟩
  let q' : FloatSpec.Core.Defs.FlocqFloat beta :=
    ⟨Classical.choose ((LSB_rep_min (beta:=beta) radix q) ⟨hbeta_radix, hradix⟩),
      LSB (beta:=beta) radix q⟩
  have hp_rep :
      _root_.F2R (beta:=beta) p = _root_.F2R (beta:=beta) p' :=
    Classical.choose_spec ((LSB_rep_min (beta:=beta) radix p) ⟨hbeta_radix, hradix⟩)
  have hq_rep :
      _root_.F2R (beta:=beta) q = _root_.F2R (beta:=beta) q' :=
    Classical.choose_spec ((LSB_rep_min (beta:=beta) radix q) ⟨hbeta_radix, hradix⟩)
  have hbeta : 1 < beta := by omega
  have hplus_pq :
      _root_.F2R (Fplus (beta:=beta) p q) =
        _root_.F2R p + _root_.F2R q :=
    (Fplus_correct (beta:=beta) p q) hbeta
  have hplus_rep :
      _root_.F2R (Fplus (beta:=beta) p' q') =
        _root_.F2R p' + _root_.F2R q' :=
    (Fplus_correct (beta:=beta) p' q') hbeta
  have hreal :
      _root_.F2R (Fplus (beta:=beta) p q) =
        _root_.F2R (Fplus (beta:=beta) p' q') := by
    calc
      _root_.F2R (Fplus (beta:=beta) p q)
          = _root_.F2R p + _root_.F2R q := hplus_pq
      _ = _root_.F2R p' + _root_.F2R q' := by rw [hp_rep, hq_rep]
      _ = _root_.F2R (Fplus (beta:=beta) p' q') := hplus_rep.symm
  have hlsb :
      LSB (beta:=beta) radix (Fplus (beta:=beta) p q) =
        LSB (beta:=beta) radix (Fplus (beta:=beta) p' q') :=
    (LSB_comp (beta:=beta) radix (Fplus (beta:=beta) p q)
      (Fplus (beta:=beta) p' q') 0)
      ⟨hbeta_radix, hradix, hnonzero, hreal⟩
  have hle :
      (Fplus (beta:=beta) p' q').Fexp ≤
        LSB (beta:=beta) radix (Fplus (beta:=beta) p' q') :=
    (Fexp_le_LSB (beta:=beta) radix (Fplus (beta:=beta) p' q')) trivial
  have hexp :
      (Fplus (beta:=beta) p' q').Fexp =
        min (LSB (beta:=beta) radix p) (LSB (beta:=beta) radix q) := by
    by_cases hle_lsb :
        LSB (beta:=beta) radix p ≤ LSB (beta:=beta) radix q
    · simp [p', q', Fplus, FloatSpec.Calc.Operations.Fplus,
        FloatSpec.Calc.Operations.Falign, hle_lsb, min_eq_left hle_lsb]
    · have hq_le :
          LSB (beta:=beta) radix q ≤ LSB (beta:=beta) radix p :=
        le_of_lt (lt_of_not_ge hle_lsb)
      simp [p', q', Fplus, FloatSpec.Calc.Operations.Fplus,
        FloatSpec.Calc.Operations.Falign, hle_lsb, min_eq_right hq_le]
  rw [hlsb]
  simpa [hexp] using hle

-- Coq: `digit_abs` — digit n (|p|) = digit n p
noncomputable def digit_abs_check (n : Int) (p : Int) : Unit :=
  ()

theorem digit_abs (n : Int) (p : Int) :
    ⦃⌜True⌝⦄
    (pure (digit_abs_check n p) : Id Unit)
    ⦃⇓_ => ⌜digit n (|p|) = digit n p⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, digit_abs_check, Id.run,
    ULift.up_down]
  show digit n (|p|) = digit n p
  exact digit_abs_eq n p

-- Coq: `digit_anti_monotone_lt` — if 1 < n and digit n p < digit n q, then |p| < |q|
noncomputable def digit_anti_monotone_lt_check (n : Int) (p q : Int) : Unit :=
  ()

theorem digit_anti_monotone_lt (n : Int) (p q : Int) :
    ⦃⌜1 < n ∧ digit n p < digit n q⌝⦄
    (pure (digit_anti_monotone_lt_check n p q) : Id Unit)
    ⦃⇓_ => ⌜|p| < |q|⌝⦄ := by
  intro ⟨hn, hlt_digits⟩
  simp only [wp, PostCond.noThrow, pure, digit_anti_monotone_lt_check, Id.run, ULift.up_down]
  by_contra hnot
  have hle_abs : |q| ≤ |p| := le_of_not_gt hnot
  have hmon := (digit_monotone n q p) ⟨hn, hle_abs⟩
  simp only [wp, PostCond.noThrow, pure, digit_monotone_check,
    Id.run, ULift.up_down] at hmon
  exact (not_lt_of_ge hmon) hlt_digits
