    (hq : Fbounded (beta:=beta) bo q)
    (hpqBounded : Fbounded (beta:=beta) bo pq)
    (hs_bound : Fbounded (beta:=beta) bo s)
    (hP : P (_root_.F2R (beta:=beta) p * _root_.F2R (beta:=beta) q) pq)
