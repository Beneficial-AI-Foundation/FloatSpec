noncomputable def EvenClosestMonotone2_check {beta : Int}
    (b : Fbound_skel) (radix : ℝ) (precision : Nat)
    (p q : ℝ)
    (p' q' : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
