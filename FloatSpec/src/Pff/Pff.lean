        -- (q.Fnum : ℝ) * ((beta : ℝ) * (beta : ℝ) ^ p.Fexp) = (beta * q.Fnum) * beta^p.Fexp
        have heq : (q.Fnum : ℝ) * ((beta : ℝ) * (beta : ℝ) ^ p.Fexp) = ((beta : ℤ) * q.Fnum : ℝ) * (beta : ℝ) ^ p.Fexp := by
