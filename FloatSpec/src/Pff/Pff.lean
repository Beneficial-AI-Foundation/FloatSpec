theorem FPredSimpl3 {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat) :
    ⦃⌜-pPred b.vNum ≠ nNormMin radix precision⌝⦄
    (pure (FPredSimpl3_check (beta:=beta) b radix precision) : Id Unit)
