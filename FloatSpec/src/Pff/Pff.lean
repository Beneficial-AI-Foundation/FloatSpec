    (x y : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `SterbenzAux` — if `x` and `y` are bounded in the same bound `b` and
    satisfy `F2R y ≤ F2R x ≤ 2 * F2R y`, then `Fminus x y` is bounded in `b`. -/
theorem SterbenzAux {beta : Int}
    (b : Fbound_skel)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜1 < beta ∧
        Fbounded (beta:=beta) b x ∧
        Fbounded (beta:=beta) b y ∧
        (_root_.F2R (beta:=beta) y) ≤ (_root_.F2R (beta:=beta) x) ∧
        (_root_.F2R (beta:=beta) x) ≤ 2 * (_root_.F2R (beta:=beta) y)⌝⦄
    (pure (SterbenzAux_check (beta:=beta) b x y) : Id Unit)
    ⦃⇓_ => ⌜Fbounded (beta:=beta) b
        (FloatSpec.Calc.Operations.Fminus (beta:=beta) x y)⌝⦄ := by
  intro h
  rcases h with ⟨hβ, hxBounded, hyBounded, hyx, hx2y⟩
  simp only [wp, PostCond.noThrow, pure, SterbenzAux_check, Id.run,
    ULift.up_down]
  let d := FloatSpec.Calc.Operations.Fminus (beta:=beta) x y
  have hdVal : _root_.F2R (beta:=beta) d =
      _root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) y := by
    have hminus := Fminus_correct (beta:=beta) x y
    simpa [d, wp, PostCond.noThrow, pure, Fminus_correct_check] using hminus hβ
  have hyNonneg : 0 ≤ _root_.F2R (beta:=beta) y := by
    have hy_le_2y : _root_.F2R (beta:=beta) y ≤
        2 * _root_.F2R (beta:=beta) y := le_trans hyx hx2y
    nlinarith
  have hsubNonneg :
      0 ≤ _root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) y := by
    nlinarith
  have hdNonneg : 0 ≤ _root_.F2R (beta:=beta) d := by
    rw [hdVal]
    exact hsubNonneg
  have hdLeX : _root_.F2R (beta:=beta) d ≤ _root_.F2R (beta:=beta) x := by
    rw [hdVal]
    nlinarith
  have hdLeY : _root_.F2R (beta:=beta) d ≤ _root_.F2R (beta:=beta) y := by
    rw [hdVal]
    nlinarith
  have hdFnum_nonneg : 0 ≤ d.Fnum := by
    let z : FloatSpec.Core.Defs.FlocqFloat beta := ⟨0, d.Fexp⟩
    have hzVal : _root_.F2R (beta:=beta) z = 0 := by
      simp [z, _root_.F2R, FloatSpec.Core.Defs.F2R]
    have hnum := Rle_Fexp_eq_Zle (beta:=beta) z d
      ⟨by simpa [hzVal] using hdNonneg, rfl, hβ⟩
    simpa [z] using hnum
  constructor
  · by_cases hexp : x.Fexp ≤ y.Fexp
    · have hdExp : d.Fexp = x.Fexp := by
        cases x with
        | mk mx ex =>
          cases y with
          | mk my ey =>
            simp [d, FloatSpec.Calc.Operations.Fminus,
              FloatSpec.Calc.Operations.Fplus, FloatSpec.Calc.Operations.Falign,
              FloatSpec.Calc.Operations.Fopp, hexp]
      have hdFnum_le_x : d.Fnum ≤ x.Fnum := by
        have hnum := Rle_Fexp_eq_Zle (beta:=beta) d x ⟨hdLeX, hdExp, hβ⟩
        simpa using hnum
      have hdAbs_le_xAbs : |d.Fnum| ≤ |x.Fnum| := by
        rw [abs_of_nonneg hdFnum_nonneg]
        exact le_trans hdFnum_le_x (le_abs_self x.Fnum)
      exact lt_of_le_of_lt hdAbs_le_xAbs hxBounded.1
    · have hyxExp : y.Fexp ≤ x.Fexp := le_of_lt (lt_of_not_ge hexp)
      have hdExp : d.Fexp = y.Fexp := by
        cases x with
        | mk mx ex =>
          cases y with
          | mk my ey =>
            simp [d, FloatSpec.Calc.Operations.Fminus,
              FloatSpec.Calc.Operations.Fplus, FloatSpec.Calc.Operations.Falign,
              FloatSpec.Calc.Operations.Fopp, hexp]
      have hdFnum_le_y : d.Fnum ≤ y.Fnum := by
        have hnum := Rle_Fexp_eq_Zle (beta:=beta) d y ⟨hdLeY, hdExp, hβ⟩
        simpa using hnum
      have hdAbs_le_yAbs : |d.Fnum| ≤ |y.Fnum| := by
        rw [abs_of_nonneg hdFnum_nonneg]
        exact le_trans hdFnum_le_y (le_abs_self y.Fnum)
      exact lt_of_le_of_lt hdAbs_le_yAbs hyBounded.1
  · by_cases hexp : x.Fexp ≤ y.Fexp
    · have hdExp : d.Fexp = x.Fexp := by
        cases x with
        | mk mx ex =>
          cases y with
          | mk my ey =>
            simp [d, FloatSpec.Calc.Operations.Fminus,
              FloatSpec.Calc.Operations.Fplus, FloatSpec.Calc.Operations.Falign,
              FloatSpec.Calc.Operations.Fopp, hexp]
      rw [hdExp]
      exact hxBounded.2
    · have hdExp : d.Fexp = y.Fexp := by
        cases x with
        | mk mx ex =>
          cases y with
          | mk my ey =>
            simp [d, FloatSpec.Calc.Operations.Fminus,
              FloatSpec.Calc.Operations.Fplus, FloatSpec.Calc.Operations.Falign,
              FloatSpec.Calc.Operations.Fopp, hexp]
      rw [hdExp]
      exact hyBounded.2

-- Coq: `Sterbenz` — symmetric bound version using 1/2 ≤ x/y ≤ 2
noncomputable def Sterbenz_check {beta : Int}
    (b : Fbound_skel)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `Sterbenz` — if `x` and `y` are bounded in the same bound `b` and
    satisfy `1/2 * F2R y ≤ F2R x ≤ 2 * F2R y`, then `Fminus x y` is bounded. -/
theorem Sterbenz {beta : Int}
    (b : Fbound_skel)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜1 < beta ∧
        Fbounded (beta:=beta) b x ∧
        Fbounded (beta:=beta) b y ∧
        (1 / 2 : ℝ) * (_root_.F2R (beta:=beta) y) ≤
          (_root_.F2R (beta:=beta) x) ∧
        (_root_.F2R (beta:=beta) x) ≤ 2 * (_root_.F2R (beta:=beta) y)⌝⦄
    (pure (Sterbenz_check (beta:=beta) b x y) : Id Unit)
    ⦃⇓_ => ⌜Fbounded (beta:=beta) b
        (FloatSpec.Calc.Operations.Fminus (beta:=beta) x y)⌝⦄ := by
  intro h
  rcases h with ⟨hβ, hxBounded, hyBounded, hhalf, hx2y⟩
  simp only [wp, PostCond.noThrow, pure, Sterbenz_check, Id.run,
    ULift.up_down]
  by_cases hyx : _root_.F2R (beta:=beta) y ≤ _root_.F2R (beta:=beta) x
  · have haux := SterbenzAux (beta:=beta) b x y
    simpa [wp, PostCond.noThrow, pure, SterbenzAux_check] using
      haux ⟨hβ, hxBounded, hyBounded, hyx, hx2y⟩
  · have hxy : _root_.F2R (beta:=beta) x ≤ _root_.F2R (beta:=beta) y :=
      le_of_lt (lt_of_not_ge hyx)
    have hy2x : _root_.F2R (beta:=beta) y ≤ 2 * _root_.F2R (beta:=beta) x := by
      nlinarith
    have haux := SterbenzAux (beta:=beta) b y x
    have hyxMinusBounded :
        Fbounded (beta:=beta) b
          (FloatSpec.Calc.Operations.Fminus (beta:=beta) y x) := by
      simpa [wp, PostCond.noThrow, pure, SterbenzAux_check] using
        haux ⟨hβ, hyBounded, hxBounded, hxy, hy2x⟩
    have hswap :
        Fopp (beta:=beta)
            (FloatSpec.Calc.Operations.Fminus (beta:=beta) x y) =
          FloatSpec.Calc.Operations.Fminus (beta:=beta) y x := by
      have hswapTrip := Fopp_Fminus (beta:=beta) x y
      simpa [wp, PostCond.noThrow, pure, Fopp_Fminus_check] using
        hswapTrip trivial
    have hoppBounded :
        Fbounded (beta:=beta) b
          (Fopp (beta:=beta)
            (FloatSpec.Calc.Operations.Fminus (beta:=beta) x y)) := by
      rw [hswap]
      exact hyxMinusBounded
    have hinv :=
      oppBoundedInv (beta:=beta) b
        (FloatSpec.Calc.Operations.Fminus (beta:=beta) x y)
    simpa [wp, PostCond.noThrow, pure, oppBoundedInv_check] using
      hinv hoppBounded

/-!
Fast2Sum/Dekker support.

Upstream Flocq's `Dekker_FTS` finishes through `MDekkerAux1`: after the first
subtraction is known exact and the rounded addition error is represented by a
bounded float, the second rounded subtraction is an idempotent closest rounding.
This lemma ports that final payload without claiming the full `Dekker_FTS`
stack; the remaining upstream work is to restore `ErrorBoundedIplus` and
`MDekker`.
-/

/-- Coq: `IminusCorrect`.

In the upstream Fast2Sum section, subtraction is defined through addition with
an opposite operand.  This restores the corresponding closest-rounding payload
for the abstract `Iminus` operation. -/
theorem IminusCorrect {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (Iplus Iminus :
      FloatSpec.Core.Defs.FlocqFloat beta →
        FloatSpec.Core.Defs.FlocqFloat beta →
          FloatSpec.Core.Defs.FlocqFloat beta)
    (IplusCorrect :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) bo p →
        Fbounded (beta:=beta) bo q →
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)
          (Iplus p q))
    (IminusPlus :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Iminus p q = Iplus p (Fopp (beta:=beta) q)) :
    ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
      Fbounded (beta:=beta) bo p →
      Fbounded (beta:=beta) bo q →
      Closest (beta:=beta) bo radix
        (_root_.F2R (beta:=beta) p - _root_.F2R (beta:=beta) q)
        (Iminus p q) := by
  intro p q hp hq
  have hqOpp : Fbounded (beta:=beta) bo (Fopp (beta:=beta) q) := by
    have h := oppBounded (beta:=beta) bo q
    simpa [wp, PostCond.noThrow, pure, oppBounded_check, Id.run,
      ULift.up_down] using h hq
  have hclosest := IplusCorrect p (Fopp (beta:=beta) q) hp hqOpp
  have hqVal :
      _root_.F2R (beta:=beta) (Fopp (beta:=beta) q) =
        -_root_.F2R (beta:=beta) q := by
    simp [Fopp, FloatSpec.Calc.Operations.Fopp, _root_.F2R,
      FloatSpec.Core.Defs.F2R]
  rw [IminusPlus]
  simpa [hqVal, sub_eq_add_neg] using hclosest

/-- Coq: `IplusBounded`. -/
theorem IplusBounded {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (Iplus :
      FloatSpec.Core.Defs.FlocqFloat beta →
        FloatSpec.Core.Defs.FlocqFloat beta →
          FloatSpec.Core.Defs.FlocqFloat beta)
    (IplusCorrect :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) bo p →
        Fbounded (beta:=beta) bo q →
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)
          (Iplus p q)) :
    ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
      Fbounded (beta:=beta) bo p →
      Fbounded (beta:=beta) bo q →
      Fbounded (beta:=beta) bo (Iplus p q) := by
  intro p q hp hq
  exact (IplusCorrect p q hp hq).1

/-- Coq: `IminusBounded`. -/
theorem IminusBounded {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (Iplus Iminus :
      FloatSpec.Core.Defs.FlocqFloat beta →
        FloatSpec.Core.Defs.FlocqFloat beta →
          FloatSpec.Core.Defs.FlocqFloat beta)
    (IplusCorrect :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) bo p →
        Fbounded (beta:=beta) bo q →
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)
          (Iplus p q))
    (IminusPlus :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Iminus p q = Iplus p (Fopp (beta:=beta) q)) :
    ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
      Fbounded (beta:=beta) bo p →
      Fbounded (beta:=beta) bo q →
      Fbounded (beta:=beta) bo (Iminus p q) := by
  intro p q hp hq
  exact (IminusCorrect (beta:=beta) bo radix Iplus Iminus
    IplusCorrect IminusPlus p q hp hq).1

/-- Coq: `IplusOr`.

If the right operand represents zero, closest rounding of `p + q` returns a
float with the same real value as `p`. -/
theorem IplusOr {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (Iplus :
      FloatSpec.Core.Defs.FlocqFloat beta →
        FloatSpec.Core.Defs.FlocqFloat beta →
          FloatSpec.Core.Defs.FlocqFloat beta)
    (IplusCorrect :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) bo p →
        Fbounded (beta:=beta) bo q →
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)
          (Iplus p q)) :
    ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
      Fbounded (beta:=beta) bo p →
      Fbounded (beta:=beta) bo q →
      _root_.F2R (beta:=beta) q = 0 →
      _root_.F2R (beta:=beta) (Iplus p q) =
        _root_.F2R (beta:=beta) p := by
  intro p q hp hq hq0
  have hclosest0 :
      Closest (beta:=beta) bo radix (_root_.F2R (beta:=beta) p)
        (Iplus p q) := by
    have hclosest := IplusCorrect p q hp hq
    simpa [hq0] using hclosest
  have hIdem := ClosestIdem (beta:=beta) bo radix p (Iplus p q)
  have hp_eq :
      _root_.F2R (beta:=beta) p =
        _root_.F2R (beta:=beta) (Iplus p q) := by
    simpa [wp, PostCond.noThrow, pure, ClosestIdem_check, Fbounded'] using
      hIdem ⟨hp, hclosest0, hp, hclosest0.1, hclosest0.2⟩
  exact hp_eq.symm

/-- Coq: `IminusId`.

If the two operands have the same real value, the abstract subtraction returns a
float with real value zero. -/
theorem IminusId {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (Iplus Iminus :
      FloatSpec.Core.Defs.FlocqFloat beta →
        FloatSpec.Core.Defs.FlocqFloat beta →
          FloatSpec.Core.Defs.FlocqFloat beta)
    (IplusCorrect :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) bo p →
        Fbounded (beta:=beta) bo q →
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)
          (Iplus p q))
    (IminusPlus :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Iminus p q = Iplus p (Fopp (beta:=beta) q)) :
    ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
      Fbounded (beta:=beta) bo p →
      Fbounded (beta:=beta) bo q →
      _root_.F2R (beta:=beta) p = _root_.F2R (beta:=beta) q →
      _root_.F2R (beta:=beta) (Iminus p q) = 0 := by
  intro p q hp hq hpq
  let z : FloatSpec.Core.Defs.FlocqFloat beta := ⟨0, -bo.dExp⟩
  have hvNum : 0 < bo.vNum := by
    have hnonneg : 0 ≤ |p.Fnum| := abs_nonneg p.Fnum
    exact lt_of_le_of_lt hnonneg hp.1
  have hzBounded : Fbounded (beta:=beta) bo z := by
    simpa [z, Fzero] using
      (FboundedFzero (beta:=beta) bo hvNum)
  have hzVal : _root_.F2R (beta:=beta) z = 0 := by
    simp [z, _root_.F2R, FloatSpec.Core.Defs.F2R]
  have hclosest0 :
      Closest (beta:=beta) bo radix (_root_.F2R (beta:=beta) z)
        (Iminus p q) := by
    have hclosest := IminusCorrect (beta:=beta) bo radix Iplus Iminus
      IplusCorrect IminusPlus p q hp hq
    simpa [hzVal, hpq] using hclosest
  have hIdem := ClosestIdem (beta:=beta) bo radix z (Iminus p q)
  have hz_eq :
      _root_.F2R (beta:=beta) z =
        _root_.F2R (beta:=beta) (Iminus p q) := by
    simpa [wp, PostCond.noThrow, pure, ClosestIdem_check, Fbounded'] using
      hIdem ⟨hzBounded, hclosest0, hzBounded, hclosest0.1, hclosest0.2⟩
  rw [← hz_eq, hzVal]

/-- Coq: `IplusCorrectEq`.

If `pq` is a bounded exact representation of `p + q`, then the abstract
closest addition `Iplus p q` has the same real value as the supplied result
`r`. -/
theorem IplusCorrectEq {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (Iplus :
      FloatSpec.Core.Defs.FlocqFloat beta →
        FloatSpec.Core.Defs.FlocqFloat beta →
          FloatSpec.Core.Defs.FlocqFloat beta)
    (IplusCorrect :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) bo p →
        Fbounded (beta:=beta) bo q →
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)
          (Iplus p q)) :
    ∀ (p q pq : FloatSpec.Core.Defs.FlocqFloat beta) (r : ℝ),
      Fbounded (beta:=beta) bo p →
      Fbounded (beta:=beta) bo q →
      Fbounded (beta:=beta) bo pq →
      r = _root_.F2R (beta:=beta) pq →
      _root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q =
        _root_.F2R (beta:=beta) pq →
      _root_.F2R (beta:=beta) (Iplus p q) = r := by
  intro p q pq r hp hq hpq hr hsum
  have hclosest :
      Closest (beta:=beta) bo radix (_root_.F2R (beta:=beta) pq)
        (Iplus p q) := by
    simpa [hsum] using IplusCorrect p q hp hq
  have hIdem := ClosestIdem (beta:=beta) bo radix pq (Iplus p q)
  have hpq_eq :
      _root_.F2R (beta:=beta) pq =
        _root_.F2R (beta:=beta) (Iplus p q) := by
    simpa [wp, PostCond.noThrow, pure, ClosestIdem_check, Fbounded'] using
      hIdem ⟨hpq, hclosest, hpq, hclosest.1, hclosest.2⟩
  rw [hr, hpq_eq]

/-- Coq: `IminusCorrectEq`.

If `pq` is a bounded exact representation of `p - q`, then the abstract
subtraction `Iminus p q` has the same real value as the supplied result `r`. -/
theorem IminusCorrectEq {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (Iplus Iminus :
      FloatSpec.Core.Defs.FlocqFloat beta →
        FloatSpec.Core.Defs.FlocqFloat beta →
          FloatSpec.Core.Defs.FlocqFloat beta)
    (IplusCorrect :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) bo p →
        Fbounded (beta:=beta) bo q →
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)
          (Iplus p q))
    (IminusPlus :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Iminus p q = Iplus p (Fopp (beta:=beta) q)) :
    ∀ (p q pq : FloatSpec.Core.Defs.FlocqFloat beta) (r : ℝ),
      Fbounded (beta:=beta) bo p →
      Fbounded (beta:=beta) bo q →
      Fbounded (beta:=beta) bo pq →
      r = _root_.F2R (beta:=beta) pq →
      _root_.F2R (beta:=beta) p - _root_.F2R (beta:=beta) q =
        _root_.F2R (beta:=beta) pq →
      _root_.F2R (beta:=beta) (Iminus p q) = r := by
  intro p q pq r hp hq hpq hr hdiff
  have hclosest :
      Closest (beta:=beta) bo radix (_root_.F2R (beta:=beta) pq)
        (Iminus p q) := by
    have h := IminusCorrect (beta:=beta) bo radix Iplus Iminus
      IplusCorrect IminusPlus p q hp hq
    simpa [hdiff] using h
  have hIdem := ClosestIdem (beta:=beta) bo radix pq (Iminus p q)
  have hpq_eq :
      _root_.F2R (beta:=beta) pq =
        _root_.F2R (beta:=beta) (Iminus p q) := by
    simpa [wp, PostCond.noThrow, pure, ClosestIdem_check, Fbounded'] using
      hIdem ⟨hpq, hclosest, hpq, hclosest.1, hclosest.2⟩
  rw [hr, hpq_eq]

/-- Coq: `IplusOl`.

The upstream Fast section derives the left-zero case for abstract rounded
addition from commutativity and `IplusOr`. -/
theorem IplusOl {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (Iplus :
      FloatSpec.Core.Defs.FlocqFloat beta →
        FloatSpec.Core.Defs.FlocqFloat beta →
          FloatSpec.Core.Defs.FlocqFloat beta)
    (IplusCorrect :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) bo p →
        Fbounded (beta:=beta) bo q →
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)
          (Iplus p q))
    (IplusSym :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Iplus p q = Iplus q p) :
    ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
      Fbounded (beta:=beta) bo p →
      Fbounded (beta:=beta) bo q →
      _root_.F2R (beta:=beta) p = 0 →
      _root_.F2R (beta:=beta) (Iplus p q) =
        _root_.F2R (beta:=beta) q := by
  intro p q hp hq hp0
  have hright :
      _root_.F2R (beta:=beta) (Iplus q p) =
        _root_.F2R (beta:=beta) q :=
    IplusOr (beta:=beta) bo radix Iplus IplusCorrect q p hq hp hp0
  simpa [IplusSym p q] using hright

/-- Coq: `IminusOp`.

Subtraction is addition with an opposite operand, so compatibility of
`Iplus` with `Fopp` transfers to `Iminus`. -/
theorem IminusOp {beta : Int}
    (Iplus Iminus :
      FloatSpec.Core.Defs.FlocqFloat beta →
        FloatSpec.Core.Defs.FlocqFloat beta →
          FloatSpec.Core.Defs.FlocqFloat beta)
    (IplusOp :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Fopp (beta:=beta) (Iplus p q) =
          Iplus (Fopp (beta:=beta) p) (Fopp (beta:=beta) q))
    (IminusPlus :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Iminus p q = Iplus p (Fopp (beta:=beta) q)) :
    ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
      Fopp (beta:=beta) (Iminus p q) =
        Iminus (Fopp (beta:=beta) p) (Fopp (beta:=beta) q) := by
  intro p q
  rw [IminusPlus, IminusPlus]
  exact IplusOp p (Fopp (beta:=beta) q)

noncomputable def eqExpLess_from_bounded_left_check {beta : Int}
    (b : Fbound_skel) (p q : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Bounded representative at no smaller exponent.

This is the useful payload of Coq `eqExpLess`: if a bounded float `p` has the
same real value as `q`, then that real value has a bounded representative whose
exponent is at least `q.Fexp`. -/
theorem eqExpLess_from_bounded_left {beta : Int}
    (b : Fbound_skel) (p q : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜1 < beta ∧ Fbounded (beta:=beta) b p ∧
        _root_.F2R (beta:=beta) p = _root_.F2R (beta:=beta) q⌝⦄
    (pure (eqExpLess_from_bounded_left_check (beta:=beta) b p q) : Id Unit)
    ⦃⇓_ => ⌜∃ r : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) b r ∧
        _root_.F2R (beta:=beta) r = _root_.F2R (beta:=beta) q ∧
        q.Fexp ≤ r.Fexp⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hpBounded, hpq⟩
  simp only [wp, PostCond.noThrow, pure, eqExpLess_from_bounded_left_check,
    Id.run, ULift.up_down]
  by_cases hq_exp_le : q.Fexp ≤ p.Fexp
  · exact ⟨p, hpBounded, hpq, hq_exp_le⟩
  · have hp_exp_le : p.Fexp ≤ q.Fexp := le_of_lt (lt_of_not_ge hq_exp_le)
    have hqBounded : Fbounded (beta:=beta) b q := by
      have h := FboundedEqExp (beta:=beta) b p q
      simpa only [wp, PostCond.noThrow, pure, FboundedEqExp_check, Id.run,
        ULift.up_down] using h ⟨hbeta, hpBounded, hpq, hp_exp_le⟩
    exact ⟨q, hqBounded, rfl, le_rfl⟩

noncomputable def plusExpMin_check {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop)
    (p q pq : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `plusExpMin`.

The local Lean statement uses the float-specific rounded-mode pieces explicitly:
`MinOrMaxP_float` supplies boundedness of `pq`, while the representation
payload is the same one used by `RoundedModeRep_float_from_minmax`. -/
theorem plusExpMin {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop)
    (p q pq : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧
        MinOrMaxP_float (beta:=beta) b radix P ∧
        (∀ a r : FloatSpec.Core.Defs.FlocqFloat beta,
          P (_root_.F2R (beta:=beta) a) r →
            ∃ m : Int,
              _root_.F2R (beta:=beta) r =
                _root_.F2R (beta:=beta)
                  (⟨m, a.Fexp⟩ : FloatSpec.Core.Defs.FlocqFloat beta)) ∧
        P (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q) pq⌝⦄
    (pure (plusExpMin_check (beta:=beta) b radix P p q pq) : Id Unit)
    ⦃⇓_ => ⌜∃ s : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) b s ∧
        _root_.F2R (beta:=beta) s = _root_.F2R (beta:=beta) pq ∧
        min p.Fexp q.Fexp ≤ s.Fexp⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix, hMinOrMax, hRep, hP⟩
  subst beta
  simp only [wp, PostCond.noThrow, pure, plusExpMin_check, Id.run,
    ULift.up_down]
  have hpqBounded : Fbounded (beta:=radix) b pq := by
    rcases hMinOrMax
        (_root_.F2R (beta:=radix) p + _root_.F2R (beta:=radix) q)
        pq hP with hMin | hMax
    · exact hMin.1
    · exact hMax.1
  have hplus_val :
      _root_.F2R (beta:=radix) (Fplus (beta:=radix) p q) =
        _root_.F2R (beta:=radix) p + _root_.F2R (beta:=radix) q := by
    have h := Fplus_correct (beta:=radix) p q
    simpa only [wp, PostCond.noThrow, pure, Fplus_correct_check, Id.run,
      ULift.up_down] using h hradix
  have hPplus :
      P (_root_.F2R (beta:=radix) (Fplus (beta:=radix) p q)) pq := by
    simpa [hplus_val] using hP
  rcases hRep (Fplus (beta:=radix) p q) pq hPplus with ⟨m, hm⟩
  let rep : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨m, (Fplus (beta:=radix) p q).Fexp⟩
  have hrep_val :
      _root_.F2R (beta:=radix) pq = _root_.F2R (beta:=radix) rep := by
    simpa [rep] using hm
  have hless := eqExpLess_from_bounded_left (beta:=radix) b pq rep
  rcases (by
      simpa only [wp, PostCond.noThrow, pure,
        eqExpLess_from_bounded_left_check, Id.run, ULift.up_down] using
        hless ⟨hradix, hpqBounded, hrep_val⟩) with
    ⟨s, hsBounded, hsValRep, hrepExpLe⟩
  have hplus_exp :
      (Fplus (beta:=radix) p q).Fexp = min p.Fexp q.Fexp := by
    cases p with
    | mk pm pe =>
      cases q with
      | mk qm qe =>
        by_cases hle : pe ≤ qe
        · simp [Fplus, FloatSpec.Calc.Operations.Fplus,
            FloatSpec.Calc.Operations.Falign, hle, min_eq_left hle]
        · have hqe : qe ≤ pe := le_of_lt (lt_of_not_ge hle)
          simp [Fplus, FloatSpec.Calc.Operations.Fplus,
            FloatSpec.Calc.Operations.Falign, hle, min_eq_right hqe]
  refine ⟨s, hsBounded, ?_, ?_⟩
  · rw [hsValRep, ← hrep_val]
  · simpa [rep, hplus_exp] using hrepExpLe

noncomputable def plusExpUpperBound_check {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop)
    (p q pq : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `plusExpUpperBound`.

The local proof exposes the split rounded-mode hypotheses used elsewhere in
this file.  It bounds the exact sum by the canonical maximal float at exponent
`succ (max p.Fexp q.Fexp)`, transfers that bound through rounding, then uses
`eqExpMax` to obtain a same-value bounded representative at no larger
exponent. -/
theorem plusExpUpperBound {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop)
    (p q pq : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ 1 < b.vNum ∧
        RoundedModeP P ∧ RoundedModeP_float (beta:=beta) b radix P ∧
        P (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q) pq ∧
        Fbounded (beta:=beta) b p ∧ Fbounded (beta:=beta) b q⌝⦄
    (pure (plusExpUpperBound_check (beta:=beta) b radix P p q pq) : Id Unit)
    ⦃⇓_ => ⌜∃ r : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) b r ∧
        _root_.F2R (beta:=beta) r = _root_.F2R (beta:=beta) pq ∧
        r.Fexp ≤ Int.succ (max p.Fexp q.Fexp)⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix, hvNum, hRounded, hRoundedFloat, hP, hp, hq⟩
  subst beta
  simp only [wp, PostCond.noThrow, pure, plusExpUpperBound_check, Id.run,
    ULift.up_down]
  let z : Int := max p.Fexp q.Fexp
  let upper : FloatSpec.Core.Defs.FlocqFloat radix := ⟨b.vNum - 1, Int.succ z⟩
  have hpExpLe : p.Fexp ≤ z := by
    exact le_max_left p.Fexp q.Fexp
  have hqExpLe : q.Fexp ≤ z := by
    exact le_max_right p.Fexp q.Fexp
  have hsucc_z : z ≤ Int.succ z := by
    simp [Int.succ]
  have hupperBounded : Fbounded (beta:=radix) b upper := by
    constructor
    · have hnonneg : 0 ≤ b.vNum - 1 := by omega
      rw [abs_of_nonneg hnonneg]
      omega
    · have hp_low : -b.dExp ≤ z := le_trans hp.2 hpExpLe
      exact le_trans hp_low hsucc_z
  have hpAbsLeBase :
      |_root_.F2R (beta:=radix) p| ≤
        _root_.F2R (beta:=radix)
          (⟨b.vNum - 1, z⟩ : FloatSpec.Core.Defs.FlocqFloat radix) := by
    have h := maxMax1 (beta:=radix) b p z
    simpa only [wp, PostCond.noThrow, pure, maxMax1_check, Id.run,
      ULift.up_down] using h ⟨hp, hpExpLe, hp, hradix⟩
  have hqAbsLeBase :
      |_root_.F2R (beta:=radix) q| ≤
        _root_.F2R (beta:=radix)
          (⟨b.vNum - 1, z⟩ : FloatSpec.Core.Defs.FlocqFloat radix) := by
    have h := maxMax1 (beta:=radix) b q z
    simpa only [wp, PostCond.noThrow, pure, maxMax1_check, Id.run,
      ULift.up_down] using h ⟨hq, hqExpLe, hq, hradix⟩
  have hbase_nonneg :
      0 ≤ _root_.F2R (beta:=radix)
        (⟨b.vNum - 1, z⟩ : FloatSpec.Core.Defs.FlocqFloat radix) := by
    have hnum : (0 : Int) ≤ b.vNum - 1 := by omega
    have hnumR : (0 : ℝ) ≤ ((b.vNum - 1 : Int) : ℝ) := by exact_mod_cast hnum
    have hradixR_pos : (0 : ℝ) < (radix : ℝ) := by
      exact_mod_cast (by omega : (0 : Int) < radix)
    have hpow_nonneg : 0 ≤ (radix : ℝ) ^ z :=
      le_of_lt (zpow_pos hradixR_pos z)
    simp only [_root_.F2R, FloatSpec.Core.Defs.F2R,
      FloatSpec.Core.Defs.FlocqFloat.Fnum,
      FloatSpec.Core.Defs.FlocqFloat.Fexp]
    exact mul_nonneg hnumR hpow_nonneg
  have hupper_val :
      _root_.F2R (beta:=radix) upper =
        (radix : ℝ) *
          _root_.F2R (beta:=radix)
            (⟨b.vNum - 1, z⟩ : FloatSpec.Core.Defs.FlocqFloat radix) := by
    have hradix_ne : (radix : ℝ) ≠ 0 := by
      exact_mod_cast (ne_of_gt (by omega : (0 : Int) < radix))
    simp only [upper, _root_.F2R, FloatSpec.Core.Defs.F2R,
      FloatSpec.Core.Defs.FlocqFloat.Fnum,
      FloatSpec.Core.Defs.FlocqFloat.Fexp]
    rw [show Int.succ z = z + 1 by simp [Int.succ]]
    rw [zpow_add₀ hradix_ne]
    simp
    ring
  have hsumAbsLeUpper :
      |_root_.F2R (beta:=radix) p + _root_.F2R (beta:=radix) q| ≤
        _root_.F2R (beta:=radix) upper := by
    have htri :
        |_root_.F2R (beta:=radix) p + _root_.F2R (beta:=radix) q| ≤
          |_root_.F2R (beta:=radix) p| +
            |_root_.F2R (beta:=radix) q| := abs_add_le _ _
    have htwo :
        |_root_.F2R (beta:=radix) p| + |_root_.F2R (beta:=radix) q| ≤
          (2 : ℝ) *
            _root_.F2R (beta:=radix)
              (⟨b.vNum - 1, z⟩ : FloatSpec.Core.Defs.FlocqFloat radix) := by
      linarith [hpAbsLeBase, hqAbsLeBase]
    have htwo_le_radix :
        (2 : ℝ) *
            _root_.F2R (beta:=radix)
              (⟨b.vNum - 1, z⟩ : FloatSpec.Core.Defs.FlocqFloat radix) ≤
          (radix : ℝ) *
            _root_.F2R (beta:=radix)
              (⟨b.vNum - 1, z⟩ : FloatSpec.Core.Defs.FlocqFloat radix) := by
      have hradix2 : (2 : ℝ) ≤ (radix : ℝ) := by exact_mod_cast hradix
      exact mul_le_mul_of_nonneg_right hradix2 hbase_nonneg
    calc
      |_root_.F2R (beta:=radix) p + _root_.F2R (beta:=radix) q|
          ≤ |_root_.F2R (beta:=radix) p| +
              |_root_.F2R (beta:=radix) q| := htri
      _ ≤ (2 : ℝ) *
            _root_.F2R (beta:=radix)
              (⟨b.vNum - 1, z⟩ : FloatSpec.Core.Defs.FlocqFloat radix) := htwo
      _ ≤ (radix : ℝ) *
            _root_.F2R (beta:=radix)
              (⟨b.vNum - 1, z⟩ : FloatSpec.Core.Defs.FlocqFloat radix) := htwo_le_radix
      _ = _root_.F2R (beta:=radix) upper := hupper_val.symm
  have hpqAbsLeUpper :
      |_root_.F2R (beta:=radix) pq| ≤ _root_.F2R (beta:=radix) upper := by
    have h := RoundAbsMonotoner (beta:=radix) b radix P
      (_root_.F2R (beta:=radix) p + _root_.F2R (beta:=radix) q) pq upper
    simpa only [wp, PostCond.noThrow, pure, RoundAbsMonotoner_check, Id.run,
      ULift.up_down] using h ⟨hRoundedFloat, hupperBounded, hP, hsumAbsLeUpper⟩
  have hmax := eqExpMax (beta:=radix) b radix pq upper
  simpa only [wp, PostCond.noThrow, pure, eqExpMax_check, Id.run,
    ULift.up_down, upper, z] using
    hmax ⟨rfl, hradix, by
      have hb := RoundedModeBounded (beta:=radix) b radix P
        (_root_.F2R (beta:=radix) p + _root_.F2R (beta:=radix) q) pq
      simpa only [wp, PostCond.noThrow, pure, RoundedModeBounded_check, Id.run,
        ULift.up_down] using hb ⟨hRounded, hRoundedFloat.2.2.1, hP⟩,
      hupperBounded, hpqAbsLeUpper⟩

noncomputable def plusExpBound_check {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop)
    (p q pq : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `plusExpBound`.

This combines `plusExpMin` and `plusExpUpperBound`.  If the lower-exponent
representative already satisfies the upper exponent bound, use it directly.
Otherwise shift that representative down to the upper bound; boundedness follows
by comparing against the upper-bound representative with the same real value. -/
theorem plusExpBound {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop)
    (p q pq : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ 1 < b.vNum ∧
        RoundedModeP P ∧ RoundedModeP_float (beta:=beta) b radix P ∧
        (∀ a r : FloatSpec.Core.Defs.FlocqFloat beta,
          P (_root_.F2R (beta:=beta) a) r →
            ∃ m : Int,
              _root_.F2R (beta:=beta) r =
                _root_.F2R (beta:=beta)
                  (⟨m, a.Fexp⟩ : FloatSpec.Core.Defs.FlocqFloat beta)) ∧
        P (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q) pq ∧
        Fbounded (beta:=beta) b p ∧ Fbounded (beta:=beta) b q⌝⦄
    (pure (plusExpBound_check (beta:=beta) b radix P p q pq) : Id Unit)
    ⦃⇓_ => ⌜∃ r : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) b r ∧
        _root_.F2R (beta:=beta) r = _root_.F2R (beta:=beta) pq ∧
        min p.Fexp q.Fexp ≤ r.Fexp ∧
        r.Fexp ≤ Int.succ (max p.Fexp q.Fexp)⌝⦄ := by
  intro h
  rcases h with
    ⟨hbeta, hradix, hvNum, hRounded, hRoundedFloat, hRep, hP, hp, hq⟩
  subst beta
  simp only [wp, PostCond.noThrow, pure, plusExpBound_check, Id.run,
    ULift.up_down]
  let upperExp : Int := Int.succ (max p.Fexp q.Fexp)
  have hmin_le_upper : min p.Fexp q.Fexp ≤ upperExp := by
    have hmin_le_max : min p.Fexp q.Fexp ≤ max p.Fexp q.Fexp := by
      exact le_trans (min_le_left p.Fexp q.Fexp) (le_max_left p.Fexp q.Fexp)
    have hmax_le_succ : max p.Fexp q.Fexp ≤ upperExp := by
      simp [upperExp, Int.succ]
    exact le_trans hmin_le_max hmax_le_succ
  have hMinTrip := plusExpMin (beta:=radix) b radix P p q pq
  rcases (by
      simpa only [wp, PostCond.noThrow, pure, plusExpMin_check, Id.run,
        ULift.up_down] using
        hMinTrip ⟨rfl, hradix, hRoundedFloat.2.2.1, hRep, hP⟩) with
    ⟨rLower, hrLowerBounded, hrLowerVal, hrLowerExpMin⟩
  by_cases hLowerUpper : rLower.Fexp ≤ upperExp
  · exact ⟨rLower, hrLowerBounded, hrLowerVal, hrLowerExpMin, hLowerUpper⟩
  · have hUpperTrip := plusExpUpperBound (beta:=radix) b radix P p q pq
    rcases (by
        simpa only [wp, PostCond.noThrow, pure, plusExpUpperBound_check,
          Id.run, ULift.up_down] using
          hUpperTrip ⟨rfl, hradix, hvNum, hRounded, hRoundedFloat, hP, hp, hq⟩) with
      ⟨rUpper, hrUpperBounded, hrUpperVal, hrUpperExpLe⟩
    have hUpperLtLower : upperExp < rLower.Fexp := lt_of_not_ge hLowerUpper
    have hrUpperExpLeLower : rUpper.Fexp ≤ rLower.Fexp :=
      le_trans hrUpperExpLe (le_of_lt hUpperLtLower)
    let nUpper : Nat := Int.natAbs (rLower.Fexp - rUpper.Fexp)
    let nTarget : Nat := Int.natAbs (rLower.Fexp - upperExp)
    have hnUpper :
        ((nUpper : Nat) : Int) = rLower.Fexp - rUpper.Fexp := by
      simpa [nUpper] using
        Int.natAbs_of_nonneg (by omega : 0 ≤ rLower.Fexp - rUpper.Fexp)
    have hnTarget :
        ((nTarget : Nat) : Int) = rLower.Fexp - upperExp := by
      simpa [nTarget] using
        Int.natAbs_of_nonneg (by omega : 0 ≤ rLower.Fexp - upperExp)
    have hnTargetLeUpper : nTarget ≤ nUpper := by
      have hleInt : ((nTarget : Nat) : Int) ≤ ((nUpper : Nat) : Int) := by
        rw [hnTarget, hnUpper]
        omega
      exact_mod_cast hleInt
    let shiftedUpper : FloatSpec.Core.Defs.FlocqFloat radix :=
      Fshift (beta:=radix) radix nUpper rLower
    have hshiftedUpperVal :
        _root_.F2R (beta:=radix) shiftedUpper =
          _root_.F2R (beta:=radix) rUpper := by
      calc
        _root_.F2R (beta:=radix) shiftedUpper =
            _root_.F2R (beta:=radix) rLower := by
          simpa [shiftedUpper] using
            Fshift_value (beta:=radix) radix nUpper rLower rfl hradix
        _ = _root_.F2R (beta:=radix) pq := hrLowerVal
        _ = _root_.F2R (beta:=radix) rUpper := hrUpperVal.symm
    have hshiftedUpperExp : shiftedUpper.Fexp = rUpper.Fexp := by
      simp only [shiftedUpper, Fshift, FloatSpec.Core.Defs.FlocqFloat.Fexp]
      rw [hnUpper]
      omega
    have hshiftedUpperBounded :
        Fbounded (beta:=radix) b shiftedUpper := by
      constructor
      · have hradix_pos : (0 : ℝ) < (radix : ℝ) := by
          exact_mod_cast (by omega : (0 : Int) < radix)
        have hpow_pos : 0 < (radix : ℝ) ^ rUpper.Fexp :=
          zpow_pos hradix_pos rUpper.Fexp
        have hnumReal :
            ((shiftedUpper.Fnum : Int) : ℝ) = (rUpper.Fnum : ℝ) := by
          have hval := hshiftedUpperVal
          simp only [_root_.F2R, FloatSpec.Core.Defs.F2R,
            hshiftedUpperExp] at hval
          exact (mul_right_inj' (ne_of_gt hpow_pos)).mp (by
            simpa [mul_comm] using hval)
        have hnumEq : shiftedUpper.Fnum = rUpper.Fnum := by
          exact_mod_cast hnumReal
        simpa [hnumEq] using hrUpperBounded.1
      · simpa [hshiftedUpperExp] using hrUpperBounded.2
    let r : FloatSpec.Core.Defs.FlocqFloat radix :=
      Fshift (beta:=radix) radix nTarget rLower
    have hrBounded : Fbounded (beta:=radix) b r := by
      have h := FboundedShiftLess (beta:=radix) b radix rLower nUpper nTarget
      simpa only [wp, PostCond.noThrow, pure, FboundedShiftLess_check, Id.run,
        ULift.up_down, shiftedUpper, r] using
        h ⟨hradix, hnTargetLeUpper, hshiftedUpperBounded⟩
    have hrVal : _root_.F2R (beta:=radix) r = _root_.F2R (beta:=radix) pq := by
      calc
        _root_.F2R (beta:=radix) r =
            _root_.F2R (beta:=radix) rLower := by
          simpa [r] using Fshift_value (beta:=radix) radix nTarget rLower rfl hradix
        _ = _root_.F2R (beta:=radix) pq := hrLowerVal
    have hrExp : r.Fexp = upperExp := by
      simp only [r, Fshift, FloatSpec.Core.Defs.FlocqFloat.Fexp]
      rw [hnTarget]
      omega
    refine ⟨r, hrBounded, hrVal, ?_, ?_⟩
    · simpa [hrExp] using hmin_le_upper
    · simpa [hrExp, upperExp]

/-- Coq `errorBoundedPlusLe`, factored after the `RoundedModeRep` step.

The upstream proof first obtains a representation of `pq` at the exponent of
`Fplus p q`.  This lemma restores the remaining arithmetic and boundedness
payload from that representation, leaving only the representation-producing
rounded-mode step for the closed theorem. -/
theorem errorBoundedPlusLe_from_rep {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (p q pq : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜1 < beta ∧ Fbounded (beta:=beta) bo p ∧ Fbounded (beta:=beta) bo q ∧
        p.Fexp ≤ q.Fexp ∧
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q) pq ∧
        (∃ m : Int,
          _root_.F2R (beta:=beta) pq =
            _root_.F2R (beta:=beta)
              ⟨m, (Fplus (beta:=beta) p q).Fexp⟩)⌝⦄
    (pure () : Id Unit)
    ⦃⇓_ => ⌜∃ error : FloatSpec.Core.Defs.FlocqFloat beta,
      _root_.F2R (beta:=beta) error =
        |_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q -
          _root_.F2R (beta:=beta) pq| ∧
      Fbounded (beta:=beta) bo error ∧
      error.Fexp = min p.Fexp q.Fexp⌝⦄ := by
  intro h
  rcases h with ⟨hβ, hp, hq, hpq_exp, hclosest, hrep⟩
  simp only [wp, PostCond.noThrow, pure, Id.run, ULift.up_down]
  rcases hrep with ⟨m, hrep⟩
  let rep : FloatSpec.Core.Defs.FlocqFloat beta :=
    ⟨m, (Fplus (beta:=beta) p q).Fexp⟩
  let d : FloatSpec.Core.Defs.FlocqFloat beta :=
    FloatSpec.Calc.Operations.Fminus (beta:=beta) rep p
  let error : FloatSpec.Core.Defs.FlocqFloat beta :=
    Fabs (beta:=beta) (FloatSpec.Calc.Operations.Fminus (beta:=beta) q d)
  have hplus_exp : (Fplus (beta:=beta) p q).Fexp = min p.Fexp q.Fexp := by
    cases p with
    | mk pm pe =>
      cases q with
      | mk qm qe =>
        by_cases hle : pe ≤ qe
        · simp [Fplus, FloatSpec.Calc.Operations.Fplus,
            FloatSpec.Calc.Operations.Falign, hle, min_eq_left hle]
        · have hge : qe ≤ pe := le_of_lt (lt_of_not_ge hle)
          simp [Fplus, FloatSpec.Calc.Operations.Fplus,
            FloatSpec.Calc.Operations.Falign, hle, min_eq_right hge]
  have hrep_val : _root_.F2R (beta:=beta) rep = _root_.F2R (beta:=beta) pq := by
    simpa [rep] using hrep.symm
  have hd_val :
      _root_.F2R (beta:=beta) d =
        _root_.F2R (beta:=beta) pq - _root_.F2R (beta:=beta) p := by
    have hminus := Fminus_correct (beta:=beta) rep p
    have hminus_val :
        _root_.F2R (beta:=beta) d =
          _root_.F2R (beta:=beta) rep - _root_.F2R (beta:=beta) p := by
      simpa [d, wp, PostCond.noThrow, pure, Fminus_correct_check,
        Id.run, ULift.up_down] using hminus hβ
    rw [hminus_val, hrep_val]
  have hraw_val :
      _root_.F2R (beta:=beta)
          (FloatSpec.Calc.Operations.Fminus (beta:=beta) q d) =
        _root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q -
          _root_.F2R (beta:=beta) pq := by
    have hminus := Fminus_correct (beta:=beta) q d
    have hminus_val :
        _root_.F2R (beta:=beta)
            (FloatSpec.Calc.Operations.Fminus (beta:=beta) q d) =
          _root_.F2R (beta:=beta) q - _root_.F2R (beta:=beta) d := by
      simpa [wp, PostCond.noThrow, pure, Fminus_correct_check,
        Id.run, ULift.up_down] using hminus hβ
    rw [hminus_val, hd_val]
    ring
  have herror_val :
      _root_.F2R (beta:=beta) error =
        |_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q -
          _root_.F2R (beta:=beta) pq| := by
    have habs := FloatSpec.Calc.Operations.F2R_abs (beta:=beta)
      (FloatSpec.Calc.Operations.Fminus (beta:=beta) q d)
    have habs_val :
        _root_.F2R (beta:=beta) error =
          |_root_.F2R (beta:=beta)
            (FloatSpec.Calc.Operations.Fminus (beta:=beta) q d)| := by
      simpa [error, Fabs, _root_.F2R, wp, PostCond.noThrow, pure,
        Id.run, ULift.up_down] using habs hβ
    rw [habs_val, hraw_val]
  have hd_exp : d.Fexp = min p.Fexp q.Fexp := by
    have hrep_exp : rep.Fexp = min p.Fexp q.Fexp := by
      simp [rep, hplus_exp]
    have hrep_exp_p : rep.Fexp = p.Fexp := by
      rw [hrep_exp, min_eq_left hpq_exp]
    simp [d, FloatSpec.Calc.Operations.Fminus,
      FloatSpec.Calc.Operations.Fplus, FloatSpec.Calc.Operations.Fopp,
      FloatSpec.Calc.Operations.Falign, hrep_exp_p, min_eq_left hpq_exp]
  have hraw_exp :
      (FloatSpec.Calc.Operations.Fminus (beta:=beta) q d).Fexp =
        min p.Fexp q.Fexp := by
    have hdp : d.Fexp = p.Fexp := by
      rw [hd_exp, min_eq_left hpq_exp]
    by_cases hqd : q.Fexp ≤ d.Fexp
    · have hqp : q.Fexp = p.Fexp := by
        exact le_antisymm (by simpa [hdp] using hqd) hpq_exp
      simp [FloatSpec.Calc.Operations.Fminus,
        FloatSpec.Calc.Operations.Fplus, FloatSpec.Calc.Operations.Fopp,
        FloatSpec.Calc.Operations.Falign, hqd, hqp, hdp, min_eq_left hpq_exp]
    · have hqp_not : ¬ q.Fexp ≤ p.Fexp := by
        intro hqp
        exact hqd (by simpa [hdp] using hqp)
      simp [FloatSpec.Calc.Operations.Fminus,
        FloatSpec.Calc.Operations.Fplus, FloatSpec.Calc.Operations.Fopp,
        FloatSpec.Calc.Operations.Falign, hqd, hqp_not, hdp,
        min_eq_left hpq_exp]
  have herror_exp : error.Fexp = min p.Fexp q.Fexp := by
    simp [error, Fabs, FloatSpec.Calc.Operations.Fabs, hraw_exp]
  have hclosest_dist :
      |_root_.F2R (beta:=beta) pq -
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)| ≤
        |_root_.F2R (beta:=beta) q -
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)| :=
    hclosest.2 q hq
  have herror_abs_le_p :
      |_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q -
          _root_.F2R (beta:=beta) pq| ≤
        |_root_.F2R (beta:=beta) p| := by
    have hleft :
        |_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q -
            _root_.F2R (beta:=beta) pq| =
          |_root_.F2R (beta:=beta) pq -
            (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)| := by
      rw [← abs_neg]
      congr 1
      ring
    have hright :
        |_root_.F2R (beta:=beta) q -
            (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)| =
          |_root_.F2R (beta:=beta) p| := by
      rw [show _root_.F2R (beta:=beta) q -
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q) =
            -_root_.F2R (beta:=beta) p by ring, abs_neg]
    rw [hleft]
    exact le_trans hclosest_dist (le_of_eq hright)
  have herror_bounded : Fbounded (beta:=beta) bo error := by
    constructor
    · have hbeta_pos : (0 : ℝ) < (beta : ℝ) := by
        exact_mod_cast (by omega : (0 : Int) < beta)
      have hpow_pos : (0 : ℝ) < (beta : ℝ) ^ (min p.Fexp q.Fexp) :=
        zpow_pos hbeta_pos _
      have herror_abs_real :
          |(error.Fnum : ℝ)| * (beta : ℝ) ^ (min p.Fexp q.Fexp) =
            _root_.F2R (beta:=beta) error := by
        have herror_num_nonneg : 0 ≤ error.Fnum := by
          simp [error, Fabs, FloatSpec.Calc.Operations.Fabs]
        calc
          |(error.Fnum : ℝ)| * (beta : ℝ) ^ (min p.Fexp q.Fexp)
              = (error.Fnum : ℝ) * (beta : ℝ) ^ (min p.Fexp q.Fexp) := by
                rw [abs_of_nonneg (by exact_mod_cast herror_num_nonneg)]
          _ = _root_.F2R (beta:=beta) error := by
                simp [_root_.F2R, FloatSpec.Core.Defs.F2R, herror_exp]
      have hp_abs_real :
          |_root_.F2R (beta:=beta) p| =
            |(p.Fnum : ℝ)| * (beta : ℝ) ^ (min p.Fexp q.Fexp) := by
        have hp_pow : 0 < (beta : ℝ) ^ p.Fexp := zpow_pos hbeta_pos _
        rw [show min p.Fexp q.Fexp = p.Fexp from min_eq_left hpq_exp]
        simp [_root_.F2R, FloatSpec.Core.Defs.F2R, abs_mul,
          abs_of_pos hp_pow, Int.cast_abs]
      have hmant_le : |(error.Fnum : ℝ)| ≤ |(p.Fnum : ℝ)| := by
        have hscaled :
            |(error.Fnum : ℝ)| * (beta : ℝ) ^ (min p.Fexp q.Fexp) ≤
              |(p.Fnum : ℝ)| * (beta : ℝ) ^ (min p.Fexp q.Fexp) := by
          rw [herror_abs_real, ← hp_abs_real, herror_val]
          exact herror_abs_le_p
        exact le_of_mul_le_mul_right hscaled hpow_pos
      have hp_bound_real : |(p.Fnum : ℝ)| < (bo.vNum : ℝ) := by
        exact_mod_cast hp.1
      exact_mod_cast (lt_of_le_of_lt hmant_le hp_bound_real)
    · rw [herror_exp, min_eq_left hpq_exp]
      exact hp.2
  exact ⟨error, herror_val, herror_bounded, herror_exp⟩

/-- Coq Fast-section bridge for `ErrorBoundedIplus`.

Upstream `ErrorBoundedIplus` is a direct specialization of the global
`errorBoundedPlus` theorem to the abstract addition operation `Iplus`.  This
lemma restores that specialization once the global closest-plus error payload is
available, without pretending that the global theorem has already been ported. -/
theorem ErrorBoundedIplus_from_errorBoundedPlus {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (Iplus :
      FloatSpec.Core.Defs.FlocqFloat beta →
        FloatSpec.Core.Defs.FlocqFloat beta →
          FloatSpec.Core.Defs.FlocqFloat beta)
    (IplusCorrect :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) bo p →
        Fbounded (beta:=beta) bo q →
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)
          (Iplus p q))
    (errorBoundedPlus :
      ∀ p q pq : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) bo p →
        Fbounded (beta:=beta) bo q →
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q) pq →
        ∃ error : FloatSpec.Core.Defs.FlocqFloat beta,
          _root_.F2R (beta:=beta) error =
            _root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q -
              _root_.F2R (beta:=beta) pq ∧
          Fbounded (beta:=beta) bo error ∧
          error.Fexp = min p.Fexp q.Fexp) :
    ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
      Fbounded (beta:=beta) bo p →
      Fbounded (beta:=beta) bo q →
      ∃ error : FloatSpec.Core.Defs.FlocqFloat beta,
        _root_.F2R (beta:=beta) error =
          _root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q -
            _root_.F2R (beta:=beta) (Iplus p q) ∧
        Fbounded (beta:=beta) bo error := by
  intro p q hp hq
  rcases errorBoundedPlus p q (Iplus p q) hp hq
      (IplusCorrect p q hp hq) with
    ⟨error, herrorVal, herrorBounded, _herrorExp⟩
  exact ⟨error, herrorVal, herrorBounded⟩

/-- Coq: `ErrorBoundedIplus`.

The Fast-section theorem is the abstract `Iplus` specialization of the global
closest-plus error bound. -/
theorem ErrorBoundedIplus {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (Iplus :
      FloatSpec.Core.Defs.FlocqFloat beta →
        FloatSpec.Core.Defs.FlocqFloat beta →
          FloatSpec.Core.Defs.FlocqFloat beta)
    (IplusCorrect :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) bo p →
        Fbounded (beta:=beta) bo q →
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)
          (Iplus p q))
    (errorBoundedPlus :
      ∀ p q pq : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) bo p →
        Fbounded (beta:=beta) bo q →
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q) pq →
        ∃ error : FloatSpec.Core.Defs.FlocqFloat beta,
          _root_.F2R (beta:=beta) error =
            _root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q -
              _root_.F2R (beta:=beta) pq ∧
          Fbounded (beta:=beta) bo error ∧
          error.Fexp = min p.Fexp q.Fexp) :
    ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
      Fbounded (beta:=beta) bo p →
      Fbounded (beta:=beta) bo q →
      ∃ error : FloatSpec.Core.Defs.FlocqFloat beta,
        _root_.F2R (beta:=beta) error =
          _root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q -
            _root_.F2R (beta:=beta) (Iplus p q) ∧
        Fbounded (beta:=beta) bo error :=
  ErrorBoundedIplus_from_errorBoundedPlus (beta:=beta) bo radix Iplus
    IplusCorrect errorBoundedPlus

theorem MDekkerAux1_from_payload {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (Iplus Iminus :
      FloatSpec.Core.Defs.FlocqFloat beta →
        FloatSpec.Core.Defs.FlocqFloat beta →
          FloatSpec.Core.Defs.FlocqFloat beta)
    (p q : FloatSpec.Core.Defs.FlocqFloat beta) :
    Fbounded (beta:=beta) bo p →
    Fbounded (beta:=beta) bo q →
    _root_.F2R (beta:=beta) (Iminus (Iplus p q) p) =
      _root_.F2R (beta:=beta) (Iplus p q) - _root_.F2R (beta:=beta) p →
    (∃ error : FloatSpec.Core.Defs.FlocqFloat beta,
      _root_.F2R (beta:=beta) error =
        _root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q -
          _root_.F2R (beta:=beta) (Iplus p q) ∧
      Fbounded (beta:=beta) bo error) →
    Closest (beta:=beta) bo radix
      (_root_.F2R (beta:=beta) q -
        _root_.F2R (beta:=beta) (Iminus (Iplus p q) p))
      (Iminus q (Iminus (Iplus p q) p)) →
    _root_.F2R (beta:=beta) (Iminus q (Iminus (Iplus p q) p)) =
      _root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q -
        _root_.F2R (beta:=beta) (Iplus p q) := by
  intro _hp _hq hFirstExact hError hSecondClosest
  rcases hError with ⟨error, herrorVal, herrorBounded⟩
  let result := Iminus q (Iminus (Iplus p q) p)
  have htarget :
      _root_.F2R (beta:=beta) q -
          _root_.F2R (beta:=beta) (Iminus (Iplus p q) p) =
        _root_.F2R (beta:=beta) error := by
    rw [hFirstExact, herrorVal]
    ring
  have hClosestError :
      Closest (beta:=beta) bo radix (_root_.F2R (beta:=beta) error) result := by
    simpa [result, htarget] using hSecondClosest
  have hresultBounded : Fbounded (beta:=beta) bo result := hClosestError.1
  have hresultMin :
      ∀ g : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded' (beta:=beta) bo g →
          |_root_.F2R (beta:=beta) result - _root_.F2R (beta:=beta) error| ≤
            |_root_.F2R (beta:=beta) g - _root_.F2R (beta:=beta) error| :=
    hClosestError.2
  have hIdemTrip := ClosestIdem (beta:=beta) bo radix error result
  have herror_eq_result :
      _root_.F2R (beta:=beta) error = _root_.F2R (beta:=beta) result := by
    simpa [wp, PostCond.noThrow, pure, ClosestIdem_check, Fbounded'] using
      hIdemTrip ⟨herrorBounded, hClosestError, herrorBounded,
        hresultBounded, hresultMin⟩
  rw [← herror_eq_result, herrorVal]

/-- Coq: `MDekkerAux1`, specialized through the global closest-plus error
payload.

This removes the manual error-witness and second-closest hypotheses from
`MDekkerAux1_from_payload`; the only algorithmic premise left is the first
subtraction exactness premise, exactly as in the upstream lemma. -/
theorem MDekkerAux1_from_errorBoundedPlus {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (Iplus Iminus :
      FloatSpec.Core.Defs.FlocqFloat beta →
        FloatSpec.Core.Defs.FlocqFloat beta →
          FloatSpec.Core.Defs.FlocqFloat beta)
    (IplusCorrect :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) bo p →
        Fbounded (beta:=beta) bo q →
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q)
          (Iplus p q))
    (IminusPlus :
      ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
        Iminus p q = Iplus p (Fopp (beta:=beta) q))
    (errorBoundedPlus :
      ∀ p q pq : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) bo p →
        Fbounded (beta:=beta) bo q →
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q) pq →
        ∃ error : FloatSpec.Core.Defs.FlocqFloat beta,
          _root_.F2R (beta:=beta) error =
            _root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q -
              _root_.F2R (beta:=beta) pq ∧
          Fbounded (beta:=beta) bo error ∧
          error.Fexp = min p.Fexp q.Fexp) :
    ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
      Fbounded (beta:=beta) bo p →
      Fbounded (beta:=beta) bo q →
      _root_.F2R (beta:=beta) (Iminus (Iplus p q) p) =
        _root_.F2R (beta:=beta) (Iplus p q) -
          _root_.F2R (beta:=beta) p →
      _root_.F2R (beta:=beta) (Iminus q (Iminus (Iplus p q) p)) =
        _root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q -
          _root_.F2R (beta:=beta) (Iplus p q) := by
  intro p q hp hq hFirstExact
  have hError :=
    ErrorBoundedIplus_from_errorBoundedPlus (beta:=beta) bo radix Iplus
      IplusCorrect errorBoundedPlus p q hp hq
  have hplusBounded :
      Fbounded (beta:=beta) bo (Iplus p q) :=
    IplusBounded (beta:=beta) bo radix Iplus IplusCorrect p q hp hq
  have hfirstBounded :
      Fbounded (beta:=beta) bo (Iminus (Iplus p q) p) :=
    IminusBounded (beta:=beta) bo radix Iplus Iminus IplusCorrect
      IminusPlus (Iplus p q) p hplusBounded hp
  have hSecondClosest :
      Closest (beta:=beta) bo radix
        (_root_.F2R (beta:=beta) q -
          _root_.F2R (beta:=beta) (Iminus (Iplus p q) p))
        (Iminus q (Iminus (Iplus p q) p)) :=
    IminusCorrect (beta:=beta) bo radix Iplus Iminus IplusCorrect
      IminusPlus q (Iminus (Iplus p q) p) hq hfirstBounded
  exact MDekkerAux1_from_payload (beta:=beta) bo radix Iplus Iminus p q
    hp hq hFirstExact hError hSecondClosest

/-- Coq: `MDekkerAux1`.

Fast-section reconstruction of the second Dekker subtraction.  The global
