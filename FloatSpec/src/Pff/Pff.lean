  have hMinPos :
      ∀ s : ℝ, 0 ≤ s →
        isMin' (beta:=beta) b radix s
          (RND_Min_Pos (beta:=beta) b radix p s) := by
    intro s hs
    have h := RND_Min_Pos_correct (beta:=beta) b radix p s
    simpa only [wp, PostCond.noThrow, pure, RND_Min_Pos_correct_check,
      Id.run, ULift.up_down] using h ⟨hs, hbeta, hradix, hp, hvnum⟩
  have hMaxPos :
      ∀ s : ℝ, 0 ≤ s →
        isMax' (beta:=beta) b radix s
          (RND_Max_Pos (beta:=beta) b radix p s) := by
    intro s hs
    have h := RND_Max_Pos_correct (beta:=beta) b radix p s
    simpa only [wp, PostCond.noThrow, pure, RND_Max_Pos_correct_check,
      Id.run, ULift.up_down] using h ⟨hs, hbeta, hradix, hp, hvnum⟩
  have h := RND_Max_correct (beta:=beta) b radix p r
  simpa only [wp, PostCond.noThrow, pure, RND_Max_correct_check,
    Id.run, ULift.up_down] using h ⟨hMinPos, hMaxPos⟩

/-- Closed section-context form of `RND_Closest_canonic`.

This removes the explicit lower/upper canonicity payloads by using the closed
signed min/max wrappers above. -/
theorem RND_Closest_canonic_closed {beta : Int}
    (b : Fbound_skel) (radix : Int) (p : Int)
    (choice : Int → Bool) (r : ℝ) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ 1 < p ∧
        b.vNum = Zpower_nat radix p.toNat⌝⦄
    (pure (RND_Closest_canonic_check (beta:=beta) b radix p choice r) : Id Unit)
    ⦃⇓_ => ⌜Fcanonic (beta:=beta) radix b
        (RND_Closest (beta:=beta) b radix p choice r)⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix, hp, hvnum⟩
  have hMin : Fcanonic (beta:=beta) radix b
      (RND_Min (beta:=beta) b radix p r) := by
    have h := RND_Min_canonic_closed (beta:=beta) b radix p r
    simpa only [wp, PostCond.noThrow, pure, RND_Min_canonic_check,
      Id.run, ULift.up_down] using h ⟨hbeta, hradix, hp, hvnum⟩
  have hMax : Fcanonic (beta:=beta) radix b
      (RND_Max (beta:=beta) b radix p r) := by
    have h := RND_Max_canonic_closed (beta:=beta) b radix p r
    simpa only [wp, PostCond.noThrow, pure, RND_Max_canonic_check,
      Id.run, ULift.up_down] using h ⟨hbeta, hradix, hp, hvnum⟩
  have h := RND_Closest_canonic (beta:=beta) b radix p choice r
  simpa only [wp, PostCond.noThrow, pure, RND_Closest_canonic_check,
    Id.run, ULift.up_down] using h ⟨hMin, hMax⟩

/-- Closed section-context form of `RND_Closest_correct`.

This packages the nearest-rounding correctness payload once the signed
lower/upper extremal roundings have been restored. -/
theorem RND_Closest_correct_closed {beta : Int}
    (b : Fbound_skel) (radix : Int) (p : Int)
    (choice : Int → Bool) (r : ℝ) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ 1 < p ∧
        b.vNum = Zpower_nat radix p.toNat⌝⦄
    (pure (RND_Closest_correct_check (beta:=beta) b radix p choice r) : Id Unit)
    ⦃⇓_ => ⌜Closest (beta:=beta) b (radix : ℝ) r
        (RND_Closest (beta:=beta) b radix p choice r)⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix, hp, hvnum⟩
  have hMin : isMin' (beta:=beta) b radix r
      (RND_Min (beta:=beta) b radix p r) := by
    have h := RND_Min_correct_closed (beta:=beta) b radix p r
    simpa only [wp, PostCond.noThrow, pure, RND_Min_correct_check,
      Id.run, ULift.up_down] using h ⟨hbeta, hradix, hp, hvnum⟩
  have hMax : isMax' (beta:=beta) b radix r
      (RND_Max (beta:=beta) b radix p r) := by
    have h := RND_Max_correct_closed (beta:=beta) b radix p r
    simpa only [wp, PostCond.noThrow, pure, RND_Max_correct_check,
      Id.run, ULift.up_down] using h ⟨hbeta, hradix, hp, hvnum⟩
  have h := RND_Closest_correct (beta:=beta) b radix p choice r
  simpa only [wp, PostCond.noThrow, pure, RND_Closest_correct_check,
    Id.run, ULift.up_down] using h ⟨hMin, hMax⟩

/-- Closed section-context form of `RND_EvenClosest_canonic`.

This discharges the signed lower/upper canonicity dependencies.  The analogous
correctness theorem still needs the Flocq midpoint parity bridge, so it remains
separate. -/
theorem RND_EvenClosest_canonic_closed {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat) (r : ℝ) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ 1 < (precision : Int) ∧
        b.vNum = Zpower_nat radix precision⌝⦄
    (pure (RND_EvenClosest_canonic_check (beta:=beta) b radix precision r) : Id Unit)
    ⦃⇓_ => ⌜Fcanonic (beta:=beta) radix b
        (RND_EvenClosest (beta:=beta) b radix precision r)⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix, hp, hvnum⟩
  have htoNat : ((precision : Int).toNat) = precision := by
    simp
  have hMin : Fcanonic (beta:=beta) radix b
      (RND_Min (beta:=beta) b radix (precision : Int) r) := by
    have h := RND_Min_canonic_closed (beta:=beta) b radix (precision : Int) r
    simpa only [wp, PostCond.noThrow, pure, RND_Min_canonic_check,
      Id.run, ULift.up_down, htoNat] using h ⟨hbeta, hradix, hp, hvnum⟩
  have hMax : Fcanonic (beta:=beta) radix b
      (RND_Max (beta:=beta) b radix (precision : Int) r) := by
    have h := RND_Max_canonic_closed (beta:=beta) b radix (precision : Int) r
    simpa only [wp, PostCond.noThrow, pure, RND_Max_canonic_check,
      Id.run, ULift.up_down, htoNat] using h ⟨hbeta, hradix, hp, hvnum⟩
  have h := RND_EvenClosest_canonic (beta:=beta) b radix precision r
  simpa only [wp, PostCond.noThrow, pure, RND_EvenClosest_canonic_check,
    Id.run, ULift.up_down] using h ⟨hMin, hMax⟩

/-- Closed section-context form of Coq `RND_EvenClosest_correct`.

The early payload lemma keeps the implementation case split available before
the min/max infrastructure is declared.  This theorem supplies those payloads
from the restored signed rounding correctness/canonicity theorems and handles
the exact odd lower-endpoint case by the uniqueness branch of `EvenClosest`. -/
theorem RND_EvenClosest_correct {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat) (r : ℝ) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ 1 < (precision : Int) ∧
        b.vNum = Zpower_nat radix precision⌝⦄
    (pure (RND_EvenClosest_correct_check (beta:=beta) b radix precision r) :
      Id Unit)
    ⦃⇓_ => ⌜EvenClosest (beta:=beta) b (radix : ℝ) precision r
      (RND_EvenClosest (beta:=beta) b radix precision r)⌝⦄ := by
  classical
  intro h
  rcases h with ⟨hbeta, hradix, hp, hvnum⟩
  subst beta
  have hprecision_ne : precision ≠ 0 := by omega
  have hpNat : 1 < precision := by omega
  have htoNat : ((precision : Int).toNat) = precision := by simp
  simp only [wp, PostCond.noThrow, pure, RND_EvenClosest_correct_check,
    Id.run, ULift.up_down]
  let rd := RND_Min (beta:=radix) b radix (precision : Int) r
  let ru := RND_Max (beta:=radix) b radix (precision : Int) r
  have hMin : isMin' (beta:=radix) b radix r rd := by
    have hm := RND_Min_correct_closed (beta:=radix) b radix (precision : Int) r
    simpa only [wp, PostCond.noThrow, pure, RND_Min_correct_check,
      Id.run, ULift.up_down, rd, htoNat] using hm ⟨rfl, hradix, hp, hvnum⟩
  have hMax : isMax' (beta:=radix) b radix r ru := by
    have hm := RND_Max_correct_closed (beta:=radix) b radix (precision : Int) r
    simpa only [wp, PostCond.noThrow, pure, RND_Max_correct_check,
      Id.run, ULift.up_down, ru, htoNat] using hm ⟨rfl, hradix, hp, hvnum⟩
  have hrdCan : Fcanonic (beta:=radix) radix b rd := by
    have hc := RND_Min_canonic_closed (beta:=radix) b radix (precision : Int) r
    simpa only [wp, PostCond.noThrow, pure, RND_Min_canonic_check,
      Id.run, ULift.up_down, rd, htoNat] using hc ⟨rfl, hradix, hp, hvnum⟩
  have hruCan : Fcanonic (beta:=radix) radix b ru := by
    have hc := RND_Max_canonic_closed (beta:=radix) b radix (precision : Int) r
    simpa only [wp, PostCond.noThrow, pure, RND_Max_canonic_check,
      Id.run, ULift.up_down, ru, htoNat] using hc ⟨rfl, hradix, hp, hvnum⟩
  have hClosestMinOrMax :
      ∀ q : FloatSpec.Core.Defs.FlocqFloat radix,
        Closest (beta:=radix) b (radix : ℝ) r q →
          isMin' (beta:=radix) b radix r q ∨
            isMax' (beta:=radix) b radix r q := by
    have hcm := ClosestMinOrMax (beta:=radix) b radix (radix : ℝ)
    have hfull :
        MinOrMaxP_float (beta:=radix) b radix
          (Closest (beta:=radix) b (radix : ℝ)) := by
      simpa only [wp, PostCond.noThrow, pure, ClosestMinOrMax_check,
        Id.run, ULift.up_down] using hcm trivial
    exact hfull r
  have hMinUnique :
      ∀ q : FloatSpec.Core.Defs.FlocqFloat radix,
        isMin' (beta:=radix) b radix r q →
          _root_.F2R (beta:=radix) q = _root_.F2R (beta:=radix) rd := by
    intro q hq
    have hm := MinEq (beta:=radix) b radix q rd r
    simpa only [wp, PostCond.noThrow, pure, MinEq_check, Id.run,
      ULift.up_down] using hm ⟨hq, hMin⟩
  have hMaxUnique :
      ∀ q : FloatSpec.Core.Defs.FlocqFloat radix,
        isMax' (beta:=radix) b radix r q →
          _root_.F2R (beta:=radix) q = _root_.F2R (beta:=radix) ru := by
    intro q hq
    have hm := MaxEq (beta:=radix) b radix q ru r
    simpa only [wp, PostCond.noThrow, pure, MaxEq_check, Id.run,
      ULift.up_down] using hm ⟨hq, hMax⟩
  have hrd_le : _root_.F2R (beta:=radix) rd ≤ r := hMin.2.1
  have hle_ru : r ≤ _root_.F2R (beta:=radix) ru := hMax.2.1
  have hrd_nonpos : _root_.F2R (beta:=radix) rd - r ≤ 0 := by
    linarith
  have hru_nonneg : 0 ≤ _root_.F2R (beta:=radix) ru - r := by
    linarith
  have hrdEven_of_not_odd :
      ¬ Odd rd.Fnum →
        FNeven (beta:=radix) b (radix : ℝ) precision rd := by
    intro hnot
    have hnorm := FcanonicFnormalizeEq (beta:=radix) radix b precision rd
    have hnorm_eq :
        Fnormalize (beta:=radix) radix b precision rd = rd := by
      simpa only [wp, PostCond.noThrow, pure, FcanonicFnormalizeEq_check,
        Id.run, ULift.up_down] using
        hnorm ⟨hrdCan, rfl, hradix, hprecision_ne, hvnum⟩
    have heven : Even rd.Fnum := Int.not_odd_iff_even.mp hnot
    simpa [FNeven, Feven, hnorm_eq] using heven
  unfold RND_EvenClosest
  dsimp only [rd, ru]
  by_cases hle :
      |_root_.F2R (beta:=radix) ru - r| ≤
        |_root_.F2R (beta:=radix) rd - r|
  · simp [rd, ru, hle]
    by_cases hlt :
        |_root_.F2R (beta:=radix) ru - r| <
          |_root_.F2R (beta:=radix) rd - r|
    · have hmid : _root_.F2R (beta:=radix) rd + _root_.F2R (beta:=radix) ru ≤
          2 * r := by
        rw [abs_of_nonneg hru_nonneg, abs_of_nonpos hrd_nonpos] at hlt
        linarith
      have hmaxClosest : Closest (beta:=radix) b (radix : ℝ) r ru := by
        have hc := ClosestMax (beta:=radix) b radix (radix : ℝ) r rd ru
        simpa only [wp, PostCond.noThrow, pure, ClosestMax_check,
          Id.run, ULift.up_down] using hc ⟨hMin, hMax, hmid⟩
      refine ⟨by simpa [rd, ru, hle, hlt] using hmaxClosest, Or.inr ?_⟩
      intro q hq
      have hlt_abs := hlt
      rw [abs_of_nonneg hru_nonneg, abs_of_nonpos hrd_nonpos] at hlt_abs
      rcases hClosestMinOrMax q hq with hqMin | hqMax
      · have hq_rd := hMinUnique q hqMin
        exfalso
        have hqdist := hq.2 ru hMax.1
        have hq_nonpos : _root_.F2R (beta:=radix) q - r ≤ 0 := by
          have hq_le : _root_.F2R (beta:=radix) q ≤ r := hqMin.2.1
          linarith
        rw [hq_rd, abs_of_nonpos hrd_nonpos, abs_of_nonneg hru_nonneg] at hqdist
        linarith
      · simpa [RND_EvenClosest, rd, ru, hle, hlt] using hMaxUnique q hqMax
    · have hdist_eq :
          |_root_.F2R (beta:=radix) ru - r| =
            |_root_.F2R (beta:=radix) rd - r| :=
        le_antisymm hle (le_of_not_gt hlt)
      have hmid_min :
          2 * r ≤ _root_.F2R (beta:=radix) rd +
            _root_.F2R (beta:=radix) ru := by
        rw [abs_of_nonneg hru_nonneg, abs_of_nonpos hrd_nonpos] at hdist_eq
        linarith
      have hmid_max :
          _root_.F2R (beta:=radix) rd +
            _root_.F2R (beta:=radix) ru ≤ 2 * r := by
        rw [abs_of_nonneg hru_nonneg, abs_of_nonpos hrd_nonpos] at hdist_eq
        linarith
      by_cases hodd : Odd rd.Fnum
      · by_cases hrd_eq_r : _root_.F2R (beta:=radix) rd = r
        · have hru_eq_r : _root_.F2R (beta:=radix) ru = r := by
            have hdist_eq' := hdist_eq
            rw [hrd_eq_r] at hdist_eq'
            have hru_nonneg' : 0 ≤ _root_.F2R (beta:=radix) ru - r := hru_nonneg
            rw [abs_of_nonneg hru_nonneg'] at hdist_eq'
            simp at hdist_eq'
            linarith
          have hmaxClosest : Closest (beta:=radix) b (radix : ℝ) r ru := by
            have hc := ClosestMax (beta:=radix) b radix (radix : ℝ) r rd ru
            simpa only [wp, PostCond.noThrow, pure, ClosestMax_check,
              Id.run, ULift.up_down] using hc ⟨hMin, hMax, hmid_max⟩
          refine ⟨by simpa [rd, ru, hle, hlt, hodd] using hmaxClosest, Or.inr ?_⟩
          intro q hq
          rcases hClosestMinOrMax q hq with hqMin | hqMax
          · have hq_rd := hMinUnique q hqMin
            have hq_ru : _root_.F2R (beta:=radix) q = _root_.F2R (beta:=radix) ru := by
              calc
                _root_.F2R (beta:=radix) q = _root_.F2R (beta:=radix) rd := hq_rd
                _ = r := hrd_eq_r
                _ = _root_.F2R (beta:=radix) ru := hru_eq_r.symm
            simpa [RND_EvenClosest, rd, ru, hle, hlt, hodd] using hq_ru
          · simpa [RND_EvenClosest, rd, ru, hle, hlt, hodd] using hMaxUnique q hqMax
        · let srd := FNSucc (beta:=radix) b (radix : ℝ) precision rd
          have hMinMax := MinMax (beta:=radix) b radix precision rd r
          have hsMax : isMax' (beta:=radix) b radix r srd := by
            simpa only [wp, PostCond.noThrow, pure, MinMax_check, srd,
              Id.run, ULift.up_down] using
              hMinMax ⟨hMin, hrd_eq_r, rfl, hradix, hprecision_ne, hvnum⟩
          have hs_eq_ru : _root_.F2R (beta:=radix) srd =
              _root_.F2R (beta:=radix) ru := by
            have hm := MaxEq (beta:=radix) b radix srd ru r
            simpa only [wp, PostCond.noThrow, pure, MaxEq_check,
              Id.run, ULift.up_down] using hm ⟨hsMax, hMax⟩
          have hsCan : Fcanonic (beta:=radix) radix b srd := by
            have hc := FNSuccCanonic (beta:=radix) b (radix : ℝ) precision rd
            simpa only [wp, PostCond.noThrow, pure, FNSuccCanonic_check, srd,
              Id.run, ULift.up_down] using
              hc ⟨hMin.1, hradix, hprecision_ne, hvnum⟩
          have hrd_odd_norm :
              FNodd (beta:=radix) b (radix : ℝ) precision rd := by
            have hnorm := FcanonicFnormalizeEq (beta:=radix) radix b precision rd
            have hnorm_eq :
                Fnormalize (beta:=radix) radix b precision rd = rd := by
              simpa only [wp, PostCond.noThrow, pure, FcanonicFnormalizeEq_check,
                Id.run, ULift.up_down] using
                hnorm ⟨hrdCan, rfl, hradix, hprecision_ne, hvnum⟩
            simpa [FNodd, Fodd, hnorm_eq] using hodd
          have hs_even :
              FNeven (beta:=radix) b (radix : ℝ) precision srd := by
            have hs := FNoddSuc (beta:=radix) b (radix : ℝ) precision rd
            simpa only [wp, PostCond.noThrow, pure, FNoddSuc_check, srd,
              Id.run, ULift.up_down] using
              hs ⟨hMin.1, hrd_odd_norm, hradix, hpNat, hvnum⟩
          have hru_even :
              FNeven (beta:=radix) b (radix : ℝ) precision ru := by
            have heq := FNevenEq (beta:=radix) b (radix : ℝ) precision srd ru hradix
            simpa only [wp, PostCond.noThrow, pure, FNevenEq_check,
              ULift.down_up, Fcanonic'] using
              heq ⟨hsCan, hruCan, hs_eq_ru, hs_even⟩
          have hmaxClosest : Closest (beta:=radix) b (radix : ℝ) r ru := by
            have hc := ClosestMax (beta:=radix) b radix (radix : ℝ) r rd ru
            simpa only [wp, PostCond.noThrow, pure, ClosestMax_check,
              Id.run, ULift.up_down] using hc ⟨hMin, hMax, hmid_max⟩
          exact ⟨by simpa [rd, ru, hle, hlt, hodd] using hmaxClosest,
            Or.inl (by simpa [RND_EvenClosest, rd, ru, hle, hlt, hodd] using hru_even)⟩
      · have hrd_even := hrdEven_of_not_odd hodd
        have hminClosest : Closest (beta:=radix) b (radix : ℝ) r rd := by
          have hc := ClosestMin (beta:=radix) b radix (radix : ℝ) r rd ru
          simpa only [wp, PostCond.noThrow, pure, ClosestMin_check,
            Id.run, ULift.up_down] using hc ⟨hMin, hMax, hmid_min⟩
        exact ⟨by simpa [rd, ru, hle, hlt, hodd] using hminClosest,
          Or.inl (by simpa [RND_EvenClosest, rd, ru, hle, hlt, hodd] using hrd_even)⟩
  · simp [rd, ru, hle]
    have hlt_abs :
        |_root_.F2R (beta:=radix) rd - r| <
          |_root_.F2R (beta:=radix) ru - r| :=
      lt_of_not_ge hle
    have hmid : 2 * r ≤ _root_.F2R (beta:=radix) rd +
        _root_.F2R (beta:=radix) ru := by
      rw [abs_of_nonpos hrd_nonpos, abs_of_nonneg hru_nonneg] at hlt_abs
      linarith
    by_cases hodd : Odd rd.Fnum
    · have hminClosest : Closest (beta:=radix) b (radix : ℝ) r rd := by
        have hc := ClosestMin (beta:=radix) b radix (radix : ℝ) r rd ru
        simpa only [wp, PostCond.noThrow, pure, ClosestMin_check,
          Id.run, ULift.up_down] using hc ⟨hMin, hMax, hmid⟩
      refine ⟨by simpa [rd, ru, hle] using hminClosest, Or.inr ?_⟩
      intro q hq
      rcases hClosestMinOrMax q hq with hqMin | hqMax
      · exact hMinUnique q hqMin
      · have hq_ru := hMaxUnique q hqMax
        exfalso
        have hqdist := hq.2 rd hMin.1
        rw [hq_ru, abs_of_nonneg hru_nonneg, abs_of_nonpos hrd_nonpos] at hqdist
        rw [abs_of_nonpos hrd_nonpos, abs_of_nonneg hru_nonneg] at hlt_abs
        linarith
    · have hrd_even := hrdEven_of_not_odd hodd
      have hminClosest : Closest (beta:=radix) b (radix : ℝ) r rd := by
        have hc := ClosestMin (beta:=radix) b radix (radix : ℝ) r rd ru
        simpa only [wp, PostCond.noThrow, pure, ClosestMin_check,
          Id.run, ULift.up_down] using hc ⟨hMin, hMax, hmid⟩
      exact ⟨by simpa [rd, ru, hle] using hminClosest,
        Or.inl (by simpa [RND_EvenClosest, rd, ru, hle] using hrd_even)⟩

-- Coq: `FshiftCorrectInv` — align exponents by shifting the larger one down
noncomputable def FshiftCorrectInv_check {beta : Int}
    (radix : Int)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

theorem FshiftCorrectInv {beta : Int}
    (radix : Int)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧
        _root_.F2R x = _root_.F2R y ∧ x.Fexp ≤ y.Fexp⌝⦄
    (pure (FshiftCorrectInv_check (beta:=beta) radix x y) : Id Unit)
    ⦃⇓_ => ⌜Fshift (beta:=beta) radix (Int.natAbs (y.Fexp - x.Fexp)) y = x⌝⦄ := by
  intro ⟨hbeta_radix, hradix, hxy, hexp_le⟩
  simp only [wp, PostCond.noThrow, pure, FshiftCorrectInv_check,
    Id.run, ULift.up_down]
  have hshift_val :
      _root_.F2R (Fshift (beta:=beta) radix (Int.natAbs (y.Fexp - x.Fexp)) y) =
        _root_.F2R y :=
    (FshiftCorrect (beta:=beta) radix (Int.natAbs (y.Fexp - x.Fexp)) y)
      ⟨hbeta_radix, hradix⟩
  have hval :
      _root_.F2R (Fshift (beta:=beta) radix (Int.natAbs (y.Fexp - x.Fexp)) y) =
        _root_.F2R x :=
    hshift_val.trans hxy.symm
  have hbeta : 1 < beta := by omega
  have hdiff_nonneg : 0 ≤ y.Fexp - x.Fexp := by omega
  have hn :
      ((Int.natAbs (y.Fexp - x.Fexp) : Nat) : Int) = y.Fexp - x.Fexp :=
    Int.natAbs_of_nonneg hdiff_nonneg
  have hexp :
      (Fshift (beta:=beta) radix (Int.natAbs (y.Fexp - x.Fexp)) y).Fexp =
        x.Fexp := by
    simp only [Fshift, FloatSpec.Core.Defs.FlocqFloat.Fexp]
    rw [hn]
    omega
  exact
    (sameExpEq (beta := beta)
      (Fshift (beta:=beta) radix (Int.natAbs (y.Fexp - x.Fexp)) y) x)
      ⟨hval, hexp, hbeta⟩

-- Coq: `FshiftO` — shifting by 0 is identity
noncomputable def FshiftO_check {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

theorem FshiftO {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜True⌝⦄
    (pure (FshiftO_check (beta:=beta) radix x) : Id Unit)
    ⦃⇓_ => ⌜Fshift (beta:=beta) radix 0 x = x ⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, FshiftO_check, Id.run,
    ULift.up_down]
  show Fshift radix 0 x = x
  simp [Fshift]

-- Coq: `FshiftCorrectSym` — equal reals imply some shifts match
noncomputable def FshiftCorrectSym_check {beta : Int}
    (radix : Int) (x y : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

theorem FshiftCorrectSym {beta : Int}
    (radix : Int) (x y : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ _root_.F2R x = _root_.F2R y⌝⦄
    (pure (FshiftCorrectSym_check (beta:=beta) radix x y) : Id Unit)
    ⦃⇓_ => ⌜∃ n m : Nat, Fshift (beta:=beta) radix n x = Fshift (beta:=beta) radix m y⌝⦄ := by
  intro ⟨hbeta_radix, hradix, hxy⟩
  simp [wp, PostCond.noThrow, pure, FshiftCorrectSym_check]
  rcases le_or_gt x.Fexp y.Fexp with hle | hgt
  · refine ⟨0, Int.natAbs (y.Fexp - x.Fexp), ?_⟩
    have hx0 : Fshift (beta:=beta) radix 0 x = x :=
      (FshiftO (beta:=beta) radix x) trivial
    have hy_shift :
        Fshift (beta:=beta) radix (Int.natAbs (y.Fexp - x.Fexp)) y = x :=
      (FshiftCorrectInv (beta:=beta) radix x y) ⟨hbeta_radix, hradix, hxy, hle⟩
    rw [hx0]
    exact hy_shift.symm
  · refine ⟨Int.natAbs (x.Fexp - y.Fexp), 0, ?_⟩
    have hy0 : Fshift (beta:=beta) radix 0 y = y :=
      (FshiftO (beta:=beta) radix y) trivial
    have hx_shift :
        Fshift (beta:=beta) radix (Int.natAbs (x.Fexp - y.Fexp)) x = y :=
      (FshiftCorrectInv (beta:=beta) radix y x)
        ⟨hbeta_radix, hradix, hxy.symm, le_of_lt hgt⟩
    rw [hy0]
    exact hx_shift

-- Coq: `FdigitEq` — if not zero and same real/digit, floats are equal
noncomputable def FdigitEq_check {beta : Int}
    (radix : Int) (x y : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

theorem FdigitEq {beta : Int}
    (radix : Int) (x y : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ ¬ is_Fzero x ∧ _root_.F2R x = _root_.F2R y ∧
        Fdigit (beta:=beta) radix x = Fdigit (beta:=beta) radix y⌝⦄
    (pure (FdigitEq_check (beta:=beta) radix x y) : Id Unit)
    ⦃⇓_ => ⌜x = y⌝⦄ := by
  intro ⟨hbeta_radix, hradix, hx_nonzero, hxy, hdigit⟩
  simp only [wp, PostCond.noThrow, pure, FdigitEq_check, Id.run,
    ULift.up_down]
  have hbeta : 1 < beta := by omega
  have hy_nonzero : ¬ is_Fzero y :=
    (NisFzeroComp (beta:=beta) x y) ⟨hbeta, hx_nonzero, hxy⟩
  rcases lt_trichotomy x.Fexp y.Fexp with hlt | heq | hgt
  · have hle : x.Fexp ≤ y.Fexp := le_of_lt hlt
    have n_pos :
        0 < Int.natAbs (y.Fexp - x.Fexp) := by
      have hdiff_nonneg : 0 ≤ y.Fexp - x.Fexp := by omega
      have hn :
          ((Int.natAbs (y.Fexp - x.Fexp) : Nat) : Int) = y.Fexp - x.Fexp :=
        Int.natAbs_of_nonneg hdiff_nonneg
      have hn_int : (0 : Int) < (Int.natAbs (y.Fexp - x.Fexp) : Int) := by
        rw [hn]
        omega
      exact_mod_cast hn_int
    have hshift_eq :
        Fshift (beta:=beta) radix (Int.natAbs (y.Fexp - x.Fexp)) y = x :=
      (FshiftCorrectInv (beta:=beta) radix x y) ⟨hbeta_radix, hradix, hxy, hle⟩
    have hfd_shift :
        Fdigit (beta:=beta) radix (Fshift (beta:=beta) radix
            (Int.natAbs (y.Fexp - x.Fexp)) y) =
          Fdigit (beta:=beta) radix y + Int.natAbs (y.Fexp - x.Fexp) :=
      (FshiftFdigit (beta:=beta) radix (Int.natAbs (y.Fexp - x.Fexp)) y)
        ⟨hradix, hy_nonzero⟩
    rw [hshift_eq] at hfd_shift
    have hsame :
        Fdigit (beta:=beta) radix y =
          Fdigit (beta:=beta) radix y + Int.natAbs (y.Fexp - x.Fexp) :=
      hdigit.symm.trans hfd_shift
    have hlt_nat :
        Fdigit (beta:=beta) radix y <
          Fdigit (beta:=beta) radix y + Int.natAbs (y.Fexp - x.Fexp) :=
      Nat.lt_add_of_pos_right n_pos
    rw [← hsame] at hlt_nat
    exact False.elim ((Nat.lt_irrefl (Fdigit (beta:=beta) radix y)) hlt_nat)
  · exact (sameExpEq (beta:=beta) x y) ⟨hxy, heq, hbeta⟩
  · have hle : y.Fexp ≤ x.Fexp := le_of_lt hgt
    have n_pos :
        0 < Int.natAbs (x.Fexp - y.Fexp) := by
      have hdiff_nonneg : 0 ≤ x.Fexp - y.Fexp := by omega
      have hn :
          ((Int.natAbs (x.Fexp - y.Fexp) : Nat) : Int) = x.Fexp - y.Fexp :=
        Int.natAbs_of_nonneg hdiff_nonneg
      have hn_int : (0 : Int) < (Int.natAbs (x.Fexp - y.Fexp) : Int) := by
        rw [hn]
        omega
      exact_mod_cast hn_int
    have hshift_eq :
        Fshift (beta:=beta) radix (Int.natAbs (x.Fexp - y.Fexp)) x = y :=
      (FshiftCorrectInv (beta:=beta) radix y x) ⟨hbeta_radix, hradix, hxy.symm, hle⟩
    have hfd_shift :
        Fdigit (beta:=beta) radix (Fshift (beta:=beta) radix
            (Int.natAbs (x.Fexp - y.Fexp)) x) =
          Fdigit (beta:=beta) radix x + Int.natAbs (x.Fexp - y.Fexp) :=
      (FshiftFdigit (beta:=beta) radix (Int.natAbs (x.Fexp - y.Fexp)) x)
        ⟨hradix, hx_nonzero⟩
    rw [hshift_eq] at hfd_shift
    have hsame :
        Fdigit (beta:=beta) radix x =
          Fdigit (beta:=beta) radix x + Int.natAbs (x.Fexp - y.Fexp) :=
      hdigit.trans hfd_shift
    have hlt_nat :
        Fdigit (beta:=beta) radix x <
          Fdigit (beta:=beta) radix x + Int.natAbs (x.Fexp - y.Fexp) :=
      Nat.lt_add_of_pos_right n_pos
    rw [← hsame] at hlt_nat
    exact False.elim ((Nat.lt_irrefl (Fdigit (beta:=beta) radix x)) hlt_nat)

/-- Coq: `FnormalUnique` — normal floats that agree as reals are equal. -/
theorem FnormalUnique {beta : Int}
    (radix : Int) (b : Fbound_skel) (precision : Nat)
    (p q : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜Fnormal (beta:=beta) radix b p ∧
        Fnormal' (beta:=beta) radix b p ∧
        Fnormal (beta:=beta) radix b q ∧
        Fnormal' (beta:=beta) radix b q ∧
        precision ≠ 0 ∧ beta = radix ∧ 1 < radix ∧
        b.vNum = Zpower_nat radix precision ∧
        _root_.F2R (beta:=beta) p = _root_.F2R (beta:=beta) q⌝⦄
    (pure (FnormalUnique_check (beta:=beta) radix b p q) : Id Unit)
    ⦃⇓_ => ⌜p = q⌝⦄ := by
  intro h
  rcases h with
    ⟨hnormal_p, hnormal'_p, hnormal_q, hnormal'_q, hprecision, hbeta_radix,
      hradix, hvNum, hval⟩
  simp only [wp, PostCond.noThrow, pure, FnormalUnique_check,
    Id.run, ULift.up_down]
  have hvNum_pos : 0 < b.vNum := by
    rw [hvNum, Zpower_nat]
    exact pow_pos (by omega : 0 < radix) precision
  have hp_nonzero : ¬ is_Fzero p :=
    (FnormalNotZero (beta:=beta) b radix p radix hvNum_pos hnormal'_p.2)
      hnormal_p
  have hp_digit :
      Fdigit (beta:=beta) radix p = precision :=
    (FnormalPrecision (beta:=beta) radix b precision p)
      ⟨hnormal_p, hnormal'_p, hprecision, hradix, hvNum⟩
  have hq_digit :
      Fdigit (beta:=beta) radix q = precision :=
    (FnormalPrecision (beta:=beta) radix b precision q)
      ⟨hnormal_q, hnormal'_q, hprecision, hradix, hvNum⟩
  exact
    (FdigitEq (beta:=beta) radix p q)
      ⟨hbeta_radix, hradix, hp_nonzero, hval, hp_digit.trans hq_digit.symm⟩

-- Least significant bit position of a float.
noncomputable def LSB {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) : Int :=
  Int.ofNat (maxDiv radix x.Fnum (Fdigit (beta:=beta) radix x)) + x.Fexp

-- Coq: `Fexp_le_LSB` — the encoded exponent is below the least significant bit.
noncomputable def Fexp_le_LSB_check {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

theorem Fexp_le_LSB {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜True⌝⦄
    (pure (Fexp_le_LSB_check (beta:=beta) radix x) : Id Unit)
    ⦃⇓_ => ⌜x.Fexp ≤ LSB (beta:=beta) radix x⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, Fexp_le_LSB_check, Id.run,
    ULift.up_down]
  unfold LSB
  have hnonneg :
      (0 : Int) ≤
        Int.ofNat (maxDiv radix x.Fnum (Fdigit (beta:=beta) radix x)) :=
    Int.natCast_nonneg _
  simpa [add_comm, add_left_comm, add_assoc] using
    add_le_add_right hnonneg x.Fexp

/-- Coq: `Ulp_Le_LSigB` — the unit at the encoded exponent is below the
unit at the least significant bit position. -/
theorem Ulp_Le_LSigB {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    beta = radix →
    1 < radix →
    _root_.F2R (beta:=beta) (⟨1, x.Fexp⟩ : FloatSpec.Core.Defs.FlocqFloat beta) ≤
      _root_.F2R (beta:=beta)
        (⟨1, LSB (beta:=beta) radix x⟩ : FloatSpec.Core.Defs.FlocqFloat beta) := by
  intro hbeta_radix hradix
  have hbeta : 1 < beta := by omega
  have hle : x.Fexp ≤ LSB (beta:=beta) radix x :=
    (Fexp_le_LSB (beta:=beta) radix x) trivial
  exact (oneExp_le (beta:=beta) x.Fexp (LSB (beta:=beta) radix x))
    ⟨hbeta, hle⟩

/-- Coq: `FUlp_Le_LSigB` — a bounded float's normalized ulp is no larger
than the radix unit at its least significant bit. -/
theorem FUlp_Le_LSigB {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    beta = radix →
    1 < radix →
    Fbounded (beta:=beta) b x →
    Fulp (beta:=beta) b radix precision x ≤
      _root_.F2R (beta:=beta)
        (⟨1, LSB (beta:=beta) radix x⟩ : FloatSpec.Core.Defs.FlocqFloat beta) := by
  intro hbeta_radix hradix hx
  have hFulp_le :
      Fulp (beta:=beta) b radix precision x ≤ (beta : ℝ) ^ x.Fexp := by
    exact (FulpLe (beta:=beta) radix b precision x) ⟨hx, hbeta_radix, hradix⟩
  have hUlp_le :
      _root_.F2R (beta:=beta)
          (⟨1, x.Fexp⟩ : FloatSpec.Core.Defs.FlocqFloat beta) ≤
        _root_.F2R (beta:=beta)
          (⟨1, LSB (beta:=beta) radix x⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) :=
    Ulp_Le_LSigB (beta:=beta) radix x hbeta_radix hradix
  have hpow_eq :
      (beta : ℝ) ^ x.Fexp =
        _root_.F2R (beta:=beta)
          (⟨1, x.Fexp⟩ : FloatSpec.Core.Defs.FlocqFloat beta) := by
    simp [_root_.F2R, FloatSpec.Core.Defs.F2R]
  exact le_trans (by simpa [hpow_eq] using hFulp_le) hUlp_le

-- Coq: `LSB_shift` — ~is_Fzero x -> LSB x = LSB (Fshift n x)
noncomputable def LSB_shift_check {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) (n : Nat) : Unit :=
  ()

-- Coq: `maxDivLess` — maxDiv v p ≤ p
noncomputable def maxDivLess_check (radix : Int) (v : Int) (p : Nat) : Unit :=
  ()

theorem maxDivLess (radix : Int) (v : Int) (p : Nat) :
    ⦃⌜True⌝⦄
    (pure (maxDivLess_check radix v p) : Id Unit)
    ⦃⇓_ => ⌜maxDiv radix v p ≤ p⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, maxDivLess_check, Id.run,
    ULift.up_down]
  show maxDiv radix v p ≤ p
  classical
  induction p with
  | zero => simp [maxDiv]
  | succ p ih =>
      by_cases h : Zdivides v (Zpower_nat radix (Nat.succ p))
      · simp [maxDiv, h]
      · simpa [maxDiv, h] using Nat.le_trans ih (Nat.le_succ p)

-- Coq: `LSB_comp` — ~is_Fzero x → x = y :>R → LSB x = LSB y
noncomputable def LSB_comp_check {beta : Int}
    (radix : Int)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) (n : Nat) : Unit :=
  ()

-- Coq: `maxDivCorrect` — Zdivides v (radix^maxDiv v p)
noncomputable def maxDivCorrect_check (radix : Int) (v : Int) (p : Nat) : Unit :=
  ()

/-- Coq: `maxDivCorrect` — for any integer `v` and natural `p`,
`v` divides `radix^(maxDiv v p)`. We only state the property here. -/
theorem maxDivCorrect (radix : Int) (v : Int) (p : Nat) :
    ⦃⌜True⌝⦄
    (pure (maxDivCorrect_check radix v p) : Id Unit)
    ⦃⇓_ => ⌜Zdivides v (Zpower_nat radix (maxDiv radix v p))⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, maxDivCorrect_check, Id.run,
    ULift.up_down]
  show Zdivides v (Zpower_nat radix (maxDiv radix v p))
  classical
  induction p with
  | zero =>
      simp [maxDiv, Zpower_nat, Zdivides]
  | succ p ih =>
      by_cases h : Zdivides v (Zpower_nat radix (Nat.succ p))
      · simpa [maxDiv, h] using h
      · simpa [maxDiv, h] using ih

-- Coq: `LSB_rep_min` — every float has an equivalent representation at `LSB`.
noncomputable def LSB_rep_min_check {beta : Int}
    (radix : Int) (p : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

theorem LSB_rep_min {beta : Int}
    (radix : Int) (p : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix⌝⦄
    (pure (LSB_rep_min_check (beta:=beta) radix p) : Id Unit)
    ⦃⇓_ => ⌜∃ z : Int,
      _root_.F2R (beta:=beta) p =
        _root_.F2R (beta:=beta)
          (⟨z, LSB (beta:=beta) radix p⟩ : FloatSpec.Core.Defs.FlocqFloat beta)⌝⦄ := by
  intro ⟨hbeta_radix, hradix⟩
  simp only [wp, PostCond.noThrow, pure, LSB_rep_min_check, Id.run,
    ULift.up_down]
  let md : Nat := maxDiv radix p.Fnum (Fdigit (beta:=beta) radix p)
  let powi : Int := Zpower_nat radix md
  let z : Int := Zquotient p.Fnum powi
  refine ⟨z, ?_⟩
  have hradix_pos_int : 0 < radix := by omega
  have hradix_ne_real : (radix : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hradix_pos_int)
  have hpowi_ne : powi ≠ 0 := by
    unfold powi Zpower_nat
    exact pow_ne_zero md (ne_of_gt hradix_pos_int)
  have hdivides : Zdivides p.Fnum powi := by
    simpa [powi, md] using
      (maxDivCorrect radix p.Fnum (Fdigit (beta:=beta) radix p)) trivial
  have hnum : p.Fnum = z * powi := by
    simpa [z] using (ZdividesZquotient p.Fnum powi) ⟨hpowi_ne, hdivides⟩
  have hpow_real :
      (powi : ℝ) = (radix : ℝ) ^ (md : Int) := by
    simpa [powi] using (Zpower_nat_Z_powerRZ radix md) trivial
  have hlsb : LSB (beta:=beta) radix p = (md : Int) + p.Fexp := by
    simp [LSB, md]
  calc
    _root_.F2R (beta:=beta) p
        = (p.Fnum : ℝ) * (radix : ℝ) ^ p.Fexp := by
          simp [_root_.F2R, FloatSpec.Core.Defs.F2R, hbeta_radix]
    _ = ((z : ℝ) * (powi : ℝ)) * (radix : ℝ) ^ p.Fexp := by
          rw [hnum]
          simp [Int.cast_mul]
    _ = ((z : ℝ) * (radix : ℝ) ^ (md : Int)) * (radix : ℝ) ^ p.Fexp := by
          rw [hpow_real]
    _ = (z : ℝ) * ((radix : ℝ) ^ (md : Int) * (radix : ℝ) ^ p.Fexp) := by
          ring
    _ = (z : ℝ) * (radix : ℝ) ^ ((md : Int) + p.Fexp) := by
          rw [← zpow_add₀ hradix_ne_real (md : Int) p.Fexp]
    _ = _root_.F2R (beta:=beta)
          (⟨z, LSB (beta:=beta) radix p⟩ : FloatSpec.Core.Defs.FlocqFloat beta) := by
          simp [_root_.F2R, FloatSpec.Core.Defs.F2R, hbeta_radix, hlsb]

-- Coq: `maxDivLt` — ~Zdivides v (radix^p) → maxDiv v p < p
noncomputable def maxDivLt_check (radix : Int) (v : Int) (p : Nat) : Unit :=
  ()

/-- Coq: `maxDivLt` — if `v` does not divide `radix^p` then the maximal
exponent `maxDiv v p` is strictly less than `p`. Statement only. -/
theorem maxDivLt (radix : Int) (v : Int) (p : Nat) :
    ⦃⌜¬ Zdivides v (Zpower_nat radix p)⌝⦄
    (pure (maxDivLt_check radix v p) : Id Unit)
    ⦃⇓_ => ⌜maxDiv radix v p < p⌝⦄ := by
  intro h
  simp only [wp, PostCond.noThrow, pure, maxDivLt_check, Id.run,
    ULift.up_down]
  show maxDiv radix v p < p
  classical
  cases p with
  | zero =>
      exact False.elim (h ⟨v, by simp [Zpower_nat]⟩)
  | succ p =>
      by_cases hdiv : Zdivides v (Zpower_nat radix (Nat.succ p))
      · exact False.elim (h hdiv)
      · have hle := (maxDivLess radix v p) trivial
        simpa [maxDiv, hdiv] using Nat.lt_succ_of_le hle

-- Coq: `maxDiv_opp` — maxDiv v p = maxDiv (-v) p
noncomputable def maxDiv_opp_check (radix : Int) (v : Int) (p : Nat) : Unit :=
  ()

private lemma Zdivides_neg_iff (v m : Int) : Zdivides (-v) m ↔ Zdivides v m := by
  constructor
  · intro ⟨q, hq⟩
    refine ⟨-q, ?_⟩
    calc
      v = -(-v) := by ring
      _ = -(m * q) := by rw [hq]
      _ = m * -q := by ring
  · intro ⟨q, hq⟩
    refine ⟨-q, ?_⟩
    calc
      -v = -(m * q) := by rw [hq]
      _ = m * -q := by ring

theorem maxDiv_opp (radix : Int) (v : Int) (p : Nat) :
    ⦃⌜True⌝⦄
    (pure (maxDiv_opp_check radix v p) : Id Unit)
    ⦃⇓_ => ⌜maxDiv radix v p = maxDiv radix (-v) p⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, maxDiv_opp_check, Id.run,
    ULift.up_down]
  show maxDiv radix v p = maxDiv radix (-v) p
  classical
  induction p with
  | zero => simp [maxDiv]
  | succ p ih =>
      by_cases h : Zdivides v (Zpower_nat radix (Nat.succ p))
      · have hneg : Zdivides (-v) (Zpower_nat radix (Nat.succ p)) :=
          (Zdivides_neg_iff v (Zpower_nat radix (Nat.succ p))).2 h
        simp [maxDiv, h, hneg]
      · have hneg : ¬ Zdivides (-v) (Zpower_nat radix (Nat.succ p)) := by
          intro hn
          exact h ((Zdivides_neg_iff v (Zpower_nat radix (Nat.succ p))).1 hn)
        simp [maxDiv, h, hneg, ih]

-- Coq: `LSB_opp` — LSB x = LSB (Fopp x)
noncomputable def LSB_opp_check {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

theorem LSB_opp {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜True⌝⦄
    (pure (LSB_opp_check (beta:=beta) radix x) : Id Unit)
    ⦃⇓_ => ⌜LSB (beta:=beta) radix x = LSB (beta:=beta) radix (Fopp x)⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, LSB_opp_check, Id.run,
    ULift.up_down]
  show LSB radix x = LSB radix (Fopp x)
  cases x with
  | mk m e =>
      change Int.ofNat (maxDiv radix m (digit radix m)) + e =
        Int.ofNat (maxDiv radix (-m) (digit radix (-m))) + e
      rw [digit_neg radix m]
      have hmax := (maxDiv_opp radix m (digit radix m)) trivial
      rw [hmax]

-- Coq: `maxDiv_abs` — maxDiv v p = maxDiv (|v|) p
noncomputable def maxDiv_abs_check (radix : Int) (v : Int) (p : Nat) : Unit :=
  ()

private lemma Zdivides_abs_iff (v m : Int) : Zdivides (|v|) m ↔ Zdivides v m := by
  rcases le_or_gt 0 v with hv | hv
  · have habs : |v| = v := abs_of_nonneg hv
    simp [habs]
  · have habs : |v| = -v := abs_of_neg hv
    simp [habs, Zdivides_neg_iff]

theorem maxDiv_abs (radix : Int) (v : Int) (p : Nat) :
    ⦃⌜True⌝⦄
    (pure (maxDiv_abs_check radix v p) : Id Unit)
    ⦃⇓_ => ⌜maxDiv radix v p = maxDiv radix |v| p⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, maxDiv_abs_check, Id.run,
    ULift.up_down]
  show maxDiv radix v p = maxDiv radix |v| p
  classical
  induction p with
  | zero => simp [maxDiv]
  | succ p ih =>
      by_cases h : Zdivides v (Zpower_nat radix (Nat.succ p))
      · have habs : Zdivides (|v|) (Zpower_nat radix (Nat.succ p)) :=
          (Zdivides_abs_iff v (Zpower_nat radix (Nat.succ p))).2 h
        simp [maxDiv, h, habs]
      · have habs : ¬ Zdivides (|v|) (Zpower_nat radix (Nat.succ p)) := by
          intro ha
          exact h ((Zdivides_abs_iff v (Zpower_nat radix (Nat.succ p))).1 ha)
        simp [maxDiv, h, habs, ih]

-- Coq: `LSB_abs` — LSB x = LSB (Fabs x)
noncomputable def LSB_abs_check {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

theorem LSB_abs {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜True⌝⦄
    (pure (LSB_abs_check (beta:=beta) radix x) : Id Unit)
    ⦃⇓_ => ⌜LSB (beta:=beta) radix x = LSB (beta:=beta) radix (Fabs x)⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, LSB_abs_check, Id.run,
    ULift.up_down]
  show LSB radix x = LSB radix (Fabs x)
  cases x with
  | mk m e =>
      simp only [LSB, Fdigit, Fabs, FloatSpec.Calc.Operations.Fabs,
        FloatSpec.Core.Defs.FlocqFloat.Fnum, FloatSpec.Core.Defs.FlocqFloat.Fexp]
      change Int.ofNat (maxDiv radix m (digit radix m)) + e =
        Int.ofNat (maxDiv radix (m.natAbs : Int) (digit radix (m.natAbs : Int))) + e
      have heq_abs : (|m| : Int) = (m.natAbs : Int) := by
        rw [Int.abs_eq_natAbs]
      rw [← heq_abs]
      rw [digit_abs_eq radix m]
      have hmax := (maxDiv_abs radix m (digit radix m)) trivial
      rw [hmax]

-- Most significant bit position of a float.
noncomputable def MSB {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) : Int :=
  Int.pred (Int.ofNat (Fdigit (beta:=beta) radix x) + x.Fexp)

-- Coq: `MSB_shift` — ~is_Fzero x -> MSB x = MSB (Fshift n x)
noncomputable def MSB_shift_check {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) (n : Nat) : Unit :=
  ()

theorem MSB_shift {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) (n : Nat) :
    ⦃⌜1 < radix ∧ ¬ is_Fzero x⌝⦄
    (pure (MSB_shift_check (beta:=beta) radix x n) : Id Unit)
    ⦃⇓_ => ⌜MSB (beta:=beta) radix x = MSB (beta:=beta) radix (Fshift (beta:=beta) radix n x)⌝⦄ := by
  intro ⟨hradix, hx_nonzero⟩
  simp only [wp, PostCond.noThrow, pure, MSB_shift_check, Id.run,
    ULift.up_down]
  show MSB radix x = MSB radix (Fshift radix n x)
  unfold MSB
  have hfd :
      Fdigit (beta:=beta) radix (Fshift (beta:=beta) radix n x) =
        Fdigit (beta:=beta) radix x + n :=
    (FshiftFdigit (beta:=beta) radix n x) ⟨hradix, hx_nonzero⟩
  rw [hfd]
  simp only [Fshift, FloatSpec.Core.Defs.FlocqFloat.Fexp]
  congr 1
  have hcast :
      Int.ofNat (Fdigit (beta:=beta) radix x + n) =
        Int.ofNat (Fdigit (beta:=beta) radix x) + (n : Int) := by
    simpa using
      (Nat.cast_add (Fdigit (beta:=beta) radix x) n :
        ((Fdigit (beta:=beta) radix x + n : Nat) : Int) =
          (Fdigit (beta:=beta) radix x : Int) + (n : Int))
  rw [hcast]
  omega

-- Coq: `MSB_comp` — ~is_Fzero x → x = y :>R → MSB x = MSB y
noncomputable def MSB_comp_check {beta : Int}
    (radix : Int)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) (n : Nat) : Unit :=
  ()

theorem MSB_comp {beta : Int}
    (radix : Int)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) (n : Nat) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ ¬ is_Fzero x ∧ _root_.F2R x = _root_.F2R y⌝⦄
    (pure (MSB_comp_check (beta:=beta) radix x y n) : Id Unit)
    ⦃⇓_ => ⌜MSB (beta:=beta) radix x = MSB (beta:=beta) radix y⌝⦄ := by
  intro ⟨hbeta_radix, hradix, hx_nonzero, hxy⟩
  simp only [wp, PostCond.noThrow, pure, MSB_comp_check, Id.run,
    ULift.up_down]
  have hbeta : 1 < beta := by omega
  have hy_nonzero : ¬ is_Fzero y :=
    (NisFzeroComp (beta:=beta) x y) ⟨hbeta, hx_nonzero, hxy⟩
  rcases (FshiftCorrectSym (beta:=beta) radix x y)
      ⟨hbeta_radix, hradix, hxy⟩ with ⟨nx, ny, hshift⟩
  have hx_msb :
      MSB (beta:=beta) radix x =
        MSB (beta:=beta) radix (Fshift (beta:=beta) radix nx x) :=
    (MSB_shift (beta:=beta) radix x nx) ⟨hradix, hx_nonzero⟩
  have hy_msb :
      MSB (beta:=beta) radix y =
        MSB (beta:=beta) radix (Fshift (beta:=beta) radix ny y) :=
    (MSB_shift (beta:=beta) radix y ny) ⟨hradix, hy_nonzero⟩
  rw [hx_msb, hshift, ← hy_msb]
  rfl

