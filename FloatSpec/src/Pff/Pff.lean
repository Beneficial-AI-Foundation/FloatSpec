/-- Coq: `ClosestMin` — if `min` is the greatest bounded float below `r`,
    `max` is the least bounded float above `r`, and the midpoint leans toward
    `min`, then `min` is a closest bounded float to `r`. -/
theorem ClosestMin {beta : Int}
    (bo : Fbound_skel) (radixZ : Int) (radixR : ℝ)
    (r : ℝ)
    (min max : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜isMin' (beta:=beta) bo radixZ r min ∧
        isMax' (beta:=beta) bo radixZ r max ∧
        2 * r ≤ _root_.F2R (beta:=beta) min + _root_.F2R (beta:=beta) max⌝⦄
    (pure (ClosestMin_check (beta:=beta) bo radixR r min max) : Id Unit)
    ⦃⇓_ => ⌜Closest (beta:=beta) bo radixR r min⌝⦄ := by
  intro h
  rcases h with ⟨hmin, hmax, hmid⟩
  rcases hmin with ⟨hminBounded, hmin_le, hminGreatest⟩
  rcases hmax with ⟨_hmaxBounded, _hr_le_max, hmaxLeast⟩
  simp only [wp, PostCond.noThrow, pure, ClosestMin_check, Id.run, ULift.up_down]
  constructor
  · exact hminBounded
  · intro f hfBounded
    by_cases hf_le : _root_.F2R (beta:=beta) f ≤ r
    · have hf_min : _root_.F2R (beta:=beta) f ≤ _root_.F2R (beta:=beta) min :=
        hminGreatest f hfBounded hf_le
      have hmin_sub_nonpos : _root_.F2R (beta:=beta) min - r ≤ 0 := by
        linarith
      have hf_sub_nonpos : _root_.F2R (beta:=beta) f - r ≤ 0 := by
        linarith
      rw [abs_of_nonpos hmin_sub_nonpos, abs_of_nonpos hf_sub_nonpos]
      linarith
    · have hr_le_f : r ≤ _root_.F2R (beta:=beta) f := le_of_lt (lt_of_not_ge hf_le)
      have hmax_f : _root_.F2R (beta:=beta) max ≤ _root_.F2R (beta:=beta) f :=
        hmaxLeast f hfBounded hr_le_f
      have hmin_sub_nonpos : _root_.F2R (beta:=beta) min - r ≤ 0 := by
        linarith
      have hf_sub_nonneg : 0 ≤ _root_.F2R (beta:=beta) f - r := by
        linarith
      rw [abs_of_nonpos hmin_sub_nonpos, abs_of_nonneg hf_sub_nonneg]
      linarith

-- Maximal conditions imply `Closest r max` (Coq: `ClosestMax`)
noncomputable def ClosestMax_check {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (r : ℝ)
    (min max : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `ClosestMax` — if `min` is the greatest bounded float below `r`,
    `max` is the least bounded float above `r`, and the midpoint leans toward
    `max`, then `max` is a closest bounded float to `r`. -/
theorem ClosestMax {beta : Int}
    (bo : Fbound_skel) (radixZ : Int) (radixR : ℝ)
    (r : ℝ)
    (min max : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜isMin' (beta:=beta) bo radixZ r min ∧
        isMax' (beta:=beta) bo radixZ r max ∧
        _root_.F2R (beta:=beta) min + _root_.F2R (beta:=beta) max ≤ 2 * r⌝⦄
    (pure (ClosestMax_check (beta:=beta) bo radixR r min max) : Id Unit)
    ⦃⇓_ => ⌜Closest (beta:=beta) bo radixR r max⌝⦄ := by
  intro h
  rcases h with ⟨hmin, hmax, hmid⟩
  rcases hmin with ⟨_hminBounded, _hmin_le, hminGreatest⟩
  rcases hmax with ⟨hmaxBounded, hr_le_max, hmaxLeast⟩
  simp only [wp, PostCond.noThrow, pure, ClosestMax_check, Id.run, ULift.up_down]
  constructor
  · exact hmaxBounded
  · intro f hfBounded
    by_cases hr_le_f : r ≤ _root_.F2R (beta:=beta) f
    · have hmax_f : _root_.F2R (beta:=beta) max ≤ _root_.F2R (beta:=beta) f :=
        hmaxLeast f hfBounded hr_le_f
      have hmax_sub_nonneg : 0 ≤ _root_.F2R (beta:=beta) max - r := by
        linarith
      have hf_sub_nonneg : 0 ≤ _root_.F2R (beta:=beta) f - r := by
        linarith
      rw [abs_of_nonneg hmax_sub_nonneg, abs_of_nonneg hf_sub_nonneg]
      linarith
    · have hf_le_r : _root_.F2R (beta:=beta) f ≤ r := le_of_lt (lt_of_not_ge hr_le_f)
      have hf_min : _root_.F2R (beta:=beta) f ≤ _root_.F2R (beta:=beta) min :=
        hminGreatest f hfBounded hf_le_r
      have hmax_sub_nonneg : 0 ≤ _root_.F2R (beta:=beta) max - r := by
        linarith
      have hf_sub_nonpos : _root_.F2R (beta:=beta) f - r ≤ 0 := by
        linarith
      rw [abs_of_nonneg hmax_sub_nonneg, abs_of_nonpos hf_sub_nonpos]
      linarith

/-- Coq: `RND_Closest_correct`.

The nearest result is closest because the selected branch is either the
restored lower or upper extremal rounded value. -/
theorem RND_Closest_correct {beta : Int}
    (b : Fbound_skel) (radix : Int) (p : Int)
    (choice : Int → Bool) (r : ℝ) :
    ⦃⌜isMin' (beta:=beta) b radix r
          (RND_Min (beta:=beta) b radix p r) ∧
        isMax' (beta:=beta) b radix r
          (RND_Max (beta:=beta) b radix p r)⌝⦄
    (pure (RND_Closest_correct_check (beta:=beta) b radix p choice r) : Id Unit)
    ⦃⇓_ => ⌜Closest (beta:=beta) b (radix : ℝ) r
        (RND_Closest (beta:=beta) b radix p choice r)⌝⦄ := by
  intro h
  rcases h with ⟨hMin, hMax⟩
  simp only [wp, PostCond.noThrow, pure, RND_Closest_correct_check,
    Id.run, ULift.up_down]
  let rd := RND_Min (beta:=beta) b radix p r
  let ru := RND_Max (beta:=beta) b radix p r
  have hrd_le : _root_.F2R (beta:=beta) rd ≤ r := hMin.2.1
  have hle_ru : r ≤ _root_.F2R (beta:=beta) ru := hMax.2.1
  have hrd_nonpos : _root_.F2R (beta:=beta) rd - r ≤ 0 := by
    dsimp [rd] at hrd_le ⊢
    linarith
  have hru_nonneg : 0 ≤ _root_.F2R (beta:=beta) ru - r := by
    dsimp [ru] at hle_ru ⊢
    linarith
  have hClosestMin := ClosestMin (beta:=beta) b radix (radix : ℝ) r rd ru
  have hClosestMax := ClosestMax (beta:=beta) b radix (radix : ℝ) r rd ru
  have closest_min
      (hmid : 2 * r ≤ _root_.F2R (beta:=beta) rd + _root_.F2R (beta:=beta) ru) :
      Closest (beta:=beta) b (radix : ℝ) r rd := by
    simpa only [wp, PostCond.noThrow, pure, ClosestMin_check,
      Id.run, ULift.up_down, rd, ru] using hClosestMin ⟨hMin, hMax, hmid⟩
  have closest_max
      (hmid : _root_.F2R (beta:=beta) rd + _root_.F2R (beta:=beta) ru ≤ 2 * r) :
      Closest (beta:=beta) b (radix : ℝ) r ru := by
    simpa only [wp, PostCond.noThrow, pure, ClosestMax_check,
      Id.run, ULift.up_down, rd, ru] using hClosestMax ⟨hMin, hMax, hmid⟩
  unfold RND_Closest
  dsimp only [rd, ru]
  by_cases hle :
      |_root_.F2R (beta:=beta) ru - r| ≤
        |_root_.F2R (beta:=beta) rd - r|
  · simp [rd, ru, hle]
    by_cases hlt :
        |_root_.F2R (beta:=beta) ru - r| <
          |_root_.F2R (beta:=beta) rd - r|
    · have hmid : _root_.F2R (beta:=beta) rd + _root_.F2R (beta:=beta) ru ≤
          2 * r := by
        rw [abs_of_nonneg hru_nonneg, abs_of_nonpos hrd_nonpos] at hlt
        linarith
      simpa [rd, ru, hle, hlt] using closest_max hmid
    · simp [rd, ru, hle, hlt]
      have hdist_eq :
          |_root_.F2R (beta:=beta) ru - r| =
            |_root_.F2R (beta:=beta) rd - r| :=
        le_antisymm hle (le_of_not_gt hlt)
      have hmid_min :
          2 * r ≤ _root_.F2R (beta:=beta) rd + _root_.F2R (beta:=beta) ru := by
        rw [abs_of_nonneg hru_nonneg, abs_of_nonpos hrd_nonpos] at hdist_eq
        linarith
      have hmid_max :
          _root_.F2R (beta:=beta) rd + _root_.F2R (beta:=beta) ru ≤ 2 * r := by
        rw [abs_of_nonneg hru_nonneg, abs_of_nonpos hrd_nonpos] at hdist_eq
        linarith
      by_cases hchoice : choice (FloatSpec.Core.Raux.Zfloor
          (FloatSpec.Core.Generic_fmt.scaled_mantissa beta
            (FLT_exp (-b.dExp) p) r))
      · simpa [rd, ru, hle, hlt, hchoice] using closest_max hmid_max
      · simpa [rd, ru, hle, hlt, hchoice] using closest_min hmid_min
  · simp [rd, ru, hle]
    have hlt_abs :
        |_root_.F2R (beta:=beta) rd - r| <
          |_root_.F2R (beta:=beta) ru - r| :=
      lt_of_not_ge hle
    have hmid : 2 * r ≤ _root_.F2R (beta:=beta) rd +
        _root_.F2R (beta:=beta) ru := by
      rw [abs_of_nonpos hrd_nonpos, abs_of_nonneg hru_nonneg] at hlt_abs
      linarith
    simpa [rd, ru, hle] using closest_min hmid

-- Existence of a closest representation (Coq: `ClosestTotal`)
noncomputable def ClosestTotal_check {beta : Int}
    (bo : Fbound_skel) (radix : ℝ) (r : ℝ) : Unit :=
  ()

/-- Coq: `ClosestTotal`.

Upstream proves closest-point existence from `MinEx` and `MaxEx`, then chooses
the side with the smaller distance to `r`.  The current Lean theorem keeps
those two existence constructions explicit because the corresponding finite
bounded-float enumeration theorems are defined later in this file. -/
theorem ClosestTotal {beta : Int}
    (bo : Fbound_skel) (radixZ : Int) (radixR : ℝ) (r : ℝ) :
    ⦃⌜TotalP (isMin' (beta:=beta) bo radixZ) ∧
        TotalP (isMax' (beta:=beta) bo radixZ)⌝⦄
    (pure (ClosestTotal_check (beta:=beta) bo radixR r) : Id Unit)
    ⦃⇓_ => ⌜∃ p : FloatSpec.Core.Defs.FlocqFloat beta,
      Closest (beta:=beta) bo radixR r p⌝⦄ := by
  intro h
  rcases h with ⟨hMinTotal, hMaxTotal⟩
  simp only [wp, PostCond.noThrow, pure, ClosestTotal_check,
    Id.run, ULift.up_down]
  obtain ⟨min, hmin⟩ := hMinTotal r
  obtain ⟨max, hmax⟩ := hMaxTotal r
  rcases hmin with ⟨hminBounded, hminLe, hminGreatest⟩
  rcases hmax with ⟨hmaxBounded, hmaxGe, hmaxLeast⟩
  by_cases hdist :
      |_root_.F2R (beta:=beta) min - r| ≤
        |_root_.F2R (beta:=beta) max - r|
  · refine ⟨min, ?_⟩
    have hminNonpos : _root_.F2R (beta:=beta) min - r ≤ 0 := by
      linarith
    have hmaxNonneg : 0 ≤ _root_.F2R (beta:=beta) max - r := by
      linarith
    have hmid :
        2 * r ≤ _root_.F2R (beta:=beta) min +
          _root_.F2R (beta:=beta) max := by
      rw [abs_of_nonpos hminNonpos, abs_of_nonneg hmaxNonneg] at hdist
      linarith
    have hClosestMin := ClosestMin (beta:=beta) bo radixZ radixR r min max
    simpa [wp, PostCond.noThrow, pure, ClosestMin_check, Id.run, ULift.up_down] using
      hClosestMin ⟨⟨hminBounded, hminLe, hminGreatest⟩,
        ⟨hmaxBounded, hmaxGe, hmaxLeast⟩, hmid⟩
  · push Not at hdist
    refine ⟨max, ?_⟩
    have hminNonpos : _root_.F2R (beta:=beta) min - r ≤ 0 := by
      linarith
    have hmaxNonneg : 0 ≤ _root_.F2R (beta:=beta) max - r := by
      linarith
    have hmid :
        _root_.F2R (beta:=beta) min +
          _root_.F2R (beta:=beta) max ≤ 2 * r := by
      rw [abs_of_nonpos hminNonpos, abs_of_nonneg hmaxNonneg] at hdist
      linarith
    have hClosestMax := ClosestMax (beta:=beta) bo radixZ radixR r min max
    simpa [wp, PostCond.noThrow, pure, ClosestMax_check, Id.run, ULift.up_down] using
      hClosestMax ⟨⟨hminBounded, hminLe, hminGreatest⟩,
        ⟨hmaxBounded, hmaxGe, hmaxLeast⟩, hmid⟩

-- Disjunction: any candidate is either a min or a max (Coq: `ClosestMinOrMax`)
noncomputable def ClosestMinOrMax_check {beta : Int}
    (bo : Fbound_skel) (radix : ℝ) : Unit :=
  ()

/-- Coq: `ClosestMinOrMax` — every closest rounded float is either the
    greatest bounded float below `r` or the least bounded float above `r`. -/
theorem ClosestMinOrMax {beta : Int}
    (bo : Fbound_skel) (radixZ : Int) (radixR : ℝ) :
    ⦃⌜True⌝⦄
    (pure (ClosestMinOrMax_check (beta:=beta) bo radixR) : Id Unit)
    ⦃⇓_ => ⌜MinOrMaxP_float (beta:=beta) bo radixZ
      (Closest (beta:=beta) bo radixR)⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, ClosestMinOrMax_check, Id.run, ULift.up_down]
  intro r p hp
  rcases hp with ⟨hpBounded, hpClosest⟩
  by_cases hp_le : _root_.F2R (beta:=beta) p ≤ r
  · left
    refine ⟨hpBounded, hp_le, ?_⟩
    intro f hfBounded hf_le
    have hdist := hpClosest f hfBounded
    have hp_nonpos : _root_.F2R (beta:=beta) p - r ≤ 0 := by linarith
    have hf_nonpos : _root_.F2R (beta:=beta) f - r ≤ 0 := by linarith
    rw [abs_of_nonpos hp_nonpos, abs_of_nonpos hf_nonpos] at hdist
    linarith
  · right
    have hr_le_p : r ≤ _root_.F2R (beta:=beta) p := le_of_lt (lt_of_not_ge hp_le)
    refine ⟨hpBounded, hr_le_p, ?_⟩
    intro f hfBounded hr_le_f
    have hdist := hpClosest f hfBounded
    have hp_nonneg : 0 ≤ _root_.F2R (beta:=beta) p - r := by linarith
    have hf_nonneg : 0 ≤ _root_.F2R (beta:=beta) f - r := by linarith
    rw [abs_of_nonneg hp_nonneg, abs_of_nonneg hf_nonneg] at hdist
    linarith

-- Zero case for Closest rounding (Coq: `ClosestZero`)
noncomputable def ClosestZero_check {beta : Int}
    (bo : Fbound_skel) (radix : ℝ) (r : ℝ)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `ClosestZero` — if `x` is a closest rounding of `r` and `r = 0`,
    then the real value of `x` is `0`. We phrase this using the project
    `Closest` predicate and `F2R` interpretation.

    Note: `Closest` is now concrete; this port still carries explicit
    hypotheses exposing the Coq proof obligations:
    - `Fbounded' bo x`: the float is bounded
    - `hClosestProp`: `x` minimizes distance to `r` among bounded floats
    These make the theorem provable and match the original Coq semantics. -/
theorem ClosestZero {beta : Int}
    (bo : Fbound_skel) (radix : ℝ) (r : ℝ)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜Closest (beta:=beta) bo radix r x ∧ r = 0 ∧
        Fbounded' bo x ∧
        (∀ g : FloatSpec.Core.Defs.FlocqFloat beta, Fbounded' bo g → |_root_.F2R x - r| ≤ |_root_.F2R g - r|)⌝⦄
    (pure (ClosestZero_check (beta:=beta) bo radix r x) : Id Unit)
    ⦃⇓_ => ⌜_root_.F2R x = 0⌝⦄ := by
  intro ⟨_hClosest, hr0, hBounded, hMin⟩
  simp only [wp, PostCond.noThrow, pure, ClosestZero_check]
  subst hr0
  simp only [sub_zero] at hMin
  -- We need to show F2R x = 0
  -- Strategy: the zero float ⟨0, -bo.dExp⟩ is bounded (if bo.vNum > 0)
  -- and F2R ⟨0, -bo.dExp⟩ = 0, so |F2R x| ≤ 0, hence F2R x = 0
  by_cases hvNum : 0 < bo.vNum
  · -- Case: bo.vNum > 0, so the zero float is bounded
    let zeroFloat : FloatSpec.Core.Defs.FlocqFloat beta := ⟨0, -bo.dExp⟩
    have hZeroBounded : Fbounded' (beta:=beta) bo zeroFloat := by
      constructor
      · show |zeroFloat.Fnum| < bo.vNum
        simp only [zeroFloat, abs_zero]
        exact hvNum
      · rfl
    have hZeroF2R : _root_.F2R zeroFloat = 0 := by
      unfold _root_.F2R FloatSpec.Core.Defs.F2R zeroFloat
      ring
    specialize hMin zeroFloat hZeroBounded
    rw [hZeroF2R, abs_zero] at hMin
    exact abs_eq_zero.mp (le_antisymm hMin (abs_nonneg _))
  · -- Case: bo.vNum ≤ 0, so no float is bounded (Fbounded' is vacuously false)
    -- But we have Fbounded' bo x from hClosest, contradiction
    push Not at hvNum
    obtain ⟨hNumBound, _⟩ := hBounded
    have : |x.Fnum| ≥ 0 := abs_nonneg _
    omega

-- Coq: `ClosestZero2` — a closest rounding of zero has real value zero.
noncomputable def ClosestZero2_check {beta : Int}
    (bo : Fbound_skel) (radix : ℝ) (r : ℝ)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `ClosestZero2`.

If `x` is a closest rounded float for `r`, and `r = 0`, then `F2R x = 0`.
This exact-name wrapper exposes the upstream theorem name while reusing the
already restored local `ClosestZero` payload. -/
theorem ClosestZero2 {beta : Int}
    (bo : Fbound_skel) (radix : ℝ) (r : ℝ)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜Closest (beta:=beta) bo radix r x ∧ r = 0⌝⦄
    (pure (ClosestZero2_check (beta:=beta) bo radix r x) : Id Unit)
    ⦃⇓_ => ⌜_root_.F2R x = 0⌝⦄ := by
  intro h
  rcases h with ⟨hClosest, hr0⟩
  have hBounded : Fbounded' (beta:=beta) bo x := by
    simpa [Fbounded'] using hClosest.1
  have hMin :
      ∀ g : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded' (beta:=beta) bo g →
          |_root_.F2R x - r| ≤ |_root_.F2R g - r| := by
    intro g hg
    exact hClosest.2 g (by simpa [Fbounded'] using hg)
  have hzero := ClosestZero (beta:=beta) bo radix r x
  simpa only [wp, PostCond.noThrow, pure, ClosestZero2_check, Id.run,
    ULift.up_down] using hzero ⟨hClosest, hr0, hBounded, hMin⟩

-- ---------------------------------------------------------------------------
-- Min/Max existence over finite lists (from Coq Pff.v)

/-
Coq: `FboundedMboundPos`

Construct a bounded float whose real value equals `m * radix^z` when the
mantissa/exponent bounds hold. The real radix is obtained from the integer
radix via coercion so that `powerRZ` can be reused verbatim.
-/
noncomputable def FboundedMboundPos_check {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (z m : Int) : Unit :=
  ()

/-- Coq: `FboundedMboundPos`.

The original theorem lives under the Pff section assumptions connecting the
float radix to `radix` and `b.vNum` to `Zpower_nat radix precision`; those
assumptions are explicit here. -/
theorem FboundedMboundPos {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (precision : Nat)
    (z m : Int) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ 0 < precision ∧
        b.vNum = Zpower_nat radix precision ∧
        0 ≤ m ∧ m ≤ Zpower_nat radix precision ∧
        -b.dExp ≤ z⌝⦄
    (pure (FboundedMboundPos_check (beta:=beta) b radix z m) : Id Unit)
    ⦃⇓_ => ⌜∃ c : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) b c ∧
        _root_.F2R (beta:=beta) c =
          (m : ℝ) * (radix : ℝ) ^ z⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix_gt, hprec_pos, hvNum, hm_nonneg, hm_le, hz⟩
  simp only [wp, PostCond.noThrow, pure, FboundedMboundPos_check, Id.run,
    ULift.up_down]
  have hradix_pos_int : (0 : Int) < radix := lt_trans (by decide) hradix_gt
  have hradix_pos : (0 : ℝ) < (radix : ℝ) := by exact_mod_cast hradix_pos_int
  have hradix_ne : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos
  have hbound_nonneg : 0 ≤ Zpower_nat radix precision := by
    unfold Zpower_nat
    exact pow_nonneg (le_of_lt hradix_pos_int) precision
  rcases lt_or_eq_of_le hm_le with hm_lt | hm_eq
  · refine ⟨⟨m, z⟩, ?_, ?_⟩
    · constructor
      · have habs : |m| = m := abs_of_nonneg hm_nonneg
        simpa [Fbounded, hvNum, habs] using hm_lt
      · exact hz
    · subst beta
      simp [_root_.F2R, FloatSpec.Core.Defs.F2R]
  · let mant : Int := radix ^ (precision - 1)
    refine ⟨⟨mant, z + 1⟩, ?_, ?_⟩
    · constructor
      · have hmant_pos : 0 < mant := by
          dsimp [mant]
          exact pow_pos hradix_pos_int (precision - 1)
        have hsucc : Nat.succ (precision - 1) = precision := by
          omega
        have hbound_eq : Zpower_nat radix precision = mant * radix := by
          dsimp [mant]
          unfold Zpower_nat
          calc
            radix ^ precision = radix ^ Nat.succ (precision - 1) := by rw [hsucc]
            _ = radix ^ (precision - 1) * radix := by rw [pow_succ]
        have hmant_lt : mant < Zpower_nat radix precision := by
          rw [hbound_eq]
          nlinarith
        have habs : |mant| = mant := abs_of_nonneg (le_of_lt hmant_pos)
        simpa [Fbounded, hvNum, habs] using hmant_lt
      · change -b.dExp ≤ z + 1
        omega
    · subst beta
      have hsucc : Nat.succ (precision - 1) = precision := by
        omega
      have hpow_real :
          ((Zpower_nat radix precision : Int) : ℝ) =
            (mant : ℝ) * (radix : ℝ) := by
        dsimp [mant]
        unfold Zpower_nat
        calc
          ((radix ^ precision : Int) : ℝ) =
              ((radix ^ Nat.succ (precision - 1) : Int) : ℝ) := by rw [hsucc]
          _ = ((radix ^ (precision - 1) * radix : Int) : ℝ) := by rw [pow_succ]
          _ = ((radix ^ (precision - 1) : Int) : ℝ) * (radix : ℝ) := by
                rw [Int.cast_mul, Int.cast_pow]
      calc
        _root_.F2R (beta:=radix) (FloatSpec.Core.Defs.FlocqFloat.mk mant (z + 1)) =
            (mant : ℝ) * (radix : ℝ) ^ (z + 1) := by
              simp [_root_.F2R, FloatSpec.Core.Defs.F2R]
        _ = (mant : ℝ) * ((radix : ℝ) ^ z * (radix : ℝ)) := by
              rw [zpow_add₀ hradix_ne, zpow_one]
        _ = ((Zpower_nat radix precision : Int) : ℝ) * (radix : ℝ) ^ z := by
              rw [hpow_real]
              ring
        _ = (m : ℝ) * (radix : ℝ) ^ z := by
              rw [hm_eq]

/-- Coq: `FboundedMbound` — extends `FboundedMboundPos` by allowing
negative mantissas via symmetry. -/
noncomputable def FboundedMbound_check {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (z m : Int) : Unit :=
  ()

/-- Coq: `FboundedMbound` — construct a bounded float for any signed
    mantissa whose absolute value is within the precision bound. -/
theorem FboundedMbound {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (precision : Nat)
    (z m : Int) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ 0 < precision ∧
        b.vNum = Zpower_nat radix precision ∧
        |m| ≤ Zpower_nat radix precision ∧
        -b.dExp ≤ z⌝⦄
    (pure (FboundedMbound_check (beta:=beta) b radix z m) : Id Unit)
    ⦃⇓_ => ⌜∃ c : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) b c ∧
        _root_.F2R (beta:=beta) c =
          (m : ℝ) * (radix : ℝ) ^ z⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix_gt, hprec_pos, hvNum, hm_abs_le, hz⟩
  simp only [wp, PostCond.noThrow, pure, FboundedMbound_check, Id.run,
    ULift.up_down]
  by_cases hm_nonneg : 0 ≤ m
  · have hm_abs : |m| = m := abs_of_nonneg hm_nonneg
    have hpos := FboundedMboundPos (beta:=beta) b radix precision z m
    have hres := hpos ⟨hbeta, hradix_gt, hprec_pos, hvNum, hm_nonneg, by
      simpa [hm_abs] using hm_abs_le, hz⟩
    simpa [wp, PostCond.noThrow, pure, FboundedMboundPos_check] using hres
  · have hm_neg : m < 0 := lt_of_not_ge hm_nonneg
    have hm_abs : |m| = -m := abs_of_neg hm_neg
    have hm_pos_nonneg : 0 ≤ -m := by omega
    have hm_pos_le : -m ≤ Zpower_nat radix precision := by
      simpa [hm_abs] using hm_abs_le
    have hpos := FboundedMboundPos (beta:=beta) b radix precision z (-m)
    have hres := hpos ⟨hbeta, hradix_gt, hprec_pos, hvNum, hm_pos_nonneg, hm_pos_le, hz⟩
    rcases hres with ⟨c, hcBounded, hcVal⟩
    refine ⟨Fopp (beta:=beta) c, ?_, ?_⟩
    · simpa [Fbounded, Fopp, FloatSpec.Calc.Operations.Fopp, abs_neg] using hcBounded
    · have hFopp :
          _root_.F2R (beta:=beta) (Fopp (beta:=beta) c) =
            - _root_.F2R (beta:=beta) c := by
        simp [_root_.F2R, FloatSpec.Core.Defs.F2R, Fopp,
          FloatSpec.Calc.Operations.Fopp, neg_mul]
      calc
        _root_.F2R (beta:=beta) (Fopp (beta:=beta) c) =
            - _root_.F2R (beta:=beta) c := hFopp
        _ = - ((-m : Int) : ℝ) * (radix : ℝ) ^ z := by
              rw [hcVal]
              ring
        _ = (m : ℝ) * (radix : ℝ) ^ z := by
              norm_num

noncomputable def FboundedMbound2Pos_check {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (z m : Int) : Unit :=
  ()

/-- Coq: `FboundedMbound2Pos`.

Positive mantissas up to the precision bound have a bounded float
representative whose exponent is no smaller than the requested exponent. -/
theorem FboundedMbound2Pos {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (precision : Nat)
    (z m : Int) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ 0 < precision ∧
        b.vNum = Zpower_nat radix precision ∧
        0 ≤ m ∧ m ≤ Zpower_nat radix precision ∧
        -b.dExp ≤ z⌝⦄
    (pure (FboundedMbound2Pos_check (beta:=beta) b radix z m) : Id Unit)
    ⦃⇓_ => ⌜∃ c : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) b c ∧
        _root_.F2R (beta:=beta) c =
          (m : ℝ) * (radix : ℝ) ^ z ∧
        z ≤ c.Fexp⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix_gt, hprec_pos, hvNum, hm_nonneg, hm_le, hz⟩
  simp only [wp, PostCond.noThrow, pure, FboundedMbound2Pos_check, Id.run,
    ULift.up_down]
  have hradix_pos_int : (0 : Int) < radix := lt_trans (by decide) hradix_gt
  have hradix_pos : (0 : ℝ) < (radix : ℝ) := by exact_mod_cast hradix_pos_int
  have hradix_ne : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos
  rcases lt_or_eq_of_le hm_le with hm_lt | hm_eq
  · refine ⟨⟨m, z⟩, ?_, ?_, le_rfl⟩
    · constructor
      · have habs : |m| = m := abs_of_nonneg hm_nonneg
        simpa [Fbounded, hvNum, habs] using hm_lt
      · exact hz
    · subst beta
      simp [_root_.F2R, FloatSpec.Core.Defs.F2R]
  · let mant : Int := radix ^ (precision - 1)
    refine ⟨⟨mant, z + 1⟩, ?_, ?_, ?_⟩
    · constructor
      · have hmant_pos : 0 < mant := by
          dsimp [mant]
          exact pow_pos hradix_pos_int (precision - 1)
        have hsucc : Nat.succ (precision - 1) = precision := by
          omega
        have hbound_eq : Zpower_nat radix precision = mant * radix := by
          dsimp [mant]
          unfold Zpower_nat
          calc
            radix ^ precision = radix ^ Nat.succ (precision - 1) := by rw [hsucc]
            _ = radix ^ (precision - 1) * radix := by rw [pow_succ]
        have hmant_lt : mant < Zpower_nat radix precision := by
          rw [hbound_eq]
          nlinarith
        have habs : |mant| = mant := abs_of_nonneg (le_of_lt hmant_pos)
        simpa [Fbounded, hvNum, habs] using hmant_lt
      · change -b.dExp ≤ z + 1
        omega
    · subst beta
      have hsucc : Nat.succ (precision - 1) = precision := by
        omega
      have hpow_real :
          ((Zpower_nat radix precision : Int) : ℝ) =
            (mant : ℝ) * (radix : ℝ) := by
        dsimp [mant]
        unfold Zpower_nat
        calc
          ((radix ^ precision : Int) : ℝ) =
              ((radix ^ Nat.succ (precision - 1) : Int) : ℝ) := by rw [hsucc]
          _ = ((radix ^ (precision - 1) * radix : Int) : ℝ) := by rw [pow_succ]
          _ = ((radix ^ (precision - 1) : Int) : ℝ) * (radix : ℝ) := by
                rw [Int.cast_mul, Int.cast_pow]
      calc
        _root_.F2R (beta:=radix) (FloatSpec.Core.Defs.FlocqFloat.mk mant (z + 1)) =
            (mant : ℝ) * (radix : ℝ) ^ (z + 1) := by
              simp [_root_.F2R, FloatSpec.Core.Defs.F2R]
        _ = (mant : ℝ) * ((radix : ℝ) ^ z * (radix : ℝ)) := by
              rw [zpow_add₀ hradix_ne, zpow_one]
        _ = ((Zpower_nat radix precision : Int) : ℝ) * (radix : ℝ) ^ z := by
              rw [hpow_real]
              ring
        _ = (m : ℝ) * (radix : ℝ) ^ z := by
              rw [hm_eq]
    · change z ≤ z + 1
      omega

noncomputable def FboundedMbound2_check {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (z m : Int) : Unit :=
  ()

/-- Coq: `FboundedMbound2`.

Signed version of `FboundedMbound2Pos`, reducing negative mantissas by
opposition. -/
theorem FboundedMbound2 {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (precision : Nat)
    (z m : Int) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ 0 < precision ∧
        b.vNum = Zpower_nat radix precision ∧
        |m| ≤ Zpower_nat radix precision ∧
        -b.dExp ≤ z⌝⦄
    (pure (FboundedMbound2_check (beta:=beta) b radix z m) : Id Unit)
    ⦃⇓_ => ⌜∃ c : FloatSpec.Core.Defs.FlocqFloat beta,
        Fbounded (beta:=beta) b c ∧
        _root_.F2R (beta:=beta) c =
          (m : ℝ) * (radix : ℝ) ^ z ∧
        z ≤ c.Fexp⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix_gt, hprec_pos, hvNum, hm_abs_le, hz⟩
  simp only [wp, PostCond.noThrow, pure, FboundedMbound2_check, Id.run,
    ULift.up_down]
  by_cases hm_nonneg : 0 ≤ m
  · have hm_abs : |m| = m := abs_of_nonneg hm_nonneg
    have hpos := FboundedMbound2Pos (beta:=beta) b radix precision z m
    simpa only [wp, PostCond.noThrow, pure, FboundedMbound2Pos_check, Id.run,
      ULift.up_down] using
      hpos ⟨hbeta, hradix_gt, hprec_pos, hvNum, hm_nonneg,
        by simpa [hm_abs] using hm_abs_le, hz⟩
  · have hm_neg : m < 0 := lt_of_not_ge hm_nonneg
    have hm_abs : |m| = -m := abs_of_neg hm_neg
    have hm_pos_nonneg : 0 ≤ -m := by omega
    have hm_pos_le : -m ≤ Zpower_nat radix precision := by
      simpa [hm_abs] using hm_abs_le
    have hpos := FboundedMbound2Pos (beta:=beta) b radix precision z (-m)
    rcases (by
      simpa only [wp, PostCond.noThrow, pure, FboundedMbound2Pos_check, Id.run,
        ULift.up_down] using
        hpos ⟨hbeta, hradix_gt, hprec_pos, hvNum, hm_pos_nonneg, hm_pos_le, hz⟩) with
      ⟨c, hcBounded, hcVal, hcExp⟩
    refine ⟨Fopp (beta:=beta) c, ?_, ?_, ?_⟩
    · simpa [Fbounded, Fopp, FloatSpec.Calc.Operations.Fopp, abs_neg] using hcBounded
    · have hFopp :
          _root_.F2R (beta:=beta) (Fopp (beta:=beta) c) =
            - _root_.F2R (beta:=beta) c := by
        simp [_root_.F2R, FloatSpec.Core.Defs.F2R, Fopp,
          FloatSpec.Calc.Operations.Fopp, neg_mul]
      calc
        _root_.F2R (beta:=beta) (Fopp (beta:=beta) c) =
            - _root_.F2R (beta:=beta) c := hFopp
        _ = - ((-m : Int) : ℝ) * (radix : ℝ) ^ z := by
              rw [hcVal]
              ring
        _ = (m : ℝ) * (radix : ℝ) ^ z := by
              norm_num
    · simpa [Fopp, FloatSpec.Calc.Operations.Fopp] using hcExp

/-!
Coq: `MinExList`

For any real `r` and finite list `L` of floats, either every element of `L`
has value strictly greater than `r`, or there exists an element `min ∈ L`
such that `F2R min ≤ r` and it is minimal among those at most `r`.
-/

/-- Helper: the pure mathematical content of `MinExList`, proved by induction on the list. -/
private lemma minExList_aux {beta : Int}
    (r : ℝ) (L : List (FloatSpec.Core.Defs.FlocqFloat beta)) :
    (∀ f, f ∈ L → r < _root_.F2R f) ∨
    (∃ min, min ∈ L ∧ _root_.F2R min ≤ r ∧
      ∀ f, f ∈ L → _root_.F2R f ≤ r → _root_.F2R f ≤ _root_.F2R min) := by
  induction L with
  | nil => left; intro f hf; exact absurd hf (List.not_mem_nil)
  | cons hd tl ih =>
    by_cases h : _root_.F2R hd ≤ r
    · right
      rcases ih with hall | ⟨min, hmin_mem, hmin_le, hmin_max⟩
      · exact ⟨hd, List.mem_cons_self, h, fun f hf hfr => by
          rcases List.mem_cons.mp hf with heq | hmem
          · exact heq ▸ le_refl _
          · exact absurd hfr (not_le.mpr (hall f hmem))⟩
      · by_cases hcmp : _root_.F2R hd ≤ _root_.F2R min
        · exact ⟨min, List.mem_cons_of_mem _ hmin_mem, hmin_le, fun f hf hfr => by
            rcases List.mem_cons.mp hf with heq | hmem
            · exact heq ▸ hcmp
            · exact hmin_max f hmem hfr⟩
        · push Not at hcmp
          exact ⟨hd, List.mem_cons_self, h, fun f hf hfr => by
            rcases List.mem_cons.mp hf with heq | hmem
            · exact heq ▸ le_refl _
            · exact le_trans (hmin_max f hmem hfr) (le_of_lt hcmp)⟩
    · push Not at h
      rcases ih with hall | ⟨min, hmin_mem, hmin_le, hmin_max⟩
      · left
        intro f hf
        rcases List.mem_cons.mp hf with heq | hmem
        · exact heq ▸ h
        · exact hall f hmem
      · right
        exact ⟨min, List.mem_cons_of_mem _ hmin_mem, hmin_le, fun f hf hfr => by
          rcases List.mem_cons.mp hf with heq | hmem
          · exact absurd hfr (not_le.mpr (heq ▸ h))
          · exact hmin_max f hmem hfr⟩

noncomputable def MinExList_check {beta : Int}
    (r : ℝ) (L : List (FloatSpec.Core.Defs.FlocqFloat beta)) : Unit :=
  ()

theorem MinExList {beta : Int}
    (r : ℝ) (L : List (FloatSpec.Core.Defs.FlocqFloat beta)) :
    ⦃⌜True⌝⦄
    (pure (MinExList_check (beta:=beta) r L) : Id Unit)
    ⦃⇓_ => ⌜(∀ f, f ∈ L → r < _root_.F2R f) ∨
            (∃ min, min ∈ L ∧ _root_.F2R min ≤ r ∧
              ∀ f, f ∈ L → _root_.F2R f ≤ r → _root_.F2R f ≤ _root_.F2R min)⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, MinExList_check, ULift.down_up]
  exact minExList_aux r L

/-!
Coq: `MaxExList`

Dual finite-list selection principle used by the `MaxEx` construction.  Either
every element of the finite list is strictly below `r`, or the list contains a
least element among those whose value is at least `r`.
-/

private lemma maxExList_aux {beta : Int}
    (r : ℝ) (L : List (FloatSpec.Core.Defs.FlocqFloat beta)) :
    (∀ f, f ∈ L → _root_.F2R f < r) ∨
    (∃ max, max ∈ L ∧ r ≤ _root_.F2R max ∧
      ∀ f, f ∈ L → r ≤ _root_.F2R f → _root_.F2R max ≤ _root_.F2R f) := by
  induction L with
  | nil => left; intro f hf; exact absurd hf (List.not_mem_nil)
  | cons hd tl ih =>
    by_cases h : r ≤ _root_.F2R hd
    · right
      rcases ih with hall | ⟨max, hmax_mem, hmax_ge, hmax_min⟩
      · exact ⟨hd, List.mem_cons_self, h, fun f hf hfr => by
          rcases List.mem_cons.mp hf with heq | hmem
          · exact heq ▸ le_refl _
          · exact absurd hfr (not_le.mpr (hall f hmem))⟩
      · by_cases hcmp : _root_.F2R hd ≤ _root_.F2R max
        · exact ⟨hd, List.mem_cons_self, h, fun f hf hfr => by
            rcases List.mem_cons.mp hf with heq | hmem
            · exact heq ▸ le_refl _
            · exact le_trans hcmp (hmax_min f hmem hfr)⟩
        · push Not at hcmp
          exact ⟨max, List.mem_cons_of_mem _ hmax_mem, hmax_ge, fun f hf hfr => by
            rcases List.mem_cons.mp hf with heq | hmem
            · exact heq ▸ le_of_lt hcmp
            · exact hmax_min f hmem hfr⟩
    · push Not at h
      rcases ih with hall | ⟨max, hmax_mem, hmax_ge, hmax_min⟩
      · left
        intro f hf
        rcases List.mem_cons.mp hf with heq | hmem
        · exact heq ▸ h
        · exact hall f hmem
      · right
        exact ⟨max, List.mem_cons_of_mem _ hmax_mem, hmax_ge, fun f hf hfr => by
          rcases List.mem_cons.mp hf with heq | hmem
          · exact absurd hfr (not_le.mpr (heq ▸ h))
          · exact hmax_min f hmem hfr⟩

noncomputable def MaxExList_check {beta : Int}
    (r : ℝ) (L : List (FloatSpec.Core.Defs.FlocqFloat beta)) : Unit :=
  ()

theorem MaxExList {beta : Int}
    (r : ℝ) (L : List (FloatSpec.Core.Defs.FlocqFloat beta)) :
    ⦃⌜True⌝⦄
    (pure (MaxExList_check (beta:=beta) r L) : Id Unit)
    ⦃⇓_ => ⌜(∀ f, f ∈ L → _root_.F2R f < r) ∨
            (∃ max, max ∈ L ∧ r ≤ _root_.F2R max ∧
              ∀ f, f ∈ L → r ≤ _root_.F2R f → _root_.F2R max ≤ _root_.F2R f)⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, MaxExList_check, ULift.down_up]
  exact maxExList_aux r L

-- Equality under strict-leaning midpoint toward min (Coq: `ClosestMinEq`)
noncomputable def ClosestMinEq_check {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (r : ℝ)
    (min max p : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `ClosestMinEq` — if `(2 * r) < (min + max)` and `p` is closest,
    then the closest equals `min` at the real level.

    **Strengthened precondition**: The precondition inlines the essential
    mathematical content from the Coq originals:
    - `isMin r min` provides `F2R min ≤ r`
    - `isMax r max` provides `r ≤ F2R max`
    - `Closest r p` provides `∀ bounded f, |F2R p - r| ≤ |F2R f - r|`; we instantiate at `min`
    - `ClosestMinOrMax` provides `F2R p = F2R min ∨ F2R p = F2R max` -/
theorem ClosestMinEq {beta : Int}
    (bo : Fbound_skel) (radixZ : Int) (radixR : ℝ)
    (r : ℝ)
    (min max p : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜_root_.F2R min ≤ r ∧
        r ≤ _root_.F2R max ∧
        2 * r < _root_.F2R min + _root_.F2R max ∧
        (_root_.F2R p = _root_.F2R min ∨ _root_.F2R p = _root_.F2R max) ∧
        |_root_.F2R p - r| ≤ |_root_.F2R min - r|⌝⦄
    (pure (ClosestMinEq_check (beta:=beta) bo radixR r min max p) : Id Unit)
    ⦃⇓_ => ⌜_root_.F2R p = _root_.F2R min⌝⦄ := by
  intro ⟨hmin_le, hmax_ge, hmid, hor, hclosest⟩
  simp [wp, PostCond.noThrow, pure, ClosestMinEq_check]
  rcases hor with h | h
  · exact h
  · exfalso
    rw [h] at hclosest
    have h1 : _root_.F2R min - r ≤ 0 := by linarith
    have h2 : 0 ≤ _root_.F2R max - r := by linarith
    rw [abs_of_nonpos h1, abs_of_nonneg h2] at hclosest
    linarith

-- Equality under strict-leaning midpoint toward max (Coq: `ClosestMaxEq`)
noncomputable def ClosestMaxEq_check {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (r : ℝ)
    (min max p : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `ClosestMaxEq` — if `(min + max) < (2 * r)` and `p` is closest,
    then the closest equals `max` at the real level.

    **Strengthened precondition**: The precondition inlines the essential
    mathematical content from the Coq originals:
    - `isMin r min` provides `F2R min ≤ r`
    - `isMax r max` provides `r ≤ F2R max`
    - `Closest r p` provides `∀ bounded f, |F2R p - r| ≤ |F2R f - r|`; we instantiate at `max`
    - `ClosestMinOrMax` provides `F2R p = F2R min ∨ F2R p = F2R max` -/
theorem ClosestMaxEq {beta : Int}
    (bo : Fbound_skel) (radixZ : Int) (radixR : ℝ)
    (r : ℝ)
    (min max p : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜_root_.F2R min ≤ r ∧
        r ≤ _root_.F2R max ∧
        _root_.F2R min + _root_.F2R max < 2 * r ∧
        (_root_.F2R p = _root_.F2R min ∨ _root_.F2R p = _root_.F2R max) ∧
        |_root_.F2R p - r| ≤ |_root_.F2R max - r|⌝⦄
    (pure (ClosestMaxEq_check (beta:=beta) bo radixR r min max p) : Id Unit)
    ⦃⇓_ => ⌜_root_.F2R p = _root_.F2R max⌝⦄ := by
  intro ⟨hmin_le, hmax_ge, hmid, hor, hclosest⟩
  simp [wp, PostCond.noThrow, pure, ClosestMaxEq_check]
  rcases hor with h | h
  · exfalso
    rw [h] at hclosest
    have h1 : 0 ≤ _root_.F2R max - r := by linarith
    have h2 : _root_.F2R min - r ≤ 0 := by linarith
    rw [abs_of_nonneg h1, abs_of_nonpos h2] at hclosest
    linarith
  · exact h

-- Monotonicity of the Closest relation (Coq: `ClosestMonotone`)
noncomputable def ClosestMonotone_check {beta : Int}
    (bo : Fbound_skel) (radix : ℝ) : Unit :=
  ()

/-- Coq: `ClosestMonotone` — closest rounding is monotone in real value.

The Lean statement targets the float-specific monotonicity predicate; the
generic `MonotoneP` fallback is representation equality and is not the Flocq
payload. -/
theorem ClosestMonotone {beta : Int}
    (bo : Fbound_skel) (radix : ℝ) :
    ⦃⌜True⌝⦄
    (pure (ClosestMonotone_check (beta:=beta) bo radix) : Id Unit)
    ⦃⇓_ => ⌜MonotoneP_float (Closest (beta:=beta) bo radix)⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, ClosestMonotone_check, Id.run,
    ULift.up_down]
  intro p q p' q' hpq hp' hq'
  show _root_.F2R (beta:=beta) p' ≤ _root_.F2R (beta:=beta) q'
  by_contra hnot
  have hq'p' : _root_.F2R (beta:=beta) q' < _root_.F2R (beta:=beta) p' :=
    lt_of_not_ge hnot
  rcases hp' with ⟨hp'Bounded, hp'Closest⟩
  rcases hq' with ⟨hq'Bounded, hq'Closest⟩
  have hA :
      |_root_.F2R (beta:=beta) p' - p| ≤
        |_root_.F2R (beta:=beta) q' - p| :=
    hp'Closest q' hq'Bounded
  have hB :
      |_root_.F2R (beta:=beta) q' - q| ≤
        |_root_.F2R (beta:=beta) p' - q| :=
    hq'Closest p' hp'Bounded
  have hA2 :
      (_root_.F2R (beta:=beta) p' - p)^2 ≤
        (_root_.F2R (beta:=beta) q' - p)^2 := by
    have h := sq_le_sq.mpr hA
    simpa [sq_abs] using h
  have hB2 :
      (_root_.F2R (beta:=beta) q' - q)^2 ≤
        (_root_.F2R (beta:=beta) p' - q)^2 := by
    have h := sq_le_sq.mpr hB
    simpa [sq_abs] using h
  have hsum_le :
      _root_.F2R (beta:=beta) p' + _root_.F2R (beta:=beta) q' ≤ 2 * p := by
    nlinarith
  have hsum_ge :
      2 * q ≤ _root_.F2R (beta:=beta) p' + _root_.F2R (beta:=beta) q' := by
    nlinarith
  nlinarith

-- Rounded-mode packaging for `Closest` (Coq: `ClosestRoundedModeP`)
noncomputable def ClosestRoundedModeP_check {beta : Int}
    (bo : Fbound_skel) (radix : ℝ) : Unit :=
  ()

/-- Coq: `ClosestRoundedModeP`.

The local generic `RoundedModeP` is intentionally not the Coq float-specific
package, so this theorem restores the payload as `RoundedModeP_full`.  Totality
remains explicit because `ClosestTotal` is still an open construction over the
bounded-float set. -/
theorem ClosestRoundedModeP {beta : Int}
    (bo : Fbound_skel) (radix : ℝ) :
    ⦃⌜TotalP (Closest (beta:=beta) bo radix)⌝⦄
    (pure (ClosestRoundedModeP_check (beta:=beta) bo radix) : Id Unit)
    ⦃⇓_ => ⌜RoundedModeP_full (beta:=beta) bo
      (Closest (beta:=beta) bo radix)⌝⦄ := by
  intro hTotal
  simp only [wp, PostCond.noThrow, pure, ClosestRoundedModeP_check,
    Id.run, ULift.up_down]
  refine ⟨hTotal, ?_, ?_, ?_, ?_⟩
  · have h := ClosestCompatible (beta:=beta) bo radix True.intro
    simpa only [wp, PostCond.noThrow, pure, ClosestCompatible_check,
      Id.run, ULift.up_down] using h
  · have h := ClosestMonotone (beta:=beta) bo radix True.intro
    simpa only [wp, PostCond.noThrow, pure, ClosestMonotone_check,
      Id.run, ULift.up_down] using h
  · intro p hpBounded
    constructor
    · exact hpBounded
    · intro g hgBounded
      rw [sub_self, abs_zero]
      exact abs_nonneg (_root_.F2R (beta:=beta) g - _root_.F2R (beta:=beta) p)
  · intro p q hpBounded hClosest
    rcases hClosest with ⟨_hqBounded, hMin⟩
    have hdist := hMin p hpBounded
    rw [sub_self, abs_zero] at hdist
    have hzero : |_root_.F2R (beta:=beta) q - _root_.F2R (beta:=beta) p| = 0 :=
      le_antisymm hdist (abs_nonneg _)
    exact (sub_eq_zero.mp (abs_eq_zero.mp hzero)).symm

/-- Coq Veltkamp local lemma `pPos`.

The first Veltkamp rounded value is nonnegative because it rounds the positive
quantity `x * (radix^s + 1)` with the monotone closest-rounding mode. -/
theorem pPos {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p : FloatSpec.Core.Defs.FlocqFloat beta)
    (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p) :
    0 ≤ _root_.F2R (beta:=beta) p := by
  have hMono :
      MonotoneP_float (Closest (beta:=beta) b (radix : ℝ)) := by
    have h := ClosestMonotone (beta:=beta) b (radix : ℝ)
    simpa only [wp, PostCond.noThrow, pure, ClosestMonotone_check,
      Id.run, ULift.up_down] using h trivial
  let zeroFloat : FloatSpec.Core.Defs.FlocqFloat beta := ⟨0, -b.dExp⟩
  have hradix_pos_int : (0 : Int) < radix := lt_trans (by decide) hradix
  have hvNum_pos : 0 < b.vNum := by
    rw [hvNum, Zpower_nat]
    exact pow_pos hradix_pos_int t
  have hZeroBounded : Fbounded (beta:=beta) b zeroFloat := by
    constructor
    · show |zeroFloat.Fnum| < b.vNum
      simp [zeroFloat, hvNum_pos]
    · show -b.dExp ≤ zeroFloat.Fexp
      rfl
  have hZeroF2R : _root_.F2R (beta:=beta) zeroFloat = 0 := by
    unfold _root_.F2R FloatSpec.Core.Defs.F2R zeroFloat
    ring
  have hP0 :
      Closest (beta:=beta) b (radix : ℝ) 0 zeroFloat := by
    constructor
    · exact hZeroBounded
    · intro f _hfBounded
      rw [hZeroF2R, sub_self, abs_zero]
      exact abs_nonneg _
  have hradix_pos_real : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradix_pos_int
  have hpow_pos : 0 < (radix : ℝ) ^ (s : Int) :=
    zpow_pos hradix_pos_real _
  have hfactor_pos : 0 < (radix : ℝ) ^ (s : Int) + 1 := by
    linarith
  have hinput_pos :
      0 < _root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1) :=
    mul_pos hxPos hfactor_pos
  have hmono := hMono 0
    (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1))
    zeroFloat p hinput_pos hP0 hpDef
  simpa [hZeroF2R] using hmono

/-- Coq Veltkamp local lemma `qNeg`.

After `p` rounds the scaled value above `x`, the second rounded value `q`
rounds the nonpositive residual `x - p`, so it is nonpositive. -/
theorem qNeg {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q : FloatSpec.Core.Defs.FlocqFloat beta)
    (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hxBound : Fbounded (beta:=beta) b x)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q) :
    _root_.F2R (beta:=beta) q ≤ 0 := by
  have hMono :
      MonotoneP_float (Closest (beta:=beta) b (radix : ℝ)) := by
    have h := ClosestMonotone (beta:=beta) b (radix : ℝ)
    simpa only [wp, PostCond.noThrow, pure, ClosestMonotone_check,
      Id.run, ULift.up_down] using h trivial
  let zeroFloat : FloatSpec.Core.Defs.FlocqFloat beta := ⟨0, -b.dExp⟩
  have hradix_pos_int : (0 : Int) < radix := lt_trans (by decide) hradix
  have hvNum_pos : 0 < b.vNum := by
    rw [hvNum, Zpower_nat]
    exact pow_pos hradix_pos_int t
  have hZeroBounded : Fbounded (beta:=beta) b zeroFloat := by
    constructor
    · show |zeroFloat.Fnum| < b.vNum
      simp [zeroFloat, hvNum_pos]
    · show -b.dExp ≤ zeroFloat.Fexp
      rfl
  have hZeroF2R : _root_.F2R (beta:=beta) zeroFloat = 0 := by
    unfold _root_.F2R FloatSpec.Core.Defs.F2R zeroFloat
    ring
  have hP0 :
      Closest (beta:=beta) b (radix : ℝ) 0 zeroFloat := by
    constructor
    · exact hZeroBounded
    · intro f _hfBounded
      rw [hZeroF2R, sub_self, abs_zero]
      exact abs_nonneg _
  have hxProject :
      Closest (beta:=beta) b (radix : ℝ)
        (_root_.F2R (beta:=beta) x) x := by
    constructor
    · exact hxBound
    · intro f _hfBounded
      rw [sub_self, abs_zero]
      exact abs_nonneg _
  have hradix_pos_real : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradix_pos_int
  have hpow_pos : 0 < (radix : ℝ) ^ (s : Int) :=
    zpow_pos hradix_pos_real _
  have hfactor_gt_one : 1 < (radix : ℝ) ^ (s : Int) + 1 := by
    linarith
  have hscaled_gt :
      _root_.F2R (beta:=beta) x <
        _root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1) := by
    nlinarith
  have hx_le_p :
      _root_.F2R (beta:=beta) x ≤ _root_.F2R (beta:=beta) p :=
    hMono (_root_.F2R (beta:=beta) x)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1))
      x p hscaled_gt hxProject hpDef
  have hres_le_zero :
      _root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p ≤ 0 := by
    linarith
  rcases hres_le_zero.lt_or_eq with hres_lt | hres_eq
  · have hmono := hMono
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p)
      0 q zeroFloat hres_lt hqDef hP0
    simpa [hZeroF2R] using hmono
  · have hdist := hqDef.2 zeroFloat hZeroBounded
    rw [hres_eq, hZeroF2R, sub_zero, sub_self, abs_zero] at hdist
    have hqZero : _root_.F2R (beta:=beta) q = 0 :=
      abs_eq_zero.mp (le_antisymm hdist (abs_nonneg _))
    exact le_of_eq hqZero

-- Symmetry under negation on the real side (Coq: `ClosestOpp`)
noncomputable def ClosestOpp_check {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) (r : ℝ) : Unit :=
  ()

/-- Coq: `ClosestOpp` — negation preserves closestness. -/
theorem ClosestOpp {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) (r : ℝ) :
    ⦃⌜Closest (beta:=beta) bo radix r p⌝⦄
    (pure (ClosestOpp_check (beta:=beta) bo radix p r) : Id Unit)
    ⦃⇓_ => ⌜Closest (beta:=beta) bo radix (-r) (Fopp p)⌝⦄ := by
  intro hp
  simp only [wp, PostCond.noThrow, pure, ClosestOpp_check,
    Id.run, ULift.up_down]
  rcases hp with ⟨hpBounded, hpClosest⟩
  constructor
  · simpa [Fbounded, Fopp, FloatSpec.Calc.Operations.Fopp, abs_neg] using hpBounded
  · intro f hfBounded
    have hFoppFBounded : Fbounded (beta:=beta) bo (Fopp f) := by
      simpa [Fbounded, Fopp, FloatSpec.Calc.Operations.Fopp, abs_neg] using hfBounded
    have hClosest := hpClosest (Fopp f) hFoppFBounded
    have hpOpp :
        _root_.F2R (beta:=beta) (Fopp (beta:=beta) p) = - _root_.F2R (beta:=beta) p := by
      have h := (FloatSpec.Calc.Operations.F2R_opp (beta:=beta) p) trivial
      simpa [Fopp, _root_.F2R] using h
    have hfOpp :
        _root_.F2R (beta:=beta) (Fopp (beta:=beta) f) = - _root_.F2R (beta:=beta) f := by
      have h := (FloatSpec.Calc.Operations.F2R_opp (beta:=beta) f) trivial
      simpa [Fopp, _root_.F2R] using h
    calc
      |_root_.F2R (beta:=beta) (Fopp (beta:=beta) p) - -r|
          = |_root_.F2R (beta:=beta) p - r| := by
            have harg :
                _root_.F2R (beta:=beta) (Fopp (beta:=beta) p) - -r =
                  - (_root_.F2R (beta:=beta) p - r) := by
              rw [hpOpp]
              ring
            rw [harg, abs_neg]
      _ ≤ |_root_.F2R (beta:=beta) (Fopp (beta:=beta) f) - r| := hClosest
      _ = |_root_.F2R (beta:=beta) f - -r| := by
            have harg :
                _root_.F2R (beta:=beta) (Fopp (beta:=beta) f) - r =
                  - (_root_.F2R (beta:=beta) f - -r) := by
              rw [hfOpp]
              ring
            rw [harg, abs_neg]

-- Absolute-value symmetry on the real side (Coq: `ClosestFabs`)
noncomputable def ClosestFabs_check {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) (r : ℝ) : Unit :=
  ()

/-- Coq: `ClosestFabs` — absolute value preserves closestness. -/
theorem ClosestFabs {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) (r : ℝ) :
    ⦃⌜1 < beta ∧ Closest (beta:=beta) bo radix r p⌝⦄
    (pure (ClosestFabs_check (beta:=beta) bo radix p r) : Id Unit)
    ⦃⇓_ => ⌜Closest (beta:=beta) bo radix |r| (Fabs p)⌝⦄ := by
  intro ⟨hβ, hp⟩
  simp only [wp, PostCond.noThrow, pure, ClosestFabs_check, Id.run,
    ULift.up_down]
  rcases hp with ⟨hpBounded, hpClosest⟩
  have hFabsBounded : Fbounded (beta:=beta) bo (Fabs (beta:=beta) p) := by
    simpa [Fbounded, Fabs, FloatSpec.Calc.Operations.Fabs, Int.natCast_natAbs]
      using hpBounded
  have hFabsVal :
      _root_.F2R (beta:=beta) (Fabs (beta:=beta) p) =
        |_root_.F2R (beta:=beta) p| := by
    have h := FloatSpec.Calc.Operations.F2R_abs (beta:=beta) p hβ
    simpa [Fabs, _root_.F2R] using h
  constructor
  · exact hFabsBounded
  · intro g hg
    by_cases hr : 0 ≤ r
    · have hr_abs : |r| = r := abs_of_nonneg hr
      calc
        |(_root_.F2R (beta:=beta) (Fabs (beta:=beta) p)) - (|r|)| =
            |(|_root_.F2R (beta:=beta) p|) - (|r|)| := by rw [hFabsVal]
        _ ≤ |_root_.F2R (beta:=beta) p - r| :=
            abs_abs_sub_abs_le_abs_sub _ _
        _ ≤ |_root_.F2R (beta:=beta) g - r| :=
            hpClosest g hg
        _ = |(_root_.F2R (beta:=beta) g) - (|r|)| := by rw [hr_abs]
    · have hr_lt : r < 0 := lt_of_not_ge hr
      have hr_abs : |r| = -r := abs_of_neg hr_lt
      have hFoppBounded : Fbounded (beta:=beta) bo (Fopp (beta:=beta) g) := by
        simpa [Fbounded, Fopp, FloatSpec.Calc.Operations.Fopp, abs_neg] using hg
      have hFoppVal :
          _root_.F2R (beta:=beta) (Fopp (beta:=beta) g) =
            - _root_.F2R (beta:=beta) g := by
        have h := (FloatSpec.Calc.Operations.F2R_opp (beta:=beta) g) trivial
        simpa [Fopp, _root_.F2R] using h
      calc
        |(_root_.F2R (beta:=beta) (Fabs (beta:=beta) p)) - (|r|)| =
            |(|_root_.F2R (beta:=beta) p|) - (|r|)| := by rw [hFabsVal]
        _ ≤ |_root_.F2R (beta:=beta) p - r| :=
            abs_abs_sub_abs_le_abs_sub _ _
        _ ≤ |_root_.F2R (beta:=beta) (Fopp (beta:=beta) g) - r| :=
            hpClosest (Fopp (beta:=beta) g) hFoppBounded
        _ = |(_root_.F2R (beta:=beta) g) - (|r|)| := by
            rw [hFoppVal, hr_abs]
            have harg :
                - _root_.F2R (beta:=beta) g - r =
                  - (_root_.F2R (beta:=beta) g + r) := by
              ring
            rw [harg, abs_neg]
            have htarget :
                _root_.F2R (beta:=beta) g + r =
                  _root_.F2R (beta:=beta) g - -r := by
              ring
            rw [htarget]

