          congr 1
          simp only [Int.cast_add, Int.cast_sub, Int.cast_neg, Int.cast_one, Int.cast_natCast]
        have hLogRadixPos' : 0 < Real.log radix := Real.log_pos hRadixReal
        have hBound : (((p.toNat : ℤ) - 1 + (-b.dExp)) : ℝ) ≤ Real.log r₂ / Real.log radix := by
