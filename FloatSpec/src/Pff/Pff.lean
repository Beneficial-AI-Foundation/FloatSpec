    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit := ()

/-- Coq: `FSucPred` — successor cancels predecessor on canonical floats. -/
theorem FSucPred {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜Fcanonic (beta:=beta) radix b x ∧ 1 < radix ∧ precision ≠ 0 ∧
        b.vNum = Zpower_nat radix precision⌝⦄
    (pure (FSucPred_check (beta:=beta) b radix precision x) : Id Unit)
    ⦃⇓_ => ⌜FSucc (beta:=beta) b radix precision
        (FPred (beta:=beta) b radix precision x) = x⌝⦄ := by
  intro h
  rcases h with ⟨hcan, hradix, hprecision, hvnum⟩
  simp only [wp, PostCond.noThrow, pure, FSucPred_check, Id.run,
    ULift.up_down]
  have hctx : 1 < radix ∧ precision ≠ 0 ∧
      b.vNum = Zpower_nat radix precision := ⟨hradix, hprecision, hvnum⟩
  have hopp_can :
      Fcanonic (beta:=beta) radix b (Fopp (beta:=beta) x) := by
    have hcan_opp := FcanonicFopp (beta:=beta) radix b x
    simpa only [wp, PostCond.noThrow, pure, FcanonicFopp_check]
      using hcan_opp hcan
  have hpred_succ_opp :
      FPred (beta:=beta) b radix precision
          (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x)) =
        Fopp (beta:=beta) x := by
    have hps := FPredSuc (beta:=beta) b radix precision (Fopp (beta:=beta) x)
    simpa only [wp, PostCond.noThrow, pure, FPredSuc_check,
      Id.run, ULift.up_down] using
      hps ⟨hopp_can, hradix, hprecision, hvnum⟩
  have hpred_eq :
      FPred (beta:=beta) b radix precision x =
        Fopp (beta:=beta)
          (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x)) := by
    have hpf := FPredFopFSucc (beta:=beta) b radix precision x
    simpa only [wp, PostCond.noThrow, pure, FPredFopFSucc_check,
      Id.run, ULift.up_down] using hpf hctx
  have hfopp_pred :
      Fopp (beta:=beta) (FPred (beta:=beta) b radix precision x) =
        FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x) := by
    rw [hpred_eq]
    cases FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x)
    simp [Fopp, FloatSpec.Calc.Operations.Fopp]
  have hsucc_pred :
      FSucc (beta:=beta) b radix precision
          (FPred (beta:=beta) b radix precision x) =
        Fopp (beta:=beta)
          (FPred (beta:=beta) b radix precision
            (Fopp (beta:=beta)
              (FPred (beta:=beta) b radix precision x))) := by
    have hsf := FSuccFopFPred (beta:=beta) b radix precision
      (FPred (beta:=beta) b radix precision x)
    simpa only [wp, PostCond.noThrow, pure, FSuccFopFPred_check,
      Id.run, ULift.up_down] using hsf hctx
  rw [hsucc_pred, hfopp_pred, hpred_succ_opp]
  cases x
  simp [Fopp, FloatSpec.Calc.Operations.Fopp]

noncomputable def FSuccCanonic_check {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit := ()

/-- Coq: `FSuccCanonic` — successor preserves canonicity under the local
precision/radix section assumptions.  Upstream statement:
`forall a : float, Fcanonic radix b a -> Fcanonic radix b (FSucc a)`. -/
theorem FSuccCanonic {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜Fcanonic (beta:=beta) radix b x ∧ 1 < radix ∧ precision ≠ 0 ∧
        b.vNum = Zpower_nat radix precision⌝⦄
    (pure (FSuccCanonic_check (beta:=beta) b radix precision x) : Id Unit)
    ⦃⇓_ => ⌜Fcanonic (beta:=beta) radix b
      (FSucc (beta:=beta) b radix precision x)⌝⦄ := by
  intro h
  rcases h with ⟨hcan, hradix, hprecision, hvnum⟩
  have hbounded_succ : Fbounded (beta:=beta) b
      (FSucc (beta:=beta) b radix precision x) := by
    have hbound := FBoundedSuc (beta:=beta) b radix precision x
    have hx_bound : Fbounded (beta:=beta) b x := by
      have hcan_bound := FcanonicBound (beta:=beta) radix b x
      simpa only [wp, PostCond.noThrow, pure, FcanonicBound_check,
        Id.run, ULift.up_down] using hcan_bound hcan
    simpa only [wp, PostCond.noThrow, pure, FBoundedSuc_check,
      Id.run, ULift.up_down] using
      hbound ⟨hx_bound, hradix, hprecision, hvnum⟩
  simp only [wp, PostCond.noThrow, pure, FSuccCanonic_check, Id.run,
    ULift.up_down]
  have hradix_pos : 0 < radix := by omega
  have hnm_pos : 0 < nNormMin radix precision := by
    unfold nNormMin
    exact pow_pos hradix_pos _
  have hpow_succ :
      radix ^ precision = radix * radix ^ (precision - 1) := by
    have hsucc : Nat.succ (precision - 1) = precision := by omega
    calc
      radix ^ precision = radix ^ Nat.succ (precision - 1) := by rw [hsucc]
      _ = radix ^ (precision - 1) * radix := by rw [pow_succ]
      _ = radix * radix ^ (precision - 1) := by ring
  have hvnum_mul_norm : b.vNum = radix * nNormMin radix precision := by
    rw [hvnum, Zpower_nat, nNormMin, hpow_succ]
  have hvnum_pos : 0 < b.vNum := by
    rw [hvnum_mul_norm]
    exact mul_pos hradix_pos hnm_pos
  have hvnum_gt_one : (1 : Int) < b.vNum := by
    rw [hvnum, Zpower_nat]
    exact one_lt_pow₀ hradix hprecision
  have hneg_norm_ne_pred : -nNormMin radix precision ≠ pPred b.vNum := by
    unfold pPred
    omega
  unfold FSucc
  by_cases htop : x.Fnum = pPred b.vNum
  · simp [htop]
    left
    constructor
    · simpa [FSucc, htop] using hbounded_succ
    · rw [hvnum_mul_norm]
      have hmul_pos : 0 < radix * nNormMin radix precision :=
        mul_pos hradix_pos hnm_pos
      rw [abs_of_pos hmul_pos]
  · simp [htop]
    by_cases hlow : x.Fnum = -nNormMin radix precision
    · simp [hlow]
      by_cases hexp_min : x.Fexp = -b.dExp
      · simp [hexp_min]
        right
        constructor
        · simpa [FSucc, htop, hlow, hexp_min, hneg_norm_ne_pred] using hbounded_succ
        · constructor
          · rfl
          · rw [hvnum_mul_norm]
            have hnum_nonpos : -nNormMin radix precision + 1 ≤ 0 := by omega
            have hradix_mul_nonpos :
                radix * (-nNormMin radix precision + 1) ≤ 0 := by
              exact mul_nonpos_of_nonneg_of_nonpos (le_of_lt hradix_pos) hnum_nonpos
            rw [abs_of_nonpos hradix_mul_nonpos]
            nlinarith [hradix_pos, hnm_pos]
      · simp [hexp_min]
        left
        constructor
        · simpa [FSucc, htop, hlow, hexp_min, hneg_norm_ne_pred] using hbounded_succ
        · rw [abs_mul, abs_of_pos hradix_pos]
          have hpPred_nonneg : 0 ≤ pPred b.vNum := by
            unfold pPred
            omega
          rw [abs_neg, abs_of_nonneg hpPred_nonneg]
          unfold pPred
          nlinarith [hradix, hvnum_gt_one]
    · simp [hlow]
      by_cases hnorm_succ : x.Fnum + 1 = nNormMin radix precision
      · simp [hnorm_succ]
        left
        constructor
        · simpa [FSucc, htop, hlow, hnorm_succ] using hbounded_succ
        · rw [hvnum_mul_norm]
          have hmul_pos : 0 < radix * nNormMin radix precision :=
            mul_pos hradix_pos hnm_pos
          rw [abs_of_pos hmul_pos]
      · rcases hcan with hnormal | hsubnormal
        · left
          constructor
          · simpa [FSucc, htop, hlow, hnorm_succ] using hbounded_succ
          · rcases hnormal with ⟨_, hnormal_num⟩
            have hscale_abs :
                |radix * x.Fnum| = radix * |x.Fnum| := by
              rw [abs_mul, abs_of_pos hradix_pos]
            rw [hscale_abs, hvnum_mul_norm] at hnormal_num
            have hnorm_le_abs : nNormMin radix precision ≤ |x.Fnum| := by
              exact Int.le_of_mul_le_mul_left hnormal_num hradix_pos
            have hnorm_le_abs_succ :
                nNormMin radix precision ≤ |x.Fnum + 1| := by
              rcases le_or_gt 0 x.Fnum with hx_nonneg | hx_neg
              · have hx_abs : |x.Fnum| = x.Fnum := abs_of_nonneg hx_nonneg
                rw [hx_abs] at hnorm_le_abs
                have hx_succ_nonneg : 0 ≤ x.Fnum + 1 := by omega
                rw [abs_of_nonneg hx_succ_nonneg]
                omega
              · have hx_abs : |x.Fnum| = -x.Fnum := abs_of_neg hx_neg
                rw [hx_abs] at hnorm_le_abs
                have hx_ne_neg_norm : x.Fnum ≠ -nNormMin radix precision := hlow
                have hx_succ_nonpos : x.Fnum + 1 ≤ 0 := by omega
                rw [abs_of_nonpos hx_succ_nonpos]
                omega
            rw [abs_mul, abs_of_pos hradix_pos, hvnum_mul_norm]
            exact mul_le_mul_of_nonneg_left hnorm_le_abs_succ (le_of_lt hradix_pos)
        · right
          constructor
          · simpa [FSucc, htop, hlow, hnorm_succ] using hbounded_succ
          · rcases hsubnormal with ⟨_, hexp, hsub_num⟩
            constructor
            · exact hexp
            · have hscale_abs :
                |radix * x.Fnum| = radix * |x.Fnum| := by
                rw [abs_mul, abs_of_pos hradix_pos]
              rw [hscale_abs, hvnum_mul_norm] at hsub_num
              have habs_lt_norm : |x.Fnum| < nNormMin radix precision := by
                exact Int.lt_of_mul_lt_mul_left hsub_num (le_of_lt hradix_pos)
              have habs_succ_lt_norm :
                  |x.Fnum + 1| < nNormMin radix precision := by
                rcases le_or_gt 0 x.Fnum with hx_nonneg | hx_neg
                · have hx_abs : |x.Fnum| = x.Fnum := abs_of_nonneg hx_nonneg
                  rw [hx_abs] at habs_lt_norm
                  have hx_succ_nonneg : 0 ≤ x.Fnum + 1 := by omega
                  rw [abs_of_nonneg hx_succ_nonneg]
                  omega
                · have hx_abs : |x.Fnum| = -x.Fnum := abs_of_neg hx_neg
                  rw [hx_abs] at habs_lt_norm
                  by_cases hx_succ_nonneg : 0 ≤ x.Fnum + 1
                  · rw [abs_of_nonneg hx_succ_nonneg]
                    omega
                  · have hx_succ_neg : x.Fnum + 1 < 0 := by omega
                    rw [abs_of_neg hx_succ_neg]
                    omega
              rw [abs_mul, abs_of_pos hradix_pos, hvnum_mul_norm]
              exact mul_lt_mul_of_pos_left habs_succ_lt_norm hradix_pos

/-- Coq: `FSuccNormNegNotNormMin` — the successor of a nonpositive normal
float is normal unless the input is the negative minimal-normal boundary. -/
theorem FSuccNormNegNotNormMin {beta : Int}
    (radix : Int) (b : Fbound_skel) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    beta = radix →
    1 < radix →
    0 < precision →
    b.vNum = Zpower_nat radix precision →
    FtoR x ≤ 0 →
    Fnormal (beta:=beta) radix b x →
    x ≠ (⟨-nNormMin radix precision, -b.dExp⟩ :
      FloatSpec.Core.Defs.FlocqFloat beta) →
    Fnormal (beta:=beta) radix b
      (FSucc (beta:=beta) b radix precision x) := by
  intro hbeta hradix hprecision hvNum hx_nonpos hx_normal hx_not_boundary
  subst beta
  have hprecision_ne : precision ≠ 0 := by omega
  have hx_bounded : Fbounded (beta:=radix) b x := hx_normal.1
  have hx_num_nonpos : x.Fnum ≤ 0 := by
    exact FloatSpec.Core.Float_prop.le_0_F2R (beta:=radix) x hradix
      (by simpa [FtoR] using hx_nonpos)
  have hsucc_bounded : Fbounded (beta:=radix) b
      (FSucc (beta:=radix) b radix precision x) := by
    have h := FBoundedSuc (beta:=radix) b radix precision x
    simpa only [wp, PostCond.noThrow, pure, FBoundedSuc_check,
      Id.run, ULift.up_down] using
      h ⟨hx_bounded, hradix, hprecision_ne, hvNum⟩
  have hradix_pos : 0 < radix := by omega
  have hnpos : 0 < nNormMin radix precision := by
    cases precision with
    | zero => cases hprecision
    | succ p =>
        simp [nNormMin]
        exact pow_pos hradix_pos p
  have hvnum_mul_norm : b.vNum = radix * nNormMin radix precision :=
    PosNormMin radix b precision hprecision hvNum
  have hvnum_pos : 0 < b.vNum := by
    rw [hvnum_mul_norm]
    exact mul_pos hradix_pos hnpos
  have hvnum_gt_one : (1 : Int) < b.vNum := by
    rw [hvNum, Zpower_nat]
    exact one_lt_pow₀ hradix hprecision_ne
  have hdisjoint : pPred b.vNum ≠ -nNormMin radix precision :=
    pPred_ne_neg_nNormMin radix b precision hradix hprecision_ne hvNum
  have hnot_neg_norm_top : -nNormMin radix precision ≠ pPred b.vNum := by
    intro h
    exact hdisjoint h.symm
  unfold FSucc
  by_cases htop : x.Fnum = pPred b.vNum
  · exfalso
    have hpPred_pos : 0 < pPred b.vNum := by
      unfold pPred
      omega
    rw [htop] at hx_num_nonpos
    omega
  · simp only [htop, ↓reduceIte]
    by_cases hlow : x.Fnum = -nNormMin radix precision
    · simp only [hlow, ↓reduceIte]
      by_cases hexp_min : x.Fexp = -b.dExp
      · exfalso
        apply hx_not_boundary
        cases x
        simp_all
      · simp only [hexp_min, ↓reduceIte]
        constructor
        · simpa [FSucc, htop, hlow, hexp_min, hnot_neg_norm_top] using
            hsucc_bounded
        · rw [abs_mul, abs_of_pos hradix_pos]
          have hpPred_nonneg : 0 ≤ pPred b.vNum := by
            unfold pPred
            omega
          rw [abs_neg, abs_of_nonneg hpPred_nonneg]
          unfold pPred
          nlinarith [hradix, hvnum_gt_one]
    · simp only [hlow, ↓reduceIte]
      constructor
      · simpa [FSucc, htop, hlow] using hsucc_bounded
      · have hx_num_ne_zero : x.Fnum ≠ 0 := by
          intro hz
          have hnormal_num := hx_normal.2
          have hvnum_le_zero : b.vNum ≤ 0 := by
            simpa [hz] using hnormal_num
          omega
        have hx_num_neg : x.Fnum < 0 := by omega
        have hscale_abs :
            |radix * x.Fnum| = radix * |x.Fnum| := by
          rw [abs_mul, abs_of_pos hradix_pos]
        have hnorm_le_abs : nNormMin radix precision ≤ |x.Fnum| := by
          have hnormal_num := hx_normal.2
          rw [hscale_abs, hvnum_mul_norm] at hnormal_num
          exact Int.le_of_mul_le_mul_left hnormal_num hradix_pos
        have hnorm_lt_neg_num : nNormMin radix precision < -x.Fnum := by
          have hx_abs : |x.Fnum| = -x.Fnum := abs_of_neg hx_num_neg
          rw [hx_abs] at hnorm_le_abs
          omega
        have hx_succ_nonpos : x.Fnum + 1 ≤ 0 := by omega
        have hnorm_le_abs_succ : nNormMin radix precision ≤ |x.Fnum + 1| := by
          rw [abs_of_nonpos hx_succ_nonpos]
          omega
        rw [abs_mul, abs_of_pos hradix_pos, hvnum_mul_norm]
        exact mul_le_mul_of_nonneg_left hnorm_le_abs_succ (le_of_lt hradix_pos)

noncomputable def FSuccNegCanonic_check {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit := ()

/-- Coq: `FSuccNegCanonic` — successor preserves canonicity on the
nonpositive branch.  The local all-sign `FSuccCanonic` theorem is stronger,
so this wrapper restores the exact upstream name. -/
theorem FSuccNegCanonic {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜FtoR x ≤ 0 ∧ Fcanonic (beta:=beta) radix b x ∧
        1 < radix ∧ precision ≠ 0 ∧ b.vNum = Zpower_nat radix precision⌝⦄
    (pure (FSuccNegCanonic_check (beta:=beta) b radix precision x) : Id Unit)
    ⦃⇓_ => ⌜Fcanonic (beta:=beta) radix b
      (FSucc (beta:=beta) b radix precision x)⌝⦄ := by
  intro h
  rcases h with ⟨_, hcan, hradix, hprecision, hvnum⟩
  have hsucc := FSuccCanonic (beta:=beta) b radix precision x
  simpa only [wp, PostCond.noThrow, pure, FSuccCanonic_check,
    FSuccNegCanonic_check, Id.run, ULift.up_down] using
    hsucc ⟨hcan, hradix, hprecision, hvnum⟩

noncomputable def FSuccLt_check {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit := ()

/-- Coq: `FSuccLt` — every float is strictly below its normalized successor.

Upstream statement: `forall a : float, (a < FSucc a)%R`.  The Lean port makes
the section assumptions explicit, including the equality between the `F2R` base
and the Pff radix. -/
theorem FSuccLt {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ precision ≠ 0 ∧
        b.vNum = Zpower_nat radix precision⌝⦄
    (pure (FSuccLt_check (beta:=beta) b radix precision x) : Id Unit)
    ⦃⇓_ => ⌜_root_.F2R (beta:=beta) x <
      _root_.F2R (beta:=beta)
        (FSucc (beta:=beta) b radix precision x)⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix, hprecision, hvnum⟩
  subst beta
  simp only [wp, PostCond.noThrow, pure, FSuccLt_check, Id.run,
    ULift.up_down]
  have hradix_pos_int : (0 : Int) < radix := by omega
  have hradix_pos_real : (0 : ℝ) < (radix : ℝ) :=
    Int.cast_pos.mpr hradix_pos_int
  have hradix_ne_real : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos_real
  have hpow_succ :
      radix ^ precision = radix * radix ^ (precision - 1) := by
    have hsucc : Nat.succ (precision - 1) = precision := by omega
    calc
      radix ^ precision = radix ^ Nat.succ (precision - 1) := by rw [hsucc]
      _ = radix ^ (precision - 1) * radix := by rw [pow_succ]
      _ = radix * radix ^ (precision - 1) := by ring
  have hvnum_mul_norm : b.vNum = radix * nNormMin radix precision := by
    rw [hvnum, Zpower_nat, nNormMin, hpow_succ]
  have zpow_succ (e : Int) :
      (radix : ℝ) ^ (e + 1) = (radix : ℝ) ^ e * (radix : ℝ) := by
    simpa [mul_comm] using zpow_add_one₀ hradix_ne_real e
  have zpow_pred (e : Int) :
      (radix : ℝ) ^ e = (radix : ℝ) * (radix : ℝ) ^ (e - 1) := by
    calc
      (radix : ℝ) ^ e = (radix : ℝ) ^ ((e - 1) + 1) := by ring_nf
      _ = (radix : ℝ) * (radix : ℝ) ^ (e - 1) := by
        rw [zpow_succ]
        ring
  unfold FSucc
  by_cases htop : x.Fnum = pPred b.vNum
  · simp [htop, _root_.F2R, FloatSpec.Core.Defs.F2R]
    have hmant_lt_int : pPred b.vNum < radix * nNormMin radix precision := by
      rw [← hvnum_mul_norm]
      unfold pPred
      omega
    have hmant_lt_real :
        (pPred b.vNum : ℝ) <
          ((radix * nNormMin radix precision : Int) : ℝ) :=
      Int.cast_lt.mpr hmant_lt_int
    calc
      (pPred b.vNum : ℝ) * (radix : ℝ) ^ x.Fexp
          < ((radix * nNormMin radix precision : Int) : ℝ) *
              (radix : ℝ) ^ x.Fexp := by
            exact mul_lt_mul_of_pos_right hmant_lt_real
              (zpow_pos hradix_pos_real x.Fexp)
      _ = (nNormMin radix precision : ℝ) *
            (radix : ℝ) ^ (x.Fexp + 1) := by
            rw [zpow_succ]
            simp [Int.cast_mul]
            ring
  · simp [htop]
    by_cases hlow : x.Fnum = -nNormMin radix precision
    · simp [hlow]
      by_cases hexp_min : x.Fexp = -b.dExp
      · simp [hexp_min, _root_.F2R, FloatSpec.Core.Defs.F2R]
        have hpow_pos : 0 < (radix : ℝ) ^ (-b.dExp) :=
          zpow_pos hradix_pos_real (-b.dExp)
        exact mul_lt_mul_of_pos_right
          (by exact_mod_cast
            (show x.Fnum < -nNormMin radix precision + 1 by omega))
          (by simpa using hpow_pos)
      · simp [hexp_min, _root_.F2R, FloatSpec.Core.Defs.F2R]
        have hmant_lt_int : radix * x.Fnum < -pPred b.vNum := by
          rw [hlow, hvnum_mul_norm]
          have hmul_neg :
              radix * -nNormMin radix precision =
                -(radix * nNormMin radix precision) := by
            ring
          rw [hmul_neg]
          unfold pPred
          omega
        have hmant_lt_real :
            (radix : ℝ) * (x.Fnum : ℝ) <
              ((-pPred b.vNum : Int) : ℝ) := by
          have hcast :
              ((radix * x.Fnum : Int) : ℝ) <
                ((-pPred b.vNum : Int) : ℝ) :=
            Int.cast_lt.mpr hmant_lt_int
          simpa [Int.cast_mul] using hcast
        calc
          (x.Fnum : ℝ) * (radix : ℝ) ^ x.Fexp
              = ((radix : ℝ) * (x.Fnum : ℝ)) *
                  (radix : ℝ) ^ (x.Fexp - 1) := by
                rw [zpow_pred]
                ring
          _ < ((-pPred b.vNum : Int) : ℝ) *
                (radix : ℝ) ^ (x.Fexp - 1) := by
                exact mul_lt_mul_of_pos_right hmant_lt_real
                  (zpow_pos hradix_pos_real (x.Fexp - 1))
          _ = -((pPred b.vNum : ℝ) *
                (radix : ℝ) ^ (x.Fexp - 1)) := by
                simp [Int.cast_neg]
    · simp [hlow, _root_.F2R, FloatSpec.Core.Defs.F2R]
      exact mul_lt_mul_of_pos_right
        (by exact_mod_cast (show x.Fnum < x.Fnum + 1 by omega))
        (zpow_pos hradix_pos_real x.Fexp)

noncomputable def FPredCanonic_check {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit := ()

/-- Coq: `FPredCanonic` — predecessor preserves canonicity. -/
theorem FPredCanonic {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜Fcanonic (beta:=beta) radix b x ∧ 1 < radix ∧ precision ≠ 0 ∧
        b.vNum = Zpower_nat radix precision⌝⦄
    (pure (FPredCanonic_check (beta:=beta) b radix precision x) : Id Unit)
    ⦃⇓_ => ⌜Fcanonic (beta:=beta) radix b
      (FPred (beta:=beta) b radix precision x)⌝⦄ := by
  intro h
  rcases h with ⟨hcan, hradix, hprecision, hvnum⟩
  simp only [wp, PostCond.noThrow, pure, FPredCanonic_check, Id.run,
    ULift.up_down]
  have hopp_can :
      Fcanonic (beta:=beta) radix b (Fopp (beta:=beta) x) := by
    have h := FcanonicFopp (beta:=beta) radix b x
    simpa only [wp, PostCond.noThrow, pure, FcanonicFopp_check]
      using h hcan
  have hsucc_can :
      Fcanonic (beta:=beta) radix b
        (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x)) := by
    have h := FSuccCanonic (beta:=beta) b radix precision (Fopp (beta:=beta) x)
    simpa only [wp, PostCond.noThrow, pure, FSuccCanonic_check,
      Id.run, ULift.up_down] using
      h ⟨hopp_can, hradix, hprecision, hvnum⟩
  have hpred_eq :
      FPred (beta:=beta) b radix precision x =
        Fopp (beta:=beta)
          (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x)) := by
    have h := FPredFopFSucc (beta:=beta) b radix precision x
    simpa only [wp, PostCond.noThrow, pure, FPredFopFSucc_check,
      Id.run, ULift.up_down] using h ⟨hradix, hprecision, hvnum⟩
  rw [hpred_eq]
  have h := FcanonicFopp (beta:=beta) radix b
    (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x))
  simpa only [wp, PostCond.noThrow, pure, FcanonicFopp_check]
    using h hsucc_can

/-- Boundedness corollary for the canonical predecessor. -/
theorem FPredBounded {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    Fcanonic (beta:=beta) radix b x →
    1 < radix →
    precision ≠ 0 →
    b.vNum = Zpower_nat radix precision →
    Fbounded (beta:=beta) b
      (FPred (beta:=beta) b radix precision x) := by
  intro hxCan hradix hprecision hvnum
  have hpredCan : Fcanonic (beta:=beta) radix b
      (FPred (beta:=beta) b radix precision x) := by
    have h := FPredCanonic (beta:=beta) b radix precision x
    simpa only [wp, PostCond.noThrow, pure, FPredCanonic_check,
      Id.run, ULift.up_down] using h ⟨hxCan, hradix, hprecision, hvnum⟩
  have hbound := FcanonicBound (beta:=beta) radix b
    (FPred (beta:=beta) b radix precision x)
  simpa only [wp, PostCond.noThrow, pure, FcanonicBound_check,
    Id.run, ULift.up_down] using hbound hpredCan

noncomputable def FPredLt_check {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit := ()

/-- Coq: `FPredLt` — every float is strictly above its normalized predecessor. -/
theorem FPredLt {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ precision ≠ 0 ∧
        b.vNum = Zpower_nat radix precision⌝⦄
    (pure (FPredLt_check (beta:=beta) b radix precision x) : Id Unit)
    ⦃⇓_ => ⌜_root_.F2R (beta:=beta)
        (FPred (beta:=beta) b radix precision x) <
      _root_.F2R (beta:=beta) x⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix, hprecision, hvnum⟩
  simp only [wp, PostCond.noThrow, pure, FPredLt_check, Id.run,
    ULift.up_down]
  have hsucc_lt :
      _root_.F2R (beta:=beta) (Fopp (beta:=beta) x) <
        _root_.F2R (beta:=beta)
          (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x)) := by
    have h := FSuccLt (beta:=beta) b radix precision (Fopp (beta:=beta) x)
    simpa only [wp, PostCond.noThrow, pure, FSuccLt_check,
      Id.run, ULift.up_down] using h ⟨hbeta, hradix, hprecision, hvnum⟩
  have hpred_eq :
      FPred (beta:=beta) b radix precision x =
        Fopp (beta:=beta)
          (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x)) := by
    have h := FPredFopFSucc (beta:=beta) b radix precision x
    simpa only [wp, PostCond.noThrow, pure, FPredFopFSucc_check,
      Id.run, ULift.up_down] using h ⟨hradix, hprecision, hvnum⟩
  have hx_opp :
      _root_.F2R (beta:=beta) (Fopp (beta:=beta) x) =
        - _root_.F2R (beta:=beta) x := by
    have h := FloatSpec.Calc.Operations.F2R_opp (beta:=beta) x
    simpa [Fopp, _root_.F2R] using h trivial
  have hsucc_opp :
      _root_.F2R (beta:=beta)
          (Fopp (beta:=beta)
            (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x))) =
        - _root_.F2R (beta:=beta)
          (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x)) := by
    have h := FloatSpec.Calc.Operations.F2R_opp (beta:=beta)
      (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x))
    simpa [Fopp, _root_.F2R] using h trivial
  rw [hpred_eq, hsucc_opp]
  rw [hx_opp] at hsucc_lt
  have hdual := neg_lt_neg hsucc_lt
  simpa using hdual

noncomputable def R0RltRleSucc_check {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit := ()

/-- Coq: `R0RltRleSucc` — if a float is negative, its normalized successor is
still nonpositive. -/
theorem R0RltRleSucc {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ precision ≠ 0 ∧
        b.vNum = Zpower_nat radix precision ∧
        _root_.F2R (beta:=beta) x < 0⌝⦄
    (pure (R0RltRleSucc_check (beta:=beta) b radix precision x) : Id Unit)
    ⦃⇓_ => ⌜_root_.F2R (beta:=beta)
      (FSucc (beta:=beta) b radix precision x) ≤ 0⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix, hprecision, hvnum, hxneg⟩
  subst beta
  simp only [wp, PostCond.noThrow, pure, R0RltRleSucc_check, Id.run,
    ULift.up_down]
  have hxnum_neg : x.Fnum < 0 :=
    FloatSpec.Core.Float_prop.lt_0_F2R (beta:=radix) x hradix hxneg
  have hradix_pos : 0 < radix := by omega
  have hvnum_gt_one : (1 : Int) < b.vNum := by
    rw [hvnum, Zpower_nat]
    exact one_lt_pow₀ hradix hprecision
  have hnm_pos : 0 < nNormMin radix precision := by
    unfold nNormMin
    exact pow_pos hradix_pos _
  have hpPred_pos : 0 < pPred b.vNum := by
    unfold pPred
    omega
  have hle_zero_of_fnum
      (f : FloatSpec.Core.Defs.FlocqFloat radix) (hf : f.Fnum ≤ 0) :
      _root_.F2R (beta:=radix) f ≤ 0 :=
    FloatSpec.Core.Float_prop.F2R_le_0 (beta:=radix) f hradix hf
  unfold FSucc
  by_cases htop : x.Fnum = pPred b.vNum
  · exfalso
    omega
  · simp [htop]
    by_cases hlow : x.Fnum = -nNormMin radix precision
    · simp [hlow]
      by_cases hexp_min : x.Fexp = -b.dExp
      · simp [hexp_min]
        have hmant : -nNormMin radix precision + 1 ≤ 0 := by omega
        exact hle_zero_of_fnum
          (⟨-nNormMin radix precision + 1, -b.dExp⟩ :
            FloatSpec.Core.Defs.FlocqFloat radix)
          hmant
      · simp [hexp_min]
        have hmant : -pPred b.vNum ≤ 0 := by omega
        exact hle_zero_of_fnum
          (⟨-pPred b.vNum, x.Fexp - 1⟩ :
            FloatSpec.Core.Defs.FlocqFloat radix)
          hmant
    · simp [hlow]
      have hmant : x.Fnum + 1 ≤ 0 := by omega
      exact hle_zero_of_fnum
        (⟨x.Fnum + 1, x.Fexp⟩ :
          FloatSpec.Core.Defs.FlocqFloat radix)
        hmant

noncomputable def R0RltRlePred_check {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit := ()

/-- Coq: `R0RltRlePred` — if a float is positive, its normalized predecessor is
still nonnegative. -/
theorem R0RltRlePred {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ precision ≠ 0 ∧
        b.vNum = Zpower_nat radix precision ∧
        0 < _root_.F2R (beta:=beta) x⌝⦄
    (pure (R0RltRlePred_check (beta:=beta) b radix precision x) : Id Unit)
    ⦃⇓_ => ⌜0 ≤ _root_.F2R (beta:=beta)
      (FPred (beta:=beta) b radix precision x)⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix, hprecision, hvnum, hxpos⟩
  simp only [wp, PostCond.noThrow, pure, R0RltRlePred_check, Id.run,
    ULift.up_down]
  have hx_opp :
      _root_.F2R (beta:=beta) (Fopp (beta:=beta) x) =
        - _root_.F2R (beta:=beta) x := by
    have h := FloatSpec.Calc.Operations.F2R_opp (beta:=beta) x
    simpa [Fopp, _root_.F2R] using h trivial
  have hopp_neg :
      _root_.F2R (beta:=beta) (Fopp (beta:=beta) x) < 0 := by
    rw [hx_opp]
    exact neg_neg_of_pos hxpos
  have hsucc_nonpos :
      _root_.F2R (beta:=beta)
          (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x)) ≤ 0 := by
    have h := R0RltRleSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x)
    simpa only [wp, PostCond.noThrow, pure, R0RltRleSucc_check,
      Id.run, ULift.up_down] using
      h ⟨hbeta, hradix, hprecision, hvnum, hopp_neg⟩
  have hpred_eq :
      FPred (beta:=beta) b radix precision x =
        Fopp (beta:=beta)
          (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x)) := by
    have h := FPredFopFSucc (beta:=beta) b radix precision x
    simpa only [wp, PostCond.noThrow, pure, FPredFopFSucc_check,
      Id.run, ULift.up_down] using h ⟨hradix, hprecision, hvnum⟩
  have hsucc_opp :
      _root_.F2R (beta:=beta)
          (Fopp (beta:=beta)
            (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x))) =
        - _root_.F2R (beta:=beta)
          (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x)) := by
    have h := FloatSpec.Calc.Operations.F2R_opp (beta:=beta)
      (FSucc (beta:=beta) b radix precision (Fopp (beta:=beta) x))
    simpa [Fopp, _root_.F2R] using h trivial
  rw [hpred_eq, hsucc_opp]
  exact neg_nonneg.mpr hsucc_nonpos

-- Relative ordering of canonical floats (Coq: `FcanonicLtPos`)
noncomputable def FcanonicLtPos_check {beta : Int}
    (radix : Int) (b : Fbound_skel)
    (p q : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `FcanonicLtPos` — for canonical floats `p` and `q`, if
`0 ≤ F2R p < F2R q`, then either the exponent of `p` is strictly
smaller than that of `q`, or the exponents match and the mantissa of `p`
is strictly smaller.

Note: Uses `Fcanonic'`, the Coq-matching canonical predicate.
This theorem requires the canonical form structure to be meaningful.
Requires `1 < beta` (radixMoreThanOne in Coq) and `radix = beta`. -/
theorem FcanonicLtPos {beta : Int}
    (radix : Int) (b : Fbound_skel)
    (p q : FloatSpec.Core.Defs.FlocqFloat beta)
    (hβ : 1 < beta)
    (hradix : radix = beta) :
    ⦃⌜Fcanonic' (beta:=beta) radix b p ∧
        Fcanonic' (beta:=beta) radix b q ∧
        0 ≤ _root_.F2R (beta:=beta) p ∧
        _root_.F2R (beta:=beta) p < _root_.F2R (beta:=beta) q⌝⦄
    (pure (FcanonicLtPos_check (beta:=beta) radix b p q) : Id Unit)
    ⦃⇓_ => ⌜p.Fexp < q.Fexp ∨
            (p.Fexp = q.Fexp ∧ p.Fnum < q.Fnum)⌝⦄ := by
  intro ⟨hcanP, hcanQ, hPos, hLt⟩
  simp only [wp, PostCond.noThrow, pure, FcanonicLtPos_check, ULift.down_up]
  -- Derive beta > 0 from 1 < beta
  have hbeta_pos : (0 : ℝ) < (beta : ℝ) := by
    have : (0 : Int) < beta := lt_trans (by norm_num : (0 : Int) < 1) hβ
    exact Int.cast_pos.mpr this
  -- Unfold F2R to get: p.Fnum * beta ^ p.Fexp < q.Fnum * beta ^ q.Fexp
  simp only [_root_.F2R, FloatSpec.Core.Defs.F2R] at hLt hPos
  -- Case split on exponent comparison
  by_cases hexp : p.Fexp < q.Fexp
  · left; exact hexp
  · -- p.Fexp ≥ q.Fexp
    push Not at hexp
    by_cases hexp_eq : p.Fexp = q.Fexp
    · -- Exponents equal: compare mantissas
      right
      constructor
      · exact hexp_eq
      · -- Need to show p.Fnum < q.Fnum given F2R p < F2R q and p.Fexp = q.Fexp
        rw [hexp_eq] at hLt
        -- Now hLt : p.Fnum * beta ^ q.Fexp < q.Fnum * beta ^ q.Fexp
        -- Since beta > 0, beta ^ q.Fexp > 0, so we can divide
        have hpow_pos : (0 : ℝ) < (beta : ℝ) ^ q.Fexp := zpow_pos hbeta_pos q.Fexp
        -- Divide both sides by the positive power
        have hpow_ne : (beta : ℝ) ^ q.Fexp ≠ 0 := ne_of_gt hpow_pos
        have h : (p.Fnum : ℝ) < (q.Fnum : ℝ) := by
          calc (p.Fnum : ℝ) = (p.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp / (beta : ℝ) ^ q.Fexp := by
                field_simp
            _ < (q.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp / (beta : ℝ) ^ q.Fexp := by
                apply div_lt_div_of_pos_right hLt hpow_pos
            _ = (q.Fnum : ℝ) := by field_simp
        exact Int.cast_lt.mp h
    · -- p.Fexp > q.Fexp: use the case analysis from Coq proof
      -- The Coq proof uses FnormalLtPos, FsubnormalnormalLtPos, FsubnormalLt
      -- For canonical floats with 0 ≤ F2R p and F2R p < F2R q, when p.Fexp > q.Fexp,
      -- we need to show this leads to one of the disjuncts being true
      have hexp_gt : q.Fexp < p.Fexp := lt_of_le_of_ne hexp (Ne.symm hexp_eq)
      -- Case analysis on whether p and q are normal or subnormal
      rcases hcanP with ⟨hbP, hvnumP⟩ | ⟨hbP, hexpP, hvnumP⟩
      <;> rcases hcanQ with ⟨hbQ, hvnumQ⟩ | ⟨hbQ, hexpQ, hvnumQ⟩
      -- Case 1: Both normal - contradiction via FnormalLtPos logic
      · -- Both normal with p.Fexp > q.Fexp, 0 ≤ F2R p, F2R p < F2R q
        -- This requires detailed analysis of normal float bounds
        -- Coq proof uses FnormalLtPos helper lemma
        -- Key insight: b.vNum ≤ |radix * Fnum| constrains mantissa from below
        -- With radix = beta, the exponent difference dominates
        exfalso
        rw [hradix] at hvnumP hvnumQ
        -- Step 1: Since 0 ≤ F2R p and beta^p.Fexp > 0, we have 0 ≤ p.Fnum
        have hpow_p_pos : (0 : ℝ) < (beta : ℝ) ^ p.Fexp := zpow_pos hbeta_pos p.Fexp
        have hp_fnum_nonneg : (0 : ℤ) ≤ p.Fnum := by
          by_contra hcontra
          push Not at hcontra
          have hneg : (p.Fnum : ℝ) < 0 := Int.cast_lt_zero.mpr hcontra
          have : (p.Fnum : ℝ) * (beta : ℝ) ^ p.Fexp < 0 :=
            mul_neg_of_neg_of_pos hneg hpow_p_pos
          linarith
        -- Step 2: From hvnumP and p.Fnum ≥ 0, get b.vNum ≤ beta * p.Fnum
        have hp_fnum_nonneg_real : (0 : ℝ) ≤ (p.Fnum : ℝ) := Int.cast_nonneg hp_fnum_nonneg
        have hbeta_pos_int : (0 : ℤ) < beta := lt_trans (by norm_num : (0 : ℤ) < 1) hβ
        have hbeta_nonneg_int : (0 : ℤ) ≤ beta := le_of_lt hbeta_pos_int
        have habs_beta_p : |beta * p.Fnum| = beta * p.Fnum := by
          rw [abs_of_nonneg]
          exact mul_nonneg hbeta_nonneg_int hp_fnum_nonneg
        have hvnumP' : (b.vNum : ℤ) ≤ beta * p.Fnum := by
          rw [← habs_beta_p]
          exact hvnumP
        -- Step 3: From hbQ.1, we have |q.Fnum| < b.vNum
        have hq_abs_bound : |q.Fnum| < (b.vNum : ℤ) := hbQ.1
        -- Step 4: Therefore |q.Fnum| < beta * p.Fnum
        have hq_lt_beta_p : |q.Fnum| < beta * p.Fnum := lt_of_lt_of_le hq_abs_bound hvnumP'
        -- Step 5: We have q.Fnum ≤ |q.Fnum| < beta * p.Fnum
        have hq_fnum_lt : q.Fnum < beta * p.Fnum := lt_of_le_of_lt (le_abs_self q.Fnum) hq_lt_beta_p
        -- Step 6: Since p.Fexp > q.Fexp, we have p.Fexp ≥ q.Fexp + 1
        have hexp_ge : p.Fexp ≥ q.Fexp + 1 := hexp_gt
        -- Step 7: Show F2R p ≥ F2R q (contradiction with hLt)
        -- F2R p = p.Fnum * beta^p.Fexp ≥ p.Fnum * beta^(q.Fexp + 1) = (beta * p.Fnum) * beta^q.Fexp
        have hpow_q_pos : (0 : ℝ) < (beta : ℝ) ^ q.Fexp := zpow_pos hbeta_pos q.Fexp
        -- Compute: beta^p.Fexp ≥ beta^(q.Fexp + 1) = beta * beta^q.Fexp
        have hbeta_ge_one : (1 : ℝ) ≤ (beta : ℝ) := by
          have h1lt : (1 : ℤ) < beta := hβ
          have h1le : (1 : ℤ) ≤ beta := le_of_lt h1lt
          have hcast : ((1 : ℤ) : ℝ) ≤ ((beta : ℤ) : ℝ) := Int.cast_le.mpr h1le
          simp only [Int.cast_one] at hcast
          exact hcast
        have hpow_mono : (beta : ℝ) ^ (q.Fexp + 1) ≤ (beta : ℝ) ^ p.Fexp := by
          apply zpow_le_zpow_right₀ hbeta_ge_one hexp_ge
        have hpow_expand : (beta : ℝ) ^ (q.Fexp + 1) = (beta : ℝ) * (beta : ℝ) ^ q.Fexp := by
          rw [zpow_add_one₀ (ne_of_gt hbeta_pos)]
          ring
        -- Now combine:
        have hF2Rp_ge : (p.Fnum : ℝ) * (beta : ℝ) ^ p.Fexp ≥ (beta : ℝ) * (p.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp := by
          calc (p.Fnum : ℝ) * (beta : ℝ) ^ p.Fexp
              ≥ (p.Fnum : ℝ) * (beta : ℝ) ^ (q.Fexp + 1) := by
                  apply mul_le_mul_of_nonneg_left hpow_mono hp_fnum_nonneg_real
            _ = (p.Fnum : ℝ) * ((beta : ℝ) * (beta : ℝ) ^ q.Fexp) := by rw [hpow_expand]
            _ = (beta : ℝ) * (p.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp := by ring
        -- Now we need: beta * p.Fnum > q.Fnum
        have hbeta_p_gt_q : (beta : ℝ) * (p.Fnum : ℝ) > (q.Fnum : ℝ) := by
          have h1 : (beta * p.Fnum : ℤ) > q.Fnum := hq_fnum_lt
          have h2 : (q.Fnum : ℝ) < ((beta * p.Fnum) : ℤ) := Int.cast_lt.mpr h1
          simp only [Int.cast_mul] at h2
          exact h2
        -- Therefore: F2R p > F2R q
        have hF2Rp_gt_F2Rq : (p.Fnum : ℝ) * (beta : ℝ) ^ p.Fexp > (q.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp := by
          calc (p.Fnum : ℝ) * (beta : ℝ) ^ p.Fexp
              ≥ (beta : ℝ) * (p.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp := hF2Rp_ge
            _ > (q.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp := by
                apply mul_lt_mul_of_pos_right hbeta_p_gt_q hpow_q_pos
        -- This contradicts hLt
        linarith
      -- Case 2: p normal, q subnormal
      · -- p normal, q subnormal: q.Fexp = -b.dExp (minimal)
        -- This leads to contradiction via FsubnormalnormalLtPos logic
        -- The subnormal q has smaller magnitude than any normal at higher exp
        exfalso
        rw [hradix] at hvnumP hvnumQ
        -- Step 1: From 0 ≤ F2R p and F2R p < F2R q, both Fnum are nonneg
        have hpow_p_pos : (0 : ℝ) < (beta : ℝ) ^ p.Fexp := zpow_pos hbeta_pos p.Fexp
        have hpow_q_pos : (0 : ℝ) < (beta : ℝ) ^ q.Fexp := zpow_pos hbeta_pos q.Fexp
        have hp_fnum_nonneg : (0 : ℤ) ≤ p.Fnum := by
          by_contra hcontra
          push Not at hcontra
          have hneg : (p.Fnum : ℝ) < 0 := Int.cast_lt_zero.mpr hcontra
          have : (p.Fnum : ℝ) * (beta : ℝ) ^ p.Fexp < 0 :=
            mul_neg_of_neg_of_pos hneg hpow_p_pos
          linarith
        have hq_fnum_nonneg : (0 : ℤ) ≤ q.Fnum := by
          by_contra hcontra
          push Not at hcontra
          have hneg : (q.Fnum : ℝ) < 0 := Int.cast_lt_zero.mpr hcontra
          have hF2Rq_neg : (q.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp < 0 :=
            mul_neg_of_neg_of_pos hneg hpow_q_pos
          -- But F2R p < F2R q and 0 ≤ F2R p, so F2R q > 0
          have hF2Rq_pos : (0 : ℝ) < (q.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp := lt_of_le_of_lt hPos hLt
          linarith
        -- Step 2: Since p is normal and q is subnormal
        -- hvnumP: b.vNum ≤ |beta * p.Fnum| = beta * p.Fnum (since p.Fnum ≥ 0)
        -- hvnumQ: |beta * q.Fnum| < b.vNum, so beta * q.Fnum < b.vNum (since q.Fnum ≥ 0)
        have hbeta_pos_int : (0 : ℤ) < beta := lt_trans (by norm_num : (0 : ℤ) < 1) hβ
        have hbeta_nonneg_int : (0 : ℤ) ≤ beta := le_of_lt hbeta_pos_int
        have habs_beta_p : |beta * p.Fnum| = beta * p.Fnum := by
          rw [abs_of_nonneg]
          exact mul_nonneg hbeta_nonneg_int hp_fnum_nonneg
        have habs_beta_q : |beta * q.Fnum| = beta * q.Fnum := by
          rw [abs_of_nonneg]
          exact mul_nonneg hbeta_nonneg_int hq_fnum_nonneg
        have hvnumP' : (b.vNum : ℤ) ≤ beta * p.Fnum := by rw [← habs_beta_p]; exact hvnumP
        have hvnumQ' : beta * q.Fnum < (b.vNum : ℤ) := by rw [← habs_beta_q]; exact hvnumQ
        -- Step 3: From hvnumQ' < hvnumP', we get q.Fnum < p.Fnum
        have hq_lt_p : beta * q.Fnum < beta * p.Fnum := lt_of_lt_of_le hvnumQ' hvnumP'
        have hp_beta_pos : (0 : ℤ) < beta := hbeta_pos_int
        have hq_fnum_lt_p_fnum : q.Fnum < p.Fnum := by
          have := Int.lt_of_mul_lt_mul_left hq_lt_p (le_of_lt hp_beta_pos)
          omega
        -- Step 4: With p.Fexp > q.Fexp, show F2R p > F2R q
        -- F2R p = p.Fnum * beta^p.Fexp ≥ p.Fnum * beta^(q.Fexp+1) (since p.Fexp ≥ q.Fexp+1)
        --       = (beta * p.Fnum) * beta^q.Fexp > (beta * q.Fnum) * beta^q.Fexp ≥ q.Fnum * beta^q.Fexp
        -- Actually simpler: p.Fnum > q.Fnum and p.Fexp > q.Fexp gives F2R p > F2R q directly
        -- p.Fnum * beta^p.Fexp > q.Fnum * beta^q.Fexp
        have hp_fnum_nonneg_real : (0 : ℝ) ≤ (p.Fnum : ℝ) := Int.cast_nonneg hp_fnum_nonneg
        have hq_fnum_nonneg_real : (0 : ℝ) ≤ (q.Fnum : ℝ) := Int.cast_nonneg hq_fnum_nonneg
        have hbeta_ge_one : (1 : ℝ) ≤ (beta : ℝ) := by
          have h1le : (1 : ℤ) ≤ beta := le_of_lt hβ
          have hcast : ((1 : ℤ) : ℝ) ≤ ((beta : ℤ) : ℝ) := Int.cast_le.mpr h1le
          simp only [Int.cast_one] at hcast
          exact hcast
        have hexp_ge : p.Fexp ≥ q.Fexp + 1 := hexp_gt
        have hpow_mono : (beta : ℝ) ^ q.Fexp ≤ (beta : ℝ) ^ p.Fexp := by
          apply zpow_le_zpow_right₀ hbeta_ge_one (le_of_lt hexp_gt)
        have hq_lt_p_real : (q.Fnum : ℝ) < (p.Fnum : ℝ) := Int.cast_lt.mpr hq_fnum_lt_p_fnum
        -- Now: F2R q = q.Fnum * beta^q.Fexp < p.Fnum * beta^q.Fexp ≤ p.Fnum * beta^p.Fexp = F2R p
        have hF2Rp_ge_F2Rq : (p.Fnum : ℝ) * (beta : ℝ) ^ p.Fexp > (q.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp := by
          calc (q.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp
              < (p.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp := by
                  apply mul_lt_mul_of_pos_right hq_lt_p_real hpow_q_pos
            _ ≤ (p.Fnum : ℝ) * (beta : ℝ) ^ p.Fexp := by
                  apply mul_le_mul_of_nonneg_left hpow_mono hp_fnum_nonneg_real
        linarith
      -- Case 3: p subnormal, q normal
      · -- p subnormal, q normal: p.Fexp = -b.dExp ≤ q.Fexp
        -- This contradicts hexp_gt: q.Fexp < p.Fexp
        have hpExp : p.Fexp = -b.dExp := hexpP
        have hq_lb := hbQ.2  -- -b.dExp ≤ q.Fexp
        omega
      -- Case 4: Both subnormal
      · -- Both subnormal: p.Fexp = q.Fexp = -b.dExp
        have hpExp : p.Fexp = -b.dExp := hexpP
        have hqExp : q.Fexp = -b.dExp := hexpQ
        -- This contradicts hexp_gt: q.Fexp < p.Fexp
        omega

noncomputable def Fcanonic_Rle_Zle_check {beta : Int}
    (radix : Int) (b : Fbound_skel)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `Fcanonic_Rle_Zle` — canonical floats ordered by absolute value have
    nondecreasing exponents.

Note: Uses `Fcanonic'`, the Coq-matching canonical predicate.
This theorem requires the canonical form structure to be meaningful.
Requires `1 < beta` (radixMoreThanOne in Coq) and `radix = beta`. -/
theorem Fcanonic_Rle_Zle {beta : Int}
    (radix : Int) (b : Fbound_skel)
    (x y : FloatSpec.Core.Defs.FlocqFloat beta)
    (hβ : 1 < beta)
    (hradix : radix = beta) :
    ⦃⌜Fcanonic' (beta:=beta) radix b x ∧
        Fcanonic' (beta:=beta) radix b y ∧
        |_root_.F2R (beta:=beta) x|
          ≤ |_root_.F2R (beta:=beta) y|⌝⦄
    (pure (Fcanonic_Rle_Zle_check (beta:=beta) radix b x y) : Id Unit)
    ⦃⇓_ => ⌜x.Fexp ≤ y.Fexp⌝⦄ := by
  intro ⟨hcanX, hcanY, habs_le⟩
  simp only [wp, PostCond.noThrow, pure, Fcanonic_Rle_Zle_check, ULift.down_up]
  -- Derive beta > 0 from 1 < beta
  have hbeta_pos : (0 : ℝ) < (beta : ℝ) := by
    have : (0 : Int) < beta := lt_trans (by norm_num : (0 : Int) < 1) hβ
    exact Int.cast_pos.mpr this
  have hbeta_ge_one_int : (1 : Int) ≤ beta := le_of_lt hβ
  -- Useful lemma: ↑|z| = |↑z| for any integer z
  have int_abs_cast : ∀ z : Int, (↑|z| : ℝ) = |↑z| := fun z => by
    simp only [Int.cast_abs]
  -- Case split: |F2R x| < |F2R y| or |F2R x| = |F2R y|
  rcases habs_le.lt_or_eq with habs_lt | habs_eq
  · -- Case: |F2R x| < |F2R y|
    by_contra h_exp_not_le
    have h_exp_gt : y.Fexp < x.Fexp := not_le.mp h_exp_not_le
    simp only [_root_.F2R, FloatSpec.Core.Defs.F2R] at habs_lt
    have hpow_pos_x : (0 : ℝ) < (beta : ℝ) ^ x.Fexp := zpow_pos hbeta_pos x.Fexp
    have hpow_pos_y : (0 : ℝ) < (beta : ℝ) ^ y.Fexp := zpow_pos hbeta_pos y.Fexp
    rw [abs_mul, abs_mul, abs_of_pos hpow_pos_x, abs_of_pos hpow_pos_y] at habs_lt
    -- Convert to use ↑|z| form
    simp only [← int_abs_cast] at habs_lt
    have hd_pos : 0 < x.Fexp - y.Fexp := by omega
    have hpow_factor : (beta : ℝ) ^ x.Fexp = (beta : ℝ) ^ y.Fexp * (beta : ℝ) ^ (x.Fexp - y.Fexp) := by
      rw [← zpow_add₀ (ne_of_gt hbeta_pos)]; congr 1; omega
    -- Rewrite and derive key inequality
    have hpy_ne : (beta : ℝ) ^ y.Fexp ≠ 0 := ne_of_gt hpow_pos_y
    have habs_lt' : (↑|x.Fnum| : ℝ) * (beta : ℝ) ^ x.Fexp < (↑|y.Fnum| : ℝ) * (beta : ℝ) ^ y.Fexp := habs_lt
    rw [hpow_factor] at habs_lt'
    -- habs_lt' : ↑|x.Fnum| * (↑beta ^ y.Fexp * ↑beta ^ (x.Fexp - y.Fexp)) < ↑|y.Fnum| * ↑beta ^ y.Fexp
    have h1 : (↑|x.Fnum| : ℝ) * (beta : ℝ) ^ (x.Fexp - y.Fexp) < (↑|y.Fnum| : ℝ) := by
      -- Rewrite LHS: a * (b * c) = (a * c) * b
      have eq1 : (↑|x.Fnum| : ℝ) * ((beta : ℝ) ^ y.Fexp * (beta : ℝ) ^ (x.Fexp - y.Fexp)) =
                 (↑|x.Fnum| : ℝ) * (beta : ℝ) ^ (x.Fexp - y.Fexp) * (beta : ℝ) ^ y.Fexp := by ring
      rw [eq1] at habs_lt'
      -- Divide both sides by beta^y.Fexp
      have h := div_lt_div_of_pos_right habs_lt' hpow_pos_y
      simp only [mul_div_assoc, div_self hpy_ne, mul_one] at h
      exact h
    rcases hcanX with ⟨⟨hbX_num, hbX_exp⟩, hvnumX⟩ | ⟨⟨hbX_num, hbX_exp⟩, hexpX, hvnumX⟩
    <;> rcases hcanY with ⟨⟨hbY_num, hbY_exp⟩, hvnumY⟩ | ⟨⟨hbY_num, hbY_exp⟩, hexpY, hvnumY⟩
    -- Case 1: x normal, y normal
    · rw [hradix] at hvnumX
      have hvnumX' : (b.vNum : ℝ) ≤ (beta : ℝ) * (↑|x.Fnum| : ℝ) := by
        have h : (b.vNum : ℝ) ≤ (↑|beta * x.Fnum| : ℝ) := Int.cast_le.mpr hvnumX
        simp only [Int.cast_abs, Int.cast_mul, abs_mul, abs_of_pos hbeta_pos] at h
        simp only [Int.cast_abs]
        exact h
      have hvnumY' : (↑|y.Fnum| : ℝ) < (b.vNum : ℝ) := Int.cast_lt.mpr hbY_num
      have hpow_ge_beta : (beta : ℝ) ≤ (beta : ℝ) ^ (x.Fexp - y.Fexp) := by
        have hbeta_ge_one : (1 : ℝ) ≤ (beta : ℝ) := by
          have h : ((1 : Int) : ℝ) ≤ (beta : ℝ) := Int.cast_le.mpr hbeta_ge_one_int
          simp only [Int.cast_one] at h
          exact h
        have := zpow_le_zpow_right₀ hbeta_ge_one (by omega : (1 : ℤ) ≤ x.Fexp - y.Fexp)
        simp only [zpow_one] at this
        exact this
      by_cases hxfnum : x.Fnum = 0
      · simp [hxfnum] at hvnumX'
        simp only [hxfnum, abs_zero, Int.cast_zero, zero_mul] at h1
        have h1' : (0 : ℝ) < (↑|y.Fnum| : ℝ) := h1
        -- hvnumX' gives b.vNum ≤ 0 (as Int)
        -- hvnumY' gives ↑|y.Fnum| < b.vNum (as Real)
        -- h1' gives 0 < ↑|y.Fnum| (as Real)
        -- Contradiction: 0 < ↑|y.Fnum| < b.vNum but b.vNum ≤ 0
        have hvnum_pos : (0 : ℝ) < (b.vNum : ℝ) := lt_trans h1' hvnumY'
        have hvnumX'_real : (b.vNum : ℝ) ≤ 0 := Int.cast_nonpos.mpr hvnumX'
        linarith
      · have hxfnum_pos : 0 < (↑|x.Fnum| : ℝ) := Int.cast_pos.mpr (abs_pos.mpr hxfnum)
        have key : (b.vNum : ℝ) ≤ (↑|x.Fnum| : ℝ) * (beta : ℝ) ^ (x.Fexp - y.Fexp) :=
          calc (b.vNum : ℝ) ≤ (beta : ℝ) * (↑|x.Fnum| : ℝ) := hvnumX'
            _ = (↑|x.Fnum| : ℝ) * (beta : ℝ) := by ring
            _ ≤ (↑|x.Fnum| : ℝ) * (beta : ℝ) ^ (x.Fexp - y.Fexp) :=
                mul_le_mul_of_nonneg_left hpow_ge_beta (le_of_lt hxfnum_pos)
        linarith
    -- Case 2: x normal, y subnormal
    · rw [hradix] at hvnumX
      have hvnumX' : (b.vNum : ℝ) ≤ (beta : ℝ) * (↑|x.Fnum| : ℝ) := by
        have h : (b.vNum : ℝ) ≤ (↑|beta * x.Fnum| : ℝ) := Int.cast_le.mpr hvnumX
        simp only [Int.cast_abs, Int.cast_mul, abs_mul, abs_of_pos hbeta_pos] at h
        simp only [Int.cast_abs]
        exact h
      have hvnumY' : (↑|y.Fnum| : ℝ) < (b.vNum : ℝ) := Int.cast_lt.mpr hbY_num
      have hpow_ge_beta : (beta : ℝ) ≤ (beta : ℝ) ^ (x.Fexp - y.Fexp) := by
        have hbeta_ge_one : (1 : ℝ) ≤ (beta : ℝ) := by
          have h : ((1 : Int) : ℝ) ≤ (beta : ℝ) := Int.cast_le.mpr hbeta_ge_one_int
          simp only [Int.cast_one] at h
          exact h
        have := zpow_le_zpow_right₀ hbeta_ge_one (by omega : (1 : ℤ) ≤ x.Fexp - y.Fexp)
        simp only [zpow_one] at this
        exact this
      by_cases hxfnum : x.Fnum = 0
      · simp [hxfnum] at hvnumX'
        simp only [hxfnum, abs_zero, Int.cast_zero, zero_mul] at h1
        have h1' : (0 : ℝ) < (↑|y.Fnum| : ℝ) := h1
        have hvnum_pos : (0 : ℝ) < (b.vNum : ℝ) := lt_trans h1' hvnumY'
        have hvnumX'_real : (b.vNum : ℝ) ≤ 0 := Int.cast_nonpos.mpr hvnumX'
        linarith
      · have hxfnum_pos : 0 < (↑|x.Fnum| : ℝ) := Int.cast_pos.mpr (abs_pos.mpr hxfnum)
        have key : (b.vNum : ℝ) ≤ (↑|x.Fnum| : ℝ) * (beta : ℝ) ^ (x.Fexp - y.Fexp) :=
          calc (b.vNum : ℝ) ≤ (beta : ℝ) * (↑|x.Fnum| : ℝ) := hvnumX'
            _ = (↑|x.Fnum| : ℝ) * (beta : ℝ) := by ring
            _ ≤ (↑|x.Fnum| : ℝ) * (beta : ℝ) ^ (x.Fexp - y.Fexp) :=
                mul_le_mul_of_nonneg_left hpow_ge_beta (le_of_lt hxfnum_pos)
        linarith
    -- Case 3: x subnormal, y normal
    · rw [hexpX] at h_exp_gt; omega
    -- Case 4: x subnormal, y subnormal
    · rw [hexpX, hexpY] at h_exp_gt; omega
  · -- Case: |F2R x| = |F2R y|
    simp only [_root_.F2R, FloatSpec.Core.Defs.F2R] at habs_eq
    have hpow_pos_x : (0 : ℝ) < (beta : ℝ) ^ x.Fexp := zpow_pos hbeta_pos x.Fexp
    have hpow_pos_y : (0 : ℝ) < (beta : ℝ) ^ y.Fexp := zpow_pos hbeta_pos y.Fexp
    rw [abs_mul, abs_mul, abs_of_pos hpow_pos_x, abs_of_pos hpow_pos_y] at habs_eq
    simp only [← int_abs_cast] at habs_eq
    by_cases hxfnum : x.Fnum = 0
    · simp only [hxfnum, abs_zero, Int.cast_zero, zero_mul] at habs_eq
      have hyfnum : y.Fnum = 0 := by
        have h1 : (↑|y.Fnum| : ℝ) * (beta : ℝ) ^ y.Fexp = 0 := by linarith
        rcases mul_eq_zero.mp h1 with hyf | hpow
        · exact abs_eq_zero.mp (Int.cast_eq_zero.mp hyf)
        · exfalso; exact ne_of_gt hpow_pos_y hpow
      rcases hcanX with ⟨⟨hbX_num, hbX_exp⟩, hvnumX⟩ | ⟨⟨hbX_num, hbX_exp⟩, hexpX, hvnumX⟩
      · rw [hradix, hxfnum] at hvnumX; simp at hvnumX
        rw [hxfnum] at hbX_num; simp at hbX_num; omega
      · rcases hcanY with ⟨⟨hbY_num, hbY_exp⟩, hvnumY⟩ | ⟨⟨hbY_num, hbY_exp⟩, hexpY, hvnumY⟩
        · rw [hradix, hyfnum] at hvnumY; simp at hvnumY
          rw [hyfnum] at hbY_num; simp at hbY_num; omega
        · rw [hexpX, hexpY]; simp
    · by_cases hyfnum : y.Fnum = 0
      · simp only [hyfnum, abs_zero, Int.cast_zero, zero_mul] at habs_eq
        have hxfnum_pos : 0 < (↑|x.Fnum| : ℝ) := Int.cast_pos.mpr (abs_pos.mpr hxfnum)
        have h1 : (↑|x.Fnum| : ℝ) * (beta : ℝ) ^ x.Fexp = 0 := habs_eq
        rcases mul_eq_zero.mp h1 with hxf | hpow
        · exact absurd (abs_eq_zero.mp (Int.cast_eq_zero.mp hxf)) hxfnum
        · exact absurd hpow (ne_of_gt hpow_pos_x)
      · -- Both x.Fnum ≠ 0 and y.Fnum ≠ 0
        by_cases hexp_eq : x.Fexp = y.Fexp
        · have h_le : x.Fexp ≤ y.Fexp := le_of_eq hexp_eq
          simp only [PredTrans.pure, Id.run, wp, PostCond.noThrow, PLift.up, h_le]
          trivial
        · by_cases hexp_lt : x.Fexp < y.Fexp
          · have h_le : x.Fexp ≤ y.Fexp := le_of_lt hexp_lt
            simp only [PredTrans.pure, Id.run, wp, PostCond.noThrow, PLift.up, h_le]
            trivial
          · -- x.Fexp > y.Fexp
            have hexp_gt : y.Fexp < x.Fexp := lt_of_le_of_ne (not_lt.mp hexp_lt) (Ne.symm hexp_eq)
            have hd_pos : 0 < x.Fexp - y.Fexp := by omega
            have hpow_factor : (beta : ℝ) ^ x.Fexp = (beta : ℝ) ^ y.Fexp * (beta : ℝ) ^ (x.Fexp - y.Fexp) := by
              rw [← zpow_add₀ (ne_of_gt hbeta_pos)]; congr 1; omega
            -- From equality: |x.Fnum| * beta^x.Fexp = |y.Fnum| * beta^y.Fexp
            have hpy_ne : (beta : ℝ) ^ y.Fexp ≠ 0 := ne_of_gt hpow_pos_y
            have habs_eq' : (↑|x.Fnum| : ℝ) * (beta : ℝ) ^ x.Fexp = (↑|y.Fnum| : ℝ) * (beta : ℝ) ^ y.Fexp := habs_eq
            rw [hpow_factor] at habs_eq'
            have h1 : (↑|x.Fnum| : ℝ) * (beta : ℝ) ^ (x.Fexp - y.Fexp) = (↑|y.Fnum| : ℝ) := by
              field_simp at habs_eq' ⊢
              linarith
            have hpow_ge_beta : (beta : ℝ) ≤ (beta : ℝ) ^ (x.Fexp - y.Fexp) := by
              have hbeta_ge_one : (1 : ℝ) ≤ (beta : ℝ) := by
                have h : ((1 : Int) : ℝ) ≤ (beta : ℝ) := Int.cast_le.mpr hbeta_ge_one_int
                simp only [Int.cast_one] at h
                exact h
              have := zpow_le_zpow_right₀ hbeta_ge_one (by omega : (1 : ℤ) ≤ x.Fexp - y.Fexp)
              simp only [zpow_one] at this
              exact this
            rcases hcanX with ⟨⟨hbX_num, hbX_exp⟩, hvnumX⟩ | ⟨⟨hbX_num, hbX_exp⟩, hexpX, hvnumX⟩
            <;> rcases hcanY with ⟨⟨hbY_num, hbY_exp⟩, hvnumY⟩ | ⟨⟨hbY_num, hbY_exp⟩, hexpY, hvnumY⟩
            -- x normal, y normal
            · rw [hradix] at hvnumX
              have hvnumX' : (b.vNum : ℝ) ≤ (beta : ℝ) * (↑|x.Fnum| : ℝ) := by
                have h : (b.vNum : ℝ) ≤ (↑|beta * x.Fnum| : ℝ) := Int.cast_le.mpr hvnumX
                simp only [Int.cast_abs, Int.cast_mul, abs_mul, abs_of_pos hbeta_pos] at h
                simp only [Int.cast_abs]
                exact h
              have hvnumY' : (↑|y.Fnum| : ℝ) < (b.vNum : ℝ) := Int.cast_lt.mpr hbY_num
              have hxfnum_pos : 0 < (↑|x.Fnum| : ℝ) := Int.cast_pos.mpr (abs_pos.mpr hxfnum)
              have key : (b.vNum : ℝ) ≤ (↑|x.Fnum| : ℝ) * (beta : ℝ) ^ (x.Fexp - y.Fexp) :=
                calc (b.vNum : ℝ) ≤ (beta : ℝ) * (↑|x.Fnum| : ℝ) := hvnumX'
                  _ = (↑|x.Fnum| : ℝ) * (beta : ℝ) := by ring
                  _ ≤ (↑|x.Fnum| : ℝ) * (beta : ℝ) ^ (x.Fexp - y.Fexp) :=
                      mul_le_mul_of_nonneg_left hpow_ge_beta (le_of_lt hxfnum_pos)
              rw [h1] at key; linarith
            -- x normal, y subnormal
            · rw [hradix] at hvnumX
              have hvnumX' : (b.vNum : ℝ) ≤ (beta : ℝ) * (↑|x.Fnum| : ℝ) := by
                have h : (b.vNum : ℝ) ≤ (↑|beta * x.Fnum| : ℝ) := Int.cast_le.mpr hvnumX
                simp only [Int.cast_abs, Int.cast_mul, abs_mul, abs_of_pos hbeta_pos] at h
                simp only [Int.cast_abs]
                exact h
              have hvnumY' : (↑|y.Fnum| : ℝ) < (b.vNum : ℝ) := Int.cast_lt.mpr hbY_num
              have hxfnum_pos : 0 < (↑|x.Fnum| : ℝ) := Int.cast_pos.mpr (abs_pos.mpr hxfnum)
              have key : (b.vNum : ℝ) ≤ (↑|x.Fnum| : ℝ) * (beta : ℝ) ^ (x.Fexp - y.Fexp) :=
                calc (b.vNum : ℝ) ≤ (beta : ℝ) * (↑|x.Fnum| : ℝ) := hvnumX'
                  _ = (↑|x.Fnum| : ℝ) * (beta : ℝ) := by ring
                  _ ≤ (↑|x.Fnum| : ℝ) * (beta : ℝ) ^ (x.Fexp - y.Fexp) :=
                      mul_le_mul_of_nonneg_left hpow_ge_beta (le_of_lt hxfnum_pos)
              rw [h1] at key; linarith
            -- x subnormal, y normal
            · rw [hexpX] at hexp_gt; omega
            -- x subnormal, y subnormal
            · rw [hexpX, hexpY] at hexp_gt; omega

noncomputable def FcanonicLtNeg_check {beta : Int}
    (radix : Int) (b : Fbound_skel)
    (p q : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `FcanonicLtNeg` — for canonical floats `p` and `q`, if
`_root_.F2R q ≤ 0` and `_root_.F2R p < _root_.F2R q`, then either the exponent
of `q` is strictly smaller than the exponent of `p`, or the exponents match and
the mantissa of `p` is strictly smaller.

Note: Uses `Fcanonic'`, the Coq-matching canonical predicate.
This theorem requires the canonical form structure to be meaningful.
Requires `1 < beta` (radixMoreThanOne in Coq) and `radix = beta`. -/
theorem FcanonicLtNeg {beta : Int}
    (radix : Int) (b : Fbound_skel)
    (p q : FloatSpec.Core.Defs.FlocqFloat beta)
    (hβ : 1 < beta)
    (hradix : radix = beta) :
    ⦃⌜Fcanonic' (beta:=beta) radix b p ∧
        Fcanonic' (beta:=beta) radix b q ∧
        _root_.F2R (beta:=beta) q ≤ 0 ∧
        _root_.F2R (beta:=beta) p < _root_.F2R (beta:=beta) q⌝⦄
    (pure (FcanonicLtNeg_check (beta:=beta) radix b p q) : Id Unit)
    ⦃⇓_ => ⌜q.Fexp < p.Fexp ∨
            (p.Fexp = q.Fexp ∧ p.Fnum < q.Fnum)⌝⦄ := by
  intro ⟨hcanP, hcanQ, hNeg, hLt⟩
  simp only [wp, PostCond.noThrow, pure, FcanonicLtNeg_check, ULift.down_up]
  -- Derive beta > 0 from 1 < beta
  have hbeta_pos : (0 : ℝ) < (beta : ℝ) := by
    have : (0 : Int) < beta := lt_trans (by norm_num : (0 : Int) < 1) hβ
    exact Int.cast_pos.mpr this
  -- Derive beta ≥ 1 for exponent comparisons
  have hbeta_ge_one_real : (1 : ℝ) ≤ (beta : ℝ) := by
    have h1le : (1 : ℤ) ≤ beta := le_of_lt hβ
    exact_mod_cast h1le
  -- Unfold F2R to get: p.Fnum * beta ^ p.Fexp < q.Fnum * beta ^ q.Fexp
  simp only [_root_.F2R, FloatSpec.Core.Defs.F2R] at hLt hNeg
  -- Case split on exponent comparison
  by_cases hexp : q.Fexp < p.Fexp
  · left; exact hexp
  · -- q.Fexp ≥ p.Fexp
    push Not at hexp
    by_cases hexp_eq : p.Fexp = q.Fexp
    · -- Exponents equal: compare mantissas
      right
      constructor
      · exact hexp_eq
      · -- Need to show p.Fnum < q.Fnum given F2R p < F2R q and p.Fexp = q.Fexp
        rw [hexp_eq] at hLt
        -- Now hLt : p.Fnum * beta ^ q.Fexp < q.Fnum * beta ^ q.Fexp
        -- Since beta > 0, beta ^ q.Fexp > 0, so we can divide
        have hpow_pos : (0 : ℝ) < (beta : ℝ) ^ q.Fexp := zpow_pos hbeta_pos q.Fexp
        -- Divide both sides by the positive power
        have hpow_ne : (beta : ℝ) ^ q.Fexp ≠ 0 := ne_of_gt hpow_pos
        have h : (p.Fnum : ℝ) < (q.Fnum : ℝ) := by
          calc (p.Fnum : ℝ) = (p.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp / (beta : ℝ) ^ q.Fexp := by
                field_simp
            _ < (q.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp / (beta : ℝ) ^ q.Fexp := by
                apply div_lt_div_of_pos_right hLt hpow_pos
            _ = (q.Fnum : ℝ) := by field_simp
        exact Int.cast_lt.mp h
    · -- q.Fexp > p.Fexp: analogous to FcanonicLtPos for negative case
      have hexp_gt : p.Fexp < q.Fexp := lt_of_le_of_ne hexp (fun h => hexp_eq h)
      -- Case analysis on whether p and q are normal or subnormal
      rcases hcanP with ⟨hbP, hvnumP⟩ | ⟨hbP, hexpP, hvnumP⟩
      <;> rcases hcanQ with ⟨hbQ, hvnumQ⟩ | ⟨hbQ, hexpQ, hvnumQ⟩
      -- Case 1: Both normal
      · exfalso
        rw [hradix] at hvnumP hvnumQ
        -- Since F2R q ≤ 0 and beta^q.Fexp > 0, we have q.Fnum ≤ 0
        have hpow_q_pos : (0 : ℝ) < (beta : ℝ) ^ q.Fexp := zpow_pos hbeta_pos q.Fexp
        have hq_fnum_nonpos : q.Fnum ≤ (0 : ℤ) := by
          by_contra hcontra
          push Not at hcontra
          have hpos : (q.Fnum : ℝ) > 0 := Int.cast_pos.mpr hcontra
          have : (q.Fnum : ℝ) * (beta : ℝ) ^ q.Fexp > 0 :=
            mul_pos hpos hpow_q_pos
          linarith
        -- Since F2R p < F2R q ≤ 0, we have F2R p < 0, so p.Fnum < 0
        have hpow_p_pos : (0 : ℝ) < (beta : ℝ) ^ p.Fexp := zpow_pos hbeta_pos p.Fexp
        have hp_fnum_neg : p.Fnum < (0 : ℤ) := by
          by_contra hcontra
          push Not at hcontra
          have hpos : (p.Fnum : ℝ) ≥ 0 := Int.cast_nonneg hcontra
          have : (p.Fnum : ℝ) * (beta : ℝ) ^ p.Fexp ≥ 0 :=
            mul_nonneg hpos (le_of_lt hpow_p_pos)
          linarith
        -- Normal bounds: b.vNum ≤ |beta * Fnum|
        -- For p: b.vNum ≤ |beta * p.Fnum| = -beta * p.Fnum (since p.Fnum < 0)
        -- For q: b.vNum ≤ |beta * q.Fnum| = -beta * q.Fnum (since q.Fnum ≤ 0)
