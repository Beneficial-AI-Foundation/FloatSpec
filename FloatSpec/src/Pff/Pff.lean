      (radix : ℝ) ^ ((precision : Int) - 1) * (radix : ℝ) ^ e
          = (radix : ℝ) ^ (((precision : Int) - 1) + e) := by
              rw [zpow_add₀ hradix_ne]
      _ = (radix : ℝ) ^ (e + (precision : Int) - 1) := by
              congr 1
              ring
