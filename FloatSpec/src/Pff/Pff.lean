      simpa only [wp, PostCond.noThrow, pure, Fcanonic_Rle_Zle_check,
        Id.run, ULift.up_down, Fcanonic', lower] using
        h ⟨hlowerCan, hfCan, habs⟩
    simpa [lower] using hle
