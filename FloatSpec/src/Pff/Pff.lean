              apply mul_le_mul_of_nonneg_right hFloorLe (le_of_lt hPowPos)
          _ = r₂ * ((radix : ℝ) ^ (-e₂') * (radix : ℝ) ^ e₂') := by ring
          _ = r₂ * (radix : ℝ) ^ ((-e₂') + e₂') := by rw [← zpow_add₀ hRadixNe0]
