  have hqp : q ≤ p := Nat.le_of_not_gt hnot
  have hn_le : (1 : Int) ≤ n := le_of_lt hn
  have hpow_le : n ^ q ≤ n ^ p := pow_le_pow_right₀ hn_le hqp
