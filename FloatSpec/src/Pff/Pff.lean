/-- Coq: `mZlist_correct` — if `p ≤ r ≤ q` then `r ∈ mZlist p q`.
Hoare-triple wrapper; proof deferred. -/
theorem mZlist_correct (p q r : Int) :
    ⦃⌜p ≤ r ∧ r ≤ q⌝⦄
    (pure (mZlist_correct_check p q r) : Id Unit)
    ⦃⇓_ => ⌜List.Mem r (mZlist p q)⌝⦄ := by
  intro ⟨hpr, hrq⟩
