-- Integer power on Int for natural exponent (compat with Coq Zpower_nat)
noncomputable def Zpower_nat (n : Int) (k : Nat) : Int := n ^ k

noncomputable def Zpower_nat_int (n : Int) (k : Nat) : Int := Zpower_nat n k

-- Coq: `EvenExp` — if n is even then n^(S m) is even (nat exponent)
noncomputable def EvenExp_check (n : Int) (m : Nat) : Unit :=
  ()

theorem EvenExp (n : Int) (m : Nat) :
    ⦃⌜Even n⌝⦄
    (pure (EvenExp_check n m) : Id Unit)
    ⦃⇓_ => ⌜Even (Zpower_nat_int n (Nat.succ m))⌝⦄ := by
  intro hev
  simp only [wp, PostCond.noThrow, pure, EvenExp_check, Zpower_nat_int]
  exact hev.pow_of_ne_zero (Nat.succ_ne_zero m)

-- Coq: `OddExp` — if n is odd then n^m is odd (nat exponent)
noncomputable def OddExp_check (n : Int) (m : Nat) : Unit :=
  ()

theorem OddExp (n : Int) (m : Nat) :
    ⦃⌜Odd n⌝⦄
    (pure (OddExp_check n m) : Id Unit)
    ⦃⇓_ => ⌜Odd (Zpower_nat_int n m)⌝⦄ := by
  intro hodd
  simp [wp, PostCond.noThrow, pure, OddExp_check, Zpower_nat_int, ULift.down_up] at hodd ⊢
  exact hodd.pow

-- Float-level parity wrappers and lemmas (Lean skeletons mirroring Coq)
def Feven {beta : Int}
    (p : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  Even p.Fnum

def Fodd {beta : Int}
    (p : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  Odd p.Fnum

noncomputable def FevenOrFodd_check {beta : Int}
    (p : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

theorem FevenOrFodd {beta : Int}
    (p : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜True⌝⦄
    (pure (FevenOrFodd_check (beta:=beta) p) : Id Unit)
    ⦃⇓_ => ⌜Feven (beta:=beta) p ∨ Fodd (beta:=beta) p⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, FevenOrFodd_check, Feven, Fodd]
  exact Int.even_or_odd p.Fnum

-- ---------------------------------------------------------------------------
-- Rounded-mode predicate framework (Coq FRound section, minimized shell)
-- We provide lightweight predicate encodings to state meta-theorems such as
-- RoundedModeP_inv2 / RoundedModeP_inv4. Detailed semantics (isMin/isMax,
-- boundedness, projector properties) are intentionally deferred.

-- Totality of a rounding relation P
def TotalP {α : Type} (P : ℝ → α → Prop) : Prop :=
  ∀ r : ℝ, ∃ p : α, P r p

-- Compatibility of P under equal real value and representation equality
def CompatibleP {α : Type} (P : ℝ → α → Prop) : Prop :=
  ∀ r1 r2 : ℝ, ∀ p q : α, P r1 p → r1 = r2 → p = q → P r2 q

-- Monotonicity: if p < q (reals) and P p p', P q q' then F2R p' ≤ F2R q'.
-- For a generic type α, we require a coercion to ℝ.
-- Coq definition: ∀ (p q : R) (p' q' : float), p < q → P p p' → P q q' → p' ≤ q'
-- where p' ≤ q' is interpreted as FtoR radix p' ≤ FtoR radix q'.
-- For genericity, we parameterize over a function toReal : α → ℝ.
def MonotoneP_with {α : Type} (toReal : α → ℝ) (P : ℝ → α → Prop) : Prop :=
  ∀ (p q : ℝ) (p' q' : α), p < q → P p p' → P q q' → toReal p' ≤ toReal q'

-- For FlocqFloat, the natural toReal is F2R
def MonotoneP_float {beta : Int} (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop) : Prop :=
  MonotoneP_with (_root_.F2R (beta := beta)) P

-- Generic fallback: without a float interpretation for `α`, monotonicity can
-- only be expressed as representation uniqueness across increasing inputs.
-- Flocq-aligned float developments should use `MonotoneP_float`.
def MonotoneP {α : Type} (P : ℝ → α → Prop) : Prop :=
  ∀ (p q : ℝ) (p' q' : α), p < q → P p p' → P q q' → p' = q'

-- Generic fallback for the Flocq min/max disjunction.  The faithful
-- float-specific content is carried by `isMin'`/`isMax'`; this generic form
-- requires uniqueness at each rounded real instead of silently returning `True`.
def MinOrMaxP {α : Type} (P : ℝ → α → Prop) : Prop :=
  ∀ (r : ℝ) (p q : α), P r p → P r q → p = q

-- Rounded-mode package
def RoundedModeP {α : Type} (P : ℝ → α → Prop) : Prop :=
  TotalP P ∧ CompatibleP P ∧ MinOrMaxP P ∧ MonotoneP P

-- Uniqueness of a rounding relation P
def UniqueP {α : Type} (P : ℝ → α → Prop) : Prop :=
  ∀ r p q, P r p → P r q → p = q

-- Generic projector fallback.  Coq's `ProjectorP` is float-specific and uses
-- bounded floats plus real-value equality; in this generic shell we require
-- uniqueness of outputs at the same real input.
def ProjectorP {α : Type} (P : ℝ → α → Prop) : Prop :=
  ∀ (r : ℝ) (p q : α), P r p → P r q → p = q

-- ---------------------------------------------------------------------------
-- Minimal bound skeleton + helper predicates (shared across Pff specs)

structure Fbound_skel where
  -- Minimal exponent field needed by several Pff theorems (e.g. RleRoundedAbs)
  dExp : Int := 0
  vNum : Int := 1

/-- Coq Veltkamp helper `plusExp`.

It keeps the same mantissa bound and raises `dExp` by `precision - 1`, which
lowers the minimal admissible exponent.  This is the enlarged bound used in
the subnormal Veltkamp branch. -/
def plusExp (b : Fbound_skel) (precision : Nat) : Fbound_skel :=
  { dExp := b.dExp + ((precision - 1 : Nat) : Int), vNum := b.vNum }

/-- Coq Veltkamp reduced bound `b'`.

The reduced Veltkamp bound keeps the original exponent field and uses
precision `t - s` for the mantissa bound. -/
noncomputable def Veltkamp_reducedBound (beta : Int) (b : Fbound_skel) (s t : Nat) :
    Fbound_skel :=
  { dExp := b.dExp, vNum := Zpower_nat beta (t - s) }

/-- Coq: `p'GivesBound`, the mantissa-bound equation for `b'`. -/
theorem p'GivesBound (beta : Int) (b : Fbound_skel) (s t : Nat) :
    (Veltkamp_reducedBound beta b s t).vNum = Zpower_nat beta (t - s) := by
  rfl

/-- Coq Dekker local bound `bt`.

The Dekker split bound keeps the original exponent field and uses precision
`s` for the mantissa bound. -/
noncomputable def Veltkamp_splitBound (beta : Int) (b : Fbound_skel) (s : Nat) :
    Fbound_skel :=
  { dExp := b.dExp, vNum := Zpower_nat beta s }

/-- Coq: `p''GivesBound`, the mantissa-bound equation for `bt`. -/
theorem p''GivesBound (beta : Int) (b : Fbound_skel) (s : Nat) :
    (Veltkamp_splitBound beta b s).vNum = Zpower_nat beta s := by
  rfl

/-- Coq Dekker `b'` from section `Algo2`.

The Coq bound keeps `vNum b` and sets
`dExp b' = N.double (dExp b) + N.double (Npos (P_of_succ_nat t))`,
which coerces to `2 * dExp b + 2 * t + 2` over integers. -/
def Dekker_extendedBound (b : Fbound_skel) (t : Nat) : Fbound_skel :=
  { dExp := 2 * b.dExp + 2 * (t : Int) + 2, vNum := b.vNum }

/-- Coq: `dExpPrim`, the local exponent of Dekker's `b'` strictly extends `b`.

In Coq this follows from `dExp b : N`; the Lean skeleton uses `Int`, so the
nonnegativity of `b.dExp` is explicit. -/
theorem dExpPrim (b : Fbound_skel) (t : Nat) (hdExp : 0 ≤ b.dExp) :
    b.dExp < (Dekker_extendedBound b t).dExp := by
  have ht : 0 ≤ (t : Int) := Int.natCast_nonneg t
  dsimp [Dekker_extendedBound]
  omega

/-- Coq: `dExpPrimEq`, the integer expansion of Dekker's local `b'` exponent. -/
theorem dExpPrimEq (b : Fbound_skel) (t : Nat) :
    (Dekker_extendedBound b t).dExp = 2 * b.dExp + 2 * (t : Int) + 2 := by
  rfl

-- Coq: Fbounded b d := (Z.abs (Fnum d) < Zpos (vNum b))%Z /\ (- dExp b <= Fexp d)%Z
def Fbounded {beta : Int}
    (bo : Fbound_skel)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  |f.Fnum| < bo.vNum ∧ -bo.dExp ≤ f.Fexp

-- Backward-compatible alias kept for proofs that were already moved to the
-- faithful boundedness predicate.
def Fbounded' {beta : Int}
    (bo : Fbound_skel)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  Fbounded bo f

def isMin {α : Type} (b : Fbound_skel) (radix : Int) : ℝ → α → Prop :=
  fun _ x => ∀ y : α, y = x

def isMax {α : Type} (b : Fbound_skel) (radix : Int) : ℝ → α → Prop :=
  fun _ x => ∀ y : α, y = x

-- Proper Coq-matching isMin predicate for floats
-- Coq: isMin r min := Fbounded b min ∧ (min ≤ r) ∧ (∀ f, Fbounded b f → (f ≤ r) → (f ≤ min))
def isMin' {beta : Int} (b : Fbound_skel) (radix : Int) :
    ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop :=
  fun r min => Fbounded' b min ∧
    (_root_.F2R min ≤ r) ∧
    (∀ f : FloatSpec.Core.Defs.FlocqFloat beta, Fbounded' b f → _root_.F2R f ≤ r → _root_.F2R f ≤ _root_.F2R min)

-- Proper Coq-matching isMax predicate for floats
-- Coq: isMax r max := Fbounded b max ∧ (r ≤ max) ∧ (∀ f, Fbounded b f → (r ≤ f) → (max ≤ f))
def isMax' {beta : Int} (b : Fbound_skel) (radix : Int) :
    ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop :=
  fun r max => Fbounded' b max ∧
    (r ≤ _root_.F2R max) ∧
    (∀ f : FloatSpec.Core.Defs.FlocqFloat beta, Fbounded' b f → r ≤ _root_.F2R f → _root_.F2R max ≤ _root_.F2R f)

-- Coq: `MinOrMax z f := isMin b radix z f \/ isMax b radix z f`.
def MinOrMax {beta : Int} (b : Fbound_skel) (radix : Int) :
    ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop :=
  fun z f => isMin' (beta:=beta) b radix z f ∨
    isMax' (beta:=beta) b radix z f

-- Float-specific Coq-matching min/max disjunction.
-- Coq: MinOrMaxP P := ∀ r p, P r p -> isMin r p \/ isMax r p.
def MinOrMaxP_float {beta : Int} (b : Fbound_skel) (radix : Int)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop) : Prop :=
  ∀ (r : ℝ) (p : FloatSpec.Core.Defs.FlocqFloat beta),
    P r p → isMin' (beta:=beta) b radix r p ∨ isMax' (beta:=beta) b radix r p

-- ---------------------------------------------------------------------------
-- Float-specific rounding properties (matching Coq Pff semantics)

-- Projector property for floats: bounded floats round to themselves
def ProjectorP_float {beta : Int} (b : Fbound_skel)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop) : Prop :=
  ∀ p : FloatSpec.Core.Defs.FlocqFloat beta,
    Fbounded b p → P (_root_.F2R p) p

-- Projector equality: if P (F2R p) q for bounded p, then F2R p = F2R q
def ProjectorEqP_float {beta : Int} (b : Fbound_skel)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop) : Prop :=
  ∀ p q : FloatSpec.Core.Defs.FlocqFloat beta,
    Fbounded b p → P (_root_.F2R p) q → _root_.F2R p = _root_.F2R q

-- Full rounded-mode package for floats with all required properties
def RoundedModeP_full {beta : Int} (b : Fbound_skel)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop) : Prop :=
  TotalP P ∧ CompatibleP P ∧ MonotoneP_float P ∧
  ProjectorP_float b P ∧ ProjectorEqP_float b P

-- Coq's `RoundedModeP` package specialized to concrete float predicates.
-- The generic `RoundedModeP` above is representation-based; Flocq-facing
-- theorems use this package when the upstream theorem only needs totality,
-- compatibility, min-or-max, and monotonicity.
def RoundedModeP_float {beta : Int} (b : Fbound_skel) (radix : Int)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop) : Prop :=
  TotalP P ∧ CompatibleP P ∧
    MinOrMaxP_float (beta:=beta) b radix P ∧ MonotoneP_float P

-- ---------------------------------------------------------------------------
-- Coq-style `Fulp` is defined after `Fnormalize`, because Flocq defines it as
-- the radix power at the normalized exponent of the float.

-- Coq: `RleBoundRoundl` — rounding preserves lower bounds
noncomputable def RleBoundRoundl_check {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop)
    (p q : FloatSpec.Core.Defs.FlocqFloat beta) (r : ℝ) : Unit :=
  ()

/-- Coq: `RleBoundRoundl` — if `P` forms a rounded mode and `p ≤ r`, then
    any `q` produced by rounding `r` also satisfies `p ≤ q`.

    Note: We use `RoundedModeP_full` which includes the float-specific
    monotonicity and projector properties needed for this proof. -/
theorem RleBoundRoundl {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop)
    (p q : FloatSpec.Core.Defs.FlocqFloat beta) (r : ℝ) :
    ⦃⌜RoundedModeP_full (beta:=beta) b P ∧ Fbounded (beta:=beta) b p ∧
        (_root_.F2R (beta:=beta) p ≤ r) ∧ P r q⌝⦄
    (pure (RleBoundRoundl_check (beta:=beta) b radix P p q r) : Id Unit)
    ⦃⇓_ => ⌜_root_.F2R (beta:=beta) p ≤ _root_.F2R (beta:=beta) q⌝⦄ := by
  intro ⟨hRoundedMode, hBounded, hLeq, hPrq⟩
  simp only [wp, PostCond.noThrow, pure, RleBoundRoundl_check]
  -- Unpack RoundedModeP_full: TotalP P ∧ CompatibleP P ∧ MonotoneP_float P ∧
  --                           ProjectorP_float b P ∧ ProjectorEqP_float b P
  obtain ⟨_, _, hMono, hProj, hProjEq⟩ := hRoundedMode
  -- Case split: either F2R p < r or F2R p = r
  rcases hLeq.lt_or_eq with hLt | hEq
  · -- Case: F2R p < r
    -- By ProjectorP_float: P (F2R p) p (bounded floats round to themselves)
    have hPpp : P (_root_.F2R p) p := hProj p hBounded
    -- By MonotoneP_float: if F2R p < r and P (F2R p) p and P r q, then F2R p ≤ F2R q
    exact hMono (_root_.F2R p) r p q hLt hPpp hPrq
  · -- Case: F2R p = r
    -- By ProjectorEqP_float: if Fbounded p and P (F2R p) q, then F2R p = F2R q
    -- Since F2R p = r, we have P (F2R p) q = P r q = hPrq
    have hP_F2R_q : P (_root_.F2R p) q := by rw [hEq]; exact hPrq
    have hEqReal : _root_.F2R p = _root_.F2R q := hProjEq p q hBounded hP_F2R_q
    exact le_of_eq hEqReal

noncomputable def RleBoundRoundr_check {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop)
    (p q : FloatSpec.Core.Defs.FlocqFloat beta) (r : ℝ) : Unit :=
  ()

/-- Coq: `RleBoundRoundr` — if `P` forms a rounded mode and `r ≤ _root_.F2R p`,
    any `q` produced by rounding `r` also satisfies `_root_.F2R q ≤ _root_.F2R p`.

    Note: We use `RoundedModeP_full` which includes the float-specific
    monotonicity and projector properties needed for this proof (matching RleBoundRoundl). -/
theorem RleBoundRoundr {beta : Int}
    (b : Fbound_skel) (radix : Int)
    (P : ℝ → FloatSpec.Core.Defs.FlocqFloat beta → Prop)
    (p q : FloatSpec.Core.Defs.FlocqFloat beta) (r : ℝ) :
    ⦃⌜RoundedModeP_full (beta:=beta) b P ∧ Fbounded (beta:=beta) b p ∧
        (r ≤ _root_.F2R (beta:=beta) p) ∧ P r q⌝⦄
    (pure (RleBoundRoundr_check (beta:=beta) b radix P p q r) : Id Unit)
    ⦃⇓_ => ⌜_root_.F2R (beta:=beta) q ≤ _root_.F2R (beta:=beta) p⌝⦄ := by
  intro ⟨hRoundedMode, hBounded, hLeq, hPrq⟩
  simp only [wp, PostCond.noThrow, pure, RleBoundRoundr_check]
  -- Unpack RoundedModeP_full: TotalP P ∧ CompatibleP P ∧ MonotoneP_float P ∧
  --                           ProjectorP_float b P ∧ ProjectorEqP_float b P
  obtain ⟨_, _, hMono, hProj, hProjEq⟩ := hRoundedMode
  -- Case split: either r < F2R p or r = F2R p
  rcases hLeq.lt_or_eq with hLt | hEq
  · -- Case: r < F2R p
    -- By ProjectorP_float: P (F2R p) p (bounded floats round to themselves)
    have hPpp : P (_root_.F2R p) p := hProj p hBounded
    -- By MonotoneP_float: if r < F2R p and P r q and P (F2R p) p, then F2R q ≤ F2R p
    exact hMono r (_root_.F2R p) q p hLt hPrq hPpp
  · -- Case: r = F2R p
    -- By ProjectorEqP_float: if Fbounded p and P (F2R p) q, then F2R p = F2R q
    -- Since r = F2R p, we have P r q = P (F2R p) q
    have hP_F2R_q : P (_root_.F2R p) q := by rw [← hEq]; exact hPrq
    have hEqReal : _root_.F2R p = _root_.F2R q := hProjEq p q hBounded hP_F2R_q
    exact le_of_eq hEqReal.symm

/-- Minimal normal mantissa (`nNormMin`) defined using a positive-exponent power. -/
noncomputable def nNormMin (radix : Int) (precision : Nat) : Int :=
  radix ^ (precision - 1)

/-- Coq: `PosNormMin` — the positive mantissa bound is `radix * nNormMin`. -/
theorem PosNormMin (radix : Int) (b : Fbound_skel) (precision : Nat) :
    0 < precision →
    b.vNum = Zpower_nat radix precision →
    b.vNum = radix * nNormMin radix precision := by
  intro hprecision hvNum
  rw [hvNum]
  cases precision with
  | zero => cases hprecision
  | succ p =>
      simp [Zpower_nat, nNormMin, pow_succ, mul_comm]

/-- Coq: `pPred (vNum b)` is the predecessor of the positive mantissa bound. -/
noncomputable def pPred (n : Int) : Int :=
  n - 1

-- Coq: `firstNormalPos_eq` — value of the first normal positive float
noncomputable def firstNormalPos {beta : Int}
    (radix : Int) (b : Fbound_skel) (precision : Nat) :
    FloatSpec.Core.Defs.FlocqFloat beta :=
  ⟨nNormMin radix precision, -b.dExp⟩

noncomputable def firstNormalPos_eq_check {beta : Int}
    (radix : Int) (b : Fbound_skel) (precision : Nat) : Unit :=
  ()

/-- Coq: `firstNormalPos_eq` — interpreting the `firstNormalPos` float at
    base `radix` equals the real value `(nNormMin radix precision : ℝ) * (radix : ℝ) ^ (-b.dExp)`.
    Following the file's Hoare-triple convention.

    Note: Requires `beta = radix` since F2R uses the type-level `beta` as base,
    while `firstNormalPos` constructs the mantissa using `radix`. -/
theorem firstNormalPos_eq {beta : Int}
    (radix : Int) (b : Fbound_skel) (precision : Nat) :
    ⦃⌜beta = radix⌝⦄
    (pure (firstNormalPos_eq_check (beta:=beta) radix b precision) : Id Unit)
    ⦃⇓_ => ⌜_root_.F2R (beta:=beta) (firstNormalPos (beta:=beta) radix b precision)
            = (nNormMin radix precision : ℝ) * (radix : ℝ) ^ (-b.dExp)⌝⦄ := by
  intro hBetaEqRadix
  simp only [wp, PostCond.noThrow, pure, firstNormalPos_eq_check,
             _root_.F2R, firstNormalPos, nNormMin,
             FloatSpec.Core.Defs.FlocqFloat.Fnum, FloatSpec.Core.Defs.FlocqFloat.Fexp,
             FloatSpec.Core.Defs.F2R]
  -- The goal is: (radix ^ (precision - 1) : ℝ) * (beta : ℝ) ^ (-b.dExp) =
  --              (radix ^ (precision - 1) : ℝ) * (radix : ℝ) ^ (-b.dExp)
  -- Since beta = radix (from hBetaEqRadix which is ⌜beta = radix⌝.down), this follows
  -- Extract the underlying Int equality from the lifted proposition
  have hEq : beta = radix := hBetaEqRadix
  -- Convert Int equality to Real equality using congruence
  have hEqReal : (beta : ℝ) = (radix : ℝ) := congrArg (Int.cast) hEq
  rw [hEqReal]
  -- Goal is now reflexive: a = a
  rfl

-- ---------------------------------------------------------------------------
-- Closest/Normal predicates (from Pff.v sections)

-- Coq: Closest r p := Fbounded b p /\
--   forall f, Fbounded b f -> Rabs (p - r) <= Rabs (f - r).
def Closest {beta : Int}
    (bo : Fbound_skel) (radix : ℝ) (r : ℝ)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  Fbounded bo f ∧
    ∀ g : FloatSpec.Core.Defs.FlocqFloat beta,
      Fbounded bo g →
        |_root_.F2R f - r| ≤ |_root_.F2R g - r|

/-- Coq: `Closestbplusb` — closestness for the enlarged `plusExp` bound
restricts to closestness for the original bound. -/
theorem Closestbplusb {beta : Int}
    (b : Fbound_skel) (radix : ℝ) (precision : Nat)
    (z : ℝ) (f : FloatSpec.Core.Defs.FlocqFloat beta)
    (hClosest : Closest (beta:=beta) (plusExp b precision) radix z f)
    (hfBound : Fbounded (beta:=beta) b f) :
    Closest (beta:=beta) b radix z f := by
  constructor
  · exact hfBound
  · intro g hg
    exact hClosest.2 g (by
      rcases hg with ⟨hgNum, hgExp⟩
      constructor
      · simpa [plusExp] using hgNum
      · dsimp [plusExp]
        have hnonneg : (0 : Int) ≤ ((precision - 1 : Nat) : Int) :=
          Int.natCast_nonneg _
        omega)

noncomputable def TwoSumProp_check {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (a b x y : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `TwoSumProp`.

If `x` is a closest rounded value of `a + b` and `y` represents the residual
`a + b - x`, then the residual is no larger in absolute value than `b`. -/
theorem TwoSumProp {beta : Int}
    (bo : Fbound_skel) (radix : ℝ)
    (a b x y : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜Fbounded (beta:=beta) bo a ∧
        Closest (beta:=beta) bo radix
          (_root_.F2R (beta:=beta) a + _root_.F2R (beta:=beta) b) x ∧
        _root_.F2R (beta:=beta) y =
          _root_.F2R (beta:=beta) a + _root_.F2R (beta:=beta) b -
            _root_.F2R (beta:=beta) x⌝⦄
    (pure (TwoSumProp_check (beta:=beta) bo radix a b x y) : Id Unit)
    ⦃⇓_ => ⌜|_root_.F2R (beta:=beta) y| ≤
      |_root_.F2R (beta:=beta) b|⌝⦄ := by
  intro h
  rcases h with ⟨ha, hxClosest, hy⟩
  simp only [wp, PostCond.noThrow, pure, TwoSumProp_check, Id.run,
    ULift.up_down]
  let r : ℝ := _root_.F2R (beta:=beta) a + _root_.F2R (beta:=beta) b
  have hdist :
      |_root_.F2R (beta:=beta) x - r| ≤
        |_root_.F2R (beta:=beta) a - r| :=
    hxClosest.2 a ha
  have hy_abs :
      |_root_.F2R (beta:=beta) y| =
        |_root_.F2R (beta:=beta) x - r| := by
    have hy' :
        _root_.F2R (beta:=beta) y =
          -(_root_.F2R (beta:=beta) x - r) := by
      dsimp [r]
      rw [hy]
      ring
    rw [hy', abs_neg]
  have hb_abs :
      |_root_.F2R (beta:=beta) a - r| =
        |_root_.F2R (beta:=beta) b| := by
    have hdiff :
        _root_.F2R (beta:=beta) a - r =
          -_root_.F2R (beta:=beta) b := by
      dsimp [r]
      ring
    rw [hdiff, abs_neg]
  rw [hy_abs]
  exact le_trans hdist (le_of_eq hb_abs)

-- Coq: Fnormal p := Fbounded b p /\ (Zpos (vNum b) <= Z.abs (radix * Fnum p))%Z
def Fnormal {beta : Int}
    (radix : Int) (bo : Fbound_skel)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  Fbounded bo f ∧ bo.vNum ≤ |radix * f.Fnum|

-- Coq: Fsubnormal p := Fbounded b p /\ Fexp p = (- dExp b)%Z /\
--   (Z.abs (radix * Fnum p) < Zpos (vNum b))%Z
def Fsubnormal {beta : Int}
    (radix : Int) (bo : Fbound_skel)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  Fbounded bo f ∧ f.Fexp = -bo.dExp ∧ |radix * f.Fnum| < bo.vNum

-- Backward-compatible alias used by proofs that already avoided the old shell.
def Fnormal' {beta : Int}
    (radix : Int) (bo : Fbound_skel)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  Fnormal radix bo f

-- Backward-compatible alias used by proofs that already avoided the old shell.
def Fsubnormal' {beta : Int}
    (radix : Int) (bo : Fbound_skel)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  Fsubnormal radix bo f

-- Coq: `Fdigit p := digit radix (Fnum p)`.
noncomputable def Fdigit {beta : Int}
    (radix : Int) (x : FloatSpec.Core.Defs.FlocqFloat beta) : Nat :=
  Int.toNat (FloatSpec.Core.Digits.Zdigits radix x.Fnum)

-- Coq: `Fshift n x := Float (Fnum x * Zpower_nat radix n) (Fexp x - n)`.
noncomputable def Fshift {beta : Int}
    (radix : Int) (n : Nat) (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    FloatSpec.Core.Defs.FlocqFloat beta :=
  ⟨x.Fnum * radix ^ n, x.Fexp - (n : Int)⟩

private theorem Fshift_value {beta : Int}
    (radix : Int) (n : Nat) (x : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta_radix : beta = radix) (hradix : 1 < radix) :
    _root_.F2R (beta:=beta) (Fshift (beta:=beta) radix n x) =
      _root_.F2R (beta:=beta) x := by
  subst beta
  have hradix_pos_real : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast (by omega : (0 : Int) < radix)
  have hradix_ne_real : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos_real
  have hsplit :
      (radix : ℝ) ^ x.Fexp =
        (radix : ℝ) ^ (n : Int) * (radix : ℝ) ^ (x.Fexp - (n : Int)) := by
    have hsum : (n : Int) + (x.Fexp - (n : Int)) = x.Fexp := by omega
    simpa [hsum] using
      (zpow_add₀ hradix_ne_real (n : Int) (x.Fexp - (n : Int)))
  simp only [_root_.F2R, FloatSpec.Core.Defs.F2R, Fshift,
    FloatSpec.Core.Defs.FlocqFloat.Fnum, FloatSpec.Core.Defs.FlocqFloat.Fexp,
    Int.cast_mul, Int.cast_pow]
  have hzpow_n : (radix : ℝ) ^ (n : Int) = (radix : ℝ) ^ n :=
    zpow_ofNat (radix : ℝ) n
  rw [hsplit]
  rw [hzpow_n]
  ring_nf

-- Predicate: zero mantissa (Coq: `is_Fzero`). Placed early for downstream uses.
def is_Fzero {beta : Int} (x : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  x.Fnum = 0

/-!
Coq: `FSucc` / `FPred` and `Fnormalize`.

These definitions are placed before `FNSucc`/`FNPred` so the public normalized
neighbor aliases can match Flocq:
`FNSucc x := FSucc (Fnormalize radix b precision x)`.
-/

noncomputable def FSucc {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    FloatSpec.Core.Defs.FlocqFloat beta :=
  if x.Fnum = pPred b.vNum then
    ⟨nNormMin radix precision, x.Fexp + 1⟩
  else if x.Fnum = -nNormMin radix precision then
    if x.Fexp = -b.dExp then
      ⟨x.Fnum + 1, x.Fexp⟩
    else
      ⟨-pPred b.vNum, x.Fexp - 1⟩
  else
    ⟨x.Fnum + 1, x.Fexp⟩

noncomputable def FPred {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    FloatSpec.Core.Defs.FlocqFloat beta :=
  if x.Fnum = -pPred b.vNum then
    ⟨-nNormMin radix precision, x.Fexp + 1⟩
  else if x.Fnum = nNormMin radix precision then
    if x.Fexp = -b.dExp then
      ⟨x.Fnum - 1, x.Fexp⟩
    else
      ⟨pPred b.vNum, x.Fexp - 1⟩
  else
    ⟨x.Fnum - 1, x.Fexp⟩

/-- Coq: `Fnormalize`.

Zero is represented with the boundary exponent `-b.dExp`; nonzero floats are
shifted just enough to fit the requested precision without crossing the
minimum exponent. -/
noncomputable def Fnormalize {beta : Int}
    (radix : Int) (b : Fbound_skel) (precision : Nat)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) :
    FloatSpec.Core.Defs.FlocqFloat beta :=
  if p.Fnum = 0 then
    ⟨0, -b.dExp⟩
  else
    Fshift (beta:=beta) radix
      (min (precision - Fdigit (beta:=beta) radix p)
        (Int.natAbs (b.dExp + p.Fexp)))
      p

private lemma Fdigit_Fopp {beta : Int}
    (radix : Int) (p : FloatSpec.Core.Defs.FlocqFloat beta) :
    Fdigit (beta:=beta) radix (FloatSpec.Calc.Operations.Fopp (beta:=beta) p) =
      Fdigit (beta:=beta) radix p := by
  cases p with
  | mk m e =>
    unfold Fdigit FloatSpec.Calc.Operations.Fopp
    have h := FloatSpec.Core.Digits.Zdigits_opp (beta := radix) (n := m) (by trivial)
    simp only [wp, PostCond.noThrow, pure, Id.run] at h
    rcases h with ⟨dn, hdn, hd⟩
    exact congrArg Int.toNat (hd.trans hdn.symm)

private lemma Fdigit_Fabs_early {beta : Int}
    (radix : Int) (p : FloatSpec.Core.Defs.FlocqFloat beta) :
    Fdigit (beta:=beta) radix (FloatSpec.Calc.Operations.Fabs (beta:=beta) p) =
      Fdigit (beta:=beta) radix p := by
  cases p with
  | mk m e =>
    unfold Fdigit FloatSpec.Calc.Operations.Fabs
    change Int.toNat (FloatSpec.Core.Digits.Zdigits radix ((m.natAbs : Nat) : Int)) =
      Int.toNat (FloatSpec.Core.Digits.Zdigits radix m)
    have h := FloatSpec.Core.Digits.Zdigits_abs (beta := radix) (n := m) (by trivial)
    simp only [wp, PostCond.noThrow, pure, Id.run] at h
    rcases h with ⟨dn, hdn, hd⟩
    exact congrArg Int.toNat (hd.trans hdn.symm)

noncomputable def Fnormalize_Fopp_check {beta : Int}
    (radix : Int) (b : Fbound_skel) (precision : Nat)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `Fnormalize_Fopp` — normalization commutes with float negation. -/
theorem Fnormalize_Fopp {beta : Int}
    (radix : Int) (b : Fbound_skel) (precision : Nat)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜True⌝⦄
    (pure (Fnormalize_Fopp_check (beta:=beta) radix b precision p) : Id Unit)
    ⦃⇓_ => ⌜Fnormalize (beta:=beta) radix b precision
          (FloatSpec.Calc.Operations.Fopp (beta:=beta) p) =
        FloatSpec.Calc.Operations.Fopp (beta:=beta)
          (Fnormalize (beta:=beta) radix b precision p)⌝⦄ := by
  intro _
  simp only [wp, PostCond.noThrow, pure, Fnormalize_Fopp_check, Id.run,
    ULift.up_down]
  cases p with
  | mk m e =>
    unfold Fnormalize FloatSpec.Calc.Operations.Fopp Fshift
    by_cases hm : m = 0
    · simp [hm]
    · have hneg : -m ≠ 0 := by omega
      have hfd :
          Fdigit (beta:=beta) radix { Fnum := -m, Fexp := e } =
            Fdigit (beta:=beta) radix { Fnum := m, Fexp := e } := by
        simpa [FloatSpec.Calc.Operations.Fopp] using
          (Fdigit_Fopp (beta:=beta) radix { Fnum := m, Fexp := e })
      simp [hm, hneg, hfd]

noncomputable def Fnormalize_Fabs_check {beta : Int}
    (radix : Int) (b : Fbound_skel) (precision : Nat)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Local bridge: normalization commutes with float absolute value. -/
theorem Fnormalize_Fabs {beta : Int}
    (radix : Int) (b : Fbound_skel) (precision : Nat)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜0 < radix⌝⦄
    (pure (Fnormalize_Fabs_check (beta:=beta) radix b precision p) : Id Unit)
    ⦃⇓_ => ⌜Fnormalize (beta:=beta) radix b precision
          (FloatSpec.Calc.Operations.Fabs (beta:=beta) p) =
        FloatSpec.Calc.Operations.Fabs (beta:=beta)
          (Fnormalize (beta:=beta) radix b precision p)⌝⦄ := by
  intro hradix_pos
  simp only [wp, PostCond.noThrow, pure, Fnormalize_Fabs_check, Id.run,
    ULift.up_down]
  cases p with
  | mk m e =>
    unfold Fnormalize FloatSpec.Calc.Operations.Fabs Fshift
    by_cases hm : m = 0
    · simp [hm]
    · have habs_ne : (m.natAbs : Int) ≠ 0 := by
        intro hzero
        have hm_abs_zero : m.natAbs = 0 := by exact_mod_cast hzero
        exact hm (Int.natAbs_eq_zero.mp hm_abs_zero)
      have hfd :
          Fdigit (beta:=beta) radix { Fnum := (m.natAbs : Int), Fexp := e } =
            Fdigit (beta:=beta) radix { Fnum := m, Fexp := e } := by
        simpa [FloatSpec.Calc.Operations.Fabs] using
          (Fdigit_Fabs_early (beta:=beta) radix { Fnum := m, Fexp := e })
      let n :=
        min (precision - Fdigit (beta:=beta) radix { Fnum := m, Fexp := e })
          (Int.natAbs (b.dExp + e))
      have hn :
          min
              (precision -
                Fdigit (beta:=beta) radix { Fnum := (m.natAbs : Int), Fexp := e })
              (Int.natAbs (b.dExp + e)) = n := by
        simp only [n, hfd]
      have hpow_nonneg : 0 ≤ radix ^ n := by
        exact pow_nonneg (le_of_lt hradix_pos) n
      have hnum_abs :
          ((m * radix ^ n).natAbs : Int) = (m.natAbs : Int) * radix ^ n := by
        rw [Int.natAbs_mul, Nat.cast_mul]
        congr 1
        exact Int.natAbs_of_nonneg hpow_nonneg
      simp only [wp, PostCond.noThrow, pure, Id.run, ULift.up_down,
        PredTrans.pure, PredTrans.apply, ULift.down, hm, habs_ne, if_false]
      change
        ({ Fnum :=
              (m.natAbs : Int) *
                radix ^ min
                  (precision -
                    Fdigit (beta:=beta) radix { Fnum := (m.natAbs : Int), Fexp := e })
                  (Int.natAbs (b.dExp + e)),
            Fexp :=
              e - (min
                (precision -
                  Fdigit (beta:=beta) radix { Fnum := (m.natAbs : Int), Fexp := e })
                (Int.natAbs (b.dExp + e)) : Nat) } :
          FloatSpec.Core.Defs.FlocqFloat beta) =
        { Fnum :=
            ((m * radix ^ min
              (precision - Fdigit (beta:=beta) radix { Fnum := m, Fexp := e })
              (Int.natAbs (b.dExp + e))).natAbs : Int),
          Fexp :=
            e - (min
              (precision - Fdigit (beta:=beta) radix { Fnum := m, Fexp := e })
              (Int.natAbs (b.dExp + e)) : Nat) }
      rw [hn, hnum_abs]

-- ---------------------------------------------------------------------------
-- Parity on normalized floats and neighbor operations

-- Coq uses predicates like FNeven/FNodd and neighbors FNSucc/FNPred.
-- FNeven/FNodd are parity predicates on the normalized representation.
-- The local signatures keep `radix : ℝ` for existing callers; the integer
-- radix used by the translated Pff section is the type-level `beta`.
-- Coq: Definition FNeven (p : float) := Feven (Fnormalize radix b precision p).
def FNeven {beta : Int}
    (b : Fbound_skel) (_radix : ℝ) (precision : Nat)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  Feven (beta:=beta) (Fnormalize (beta:=beta) beta b precision p)

/-- Local bridge: normalized-even parity is preserved by float absolute value. -/
theorem FNevenFabs {beta : Int}
    (b : Fbound_skel) (radix : ℝ) (precision : Nat)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜0 < beta ∧ FNeven (beta:=beta) b radix precision p⌝⦄
    (pure () : Id Unit)
    ⦃⇓_ => ⌜FNeven (beta:=beta) b radix precision
      (FloatSpec.Calc.Operations.Fabs (beta:=beta) p)⌝⦄ := by
  intro ⟨hbeta_pos, h⟩
  simp only [wp, PostCond.noThrow, pure, Id.run, ULift.up_down]
  simp only [FNeven] at h ⊢
  have hnorm := Fnormalize_Fabs (beta:=beta) beta b precision p
  have hnorm' :
      Fnormalize (beta:=beta) beta b precision
          (FloatSpec.Calc.Operations.Fabs (beta:=beta) p) =
        FloatSpec.Calc.Operations.Fabs (beta:=beta)
          (Fnormalize (beta:=beta) beta b precision p) := by
    simpa only [wp, PostCond.noThrow, pure, Fnormalize_Fabs_check,
      Id.run, ULift.up_down] using hnorm hbeta_pos
  rw [hnorm']
  unfold Feven FloatSpec.Calc.Operations.Fabs
  have hdiv :
      (2 : Int) ∣ (Fnormalize (beta:=beta) beta b precision p).Fnum := h.two_dvd
  have hdiv_abs :
      (2 : Int) ∣
        Int.ofNat (Int.natAbs (Fnormalize (beta:=beta) beta b precision p).Fnum) :=
    (Int.dvd_natAbs (a := (2 : Int))
      (b := (Fnormalize (beta:=beta) beta b precision p).Fnum)).mpr hdiv
  exact even_iff_two_dvd.mpr hdiv_abs

-- Coq: Definition FNodd (p : float) := Fodd (Fnormalize radix b precision p).
def FNodd {beta : Int}
    (b : Fbound_skel) (_radix : ℝ) (precision : Nat)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  Fodd (beta:=beta) (Fnormalize (beta:=beta) beta b precision p)

/-- Coq: `FNSucc x := FSucc (Fnormalize radix b precision x)`. -/
noncomputable def FNSucc {beta : Int}
    (b : Fbound_skel) (_radix : ℝ) (precision : Nat)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) : FloatSpec.Core.Defs.FlocqFloat beta :=
  FSucc (beta:=beta) b beta precision
    (Fnormalize (beta:=beta) beta b precision p)

/-- Coq: `FNPred x := FPred (Fnormalize radix b precision x)`. -/
noncomputable def FNPred {beta : Int}
    (b : Fbound_skel) (_radix : ℝ) (precision : Nat)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) : FloatSpec.Core.Defs.FlocqFloat beta :=
  FPred (beta:=beta) b beta precision
    (Fnormalize (beta:=beta) beta b precision p)

-- The Flocq `FSucc` parity lemmas are stated below, after the faithful
-- boundary-aware `FSucc` definition.

-- EvenClosest: closest rounding with tie-breaking toward even (or uniqueness)
def EvenClosest {beta : Int}
    (b : Fbound_skel) (radix : ℝ) (precision : Nat)
    (r : ℝ)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  Closest (beta:=beta) b radix r p ∧
  (FNeven (beta:=beta) b radix precision p ∨
    (∀ q : FloatSpec.Core.Defs.FlocqFloat beta,
      Closest (beta:=beta) b radix r q →
        _root_.F2R (beta:=beta) q = _root_.F2R (beta:=beta) p))

-- ---------------------------------------------------------------------------
-- Rounding operators (RND_*) and canonicity (skeletons to mirror Coq Pff.v)

-- Coq: Fcanonic a := Fnormal a \/ Fsubnormal a.
def Fcanonic {beta : Int}
    (radix : Int) (b : Fbound_skel)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  Fnormal radix b f ∨ Fsubnormal radix b f

-- Backward-compatible alias used by proofs that already avoided the old shell.
def Fcanonic' {beta : Int}
    (radix : Int) (b : Fbound_skel)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) : Prop :=
  Fcanonic radix b f

/-- Coq: `FnormalPpred` — the predecessor of the positive mantissa bound is normal. -/
theorem FnormalPpred {beta : Int}
    (radix : Int) (b : Fbound_skel) (precision : Nat) (x : Int) :
    1 < radix →
    0 < precision →
    b.vNum = Zpower_nat radix precision →
    -b.dExp ≤ x →
    Fnormal (beta:=beta) radix b
      (⟨pPred b.vNum, x⟩ : FloatSpec.Core.Defs.FlocqFloat beta) := by
  intro hradix hprecision hvNum hx
  have hvge_two : 2 ≤ b.vNum := by
    cases precision with
    | zero => cases hprecision
    | succ p =>
        rw [hvNum, Zpower_nat]
        have hpow_pos : 0 < radix ^ p := pow_pos (by omega) p
        calc
          (2 : Int) ≤ radix := by omega
          _ ≤ radix * radix ^ p := by nlinarith [hpow_pos, hradix]
          _ = radix ^ Nat.succ p := by simpa [pow_succ, mul_comm]
  have hpPred_nonneg : 0 ≤ pPred b.vNum := by
    unfold pPred
    omega
  constructor
  · constructor
    · rw [abs_of_nonneg hpPred_nonneg]
      unfold pPred
      omega
    · exact hx
  · have hmul_nonneg : 0 ≤ radix * pPred b.vNum := by
      exact mul_nonneg (by omega) hpPred_nonneg
    rw [abs_of_nonneg hmul_nonneg]
    unfold pPred
    nlinarith [hradix, hvge_two]

/-- Coq: `FcanonicPpred` — the predecessor normal float is canonical. -/
theorem FcanonicPpred {beta : Int}
    (radix : Int) (b : Fbound_skel) (precision : Nat) (x : Int) :
    1 < radix →
    0 < precision →
    b.vNum = Zpower_nat radix precision →
    -b.dExp ≤ x →
    Fcanonic (beta:=beta) radix b
      (⟨pPred b.vNum, x⟩ : FloatSpec.Core.Defs.FlocqFloat beta) := by
  intro hradix hprecision hvNum hx
  exact Or.inl (FnormalPpred (beta:=beta) radix b precision x hradix hprecision hvNum hx)

/-- Coq: `FnormalNnormMin` — the minimal normal mantissa is normal. -/
theorem FnormalNnormMin {beta : Int}
    (radix : Int) (b : Fbound_skel) (precision : Nat) (x : Int) :
    1 < radix →
    0 < precision →
    b.vNum = Zpower_nat radix precision →
    -b.dExp ≤ x →
    Fnormal (beta:=beta) radix b
      (⟨nNormMin radix precision, x⟩ : FloatSpec.Core.Defs.FlocqFloat beta) := by
  intro hradix hprecision hvNum hx
  have hnpos : 0 < nNormMin radix precision := by
    cases precision with
    | zero => cases hprecision
    | succ p =>
        simp [nNormMin]
        exact pow_pos (by omega) p
  have hposnorm := PosNormMin radix b precision hprecision hvNum
  constructor
  · constructor
    · rw [abs_of_nonneg (le_of_lt hnpos)]
      rw [hposnorm]
      nlinarith [hradix, hnpos]
    · exact hx
  · have hmul_pos : 0 < radix * nNormMin radix precision := by
      exact mul_pos (by omega) hnpos
    rw [abs_of_pos hmul_pos]
    rw [hposnorm]

/-- Coq: `FcanonicNnormMin` — the minimal normal mantissa is canonical. -/
theorem FcanonicNnormMin {beta : Int}
    (radix : Int) (b : Fbound_skel) (precision : Nat) (x : Int) :
    1 < radix →
    0 < precision →
    b.vNum = Zpower_nat radix precision →
    -b.dExp ≤ x →
    Fcanonic (beta:=beta) radix b
      (⟨nNormMin radix precision, x⟩ : FloatSpec.Core.Defs.FlocqFloat beta) := by
  intro hradix hprecision hvNum hx
  exact Or.inl (FnormalNnormMin (beta:=beta) radix b precision x hradix hprecision hvNum hx)

noncomputable def FcanonicBound_check {beta : Int}
    (radix : Int) (b : Fbound_skel)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `FcanonicBound` — canonical floats are bounded. -/
theorem FcanonicBound {beta : Int}
    (radix : Int) (b : Fbound_skel)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜Fcanonic (beta:=beta) radix b p⌝⦄
    (pure (FcanonicBound_check (beta:=beta) radix b p) : Id Unit)
    ⦃⇓_ => ⌜Fbounded (beta:=beta) b p⌝⦄ := by
  intro hcan
  simp only [wp, PostCond.noThrow, pure, FcanonicBound_check]
  rcases hcan with hnormal | hsubnormal
  · exact hnormal.1
  · exact hsubnormal.1

noncomputable def FcanonicFopp_check {beta : Int}
    (radix : Int) (b : Fbound_skel)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `FcanonicFopp` — canonicity preserved under float negation. -/
theorem FcanonicFopp {beta : Int}
    (radix : Int) (b : Fbound_skel)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜Fcanonic (beta:=beta) radix b p⌝⦄
    (pure (FcanonicFopp_check (beta:=beta) radix b p) : Id Unit)
    ⦃⇓_ => ⌜Fcanonic (beta:=beta) radix b (Fopp p)⌝⦄ := by
  intro hcan
  simp only [wp, PostCond.noThrow, pure, FcanonicFopp_check]
  rcases hcan with hnormal | hsubnormal
  · left
    simpa [Fcanonic, Fnormal, Fsubnormal, Fbounded, Fopp,
      FloatSpec.Calc.Operations.Fopp, abs_mul, abs_neg, mul_neg]
      using hnormal
  · right
    simpa [Fcanonic, Fnormal, Fsubnormal, Fbounded, Fopp,
      FloatSpec.Calc.Operations.Fopp, abs_mul, abs_neg, mul_neg]
      using hsubnormal

noncomputable def FcanonicFabs_check {beta : Int}
    (radix : Int) (b : Fbound_skel)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `FcanonicFabs` — canonicity preserved under float absolute value. -/
theorem FcanonicFabs {beta : Int}
    (radix : Int) (b : Fbound_skel)
    (p : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜Fcanonic (beta:=beta) radix b p⌝⦄
    (pure (FcanonicFabs_check (beta:=beta) radix b p) : Id Unit)
    ⦃⇓_ => ⌜Fcanonic (beta:=beta) radix b (Fabs p)⌝⦄ := by
  intro hcan
  simp only [wp, PostCond.noThrow, pure, FcanonicFabs_check]
  rcases hcan with hnormal | hsubnormal
  · left
    simpa [Fcanonic, Fnormal, Fsubnormal, Fbounded, Fabs,
      FloatSpec.Calc.Operations.Fabs, Int.natCast_natAbs, abs_mul]
      using hnormal
  · right
    simpa [Fcanonic, Fnormal, Fsubnormal, Fbounded, Fabs,
      FloatSpec.Calc.Operations.Fabs, Int.natCast_natAbs, abs_mul]
      using hsubnormal

noncomputable def FSuccSimpl1_check {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) : Unit := ()

/-- Coq: `FSuccSimpl1`. -/
theorem FSuccSimpl1 {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜x.Fnum = pPred b.vNum⌝⦄
    (pure (FSuccSimpl1_check (beta:=beta) b radix precision x) : Id Unit)
    ⦃⇓_ => ⌜FSucc (beta:=beta) b radix precision x =
      ⟨nNormMin radix precision, x.Fexp + 1⟩⌝⦄ := by
  intro hx
  have hx' : x.Fnum = pPred b.vNum := by
    simpa using hx
  simp only [wp, PostCond.noThrow, pure, FSuccSimpl1_check, Id.run,
    PredTrans.pure, PredTrans.apply, ULift.down]
