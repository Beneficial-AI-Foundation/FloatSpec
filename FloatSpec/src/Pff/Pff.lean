      -- r₂ ≥ firstNP = radix^(p-1) * radix^(-dExp) = radix^(p-1-dExp)
      -- log(r₂) ≥ (p-1-dExp) * log(radix)
      -- log(r₂)/log(radix) ≥ p - 1 - dExp
