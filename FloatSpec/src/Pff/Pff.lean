/-- Coq discriminant theorem `discri7`, factored at the residual witness.

The upstream proof handles the symmetric opposite-sign branch `dp < 0` and
`0 < dq` by constructing a bounded witness for `dp - dq`.  This local theorem
keeps that constructed witness explicit, matching the factoring used by
`discri4` and `discri5`, and delegates the final estimate to `discri3`. -/
theorem discri7 {beta : Int}
    (bo : Fbound_skel) (radix : Int) (precision : Nat)
    (a b b' c p q t s d : FloatSpec.Core.Defs.FlocqFloat beta)
    (dp dq : ℝ) :
    ⦃⌜EvenClosest (beta:=beta) bo (radix : ℝ) precision
          (_root_.F2R (beta:=beta) t + _root_.F2R (beta:=beta) s) d ∧
        EvenClosest (beta:=beta) bo (radix : ℝ) precision (dp - dq) s ∧
        _root_.F2R (beta:=beta) t =
          _root_.F2R (beta:=beta) p - _root_.F2R (beta:=beta) q ∧
        dp = _root_.F2R (beta:=beta) b * _root_.F2R (beta:=beta) b' -
          _root_.F2R (beta:=beta) p ∧
        dq = _root_.F2R (beta:=beta) a * _root_.F2R (beta:=beta) c -
          _root_.F2R (beta:=beta) q ∧
        dp < 0 ∧ 0 < dq ∧
        (∃ f : FloatSpec.Core.Defs.FlocqFloat beta,
          Fbounded (beta:=beta) bo f ∧
            _root_.F2R (beta:=beta) f = dp - dq) ∧
        beta = radix ∧ 1 < radix ∧ precision ≠ 0 ∧
        bo.vNum = Zpower_nat radix precision⌝⦄
    (pure (discri7_check (beta:=beta) bo radix precision a b b' c p q t s d dp dq) :
      Id Unit)
    ⦃⇓_ => ⌜|_root_.F2R (beta:=beta) d -
          (_root_.F2R (beta:=beta) b * _root_.F2R (beta:=beta) b' -
            _root_.F2R (beta:=beta) a * _root_.F2R (beta:=beta) c)| ≤
        2 * Fulp (beta:=beta) bo radix precision d⌝⦄ := by
  intro hpre
  rcases hpre with
    ⟨hRoundd, hRounds, htExact, hdpEq, hdqEq, _hdp_neg, _hdq_pos, hResidual,
      hbeta, hradix, hprecision, hvNum⟩
  simp only [wp, PostCond.noThrow, pure, discri7_check, Id.run, ULift.up_down]
  have h := discri3 (beta:=beta) bo radix precision a b b' c p q t s d dp dq
  simpa only [wp, PostCond.noThrow, pure, discri3_check, Id.run, ULift.up_down] using
    h ⟨hRoundd, hRounds, htExact, hdpEq, hdqEq, hResidual,
      hbeta, hradix, hprecision, hvNum⟩

noncomputable def discri8_check {beta : Int}
    (bo : Fbound_skel) (radix : Int) (precision : Nat)
    (a b b' c p q t s d : FloatSpec.Core.Defs.FlocqFloat beta)
    (dp dq : ℝ) : Unit :=
  ()

/-- Coq discriminant theorem `discri8`, factored at the sign case split.

Upstream performs a four-way sign split on `dp` and `dq`, using exact residual
witnesses in the zero and same-sign branches, `discri6` for `0 < dp`, `dq < 0`,
and `discri7` for the symmetric opposite-sign branch.  This local theorem keeps
the still-unported residual-witness and half-error branch payloads explicit,
while restoring the `discri8` case-split name and composing the checked lower
branches. -/
theorem discri8 {beta : Int}
    (bo : Fbound_skel) (radix : Int) (precision : Nat)
    (a b b' c p q t s d : FloatSpec.Core.Defs.FlocqFloat beta)
    (dp dq : ℝ) :
    ⦃⌜EvenClosest (beta:=beta) bo (radix : ℝ) precision
          (_root_.F2R (beta:=beta) b * _root_.F2R (beta:=beta) b') p ∧
        EvenClosest (beta:=beta) bo (radix : ℝ) precision
          (_root_.F2R (beta:=beta) a * _root_.F2R (beta:=beta) c) q ∧
        EvenClosest (beta:=beta) bo (radix : ℝ) precision
          (_root_.F2R (beta:=beta) p - _root_.F2R (beta:=beta) q) t ∧
        EvenClosest (beta:=beta) bo (radix : ℝ) precision (dp - dq) s ∧
        EvenClosest (beta:=beta) bo (radix : ℝ) precision
          (_root_.F2R (beta:=beta) t + _root_.F2R (beta:=beta) s) d ∧
        _root_.F2R (beta:=beta) t =
          _root_.F2R (beta:=beta) p - _root_.F2R (beta:=beta) q ∧
        dp = _root_.F2R (beta:=beta) b * _root_.F2R (beta:=beta) b' -
          _root_.F2R (beta:=beta) p ∧
        dq = _root_.F2R (beta:=beta) a * _root_.F2R (beta:=beta) c -
          _root_.F2R (beta:=beta) q ∧
        beta = radix ∧ 1 < radix ∧ precision ≠ 0 ∧
        bo.vNum = Zpower_nat radix precision ∧
        ((0 < dp * dq ∧
            ∃ f : FloatSpec.Core.Defs.FlocqFloat beta,
              Fbounded (beta:=beta) bo f ∧
                _root_.F2R (beta:=beta) f = dp - dq) ∨
          (0 < dp ∧ (dq < 0) ∧
            Fbounded (beta:=beta) bo p ∧
            Fbounded (beta:=beta) bo q ∧
            Fbounded (beta:=beta) bo s ∧
            Fbounded (beta:=beta) bo d ∧
            Fcanonic (beta:=beta) beta bo s ∧
            Fcanonic (beta:=beta) beta bo d ∧
            0 ≤ _root_.F2R (beta:=beta) p ∧
            3 * |_root_.F2R (beta:=beta) p - _root_.F2R (beta:=beta) q| <
              _root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q ∧
            3 *
              min (Fulp (beta:=beta) bo radix precision p)
                (Fulp (beta:=beta) bo radix precision q) ≤
              |_root_.F2R (beta:=beta) p - _root_.F2R (beta:=beta) q| ∧
            |_root_.F2R (beta:=beta) s| ≤
              |_root_.F2R (beta:=beta) t| / 2 ∧
            Fulp (beta:=beta) bo radix precision q ≤
              2 * Fulp (beta:=beta) bo radix precision p ∧
            Fulp (beta:=beta) bo radix precision p ≤
              2 * Fulp (beta:=beta) bo radix precision q ∧
            MonotoneP_float (EvenClosest (beta:=beta) bo (radix : ℝ) precision) ∧
            UniqueP (EvenClosest (beta:=beta) bo (radix : ℝ) precision)) ∨
          (dp < 0 ∧ 0 < dq ∧
            ∃ f : FloatSpec.Core.Defs.FlocqFloat beta,
              Fbounded (beta:=beta) bo f ∧
                _root_.F2R (beta:=beta) f = dp - dq) ∨
          (∃ f : FloatSpec.Core.Defs.FlocqFloat beta,
            Fbounded (beta:=beta) bo f ∧
              _root_.F2R (beta:=beta) f = dp - dq))⌝⦄
    (pure (discri8_check (beta:=beta) bo radix precision a b b' c p q t s d dp dq) :
      Id Unit)
    ⦃⇓_ => ⌜|_root_.F2R (beta:=beta) d -
          (_root_.F2R (beta:=beta) b * _root_.F2R (beta:=beta) b' -
            _root_.F2R (beta:=beta) a * _root_.F2R (beta:=beta) c)| ≤
        2 * Fulp (beta:=beta) bo radix precision d⌝⦄ := by
  intro hpre
  rcases hpre with
    ⟨hRoundp, hRoundq, hRoundt, hRounds, hRoundd, htExact, hdpEq, hdqEq,
      hbeta, hradix, hprecision, hvNum, hbranch⟩
  simp only [wp, PostCond.noThrow, pure, discri8_check, Id.run, ULift.up_down]
  rcases hbranch with hsame | hrest
  · rcases hsame with ⟨hsameSign, hResidual⟩
    have h := discri5 (beta:=beta) bo radix precision a b b' c p q t s d dp dq
    simpa only [wp, PostCond.noThrow, pure, discri5_check, Id.run, ULift.up_down] using
      h ⟨hRoundd, hRounds, htExact, hdpEq, hdqEq, hsameSign, hResidual,
        hbeta, hradix, hprecision, hvNum⟩
  rcases hrest with hsecond | hrest
  · rcases hsecond with
      ⟨hdp_pos, hdq_neg, hpBound, hqBound, hsBound, hdBound, hsCan, hdCan,
        hpNonneg, hSecond, hlarge, hsHalf, hq_le_twice_p, hp_le_twice_q,
        hMono, hUnique⟩
    have h := discri6 (beta:=beta) bo radix precision a b b' c p q t s d dp dq
    simpa only [wp, PostCond.noThrow, pure, discri6_check, Id.run, ULift.up_down] using
      h ⟨hRoundp, hRoundq, hRoundt, hRounds, hRoundd, hdpEq, hdqEq,
        hpBound, hqBound, hsBound, hdBound, hsCan, hdCan, hpNonneg,
        hSecond, hlarge, hsHalf, hq_le_twice_p, hp_le_twice_q, hMono,
        hUnique, hdp_pos, hdq_neg, hbeta, hradix, hprecision, hvNum⟩
  rcases hrest with hsymm | hResidual
  · rcases hsymm with ⟨hdp_neg, hdq_pos, hResidual⟩
    have h := discri7 (beta:=beta) bo radix precision a b b' c p q t s d dp dq
    simpa only [wp, PostCond.noThrow, pure, discri7_check, Id.run, ULift.up_down] using
      h ⟨hRoundd, hRounds, htExact, hdpEq, hdqEq, hdp_neg, hdq_pos, hResidual,
        hbeta, hradix, hprecision, hvNum⟩
  · have h := discri3 (beta:=beta) bo radix precision a b b' c p q t s d dp dq
    simpa only [wp, PostCond.noThrow, pure, discri3_check, Id.run, ULift.up_down] using
      h ⟨hRoundd, hRounds, htExact, hdpEq, hdqEq, hResidual,
        hbeta, hradix, hprecision, hvNum⟩

/-- Final arithmetic step of Coq Veltkamp local lemma `RleRRounded`.

This factors the part after `ClosestUlp` and the relative ulp estimate used in
Coq as `FulpLe2`: once the rounding error is bounded by one ulp and that ulp is
bounded by `|f| * radix^(1 - precision)`, the rounded input `z` satisfies the
relative bound used throughout the Veltkamp proof. -/
theorem RleRRounded_from_Fulp_rel {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) (z : ℝ)
    (hClosestUlp :
      2 * |z - _root_.F2R (beta:=beta) f| ≤
        Fulp (beta:=beta) b radix precision f)
    (hFulpRel :
      Fulp (beta:=beta) b radix precision f ≤
        |_root_.F2R (beta:=beta) f| *
          (radix : ℝ) ^ (1 - (precision : Int))) :
    |z| ≤ |_root_.F2R (beta:=beta) f| *
        (1 + (radix : ℝ) ^ (1 - (precision : Int)) / 2) := by
  have htri : |z| ≤ |z - _root_.F2R (beta:=beta) f| +
      |_root_.F2R (beta:=beta) f| := by
    calc
      |z| = |(z - _root_.F2R (beta:=beta) f) +
          _root_.F2R (beta:=beta) f| := by ring_nf
      _ ≤ |z - _root_.F2R (beta:=beta) f| +
          |_root_.F2R (beta:=beta) f| := abs_add_le _ _
  have hdiff_le :
      |z - _root_.F2R (beta:=beta) f| ≤
        (|_root_.F2R (beta:=beta) f| *
          (radix : ℝ) ^ (1 - (precision : Int))) / 2 := by
    nlinarith
  calc
    |z| ≤ |z - _root_.F2R (beta:=beta) f| +
        |_root_.F2R (beta:=beta) f| := htri
    _ ≤ (|_root_.F2R (beta:=beta) f| *
          (radix : ℝ) ^ (1 - (precision : Int))) / 2 +
        |_root_.F2R (beta:=beta) f| := by
          linarith
    _ = |_root_.F2R (beta:=beta) f| *
        (1 + (radix : ℝ) ^ (1 - (precision : Int)) / 2) := by
          ring

private lemma fbounded_abs_F2R_ge_min_exp {beta : Int}
    (b : Fbound_skel) (f : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : 1 < beta)
    (hfBound : Fbounded (beta:=beta) b f)
    (hfNonzero : _root_.F2R (beta:=beta) f ≠ 0) :
    (beta : ℝ) ^ (-b.dExp) ≤ |_root_.F2R (beta:=beta) f| := by
  rcases hfBound with ⟨_, hfExp⟩
  have hbeta_pos : (0 : ℝ) < (beta : ℝ) := by
    exact_mod_cast (lt_trans Int.zero_lt_one hbeta)
  have hbeta_one : (1 : ℝ) ≤ (beta : ℝ) := by
    exact_mod_cast (le_of_lt hbeta)
  have hfnum_ne : f.Fnum ≠ 0 := by
    intro hfnum_zero
    apply hfNonzero
    simp [_root_.F2R, FloatSpec.Core.Defs.F2R, hfnum_zero]
  have hfnum_abs_pos : 0 < |f.Fnum| := abs_pos.mpr hfnum_ne
  have hfnum_abs_ge_one_int : (1 : Int) ≤ |f.Fnum| := by
    omega
  have hfnum_abs_ge_one_cast : (1 : ℝ) ≤ ((|f.Fnum| : Int) : ℝ) := by
    exact_mod_cast hfnum_abs_ge_one_int
  have hfnum_abs_ge_one : (1 : ℝ) ≤ |(f.Fnum : ℝ)| := by
    simpa [Int.cast_abs] using hfnum_abs_ge_one_cast
  have hpow_mono :
      (beta : ℝ) ^ (-b.dExp) ≤ (beta : ℝ) ^ f.Fexp :=
    zpow_le_zpow_right₀ hbeta_one hfExp
  have hpow_min_pos : 0 < (beta : ℝ) ^ (-b.dExp) :=
    zpow_pos hbeta_pos _
  calc
    (beta : ℝ) ^ (-b.dExp)
        = (1 : ℝ) * (beta : ℝ) ^ (-b.dExp) := by ring
    _ ≤ |(f.Fnum : ℝ)| * (beta : ℝ) ^ (-b.dExp) := by
          exact mul_le_mul_of_nonneg_right hfnum_abs_ge_one
            (le_of_lt hpow_min_pos)
    _ ≤ |(f.Fnum : ℝ)| * (beta : ℝ) ^ f.Fexp := by
          exact mul_le_mul_of_nonneg_left hpow_mono (abs_nonneg _)
    _ = |_root_.F2R (beta:=beta) f| := by
          simp [_root_.F2R, FloatSpec.Core.Defs.F2R, abs_mul,
            abs_of_pos (zpow_pos hbeta_pos f.Fexp)]

private lemma firstNormalPos_plusExp_eq_min_exp {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (_hprecision : precision ≠ 0) :
    _root_.F2R (beta:=beta)
        (firstNormalPos (beta:=beta) radix (plusExp b precision) precision) =
      (beta : ℝ) ^ (-b.dExp) := by
  subst beta
  have hradix_pos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast (lt_trans Int.zero_lt_one hradix)
  have hradix_ne : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos
  simp only [_root_.F2R, FloatSpec.Core.Defs.F2R, firstNormalPos, nNormMin,
    plusExp, FloatSpec.Core.Defs.FlocqFloat.Fnum,
    FloatSpec.Core.Defs.FlocqFloat.Fexp]
  have hpow_cast :
      ((radix ^ (precision - 1) : Int) : ℝ) =
        (radix : ℝ) ^ (precision - 1 : Nat) := by
    simp [Int.cast_pow]
  rw [hpow_cast]
  rw [← zpow_natCast]
  calc
    (radix : ℝ) ^ ((precision - 1 : Nat) : Int) *
        (radix : ℝ) ^ (-(b.dExp + ((precision - 1 : Nat) : Int)))
        = (radix : ℝ) ^
            (((precision - 1 : Nat) : Int) +
              (-(b.dExp + ((precision - 1 : Nat) : Int)))) := by
              rw [zpow_add₀ hradix_ne]
    _ = (radix : ℝ) ^ (-b.dExp) := by
          congr 1
          ring

/-- Coq: `bimplybplusNorm` from section `VeltS`.

Any nonzero float bounded by `b` has an equal real representative that is
normal for the enlarged `plusExp b` bound. -/
theorem bimplybplusNorm {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (f : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hpGivesBound : b.vNum = Zpower_nat radix t)
    (hSLe : 2 ≤ s) (_hSGe : s ≤ t - 2)
    (hfBound : Fbounded (beta:=beta) b f)
    (hfNonzero : _root_.F2R (beta:=beta) f ≠ 0) :
    ∃ g : FloatSpec.Core.Defs.FlocqFloat beta,
      _root_.F2R (beta:=beta) g = _root_.F2R (beta:=beta) f ∧
        Fnormal (beta:=beta) radix (plusExp b t) g := by
  let g : FloatSpec.Core.Defs.FlocqFloat beta :=
    Fnormalize (beta:=beta) radix (plusExp b t) t f
  have ht_ne : t ≠ 0 := by
    omega
  have hvNumPlus : (plusExp b t).vNum = Zpower_nat radix t := by
    simpa [plusExp] using hpGivesBound
  have hfBoundPlus : Fbounded (beta:=beta) (plusExp b t) f := by
    rcases hfBound with ⟨hfNum, hfExp⟩
    constructor
    · simpa [plusExp] using hfNum
    · dsimp [plusExp]
      have hnonneg : (0 : Int) ≤ ((t - 1 : Nat) : Int) :=
        Int.natCast_nonneg _
      omega
  have hgEq : _root_.F2R (beta:=beta) g = _root_.F2R (beta:=beta) f := by
    have h := FnormalizeCorrect (beta:=beta) radix (plusExp b t) t f
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
      Id.run, ULift.up_down, g] using h ⟨hbeta, hradix⟩
  have hgCan :
      Fcanonic (beta:=beta) radix (plusExp b t) g := by
    have h := FnormalizeCanonic (beta:=beta) radix (plusExp b t) t f
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCanonic_check,
      Id.run, ULift.up_down, Fbounded', g] using
      h ⟨hfBoundPlus, hfBoundPlus, ht_ne, hradix, hvNumPlus⟩
  refine ⟨g, hgEq, ?_⟩
  rcases hgCan with hgNormal | hgSub
  · exact hgNormal
  · exfalso
    have hbeta_gt : 1 < beta := by
      omega
    have hLower :
        (beta : ℝ) ^ (-b.dExp) ≤ |_root_.F2R (beta:=beta) f| :=
      fbounded_abs_F2R_ge_min_exp (beta:=beta) b f hbeta_gt hfBound hfNonzero
    have hFirst :
        _root_.F2R (beta:=beta)
            (firstNormalPos (beta:=beta) radix (plusExp b t) t) =
          (beta : ℝ) ^ (-b.dExp) :=
      firstNormalPos_plusExp_eq_min_exp (beta:=beta) b radix t hbeta hradix ht_ne
    have hgAbsSub :
        Fsubnormal (beta:=beta) radix (plusExp b t)
          (Fabs (beta:=beta) g) := by
      have h := FsubnormFabs (beta:=beta) (plusExp b t) radix g
      simpa only [wp, PostCond.noThrow, pure, FsubnormFabs_check,
        Id.run, ULift.up_down] using h hgSub
    have hgAbsEq :
        _root_.F2R (beta:=beta) (Fabs (beta:=beta) g) =
          |_root_.F2R (beta:=beta) g| := by
      have h := Fabs_correct (beta:=beta) g
      simpa only [wp, PostCond.noThrow, pure, Fabs_correct_check,
        Id.run, ULift.up_down] using h hbeta_gt
    have hgAbsNonneg :
        0 ≤ _root_.F2R (beta:=beta) (Fabs (beta:=beta) g) := by
      rw [hgAbsEq]
      exact abs_nonneg _
    have hSubLt :
        _root_.F2R (beta:=beta) (Fabs (beta:=beta) g) <
          _root_.F2R (beta:=beta)
            (firstNormalPos (beta:=beta) radix (plusExp b t) t) := by
      have h := FsubnormalLtFirstNormalPos
        (beta:=beta) radix (plusExp b t) t (Fabs (beta:=beta) g)
      simpa only [wp, PostCond.noThrow, pure,
        FsubnormalLtFirstNormalPos_check, Id.run, ULift.up_down, Fbounded'] using
        h ⟨hgAbsSub, hgAbsSub, ht_ne, hbeta, hradix, hvNumPlus, hgAbsNonneg⟩
    have hAbsG_lt :
        |_root_.F2R (beta:=beta) g| < (beta : ℝ) ^ (-b.dExp) := by
      simpa [hgAbsEq, hFirst] using hSubLt
    have hAbsF_lt :
        |_root_.F2R (beta:=beta) f| < (beta : ℝ) ^ (-b.dExp) := by
      simpa [hgEq] using hAbsG_lt
    exact (not_lt_of_ge hLower) hAbsF_lt

noncomputable def ClosestErrorBoundNormal_aux_check {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) (z : ℝ) : Unit :=
  ()

/-- Coq: `ClosestErrorBoundNormal_aux`.

This is the normal-case closest-rounding error bound before rewriting the
precision term from `radix / vNum` to `radix^(1-precision)`. -/
theorem ClosestErrorBoundNormal_aux {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) (z : ℝ) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ precision ≠ 0 ∧
        b.vNum = Zpower_nat radix precision ∧
        Fbounded (beta:=beta) b f ∧
        Fnormal (beta:=beta) radix b
          (Fnormalize (beta:=beta) radix b precision f) ∧
        Closest (beta:=beta) b (radix : ℝ) z f⌝⦄
    (pure (ClosestErrorBoundNormal_aux_check
      (beta:=beta) b radix precision f z) : Id Unit)
    ⦃⇓_ => ⌜|z - _root_.F2R (beta:=beta) f| ≤
        |_root_.F2R (beta:=beta) f| *
          ((1 / 2 : ℝ) * ((radix : ℝ) * ((b.vNum : ℝ)⁻¹)))⌝⦄ := by
  intro h
  rcases h with
    ⟨hbeta, hradix, hprecision, hvNum, hfBound, hnormal, hClosest⟩
  simp only [wp, PostCond.noThrow, pure, ClosestErrorBoundNormal_aux_check,
    Id.run, ULift.up_down]
  have hClosestUlp :
      2 * |z - _root_.F2R (beta:=beta) f| ≤
        Fulp (beta:=beta) b radix precision f := by
    have h := ClosestUlp (beta:=beta) b radix precision z f
    simpa only [wp, PostCond.noThrow, pure, ClosestUlp_check,
      Id.run, ULift.up_down] using
      h ⟨hClosest, hbeta, hradix, hprecision, hvNum⟩
  have hFulpRel :
      Fulp (beta:=beta) b radix precision f ≤
        |_root_.F2R (beta:=beta) f| *
          (radix : ℝ) ^ (1 - (precision : Int)) := by
    have h := FulpLe2 (beta:=beta) radix b precision f
    simpa only [wp, PostCond.noThrow, pure, FulpLe2_check,
      Id.run, ULift.up_down] using
      h ⟨hfBound, hnormal, hbeta, hradix, hprecision, hvNum⟩
  have hpow_coeff :
      (radix : ℝ) ^ (1 - (precision : Int)) =
        (radix : ℝ) * ((b.vNum : ℝ)⁻¹) := by
    have hradix_pos : (0 : ℝ) < (radix : ℝ) := by
      exact_mod_cast (lt_trans Int.zero_lt_one hradix)
    have hradix_ne : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos
    have hprecision_cast :
        ((Zpower_nat radix precision : Int) : ℝ) =
          (radix : ℝ) ^ (precision : Nat) := by
      simp [Zpower_nat]
    have hvNum_real : (b.vNum : ℝ) = (radix : ℝ) ^ (precision : Nat) := by
      rw [hvNum, hprecision_cast]
    rw [hvNum_real]
    calc
      (radix : ℝ) ^ (1 - (precision : Int))
          = (radix : ℝ) ^ (1 : Int) *
              ((radix : ℝ) ^ ((precision : Int)))⁻¹ := by
            rw [sub_eq_add_neg, zpow_add₀ hradix_ne, zpow_neg]
      _ = (radix : ℝ) * (((radix : ℝ) ^ (precision : Nat))⁻¹) := by
            norm_num
  have hdist_rel :
      |z - _root_.F2R (beta:=beta) f| ≤
        (|_root_.F2R (beta:=beta) f| *
          (radix : ℝ) ^ (1 - (precision : Int))) / 2 := by
    nlinarith
  calc
    |z - _root_.F2R (beta:=beta) f|
        ≤ (|_root_.F2R (beta:=beta) f| *
            (radix : ℝ) ^ (1 - (precision : Int))) / 2 := hdist_rel
    _ = |_root_.F2R (beta:=beta) f| *
          ((1 / 2 : ℝ) * ((radix : ℝ) * ((b.vNum : ℝ)⁻¹))) := by
            rw [hpow_coeff]
            ring

noncomputable def ClosestErrorBoundNormal_check {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) (z : ℝ) : Unit :=
  ()

/-- Coq: `ClosestErrorBoundNormal`.

Normal-case closest-rounding error bound in the rewritten precision form. -/
theorem ClosestErrorBoundNormal {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) (z : ℝ) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ precision ≠ 0 ∧
        b.vNum = Zpower_nat radix precision ∧
        Fbounded (beta:=beta) b f ∧
        Fnormal (beta:=beta) radix b
          (Fnormalize (beta:=beta) radix b precision f) ∧
        Closest (beta:=beta) b (radix : ℝ) z f⌝⦄
    (pure (ClosestErrorBoundNormal_check
      (beta:=beta) b radix precision f z) : Id Unit)
    ⦃⇓_ => ⌜|z - _root_.F2R (beta:=beta) f| ≤
        |_root_.F2R (beta:=beta) f| *
          ((1 / 2 : ℝ) * (radix : ℝ) ^ (1 - (precision : Int)))⌝⦄ := by
  intro h
  rcases h with
    ⟨hbeta, hradix, hprecision, hvNum, hfBound, hnormal, hClosest⟩
  simp only [wp, PostCond.noThrow, pure, ClosestErrorBoundNormal_check,
    Id.run, ULift.up_down]
  have hClosestUlp :
      2 * |z - _root_.F2R (beta:=beta) f| ≤
        Fulp (beta:=beta) b radix precision f := by
    have h := ClosestUlp (beta:=beta) b radix precision z f
    simpa only [wp, PostCond.noThrow, pure, ClosestUlp_check,
      Id.run, ULift.up_down] using
      h ⟨hClosest, hbeta, hradix, hprecision, hvNum⟩
  have hFulpRel :
      Fulp (beta:=beta) b radix precision f ≤
        |_root_.F2R (beta:=beta) f| *
          (radix : ℝ) ^ (1 - (precision : Int)) := by
    have h := FulpLe2 (beta:=beta) radix b precision f
    simpa only [wp, PostCond.noThrow, pure, FulpLe2_check,
      Id.run, ULift.up_down] using
      h ⟨hfBound, hnormal, hbeta, hradix, hprecision, hvNum⟩
  have hdist_rel :
      |z - _root_.F2R (beta:=beta) f| ≤
        (|_root_.F2R (beta:=beta) f| *
          (radix : ℝ) ^ (1 - (precision : Int))) / 2 := by
    nlinarith
  calc
    |z - _root_.F2R (beta:=beta) f|
        ≤ (|_root_.F2R (beta:=beta) f| *
            (radix : ℝ) ^ (1 - (precision : Int))) / 2 := hdist_rel
    _ = |_root_.F2R (beta:=beta) f| *
          ((1 / 2 : ℝ) * (radix : ℝ) ^ (1 - (precision : Int))) := by
            ring

/-- Coq Veltkamp local lemma `RleRRounded`.

A closest rounded value `z` to a normal float `f` is bounded by the standard
relative `1 + radix^(1 - precision) / 2` factor. -/
theorem RleRRounded {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) (z : ℝ)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hprecision : precision ≠ 0)
    (hvNum : b.vNum = Zpower_nat radix precision)
    (hnormal : Fnormal (beta:=beta) radix b f)
    (hClosest : Closest (beta:=beta) b (radix : ℝ) z f) :
    |z| ≤ |_root_.F2R (beta:=beta) f| *
        (1 + (radix : ℝ) ^ (1 - (precision : Int)) / 2) := by
  have hClosestUlp :
      2 * |z - _root_.F2R (beta:=beta) f| ≤
        Fulp (beta:=beta) b radix precision f := by
    have h := ClosestUlp (beta:=beta) b radix precision z f
    simpa only [wp, PostCond.noThrow, pure, ClosestUlp_check,
      Id.run, ULift.up_down] using
      h ⟨hClosest, hbeta, hradix, hprecision, hvNum⟩
  have hNormEq :
      Fnormalize (beta:=beta) radix b precision f = f := by
    have h := FcanonicFnormalizeEq (beta:=beta) radix b precision f
    simpa only [wp, PostCond.noThrow, pure, FcanonicFnormalizeEq_check,
      Id.run, ULift.up_down] using
      h ⟨Or.inl hnormal, hbeta, hradix, hprecision, hvNum⟩
  have hNormalNorm :
      Fnormal (beta:=beta) radix b
        (Fnormalize (beta:=beta) radix b precision f) := by
    simpa [hNormEq] using hnormal
  have hFulpRel :
      Fulp (beta:=beta) b radix precision f ≤
        |_root_.F2R (beta:=beta) f| *
          (radix : ℝ) ^ (1 - (precision : Int)) := by
    have h := FulpLe2 (beta:=beta) radix b precision f
    simpa only [wp, PostCond.noThrow, pure, FulpLe2_check,
      Id.run, ULift.up_down] using
      h ⟨hnormal.1, hNormalNorm, hbeta, hradix, hprecision, hvNum⟩
  exact RleRRounded_from_Fulp_rel (beta:=beta) b radix precision f z
    hClosestUlp hFulpRel

/-- Coq Veltkamp local lemma `hxExact`.

The third Veltkamp rounded value is exact: rounding `q + p` returns the
representable sum `p + q`.  This is the upstream `ClosestIdem`/`SterbenzAux`
argument using the local rounded definitions `pDef` and `qDef`. -/
theorem hxExact {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (ht_ne : t ≠ 0)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hs_ge : 2 ≤ s) (hs_le : s ≤ t - 2) :
    _root_.F2R (beta:=beta) hx =
      _root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q := by
  have hbeta_gt : 1 < beta := by
    rw [hbeta]
    exact hradix
  have hpBound : Fbounded (beta:=beta) b p := hpDef.1
  have hqBound : Fbounded (beta:=beta) b q := hqDef.1
  have hpNonneg :
      0 ≤ _root_.F2R (beta:=beta) p :=
    pPos (beta:=beta) b radix s t x p hradix hvNum hxPos hpDef
  have hqNonpos :
      _root_.F2R (beta:=beta) q ≤ 0 :=
    qNeg (beta:=beta) b radix s t x p q hradix hvNum
      hxBound hxPos hpDef hqDef
  have hMono :
      MonotoneP_float (Closest (beta:=beta) b (radix : ℝ)) := by
    have h := ClosestMonotone (beta:=beta) b (radix : ℝ)
    simpa only [wp, PostCond.noThrow, pure, ClosestMonotone_check,
      Id.run, ULift.up_down] using h trivial
  have hProject (f : FloatSpec.Core.Defs.FlocqFloat beta)
      (hf : Fbounded (beta:=beta) b f) :
      Closest (beta:=beta) b (radix : ℝ)
        (_root_.F2R (beta:=beta) f) f := by
    constructor
    · exact hf
    · intro g _hgBounded
      rw [sub_self, abs_zero]
      exact abs_nonneg _
  have hOppQ :
      Closest (beta:=beta) b (radix : ℝ)
        (-(_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p))
        (Fopp (beta:=beta) q) := by
    have h := ClosestOpp (beta:=beta) b (radix : ℝ) q
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p)
    simpa [wp, PostCond.noThrow, pure, ClosestOpp_check, Id.run,
      ULift.up_down] using h hqDef
  have hFoppQ :
      _root_.F2R (beta:=beta) (Fopp (beta:=beta) q) =
        -_root_.F2R (beta:=beta) q := by
    have h := (FloatSpec.Calc.Operations.F2R_opp (beta:=beta) q) trivial
    simpa [Fopp, _root_.F2R] using h
  have hFoppQBound : Fbounded (beta:=beta) b (Fopp (beta:=beta) q) := by
    simpa [Fbounded, Fopp, FloatSpec.Calc.Operations.Fopp, abs_neg] using hqBound
  have hProjectP :
      Closest (beta:=beta) b (radix : ℝ)
        (_root_.F2R (beta:=beta) p) p := hProject p hpBound
  have hOppInputLt :
      -(_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) <
        _root_.F2R (beta:=beta) p := by
    nlinarith
  have hFoppQ_le_p :
      _root_.F2R (beta:=beta) (Fopp (beta:=beta) q) ≤
        _root_.F2R (beta:=beta) p :=
    hMono
      (-(_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p))
      (_root_.F2R (beta:=beta) p)
      (Fopp (beta:=beta) q) p hOppInputLt hOppQ hProjectP
  have hpAbs :
      |_root_.F2R (beta:=beta) p| =
        _root_.F2R (beta:=beta) p :=
    abs_of_nonneg hpNonneg
  have hqAbs :
      |_root_.F2R (beta:=beta) q| =
        -_root_.F2R (beta:=beta) q :=
    abs_of_nonpos hqNonpos
  have hFoppQAbs :
      |_root_.F2R (beta:=beta) (Fopp (beta:=beta) q)| =
        _root_.F2R (beta:=beta) (Fopp (beta:=beta) q) := by
    rw [hFoppQ]
    exact abs_of_nonneg (by linarith)
  have ht_ge_three : 3 ≤ t := by
    omega
  have hfactor_pos :
      0 < (radix : ℝ) ^ (s : Int) + 1 := by
    have hradix_pos_int : (0 : Int) < radix := lt_trans (by decide) hradix
    have hradix_pos : (0 : ℝ) < (radix : ℝ) := by
      exact_mod_cast hradix_pos_int
    have hpow_pos : 0 < (radix : ℝ) ^ (s : Int) :=
      zpow_pos hradix_pos _
    linarith
  have hpRounded :
      |_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)| ≤
        |_root_.F2R (beta:=beta) p| *
          (1 + (radix : ℝ) ^ (1 - (t : Int)) / 2) :=
    RleRRounded (beta:=beta) b radix t p
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1))
      hbeta hradix ht_ne hvNum hpNormal hpDef
  have hp_lower :
      _root_.F2R (beta:=beta) x ≤
        _root_.F2R (beta:=beta) p *
          (1 + (radix : ℝ) ^ (1 - (t : Int)) / 2) /
            ((radix : ℝ) ^ (s : Int) + 1) := by
    have hx_nonneg : 0 ≤ _root_.F2R (beta:=beta) x := le_of_lt hxPos
    have hinput_abs :
        |_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)| =
          _root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1) := by
      rw [abs_of_nonneg]
      exact mul_nonneg hx_nonneg (le_of_lt hfactor_pos)
    have hpRounded' :
        _root_.F2R (beta:=beta) x *
            ((radix : ℝ) ^ (s : Int) + 1) ≤
          _root_.F2R (beta:=beta) p *
            (1 + (radix : ℝ) ^ (1 - (t : Int)) / 2) := by
      have hpRounded'' := hpRounded
      rw [hinput_abs, hpAbs] at hpRounded''
      exact hpRounded''
    exact (le_div_iff₀ hfactor_pos).2 hpRounded'
  have hqRounded :
      |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p| ≤
        |_root_.F2R (beta:=beta) q| *
          (1 + (radix : ℝ) ^ (1 - (t : Int)) / 2) :=
    RleRRounded (beta:=beta) b radix t q
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p)
      hbeta hradix ht_ne hvNum hqNormal hqDef
  have hx_le_p : _root_.F2R (beta:=beta) x ≤ _root_.F2R (beta:=beta) p := by
    have hProj : Closest (beta:=beta) b (radix : ℝ)
        (_root_.F2R (beta:=beta) x) x := hProject x hxBound
    have hradix_pos_int : (0 : Int) < radix := lt_trans (by decide) hradix
    have hradix_pos : (0 : ℝ) < (radix : ℝ) := by
      exact_mod_cast hradix_pos_int
    have hpow_pos : 0 < (radix : ℝ) ^ (s : Int) :=
      zpow_pos hradix_pos _
    have hscaled_gt :
        _root_.F2R (beta:=beta) x <
          _root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1) := by
      nlinarith
    exact hMono (_root_.F2R (beta:=beta) x)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1))
      x p hscaled_gt hProj hpDef
  have hq_abs_input :
      |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p| =
        _root_.F2R (beta:=beta) p - _root_.F2R (beta:=beta) x := by
    calc
      |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p| =
          -(_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) :=
        abs_of_nonpos (sub_nonpos.mpr hx_le_p)
      _ = _root_.F2R (beta:=beta) p - _root_.F2R (beta:=beta) x := by ring
  have hp_le_two_oppq :
      _root_.F2R (beta:=beta) p ≤
        2 * _root_.F2R (beta:=beta) (Fopp (beta:=beta) q) := by
    let eps : ℝ := (radix : ℝ) ^ (1 - (t : Int))
    let powS : ℝ := (radix : ℝ) ^ (s : Int)
    let A : ℝ := 1 + eps / 2
    let B : ℝ := powS + 1
    let k : ℝ := 1 - A / B
    have hqBoundFromRounded :
        _root_.F2R (beta:=beta) p - _root_.F2R (beta:=beta) x ≤
          (-_root_.F2R (beta:=beta) q) *
            (1 + (radix : ℝ) ^ (1 - (t : Int)) / 2) := by
      simpa [hq_abs_input, hqAbs] using hqRounded
    have hradix_pos_int : (0 : Int) < radix := lt_trans (by decide) hradix
    have hradix_pos : (0 : ℝ) < (radix : ℝ) := by
      exact_mod_cast hradix_pos_int
    have hradix_one_le : (1 : ℝ) ≤ (radix : ℝ) := by
      exact_mod_cast (le_of_lt hradix)
    have hradix_two_le : (2 : ℝ) ≤ (radix : ℝ) := by
      exact_mod_cast (by omega : (2 : Int) ≤ radix)
    have hradix_ne : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos
    have hsmall_pow :
        (radix : ℝ) ^ (1 - (t : Int)) ≤ 1 := by
      exact zpow_le_one_of_nonpos₀ hradix_one_le (by omega)
    have hcoeff_le : 1 + (radix : ℝ) ^ (1 - (t : Int)) / 2 ≤ (3 / 2 : ℝ) := by
      nlinarith
    have hq_nonneg : 0 ≤ -_root_.F2R (beta:=beta) q := by linarith
    have hpowS_pos : 0 < powS := by
      dsimp [powS]
      exact zpow_pos hradix_pos _
    have hB_pos : 0 < B := by
      dsimp [B]
      linarith
    have hB_ne : B ≠ 0 := ne_of_gt hB_pos
    have hpowS_ge_four : (4 : ℝ) ≤ powS := by
      have hs_two : (2 : Int) ≤ (s : Int) := by omega
      have hpow_two_le : (radix : ℝ) ^ (2 : Int) ≤ powS := by
        dsimp [powS]
        exact zpow_le_zpow_right₀ hradix_one_le hs_two
      have hfour_le_rsq : (4 : ℝ) ≤ (radix : ℝ) ^ (2 : Int) := by
        norm_num [zpow_ofNat]
        nlinarith
      exact le_trans hfour_le_rsq hpow_two_le
    have heps_mul_powS_le_half : eps * powS ≤ (1 / 2 : ℝ) := by
      have hmul_pow :
          eps * powS = (radix : ℝ) ^ (1 - (t : Int) + (s : Int)) := by
        dsimp [eps, powS]
        rw [← zpow_add₀ hradix_ne]
      have hexp_le : 1 - (t : Int) + (s : Int) ≤ -(1 : Int) := by
        omega
      have hpow_le :
          (radix : ℝ) ^ (1 - (t : Int) + (s : Int)) ≤
            (radix : ℝ) ^ (-(1 : Int)) :=
        zpow_le_zpow_right₀ hradix_one_le hexp_le
      have hinv_le_half :
          (radix : ℝ) ^ (-(1 : Int)) ≤ (1 / 2 : ℝ) := by
        have hone_div : (1 : ℝ) / (radix : ℝ) ≤ (1 : ℝ) / 2 :=
          one_div_le_one_div_of_le (by norm_num) hradix_two_le
        simpa [zpow_neg, one_div] using hone_div
      rw [hmul_pow]
      exact le_trans hpow_le hinv_le_half
    have heps_le_eighth : eps ≤ (1 / 8 : ℝ) := by
      have heps_le_half_div : eps ≤ (1 / 2 : ℝ) / powS := by
        exact (le_div_iff₀ hpowS_pos).2 heps_mul_powS_le_half
      have hhalf_div_le : (1 / 2 : ℝ) / powS ≤ (1 / 8 : ℝ) := by
        exact (div_le_iff₀ hpowS_pos).2 (by nlinarith)
      exact le_trans heps_le_half_div hhalf_div_le
    have hA_le_17 : A ≤ (17 / 16 : ℝ) := by
      dsimp [A, eps] at *
      nlinarith
    have hB_ge_five : (5 : ℝ) ≤ B := by
      dsimp [B]
      nlinarith
    have hk_pos : 0 < k := by
      have hA_lt_B : A < B := by
        nlinarith
      have hA_div_lt_one : A / B < 1 := by
        have hA_lt_one_mul_B : A < 1 * B := by simpa using hA_lt_B
        exact (div_lt_iff₀ hB_pos).2 hA_lt_one_mul_B
      dsimp [k]
      linarith
    have hp_lower_mul :
          _root_.F2R (beta:=beta) x ≤
          _root_.F2R (beta:=beta) p * (A / B) := by
      dsimp [A, B, eps, powS]
      simpa [mul_div_assoc] using hp_lower
    have hp_k_le_p_minus_x :
        _root_.F2R (beta:=beta) p * k ≤
          _root_.F2R (beta:=beta) p - _root_.F2R (beta:=beta) x := by
      calc
        _root_.F2R (beta:=beta) p * k =
            _root_.F2R (beta:=beta) p -
              _root_.F2R (beta:=beta) p * (A / B) := by
              dsimp [k]
              ring
        _ ≤ _root_.F2R (beta:=beta) p - _root_.F2R (beta:=beta) x := by
              linarith
    have hp_k_le_oppA :
        _root_.F2R (beta:=beta) p * k ≤
          (-_root_.F2R (beta:=beta) q) * A := by
      have hqBoundA :
          _root_.F2R (beta:=beta) p - _root_.F2R (beta:=beta) x ≤
            (-_root_.F2R (beta:=beta) q) * A := by
        simpa [A, eps] using hqBoundFromRounded
      exact le_trans hp_k_le_p_minus_x hqBoundA
    have hA_le_two_k : A ≤ 2 * k := by
      have hmain_mul : A * (B + 2) ≤ 2 * B := by
        change (1 + eps / 2) * (powS + 1 + 2) ≤ 2 * (powS + 1)
        nlinarith only [hpowS_ge_four, heps_mul_powS_le_half, heps_le_eighth]
      have hmul : A * B ≤ (2 * k) * B := by
        have hright : (2 * k) * B = 2 * B - 2 * A := by
          calc
            (2 * k) * B = (2 * (1 - A / B)) * B := by rfl
            _ = 2 * B - 2 * A := by field_simp [hB_ne]
        rw [hright]
        nlinarith only [hmain_mul]
      exact le_of_mul_le_mul_right hmul hB_pos
    have hopp_nonneg : 0 ≤ _root_.F2R (beta:=beta) (Fopp (beta:=beta) q) := by
      rw [hFoppQ]
      linarith
    have hoppA_le :
        _root_.F2R (beta:=beta) (Fopp (beta:=beta) q) * A ≤
          _root_.F2R (beta:=beta) (Fopp (beta:=beta) q) * (2 * k) :=
      mul_le_mul_of_nonneg_left hA_le_two_k hopp_nonneg
    have hp_k_le_two :
        _root_.F2R (beta:=beta) p * k ≤
          (2 * _root_.F2R (beta:=beta) (Fopp (beta:=beta) q)) * k := by
      have htmp :
          _root_.F2R (beta:=beta) p * k ≤
            _root_.F2R (beta:=beta) (Fopp (beta:=beta) q) * (2 * k) := by
        exact le_trans (by simpa [hFoppQ] using hp_k_le_oppA) hoppA_le
      nlinarith only [htmp]
    exact le_of_mul_le_mul_right hp_k_le_two hk_pos
  let pq : FloatSpec.Core.Defs.FlocqFloat beta :=
    FloatSpec.Calc.Operations.Fminus (beta:=beta) p (Fopp (beta:=beta) q)
  have hpqBound : Fbounded (beta:=beta) b pq := by
    have h := SterbenzAux (beta:=beta) b p (Fopp (beta:=beta) q)
    simpa [wp, PostCond.noThrow, pure, SterbenzAux_check, pq] using
      h ⟨hbeta_gt, hpBound, hFoppQBound, hFoppQ_le_p, hp_le_two_oppq⟩
  have hpqVal :
      _root_.F2R (beta:=beta) pq =
        _root_.F2R (beta:=beta) p + _root_.F2R (beta:=beta) q := by
    have hminus := Fminus_correct (beta:=beta) p (Fopp (beta:=beta) q)
    have hval :
        _root_.F2R (beta:=beta)
            (FloatSpec.Calc.Operations.Fminus (beta:=beta) p (Fopp (beta:=beta) q)) =
          _root_.F2R (beta:=beta) p -
            _root_.F2R (beta:=beta) (Fopp (beta:=beta) q) := by
      simpa [wp, PostCond.noThrow, pure, Fminus_correct_check] using hminus hbeta_gt
    simp [pq, hval, hFoppQ]
  have hhxDef' :
      Closest (beta:=beta) b (radix : ℝ) (_root_.F2R (beta:=beta) pq) hx := by
    simpa [hpqVal, add_comm] using hhxDef
  have hidem := ClosestIdem (beta:=beta) b (radix : ℝ) pq hx
  have hpq_hx :
      _root_.F2R (beta:=beta) pq = _root_.F2R (beta:=beta) hx := by
    simpa [wp, PostCond.noThrow, pure, ClosestIdem_check, Fbounded'] using
      hidem ⟨hpqBound, hhxDef', hpqBound, hhxDef'.1, hhxDef'.2⟩
  rw [← hpq_hx, hpqVal]

/-- Coq Veltkamp local lemma `eqLeep`.

The exponent of the second rounded Veltkamp value is no larger than the
exponent of the first.  This is the upstream `Fcanonic_Rle_Zle` argument after
rewriting the signs of `q` and `p`. -/
theorem eqLeep {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q) :
    q.Fexp ≤ p.Fexp := by
  have hbeta_gt : 1 < beta := by
    rw [hbeta]
    exact hradix
  have hpNonneg :
      0 ≤ _root_.F2R (beta:=beta) p :=
    pPos (beta:=beta) b radix s t x p hradix hvNum hxPos hpDef
  have hqNonpos :
      _root_.F2R (beta:=beta) q ≤ 0 :=
    qNeg (beta:=beta) b radix s t x p q hradix hvNum
      hxBound hxPos hpDef hqDef
  have hMono :
      MonotoneP_float (Closest (beta:=beta) b (radix : ℝ)) := by
    have h := ClosestMonotone (beta:=beta) b (radix : ℝ)
    simpa only [wp, PostCond.noThrow, pure, ClosestMonotone_check,
      Id.run, ULift.up_down] using h trivial
  have hOppQ :
      Closest (beta:=beta) b (radix : ℝ)
        (-(_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p))
        (Fopp (beta:=beta) q) := by
    have h := ClosestOpp (beta:=beta) b (radix : ℝ) q
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p)
    simpa [wp, PostCond.noThrow, pure, ClosestOpp_check, Id.run,
      ULift.up_down] using h hqDef
  have hFoppQ :
      _root_.F2R (beta:=beta) (Fopp (beta:=beta) q) =
        -_root_.F2R (beta:=beta) q := by
    have h := (FloatSpec.Calc.Operations.F2R_opp (beta:=beta) q) trivial
    simpa [Fopp, _root_.F2R] using h
  have hProjectP :
      Closest (beta:=beta) b (radix : ℝ)
        (_root_.F2R (beta:=beta) p) p := by
    constructor
    · exact hpDef.1
    · intro f _hfBounded
      rw [sub_self, abs_zero]
      exact abs_nonneg _
  have hOppInputLt :
      -(_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) <
        _root_.F2R (beta:=beta) p := by
    nlinarith
  have hFoppQ_le_p :
      _root_.F2R (beta:=beta) (Fopp (beta:=beta) q) ≤
        _root_.F2R (beta:=beta) p :=
    hMono
      (-(_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p))
      (_root_.F2R (beta:=beta) p)
      (Fopp (beta:=beta) q) p hOppInputLt hOppQ hProjectP
  have hpAbs :
      |_root_.F2R (beta:=beta) p| =
        _root_.F2R (beta:=beta) p :=
    abs_of_nonneg hpNonneg
  have hqAbs :
      |_root_.F2R (beta:=beta) q| =
        -_root_.F2R (beta:=beta) q :=
    abs_of_nonpos hqNonpos
  have habs_le :
      |_root_.F2R (beta:=beta) q| ≤
        |_root_.F2R (beta:=beta) p| := by
    calc
      |_root_.F2R (beta:=beta) q| =
          -_root_.F2R (beta:=beta) q := hqAbs
      _ = _root_.F2R (beta:=beta) (Fopp (beta:=beta) q) := hFoppQ.symm
      _ ≤ _root_.F2R (beta:=beta) p := hFoppQ_le_p
      _ = |_root_.F2R (beta:=beta) p| := hpAbs.symm
  have h := Fcanonic_Rle_Zle (beta:=beta) radix b q p hbeta_gt hbeta.symm
  simpa only [wp, PostCond.noThrow, pure, Fcanonic_Rle_Zle_check,
    Id.run, ULift.up_down] using
    h ⟨Or.inl hqNormal, Or.inl hpNormal, habs_le⟩

/-- Coq Veltkamp local lemma `epLe`.

The exponent of the first rounded Veltkamp value is no larger than the
exponent of the comparison float `Float (Fnum x) (s + 1 + Fexp x)`.  This is
the upstream `Fcanonic_Rle_Zle` argument after projecting the comparison float
and using closest-rounding monotonicity. -/
theorem epLe {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hs_ge : 2 ≤ s) :
    p.Fexp ≤ (s : Int) + 1 + x.Fexp := by
  have hbeta_gt : 1 < beta := by
    rw [hbeta]
    exact hradix
  have hpNonneg :
      0 ≤ _root_.F2R (beta:=beta) p :=
    pPos (beta:=beta) b radix s t x p hradix hvNum hxPos hpDef
  have hMono :
      MonotoneP_float (Closest (beta:=beta) b (radix : ℝ)) := by
    have h := ClosestMonotone (beta:=beta) b (radix : ℝ)
    simpa only [wp, PostCond.noThrow, pure, ClosestMonotone_check,
      Id.run, ULift.up_down] using h trivial
  let xp : FloatSpec.Core.Defs.FlocqFloat beta :=
    ⟨x.Fnum, (s : Int) + 1 + x.Fexp⟩
  have hxpNormal : Fnormal (beta:=beta) radix b xp := by
    rcases hxNormal with ⟨hxBound, hxMant⟩
    constructor
    · constructor
      · simpa [xp] using hxBound.1
      · exact le_trans hxBound.2 (by omega : x.Fexp ≤ (s : Int) + 1 + x.Fexp)
    · simpa [xp] using hxMant
  have hProjectXp :
      Closest (beta:=beta) b (radix : ℝ)
        (_root_.F2R (beta:=beta) xp) xp := by
    constructor
    · exact hxpNormal.1
    · intro f _hfBounded
      rw [sub_self, abs_zero]
      exact abs_nonneg _
  have hradix_pos_int : (0 : Int) < radix := lt_trans (by decide) hradix
  have hradix_pos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradix_pos_int
  have hradix_one_lt : (1 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradix
  have hradix_one_le : (1 : ℝ) ≤ (radix : ℝ) := le_of_lt hradix_one_lt
  have hradix_ne : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos
  have hpow_s_pos : 0 < (radix : ℝ) ^ (s : Int) :=
    zpow_pos hradix_pos _
  have hfactor_lt_pow :
      (radix : ℝ) ^ (s : Int) + 1 <
        (radix : ℝ) ^ ((s : Int) + 1) := by
    have hs_two_int : (2 : Int) ≤ (s : Int) := by exact_mod_cast hs_ge
    have hpow_two_le :
        (radix : ℝ) ^ (2 : Int) ≤ (radix : ℝ) ^ (s : Int) :=
      zpow_le_zpow_right₀ hradix_one_le hs_two_int
    have htwo_le_radix : (2 : ℝ) ≤ (radix : ℝ) := by
      exact_mod_cast (by omega : (2 : Int) ≤ radix)
    have hpow_two_eq : (radix : ℝ) ^ (2 : Int) = (radix : ℝ) * (radix : ℝ) := by
      norm_num [zpow_ofNat, pow_two]
    have htwo_le_pow_s : (2 : ℝ) ≤ (radix : ℝ) ^ (s : Int) := by
      calc
        (2 : ℝ) ≤ (radix : ℝ) := htwo_le_radix
        _ ≤ (radix : ℝ) * (radix : ℝ) := by
          nlinarith [hradix_one_le]
        _ = (radix : ℝ) ^ (2 : Int) := hpow_two_eq.symm
        _ ≤ (radix : ℝ) ^ (s : Int) := hpow_two_le
    calc
      (radix : ℝ) ^ (s : Int) + 1
          < (radix : ℝ) ^ (s : Int) + (radix : ℝ) ^ (s : Int) := by
            linarith
      _ = (radix : ℝ) ^ (s : Int) * (2 : ℝ) := by ring
      _ ≤ (radix : ℝ) ^ (s : Int) * (radix : ℝ) :=
            mul_le_mul_of_nonneg_left htwo_le_radix (le_of_lt hpow_s_pos)
      _ = (radix : ℝ) ^ ((s : Int) + 1) := by
            rw [zpow_add₀ hradix_ne, zpow_one]
  have hinput_lt :
      _root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1) <
        _root_.F2R (beta:=beta) xp := by
    have hscaled :
        _root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1) <
          _root_.F2R (beta:=beta) x *
            (radix : ℝ) ^ ((s : Int) + 1) :=
      mul_lt_mul_of_pos_left hfactor_lt_pow hxPos
    have hxp_val :
        _root_.F2R (beta:=beta) xp =
          _root_.F2R (beta:=beta) x *
            (radix : ℝ) ^ ((s : Int) + 1) := by
      dsimp [xp, _root_.F2R, FloatSpec.Core.Defs.F2R]
      have hradix_cast : (radix : ℝ) = (beta : ℝ) := by
        exact_mod_cast hbeta.symm
      have hbeta_pos_real : (0 : ℝ) < (beta : ℝ) := by
        have : (0 : Int) < beta := lt_trans (by decide) hbeta_gt
        exact_mod_cast this
      have hbeta_ne : (beta : ℝ) ≠ 0 := ne_of_gt hbeta_pos_real
      rw [hradix_cast]
      rw [show (s : Int) + 1 + x.Fexp = x.Fexp + ((s : Int) + 1) by ring]
      rw [zpow_add₀ hbeta_ne]
      ring
    simpa [hxp_val]
      using hscaled
  have hp_le_xp :
      _root_.F2R (beta:=beta) p ≤ _root_.F2R (beta:=beta) xp :=
    hMono
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1))
      (_root_.F2R (beta:=beta) xp)
      p xp hinput_lt hpDef hProjectXp
  have hpAbs :
      |_root_.F2R (beta:=beta) p| =
        _root_.F2R (beta:=beta) p :=
    abs_of_nonneg hpNonneg
  have hxpNonneg : 0 ≤ _root_.F2R (beta:=beta) xp :=
    le_trans hpNonneg hp_le_xp
  have hxpAbs :
      |_root_.F2R (beta:=beta) xp| =
        _root_.F2R (beta:=beta) xp :=
    abs_of_nonneg hxpNonneg
  have habs_le :
      |_root_.F2R (beta:=beta) p| ≤
        |_root_.F2R (beta:=beta) xp| := by
    simpa [hpAbs, hxpAbs] using hp_le_xp
  have h := Fcanonic_Rle_Zle (beta:=beta) radix b p xp hbeta_gt hbeta.symm
  simpa only [wp, PostCond.noThrow, pure, Fcanonic_Rle_Zle_check,
    Id.run, ULift.up_down, xp] using
    h ⟨Or.inl hpNormal, Or.inl hxpNormal, habs_le⟩

private theorem eqLe_low {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hxNumLow : x.Fnum ≤ Zpower_nat radix t - radix - 1) :
    q.Fexp ≤ (s : Int) + x.Fexp := by
  subst beta
  have htNe : t ≠ 0 := by omega
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixOneLe : (1 : ℝ) ≤ (radix : ℝ) := by
    exact_mod_cast (le_of_lt hradix)
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hxNumPos : 0 < x.Fnum :=
    FloatSpec.Core.Float_prop.gt_0_F2R (beta:=radix) x hradix hxPos
  let g : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨x.Fnum + radix, x.Fexp + (s : Int)⟩
  have hgNumPos : 0 < g.Fnum := by
    dsimp [g]
    omega
  have hgNormal : Fnormal (beta:=radix) radix b g := by
    constructor
    · constructor
      · dsimp [g]
        rw [abs_of_pos (by omega : 0 < x.Fnum + radix), hvNum]
        omega
      · dsimp [g]
        have hsNonneg : (0 : Int) ≤ (s : Int) := Int.natCast_nonneg _
        exact le_trans hxBound.2 (by omega)
    · have hxScaledPos : 0 < radix * x.Fnum :=
        mul_pos hradixPosInt hxNumPos
      have hgScaledPos : 0 < radix * (x.Fnum + radix) := by
        nlinarith
      have hxMant := hxNormal.2
      dsimp [g]
      rw [abs_of_pos hxScaledPos] at hxMant
      rw [abs_of_pos hgScaledPos]
      exact le_trans hxMant (by nlinarith)
  have hpNonneg : 0 ≤ _root_.F2R (beta:=radix) p :=
    pPos (beta:=radix) b radix s t x p hradix hvNum hxPos hpDef
  have hqNonpos : _root_.F2R (beta:=radix) q ≤ 0 :=
    qNeg (beta:=radix) b radix s t x p q hradix hvNum hxBound hxPos hpDef hqDef
  have hMono :
      MonotoneP_float (Closest (beta:=radix) b (radix : ℝ)) := by
    have h := ClosestMonotone (beta:=radix) b (radix : ℝ)
    simpa only [wp, PostCond.noThrow, pure, ClosestMonotone_check,
      Id.run, ULift.up_down] using h trivial
  have hxProject : Closest (beta:=radix) b (radix : ℝ)
      (_root_.F2R (beta:=radix) x) x := by
    constructor
    · exact hxBound
    · intro f _hfBounded
      rw [sub_self, abs_zero]
      exact abs_nonneg _
  have hpowSPos : 0 < (radix : ℝ) ^ (s : Int) :=
    zpow_pos hradixPos _
  have hscaledGt :
      _root_.F2R (beta:=radix) x <
        _root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1) := by
    nlinarith
  have hxLeP :
      _root_.F2R (beta:=radix) x ≤ _root_.F2R (beta:=radix) p :=
    hMono _ _ x p hscaledGt hxProject hpDef
  have hpUlp :
      2 * |(_root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1)) -
          _root_.F2R (beta:=radix) p| ≤
        Fulp (beta:=radix) b radix t p := by
    have h := ClosestUlp (beta:=radix) b radix t
      (_root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1)) p
    simpa only [wp, PostCond.noThrow, pure, ClosestUlp_check,
      Id.run, ULift.up_down] using h ⟨hpDef, rfl, hradix, htNe, hvNum⟩
  have hpErr :
      2 * |(_root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1)) -
          _root_.F2R (beta:=radix) p| ≤
        (radix : ℝ) ^ p.Fexp := by
    have h := ClosestExp (beta:=radix) b radix t
      (_root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1)) p
    simpa only [wp, PostCond.noThrow, pure, ClosestExp_check,
      Id.run, ULift.up_down] using h ⟨hpDef, hpUlp, rfl, hradix⟩
  have hqUlp :
      2 * |(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
          _root_.F2R (beta:=radix) q| ≤
        Fulp (beta:=radix) b radix t q := by
    have h := ClosestUlp (beta:=radix) b radix t
      (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) q
    simpa only [wp, PostCond.noThrow, pure, ClosestUlp_check,
      Id.run, ULift.up_down] using h ⟨hqDef, rfl, hradix, htNe, hvNum⟩
  have hqErr :
      2 * |(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
          _root_.F2R (beta:=radix) q| ≤
        (radix : ℝ) ^ q.Fexp := by
    have h := ClosestExp (beta:=radix) b radix t
      (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) q
    simpa only [wp, PostCond.noThrow, pure, ClosestExp_check,
      Id.run, ULift.up_down] using h ⟨hqDef, hqUlp, rfl, hradix⟩
  have hqExpLeP : q.Fexp ≤ p.Fexp :=
    eqLeep (beta:=radix) b radix s t x p q rfl hradix hvNum hxBound
      hpDef hqDef hxPos hpNormal hqNormal
  have hpExpLe : p.Fexp ≤ (s : Int) + 1 + x.Fexp :=
    epLe (beta:=radix) b radix s t x p rfl hradix hvNum hpDef hxPos
      hpNormal hxNormal hsGe
  have hpowQLeP : (radix : ℝ) ^ q.Fexp ≤ (radix : ℝ) ^ p.Fexp :=
    zpow_le_zpow_right₀ hradixOneLe hqExpLeP
  have hpowPLeTop :
      (radix : ℝ) ^ p.Fexp ≤
        (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) :=
    zpow_le_zpow_right₀ hradixOneLe hpExpLe
  have hpMinusInputLe :
      _root_.F2R (beta:=radix) p -
          _root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1) ≤
        |(_root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1)) -
          _root_.F2R (beta:=radix) p| := by
    rw [abs_sub_comm]
    exact le_abs_self _
  have hpMinusXLe :
      _root_.F2R (beta:=radix) p - _root_.F2R (beta:=radix) x ≤
        _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (s : Int) +
          (radix : ℝ) ^ p.Fexp / 2 := by
    nlinarith [hpErr, hpMinusInputLe]
  have hqAbsLe :
      |_root_.F2R (beta:=radix) q| ≤
        _root_.F2R (beta:=radix) p - _root_.F2R (beta:=radix) x +
          (radix : ℝ) ^ q.Fexp / 2 := by
    calc
      |_root_.F2R (beta:=radix) q| =
          |-(_root_.F2R (beta:=radix) q)| := by rw [abs_neg]
      _ = |(_root_.F2R (beta:=radix) p - _root_.F2R (beta:=radix) x) +
          ((_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
            _root_.F2R (beta:=radix) q)| := by congr 1 <;> ring
      _ ≤ |_root_.F2R (beta:=radix) p - _root_.F2R (beta:=radix) x| +
          |(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
            _root_.F2R (beta:=radix) q| := abs_add_le _ _
      _ = (_root_.F2R (beta:=radix) p - _root_.F2R (beta:=radix) x) +
          |(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
            _root_.F2R (beta:=radix) q| := by
            rw [abs_of_nonneg (sub_nonneg.mpr hxLeP)]
      _ ≤ _root_.F2R (beta:=radix) p - _root_.F2R (beta:=radix) x +
          (radix : ℝ) ^ q.Fexp / 2 := by nlinarith [hqErr]
  have hqAbsCore :
      |_root_.F2R (beta:=radix) q| ≤
        _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (s : Int) +
          (radix : ℝ) ^ p.Fexp := by
    nlinarith [hqAbsLe, hpMinusXLe, hpowQLeP]
  have hgValue :
      _root_.F2R (beta:=radix) g =
        _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (s : Int) +
          (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) := by
    dsimp [g, _root_.F2R, FloatSpec.Core.Defs.F2R]
    have hbase :
        (radix : ℝ) ^ (x.Fexp + (s : Int)) =
          (radix : ℝ) ^ x.Fexp * (radix : ℝ) ^ (s : Int) := by
      rw [zpow_add₀ hradixNe]
    have htop :
        (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) =
          (radix : ℝ) * (radix : ℝ) ^ (x.Fexp + (s : Int)) := by
      calc
        (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) =
            (radix : ℝ) ^ (1 + (x.Fexp + (s : Int))) := by
              congr 1
              ring
        _ = (radix : ℝ) ^ (1 : Int) *
            (radix : ℝ) ^ (x.Fexp + (s : Int)) := by
              rw [zpow_add₀ hradixNe]
        _ = (radix : ℝ) * (radix : ℝ) ^ (x.Fexp + (s : Int)) := by
              rw [zpow_one]
    simp only [Int.cast_add, hbase, htop]
    ring
  have hgNonneg : 0 ≤ _root_.F2R (beta:=radix) g := by
    dsimp [g, _root_.F2R, FloatSpec.Core.Defs.F2R]
    exact mul_nonneg (by exact_mod_cast (le_of_lt hgNumPos))
      (le_of_lt (zpow_pos hradixPos _))
  have habsLe :
      |_root_.F2R (beta:=radix) q| ≤ |_root_.F2R (beta:=radix) g| := by
    rw [abs_of_nonneg hgNonneg, hgValue]
    exact le_trans hqAbsCore (add_le_add_right hpowPLeTop _)
  have h := Fcanonic_Rle_Zle (beta:=radix) radix b q g hradix rfl
  simpa only [wp, PostCond.noThrow, pure, Fcanonic_Rle_Zle_check,
    Id.run, ULift.up_down, g, add_comm] using
    h ⟨Or.inl hqNormal, Or.inl hgNormal, habsLe⟩

private theorem velt_p_upper {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p) :
    _root_.F2R (beta:=beta) p ≤
      (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int)) +
        (radix : ℝ) ^ (x.Fexp + (t : Int)) := by
  subst beta
  have htPos : 0 < t := by omega
  have htsPos : 0 < t - s - 1 := by omega
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hxNumPos : 0 < x.Fnum :=
    FloatSpec.Core.Float_prop.gt_0_F2R (beta:=radix) x hradix hxPos
  have hxNumLt : x.Fnum < Zpower_nat radix t := by
    have hnum := hxBound.1
    rw [abs_of_pos hxNumPos, hvNum] at hnum
    exact hnum
  let j : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨Zpower_nat radix (t - 1) + Zpower_nat radix (t - s - 1),
      x.Fexp + (s : Int) + 1⟩
  have hpowPredPos : 0 < radix ^ (t - 1) := pow_pos hradixPosInt _
  have hpowSmallPos : 0 < radix ^ (t - s - 1) := pow_pos hradixPosInt _
  have hsmallExpLt : t - s - 1 < t - 1 := by omega
  have hsmallPowLt :
      radix ^ (t - s - 1) < radix ^ (t - 1) :=
    pow_lt_pow_right₀ hradix hsmallExpLt
  have hsumLtTwo :
      radix ^ (t - 1) + radix ^ (t - s - 1) <
        2 * radix ^ (t - 1) := by omega
  have htwoLeRadix : (2 : Int) ≤ radix := by omega
  have htwoPowLe :
      2 * radix ^ (t - 1) ≤ radix * radix ^ (t - 1) :=
    mul_le_mul_of_nonneg_right htwoLeRadix (le_of_lt hpowPredPos)
  have hpowT : radix * radix ^ (t - 1) = radix ^ t := by
    conv_rhs => rw [show t = (t - 1) + 1 by omega, pow_succ]
    ring
  have hjNumPos : 0 < j.Fnum := by
    dsimp [j, Zpower_nat]
    omega
  have hjBound : Fbounded (beta:=radix) b j := by
    constructor
    · dsimp [j, Zpower_nat]
      rw [abs_of_pos (by omega : 0 < radix ^ (t - 1) + radix ^ (t - s - 1)),
        hvNum, Zpower_nat]
      exact lt_of_lt_of_le hsumLtTwo (by simpa [hpowT] using htwoPowLe)
    · dsimp [j]
      have hsNonneg : (0 : Int) ≤ (s : Int) := Int.natCast_nonneg _
      exact le_trans hxBound.2 (by omega)
  have hpredCast :
      (Zpower_nat radix (t - 1) : ℝ) =
        (radix : ℝ) ^ (((t - 1 : Nat) : Int)) := by
    have h := Zpower_nat_Z_powerRZ radix (t - 1)
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hsmallCast :
      (Zpower_nat radix (t - s - 1) : ℝ) =
        (radix : ℝ) ^ (((t - s - 1 : Nat) : Int)) := by
    have h := Zpower_nat_Z_powerRZ radix (t - s - 1)
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hjValue :
      _root_.F2R (beta:=radix) j =
        (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int)) +
          (radix : ℝ) ^ (x.Fexp + (t : Int)) := by
    dsimp [j, _root_.F2R, FloatSpec.Core.Defs.F2R]
    rw [Int.cast_add, hpredCast, hsmallCast]
    calc
      ((radix : ℝ) ^ (((t - 1 : Nat) : Int)) +
          (radix : ℝ) ^ (((t - s - 1 : Nat) : Int))) *
          (radix : ℝ) ^ (x.Fexp + (s : Int) + 1) =
        (radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
            (radix : ℝ) ^ (x.Fexp + (s : Int) + 1) +
          (radix : ℝ) ^ (((t - s - 1 : Nat) : Int)) *
            (radix : ℝ) ^ (x.Fexp + (s : Int) + 1) := by ring
      _ = (radix : ℝ) ^
            (((t - 1 : Nat) : Int) + (x.Fexp + (s : Int) + 1)) +
          (radix : ℝ) ^
            (((t - s - 1 : Nat) : Int) + (x.Fexp + (s : Int) + 1)) := by
              rw [← zpow_add₀ hradixNe, ← zpow_add₀ hradixNe]
      _ = (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int)) +
          (radix : ℝ) ^ (x.Fexp + (t : Int)) := by
            congr 1 <;> congr 1 <;> omega
  have htCast :
      (Zpower_nat radix t : ℝ) = (radix : ℝ) ^ (t : Int) := by
    have h := Zpower_nat_Z_powerRZ radix t
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hxNumLtReal : (x.Fnum : ℝ) < (Zpower_nat radix t : ℝ) := by
    exact_mod_cast hxNumLt
  have hfactorPos : 0 < (radix : ℝ) ^ (s : Int) + 1 := by
    have := zpow_pos hradixPos (s : Int)
    linarith
  have hscalePos :
      0 < (radix : ℝ) ^ x.Fexp * ((radix : ℝ) ^ (s : Int) + 1) :=
    mul_pos (zpow_pos hradixPos _) hfactorPos
  have hinputRaw :
      (x.Fnum : ℝ) *
          ((radix : ℝ) ^ x.Fexp * ((radix : ℝ) ^ (s : Int) + 1)) <
        (Zpower_nat radix t : ℝ) *
          ((radix : ℝ) ^ x.Fexp * ((radix : ℝ) ^ (s : Int) + 1)) :=
    mul_lt_mul_of_pos_right hxNumLtReal hscalePos
  have hupperValue :
      (Zpower_nat radix t : ℝ) *
          ((radix : ℝ) ^ x.Fexp * ((radix : ℝ) ^ (s : Int) + 1)) =
        (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int)) +
          (radix : ℝ) ^ (x.Fexp + (t : Int)) := by
    rw [htCast]
    have htx :
        (radix : ℝ) ^ (t : Int) * (radix : ℝ) ^ x.Fexp =
          (radix : ℝ) ^ (x.Fexp + (t : Int)) := by
      rw [← zpow_add₀ hradixNe]
      congr 1
      ring
    rw [← mul_assoc, htx]
    rw [mul_add]
    simp only [mul_one]
    rw [← zpow_add₀ hradixNe]
  have hinputLt :
      _root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1) <
        _root_.F2R (beta:=radix) j := by
    rw [hjValue, ← hupperValue]
    simpa [_root_.F2R, FloatSpec.Core.Defs.F2R, mul_assoc] using hinputRaw
  have hMono :
      MonotoneP_float (Closest (beta:=radix) b (radix : ℝ)) := by
    have h := ClosestMonotone (beta:=radix) b (radix : ℝ)
    simpa only [wp, PostCond.noThrow, pure, ClosestMonotone_check,
      Id.run, ULift.up_down] using h trivial
  have hjProject : Closest (beta:=radix) b (radix : ℝ)
      (_root_.F2R (beta:=radix) j) j := by
    constructor
    · exact hjBound
    · intro f _hfBounded
      rw [sub_self, abs_zero]
      exact abs_nonneg _
  exact hjValue ▸ hMono _ _ p j hinputLt hpDef hjProject

private theorem eqLe_high {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hxNumHigh : Zpower_nat radix t - radix ≤ x.Fnum) :
    q.Fexp ≤ (s : Int) + x.Fexp ∨
      (_root_.F2R (beta:=beta) q =
          -(radix : ℝ) ^ ((t : Int) + (s : Int) + x.Fexp) ∧
        |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) hx| ≤
          (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2) := by
  subst beta
  have htNe : t ≠ 0 := by omega
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixOneLe : (1 : ℝ) ≤ (radix : ℝ) := by
    exact_mod_cast (le_of_lt hradix)
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hxNumPos : 0 < x.Fnum :=
    FloatSpec.Core.Float_prop.gt_0_F2R (beta:=radix) x hradix hxPos
  have hqExpLeP : q.Fexp ≤ p.Fexp :=
    eqLeep (beta:=radix) b radix s t x p q rfl hradix hvNum hxBound
      hpDef hqDef hxPos hpNormal hqNormal
  have hpExpLe : p.Fexp ≤ (s : Int) + 1 + x.Fexp :=
    epLe (beta:=radix) b radix s t x p rfl hradix hvNum hpDef hxPos
      hpNormal hxNormal hsGe
  by_cases hqExpLow : q.Fexp ≤ (s : Int) + x.Fexp
  · exact Or.inl hqExpLow
  · right
    have hqExpEq : q.Fexp = (s : Int) + 1 + x.Fexp := by omega
    have hstepPos :
        0 < (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) :=
      zpow_pos hradixPos _
    have hsmallPos : 0 < (radix : ℝ) ^ ((s : Int) + x.Fexp) :=
      zpow_pos hradixPos _
    let qpos : FloatSpec.Core.Defs.FlocqFloat radix :=
      ⟨nNormMin radix t, (s : Int) + 1 + x.Fexp⟩
    let q0 : FloatSpec.Core.Defs.FlocqFloat radix :=
      ⟨-nNormMin radix t, (s : Int) + 1 + x.Fexp⟩
    have hqExpBound : -b.dExp ≤ (s : Int) + 1 + x.Fexp := by
      have hsNonneg : (0 : Int) ≤ (s : Int) := Int.natCast_nonneg _
      exact le_trans hxBound.2 (by omega)
    have hqposNormal : Fnormal (beta:=radix) radix b qpos := by
      exact FnormalNnormMin (beta:=radix) radix b t
        ((s : Int) + 1 + x.Fexp) hradix (by omega) hvNum hqExpBound
    have hq0Normal : Fnormal (beta:=radix) radix b q0 := by
      have h := FnormalFop (beta:=radix) b radix qpos
      simpa only [wp, PostCond.noThrow, pure, FnormalFop_check,
        Id.run, ULift.up_down, qpos, q0, FloatSpec.Calc.Operations.Fopp,
        neg_neg] using h hqposNormal
    have hqNonpos : _root_.F2R (beta:=radix) q ≤ 0 :=
      qNeg (beta:=radix) b radix s t x p q hradix hvNum hxBound hxPos hpDef hqDef
    have hqNumNonpos : q.Fnum ≤ 0 :=
      FloatSpec.Core.Float_prop.le_0_F2R (beta:=radix) q hradix hqNonpos
    have hqAbsMin : nNormMin radix t ≤ |q.Fnum| := by
      have h := pNormal_absolu_min (beta:=radix) radix b t q
      simpa only [wp, PostCond.noThrow, pure, pNormal_absolu_min_check,
        Id.run, ULift.up_down] using
        h ⟨hqNormal, hqNormal, htNe, hradix, hvNum⟩
    have hqNumLe : q.Fnum ≤ -nNormMin radix t := by
      rw [abs_of_nonpos hqNumNonpos] at hqAbsMin
      omega
    have hnormMinCast :
        (nNormMin radix t : ℝ) = (radix : ℝ) ^ ((t : Int) - 1) := by
      unfold nNormMin
      rw [Int.cast_pow]
      rw [← zpow_natCast]
      congr 1
      omega
    have hq0Value :
        _root_.F2R (beta:=radix) q0 =
          -(radix : ℝ) ^ ((t : Int) + (s : Int) + x.Fexp) := by
      dsimp [q0, _root_.F2R, FloatSpec.Core.Defs.F2R]
      rw [Int.cast_neg, hnormMinCast]
      calc
        -(radix : ℝ) ^ ((t : Int) - 1) *
            (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) =
          -((radix : ℝ) ^ ((t : Int) - 1) *
            (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp)) := by ring
        _ = -((radix : ℝ) ^ (((t : Int) - 1) +
            ((s : Int) + 1 + x.Fexp))) := by
              exact congrArg Neg.neg
                (zpow_add₀ hradixNe ((t : Int) - 1)
                  ((s : Int) + 1 + x.Fexp)).symm
        _ = -(radix : ℝ) ^ ((t : Int) + (s : Int) + x.Fexp) := by
              congr 2
              ring
    have hpUlp :
        2 * |(_root_.F2R (beta:=radix) x *
            ((radix : ℝ) ^ (s : Int) + 1)) -
            _root_.F2R (beta:=radix) p| ≤
          Fulp (beta:=radix) b radix t p := by
      have h := ClosestUlp (beta:=radix) b radix t
        (_root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1)) p
      simpa only [wp, PostCond.noThrow, pure, ClosestUlp_check,
        Id.run, ULift.up_down] using h ⟨hpDef, rfl, hradix, htNe, hvNum⟩
    have hpErr :
        2 * |(_root_.F2R (beta:=radix) x *
            ((radix : ℝ) ^ (s : Int) + 1)) -
            _root_.F2R (beta:=radix) p| ≤
          (radix : ℝ) ^ p.Fexp := by
      have h := ClosestExp (beta:=radix) b radix t
        (_root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1)) p
      simpa only [wp, PostCond.noThrow, pure, ClosestExp_check,
        Id.run, ULift.up_down] using h ⟨hpDef, hpUlp, rfl, hradix⟩
    have hpPowLeStep :
        (radix : ℝ) ^ p.Fexp ≤
          (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) :=
      zpow_le_zpow_right₀ hradixOneLe hpExpLe
    have hpMinusInputLe :
        _root_.F2R (beta:=radix) p -
            _root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1) ≤
          |(_root_.F2R (beta:=radix) x *
            ((radix : ℝ) ^ (s : Int) + 1)) -
            _root_.F2R (beta:=radix) p| := by
      rw [abs_sub_comm]
      exact le_abs_self _
    have hpRoundUpper :
        _root_.F2R (beta:=radix) p -
            _root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1) ≤
          (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) / 2 := by
      nlinarith [hpErr, hpPowLeStep, hpMinusInputLe]
    have hxNumUpper : x.Fnum ≤ Zpower_nat radix t - 1 := by
      have hnum := hxBound.1
      rw [abs_of_pos hxNumPos, hvNum] at hnum
      omega
    have htCast :
        (Zpower_nat radix t : ℝ) = (radix : ℝ) ^ (t : Int) := by
      have h := Zpower_nat_Z_powerRZ radix t
      simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
        Id.run, ULift.up_down] using h trivial
    have hxNumUpperReal :
        (x.Fnum : ℝ) ≤ (Zpower_nat radix t - 1 : Int) := by
      exact_mod_cast hxNumUpper
    have hxScaleLe :
        _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (s : Int) ≤
          (radix : ℝ) ^ ((t : Int) + (s : Int) + x.Fexp) -
            (radix : ℝ) ^ ((s : Int) + x.Fexp) := by
      have hmul := mul_le_mul_of_nonneg_right hxNumUpperReal
        (le_of_lt (zpow_pos hradixPos (x.Fexp + (s : Int))))
      calc
        _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (s : Int) =
            (x.Fnum : ℝ) * (radix : ℝ) ^ (x.Fexp + (s : Int)) := by
              dsimp [_root_.F2R, FloatSpec.Core.Defs.F2R]
              rw [zpow_add₀ hradixNe]
              ring
        _ ≤ ((Zpower_nat radix t - 1 : Int) : ℝ) *
            (radix : ℝ) ^ (x.Fexp + (s : Int)) := by
              exact hmul
        _ = (radix : ℝ) ^ ((t : Int) + (s : Int) + x.Fexp) -
            (radix : ℝ) ^ ((s : Int) + x.Fexp) := by
              rw [Int.cast_sub, Int.cast_one, htCast]
              have hprod :
                  (radix : ℝ) ^ (t : Int) *
                      (radix : ℝ) ^ (x.Fexp + (s : Int)) =
                    (radix : ℝ) ^ ((t : Int) + (s : Int) + x.Fexp) := by
                rw [← zpow_add₀ hradixNe]
                congr 1
                ring
              rw [sub_mul, one_mul, hprod]
              congr 1
              ring
    have hinputMid :
        _root_.F2R (beta:=radix) q0 -
            (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) / 2 <
          _root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p := by
      rw [hq0Value]
      nlinarith [hpRoundUpper, hxScaleLe, hsmallPos]
    have hqNumEq : q.Fnum = -nNormMin radix t := by
      by_contra hne
      have hqNumPred : q.Fnum ≤ -nNormMin radix t - 1 := by omega
      have hqNumPredReal :
          (q.Fnum : ℝ) ≤ ((-nNormMin radix t - 1 : Int) : ℝ) := by
        exact_mod_cast hqNumPred
      have hqGap :
          _root_.F2R (beta:=radix) q ≤
            _root_.F2R (beta:=radix) q0 -
              (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) := by
        have hmul := mul_le_mul_of_nonneg_right hqNumPredReal
          (le_of_lt hstepPos)
        dsimp [q0, _root_.F2R, FloatSpec.Core.Defs.F2R]
        rw [hqExpEq]
        push_cast at hmul ⊢
        nlinarith
      have hdist := hqDef.2 q0 hq0Normal.1
      have hsq := sq_le_sq.mpr hdist
      have hleftPos :
          0 < _root_.F2R (beta:=radix) q0 -
            _root_.F2R (beta:=radix) q := by
        linarith
      have hrightPos :
          0 < 2 * (_root_.F2R (beta:=radix) x -
              _root_.F2R (beta:=radix) p) -
            _root_.F2R (beta:=radix) q -
            _root_.F2R (beta:=radix) q0 := by
        linarith
      have hprodPos := mul_pos hleftPos hrightPos
      have hprodNonpos :
          (_root_.F2R (beta:=radix) q0 - _root_.F2R (beta:=radix) q) *
              (2 * (_root_.F2R (beta:=radix) x -
                  _root_.F2R (beta:=radix) p) -
                _root_.F2R (beta:=radix) q -
                _root_.F2R (beta:=radix) q0) ≤ 0 := by
        nlinarith [hsq]
      exact (not_le_of_gt hprodPos) hprodNonpos
    have hqEqQ0 : q = q0 := by
      cases q with
      | mk m e =>
          simp only [FloatSpec.Core.Defs.FlocqFloat.Fnum,
            FloatSpec.Core.Defs.FlocqFloat.Fexp] at hqNumEq hqExpEq
          simp [q0, hqNumEq, hqExpEq]
    have hqValue :
        _root_.F2R (beta:=radix) q =
          -(radix : ℝ) ^ ((t : Int) + (s : Int) + x.Fexp) := by
      rw [hqEqQ0]
      exact hq0Value
    refine ⟨hqValue, ?_⟩
    have hpUpper := velt_p_upper (beta:=radix) b radix s t x p rfl hradix
      hvNum hsGe hsLe hxBound hxPos hpDef
    have hpUpper' :
        _root_.F2R (beta:=radix) p ≤
          (radix : ℝ) ^ ((t : Int) + (s : Int) + x.Fexp) +
            (radix : ℝ) ^ ((t : Int) + x.Fexp) := by
      simpa only [add_assoc, add_comm, add_left_comm] using hpUpper
    have hxNumHighReal :
        ((Zpower_nat radix t - radix : Int) : ℝ) ≤ (x.Fnum : ℝ) := by
      exact_mod_cast hxNumHigh
    have hxLower :
        (radix : ℝ) ^ ((t : Int) + x.Fexp) -
            (radix : ℝ) ^ (1 + x.Fexp) ≤
          _root_.F2R (beta:=radix) x := by
      have hmul := mul_le_mul_of_nonneg_right hxNumHighReal
        (le_of_lt (zpow_pos hradixPos x.Fexp))
      calc
        (radix : ℝ) ^ ((t : Int) + x.Fexp) -
            (radix : ℝ) ^ (1 + x.Fexp) =
          ((Zpower_nat radix t - radix : Int) : ℝ) *
            (radix : ℝ) ^ x.Fexp := by
              rw [Int.cast_sub, htCast]
              rw [sub_mul]
              have htProd :
                  (radix : ℝ) ^ (t : Int) * (radix : ℝ) ^ x.Fexp =
                    (radix : ℝ) ^ ((t : Int) + x.Fexp) := by
                rw [← zpow_add₀ hradixNe]
              have hradixProd :
                  (radix : ℝ) * (radix : ℝ) ^ x.Fexp =
                    (radix : ℝ) ^ (1 + x.Fexp) := by
                calc
                  (radix : ℝ) * (radix : ℝ) ^ x.Fexp =
                      (radix : ℝ) ^ (1 : Int) *
                        (radix : ℝ) ^ x.Fexp := by rw [zpow_one]
                  _ = (radix : ℝ) ^ (1 + x.Fexp) := by
                        rw [zpow_add₀ hradixNe]
              rw [htProd, hradixProd]
        _ ≤ (x.Fnum : ℝ) * (radix : ℝ) ^ x.Fexp := hmul
        _ = _root_.F2R (beta:=radix) x := by rfl
    have hLowerSideGap :
        _root_.F2R (beta:=radix) p - _root_.F2R (beta:=radix) x -
            (radix : ℝ) ^ ((t : Int) + (s : Int) + x.Fexp) ≤
          (radix : ℝ) ^ (1 + x.Fexp) := by
      nlinarith [hpUpper', hxLower]
    have htwoPowLeSmall :
        2 * (radix : ℝ) ^ (1 + x.Fexp) ≤
          (radix : ℝ) ^ ((s : Int) + x.Fexp) := by
      have htwoLeRadix : (2 : ℝ) ≤ (radix : ℝ) := by
        exact_mod_cast (by omega : (2 : Int) ≤ radix)
      have hfirst :
          2 * (radix : ℝ) ^ (1 + x.Fexp) ≤
            (radix : ℝ) * (radix : ℝ) ^ (1 + x.Fexp) :=
        mul_le_mul_of_nonneg_right htwoLeRadix
          (le_of_lt (zpow_pos hradixPos _))
      have hmulPow :
          (radix : ℝ) * (radix : ℝ) ^ (1 + x.Fexp) =
            (radix : ℝ) ^ (2 + x.Fexp) := by
        calc
          (radix : ℝ) * (radix : ℝ) ^ (1 + x.Fexp) =
              (radix : ℝ) ^ (1 : Int) *
                (radix : ℝ) ^ (1 + x.Fexp) := by rw [zpow_one]
          _ = (radix : ℝ) ^ (1 + (1 + x.Fexp)) := by
                exact (zpow_add₀ hradixNe (1 : Int) (1 + x.Fexp)).symm
          _ = (radix : ℝ) ^ (2 + x.Fexp) := by
                congr 1
                ring
      have hpowMono :
          (radix : ℝ) ^ (2 + x.Fexp) ≤
            (radix : ℝ) ^ ((s : Int) + x.Fexp) :=
        zpow_le_zpow_right₀ hradixOneLe (by omega)
      exact le_trans hfirst (hmulPow ▸ hpowMono)
    have hhxExact :
        _root_.F2R (beta:=radix) hx =
          _root_.F2R (beta:=radix) p + _root_.F2R (beta:=radix) q :=
      hxExact (beta:=radix) b radix s t x p q hx rfl hradix htNe hvNum
        hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hsGe hsLe
    rw [hhxExact]
    have hresRewrite :
        _root_.F2R (beta:=radix) x -
            (_root_.F2R (beta:=radix) p + _root_.F2R (beta:=radix) q) =
          (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
            _root_.F2R (beta:=radix) q := by ring
    rw [hresRewrite]
    by_cases hresLeQ :
        _root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p ≤
          _root_.F2R (beta:=radix) q
    · rw [abs_of_nonpos (sub_nonpos.mpr hresLeQ), hqValue]
      nlinarith [hLowerSideGap, htwoPowLeSmall]
    · have hqLtRes :
          _root_.F2R (beta:=radix) q <
            _root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p :=
        lt_of_not_ge hresLeQ
      let qplus := FNSucc (beta:=radix) b (radix : ℝ) t q
      have hqCan : Fcanonic (beta:=radix) radix b q := Or.inl hqNormal
      have hqNormEq : Fnormalize (beta:=radix) radix b t q = q := by
        have h := FcanonicFnormalizeEq (beta:=radix) radix b t q
        simpa only [wp, PostCond.noThrow, pure, FcanonicFnormalizeEq_check,
          Id.run, ULift.up_down] using h ⟨hqCan, rfl, hradix, htNe, hvNum⟩
      have hqplusCan : Fcanonic (beta:=radix) radix b qplus := by
        have h := FNSuccCanonic (beta:=radix) b (radix : ℝ) t q
        simpa only [wp, PostCond.noThrow, pure, FNSuccCanonic_check,
          Id.run, ULift.up_down, qplus] using
          h ⟨hqDef.1, hradix, htNe, hvNum⟩
      have hqplusBound : Fbounded (beta:=radix) b qplus := by
        have h := FcanonicBound (beta:=radix) radix b qplus
        simpa only [wp, PostCond.noThrow, pure, FcanonicBound_check,
          Id.run, ULift.up_down] using h hqplusCan
      have hqExpNotMin : q.Fexp ≠ -b.dExp := by
        rw [hqExpEq]
        have hsPos : (0 : Int) < (s : Int) + 1 := by omega
        exact ne_of_gt (lt_of_le_of_lt hxBound.2 (by omega))
      have hsuccDiff := FSuccDiff3 (beta:=radix) b radix t q rfl hradix
        htNe hvNum hqNumEq hqExpNotMin
      have hminusVal :
          _root_.F2R (beta:=radix)
              (FloatSpec.Calc.Operations.Fminus (beta:=radix)
                (FSucc (beta:=radix) b radix t q) q) =
            _root_.F2R (beta:=radix) (FSucc (beta:=radix) b radix t q) -
              _root_.F2R (beta:=radix) q := by
        have h := Fminus_correct (beta:=radix)
          (FSucc (beta:=radix) b radix t q) q
        simpa only [wp, PostCond.noThrow, pure, Fminus_correct_check,
          Id.run, ULift.up_down] using h hradix
      have hqplusEq : qplus = FSucc (beta:=radix) b radix t q := by
        simp only [qplus, FNSucc, hqNormEq]
      have hgap :
          _root_.F2R (beta:=radix) qplus - _root_.F2R (beta:=radix) q =
            (radix : ℝ) ^ ((s : Int) + x.Fexp) := by
        rw [hqplusEq]
        calc
          _root_.F2R (beta:=radix) (FSucc (beta:=radix) b radix t q) -
              _root_.F2R (beta:=radix) q =
            _root_.F2R (beta:=radix)
              (FloatSpec.Calc.Operations.Fminus (beta:=radix)
                (FSucc (beta:=radix) b radix t q) q) := hminusVal.symm
          _ = _root_.F2R (beta:=radix)
              (⟨1, q.Fexp - 1⟩ : FloatSpec.Core.Defs.FlocqFloat radix) := by
                simpa [FtoR] using hsuccDiff
          _ = (radix : ℝ) ^ ((s : Int) + x.Fexp) := by
                dsimp [_root_.F2R, FloatSpec.Core.Defs.F2R]
                rw [hqExpEq]
                congr 1
                ring
      have hresLeQplus :
          _root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p ≤
            _root_.F2R (beta:=radix) qplus := by
        by_contra hnot
        have hqplusLtRes :
            _root_.F2R (beta:=radix) qplus <
              _root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p :=
          lt_of_not_ge hnot
        have hdist := hqDef.2 qplus hqplusBound
        have hqDist :
            |_root_.F2R (beta:=radix) q -
                (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p)| =
              (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
                _root_.F2R (beta:=radix) q := by
          rw [abs_of_nonpos (sub_nonpos.mpr (le_of_lt hqLtRes))]
          ring
        have hqplusDist :
            |_root_.F2R (beta:=radix) qplus -
                (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p)| =
              (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
                _root_.F2R (beta:=radix) qplus := by
          rw [abs_of_nonpos (sub_nonpos.mpr (le_of_lt hqplusLtRes))]
          ring
        rw [hqDist, hqplusDist] at hdist
        linarith [hgap, hsmallPos]
      have hdist := hqDef.2 qplus hqplusBound
      have hqDist :
          |_root_.F2R (beta:=radix) q -
              (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p)| =
            (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
              _root_.F2R (beta:=radix) q := by
        rw [abs_of_nonpos (sub_nonpos.mpr (le_of_lt hqLtRes))]
        ring
      have hqplusDist :
          |_root_.F2R (beta:=radix) qplus -
              (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p)| =
            _root_.F2R (beta:=radix) qplus -
              (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) := by
        rw [abs_of_nonneg (sub_nonneg.mpr hresLeQplus)]
      rw [hqDist, hqplusDist] at hdist
      have htargetDist :
          |(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
              _root_.F2R (beta:=radix) q| =
            (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
              _root_.F2R (beta:=radix) q := by
        rw [abs_of_nonneg (sub_nonneg.mpr (le_of_lt hqLtRes))]
      rw [htargetDist]
      linarith [hgap]

/-- Coq Veltkamp local lemma `eqLe`.

The second rounded residual either has exponent at most `s + Fexp x`, or it
is the negative minimal-normal boundary value and the reconstructed high part
has the upstream half-ulp residual bound. -/
theorem eqLe {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x) :
    q.Fexp ≤ (s : Int) + x.Fexp ∨
      (_root_.F2R (beta:=beta) q =
          -(radix : ℝ) ^ ((t : Int) + (s : Int) + x.Fexp) ∧
        |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) hx| ≤
          (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2) := by
  by_cases hxHigh : Zpower_nat radix t - radix ≤ x.Fnum
  · exact eqLe_high (beta:=beta) b radix s t x p q hx hbeta hradix hvNum
      hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hxNormal hxHigh
  · left
    apply eqLe_low (beta:=beta) b radix s t x p q hbeta hradix hvNum hsGe hsLe
      hxBound hpDef hqDef hxPos hpNormal hqNormal hxNormal
    omega

private theorem eqGe_of_min_le_opp {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x q : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (htPos : 0 < t)
    (hxBound : Fbounded (beta:=beta) b x)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hLower :
      _root_.F2R (beta:=beta)
          (⟨nNormMin radix t, (s : Int) + x.Fexp⟩ :
            FloatSpec.Core.Defs.FlocqFloat beta) ≤
        _root_.F2R (beta:=beta) (Fopp (beta:=beta) q)) :
    (s : Int) + x.Fexp ≤ q.Fexp := by
  subst beta
  let g : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨nNormMin radix t, (s : Int) + x.Fexp⟩
  have hgExpBound : -b.dExp ≤ (s : Int) + x.Fexp := by
    exact le_trans hxBound.2 (by omega)
  have hgNormal : Fnormal (beta:=radix) radix b g := by
    exact FnormalNnormMin (beta:=radix) radix b t
      ((s : Int) + x.Fexp) hradix htPos hvNum hgExpBound
  have hqOppNormal :
      Fnormal (beta:=radix) radix b (Fopp (beta:=radix) q) := by
    have h := FnormalFop (beta:=radix) b radix q
    simpa only [wp, PostCond.noThrow, pure, FnormalFop_check,
      Id.run, ULift.up_down] using h hqNormal
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast (lt_trans (by decide : (0 : Int) < 1) hradix)
  have hnPos : 0 < nNormMin radix t := by
    unfold nNormMin
    exact pow_pos (by omega) _
  have hgNonneg : 0 ≤ _root_.F2R (beta:=radix) g := by
    dsimp [g, _root_.F2R, FloatSpec.Core.Defs.F2R]
    exact mul_nonneg (by exact_mod_cast (le_of_lt hnPos))
      (le_of_lt (zpow_pos hradixPos _))
  have hLower' :
      _root_.F2R (beta:=radix) g ≤
        _root_.F2R (beta:=radix) (Fopp (beta:=radix) q) := by
    simpa only [g] using hLower
  have hqOppNonneg :
      0 ≤ _root_.F2R (beta:=radix) (Fopp (beta:=radix) q) :=
    le_trans hgNonneg hLower'
  have habsLe :
      |_root_.F2R (beta:=radix) g| ≤
        |_root_.F2R (beta:=radix) (Fopp (beta:=radix) q)| := by
    simpa [abs_of_nonneg hgNonneg, abs_of_nonneg hqOppNonneg] using hLower'
  have h := Fcanonic_Rle_Zle (beta:=radix) radix b g
    (Fopp (beta:=radix) q) hradix rfl
  simpa only [wp, PostCond.noThrow, pure, Fcanonic_Rle_Zle_check,
    Id.run, ULift.up_down, g, Fopp, FloatSpec.Calc.Operations.Fopp] using
    h ⟨Or.inl hgNormal, Or.inl hqOppNormal, habsLe⟩

private theorem velt_p_lower_middle {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hxNumMiddle : nNormMin radix t + 1 ≤ x.Fnum) :
    (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int) - 1) +
        (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) +
        (radix : ℝ) ^ (x.Fexp + (s : Int)) ≤
      _root_.F2R (beta:=beta) p := by
  subst beta
  have htPos : 0 < t := by omega
  have htsPos : 0 < t - s - 1 := by omega
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  let j : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨Zpower_nat radix (t - 1) + Zpower_nat radix (t - s - 1) + 1,
      x.Fexp + (s : Int)⟩
  have hpowPredPos : 0 < radix ^ (t - 1) := pow_pos hradixPosInt _
  have hpowSmallPos : 0 < radix ^ (t - s - 1) := pow_pos hradixPosInt _
  have hsmallExpLe : t - s - 1 ≤ t - 2 := by omega
  have hsmallPowLe :
      radix ^ (t - s - 1) ≤ radix ^ (t - 2) :=
    pow_le_pow_right₀ (by omega : (1 : Int) ≤ radix) hsmallExpLe
  have honeLtSmaller : 1 < radix ^ (t - 2) := by
    have h := pow_lt_pow_right₀ hradix (by omega : 0 < t - 2)
    simpa using h
  have hsmallPlusOneLt :
      radix ^ (t - s - 1) + 1 < 2 * radix ^ (t - 2) := by
    omega
  have htwoLeRadix : (2 : Int) ≤ radix := by omega
  have htwoSmallerLe :
      2 * radix ^ (t - 2) ≤ radix * radix ^ (t - 2) :=
    mul_le_mul_of_nonneg_right htwoLeRadix
      (le_of_lt (pow_pos hradixPosInt _))
  have hpredPow : radix * radix ^ (t - 2) = radix ^ (t - 1) := by
    conv_rhs => rw [show t - 1 = (t - 2) + 1 by omega, pow_succ]
    ring
  have htailLtPred :
      radix ^ (t - s - 1) + 1 < radix ^ (t - 1) :=
    lt_of_lt_of_le hsmallPlusOneLt (by simpa [hpredPow] using htwoSmallerLe)
  have hsumLtTwoPred :
      radix ^ (t - 1) + radix ^ (t - s - 1) + 1 <
        2 * radix ^ (t - 1) := by omega
  have htwoPredLe :
      2 * radix ^ (t - 1) ≤ radix * radix ^ (t - 1) :=
    mul_le_mul_of_nonneg_right htwoLeRadix (le_of_lt hpowPredPos)
  have hpowT : radix * radix ^ (t - 1) = radix ^ t := by
    conv_rhs => rw [show t = (t - 1) + 1 by omega, pow_succ]
    ring
  have hjNumPos : 0 < j.Fnum := by
    dsimp [j, Zpower_nat]
    omega
  have hjBound : Fbounded (beta:=radix) b j := by
    constructor
    · dsimp [j, Zpower_nat]
      rw [abs_of_pos (by omega :
        0 < radix ^ (t - 1) + radix ^ (t - s - 1) + 1),
        hvNum, Zpower_nat]
      exact lt_of_lt_of_le hsumLtTwoPred (by simpa [hpowT] using htwoPredLe)
    · dsimp [j]
      exact le_trans hxBound.2 (by omega)
  have hpredCast :
      (Zpower_nat radix (t - 1) : ℝ) =
        (radix : ℝ) ^ (((t - 1 : Nat) : Int)) := by
    have h := Zpower_nat_Z_powerRZ radix (t - 1)
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hsmallCast :
      (Zpower_nat radix (t - s - 1) : ℝ) =
        (radix : ℝ) ^ (((t - s - 1 : Nat) : Int)) := by
    have h := Zpower_nat_Z_powerRZ radix (t - s - 1)
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hpredProd :
      (radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
          (radix : ℝ) ^ (x.Fexp + (s : Int)) =
        (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int) - 1) := by
    rw [← zpow_add₀ hradixNe]
    congr 1
    omega
  have hsmallProd :
      (radix : ℝ) ^ (((t - s - 1 : Nat) : Int)) *
          (radix : ℝ) ^ (x.Fexp + (s : Int)) =
        (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) := by
    rw [← zpow_add₀ hradixNe]
    congr 1
    omega
  have hjValue :
      _root_.F2R (beta:=radix) j =
        (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int) - 1) +
          (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) +
          (radix : ℝ) ^ (x.Fexp + (s : Int)) := by
    dsimp [j, _root_.F2R, FloatSpec.Core.Defs.F2R]
    rw [Int.cast_add, Int.cast_add, Int.cast_one, hpredCast, hsmallCast]
    rw [add_mul, add_mul, one_mul, hpredProd, hsmallProd]
  have hxNumMiddleReal :
      ((nNormMin radix t + 1 : Int) : ℝ) ≤ (x.Fnum : ℝ) := by
    exact_mod_cast hxNumMiddle
  have hfactorPos : 0 < (radix : ℝ) ^ (s : Int) + 1 := by
    linarith [zpow_pos hradixPos (s : Int)]
  have hscalePos :
      0 < (radix : ℝ) ^ x.Fexp * ((radix : ℝ) ^ (s : Int) + 1) :=
    mul_pos (zpow_pos hradixPos _) hfactorPos
  have hinputRaw :
      ((nNormMin radix t + 1 : Int) : ℝ) *
          ((radix : ℝ) ^ x.Fexp * ((radix : ℝ) ^ (s : Int) + 1)) ≤
        (x.Fnum : ℝ) *
          ((radix : ℝ) ^ x.Fexp * ((radix : ℝ) ^ (s : Int) + 1)) :=
    mul_le_mul_of_nonneg_right hxNumMiddleReal (le_of_lt hscalePos)
  have hnormMinCast :
      (nNormMin radix t : ℝ) =
        (radix : ℝ) ^ (((t - 1 : Nat) : Int)) := by
    unfold nNormMin
    rw [Int.cast_pow, ← zpow_natCast]
  have hnormPredProd :
      (radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
          (radix : ℝ) ^ x.Fexp =
        (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) := by
    rw [← zpow_add₀ hradixNe]
    congr 1
    omega
  have hnormPredScaleProd :
      (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) *
          (radix : ℝ) ^ (s : Int) =
        (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int) - 1) := by
    rw [← zpow_add₀ hradixNe]
    congr 1
    ring
  have hxScaleProd :
      (radix : ℝ) ^ x.Fexp * (radix : ℝ) ^ (s : Int) =
        (radix : ℝ) ^ (x.Fexp + (s : Int)) := by
    rw [zpow_add₀ hradixNe]
  have hlowerValue :
      ((nNormMin radix t + 1 : Int) : ℝ) *
          ((radix : ℝ) ^ x.Fexp * ((radix : ℝ) ^ (s : Int) + 1)) =
        (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int) - 1) +
          (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) +
          (radix : ℝ) ^ (x.Fexp + (s : Int)) +
          (radix : ℝ) ^ x.Fexp := by
    rw [Int.cast_add, Int.cast_one, hnormMinCast]
    calc
      ((radix : ℝ) ^ (((t - 1 : Nat) : Int)) + 1) *
          ((radix : ℝ) ^ x.Fexp * ((radix : ℝ) ^ (s : Int) + 1)) =
        ((radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
            (radix : ℝ) ^ x.Fexp) * ((radix : ℝ) ^ (s : Int) + 1) +
          (radix : ℝ) ^ x.Fexp * ((radix : ℝ) ^ (s : Int) + 1) := by
            ring
      _ = (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) *
            ((radix : ℝ) ^ (s : Int) + 1) +
          (radix : ℝ) ^ x.Fexp * ((radix : ℝ) ^ (s : Int) + 1) := by
            rw [hnormPredProd]
      _ = (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int) - 1) +
          (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) +
          (radix : ℝ) ^ (x.Fexp + (s : Int)) +
          (radix : ℝ) ^ x.Fexp := by
            rw [mul_add, mul_one, mul_add, mul_one,
              hnormPredScaleProd, hxScaleProd]
            ring
  have hinputLt :
      _root_.F2R (beta:=radix) j <
        _root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1) := by
    have hpowXPos := zpow_pos hradixPos x.Fexp
    rw [hjValue]
    have hstrict :
        (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int) - 1) +
              (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) +
              (radix : ℝ) ^ (x.Fexp + (s : Int)) <
          ((nNormMin radix t + 1 : Int) : ℝ) *
            ((radix : ℝ) ^ x.Fexp * ((radix : ℝ) ^ (s : Int) + 1)) := by
      rw [hlowerValue]
      linarith
    exact lt_of_lt_of_le hstrict (by
      simpa [_root_.F2R, FloatSpec.Core.Defs.F2R, mul_assoc] using hinputRaw)
  have hMono :
      MonotoneP_float (Closest (beta:=radix) b (radix : ℝ)) := by
    have h := ClosestMonotone (beta:=radix) b (radix : ℝ)
    simpa only [wp, PostCond.noThrow, pure, ClosestMonotone_check,
      Id.run, ULift.up_down] using h trivial
  have hjProject : Closest (beta:=radix) b (radix : ℝ)
      (_root_.F2R (beta:=radix) j) j := by
    constructor
    · exact hjBound
    · intro f _hfBounded
      rw [sub_self, abs_zero]
      exact abs_nonneg _
  exact hjValue ▸ hMono _ _ j p hinputLt hjProject hpDef

private theorem eqGe_middle {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNumMiddle : nNormMin radix t + 1 ≤ x.Fnum)
    (hxNumBelowLarge : x.Fnum < nNormMin radix t + radix) :
    (s : Int) + x.Fexp ≤ q.Fexp := by
  subst beta
  have htPos : 0 < t := by omega
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hradixOneLt : (1 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradix
  have hpLower := velt_p_lower_middle (beta:=radix) b radix s t x p rfl
    hradix hvNum hsGe hsLe hxBound hpDef hxNumMiddle
  let g : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨nNormMin radix t, (s : Int) + x.Fexp⟩
  have hgExpBound : -b.dExp ≤ (s : Int) + x.Fexp := by
    exact le_trans hxBound.2 (by omega)
  have hgNormal : Fnormal (beta:=radix) radix b g :=
    FnormalNnormMin (beta:=radix) radix b t ((s : Int) + x.Fexp)
      hradix htPos hvNum hgExpBound
  have hgBound : Fbounded (beta:=radix) b g := hgNormal.1
  have hnormMinCast :
      (nNormMin radix t : ℝ) =
        (radix : ℝ) ^ (((t - 1 : Nat) : Int)) := by
    unfold nNormMin
    rw [Int.cast_pow, ← zpow_natCast]
  have hgValue :
      _root_.F2R (beta:=radix) g =
        (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int) - 1) := by
    dsimp [g, _root_.F2R, FloatSpec.Core.Defs.F2R]
    rw [hnormMinCast, ← zpow_add₀ hradixNe]
    congr 1
    omega
  have hxNumUpper : x.Fnum ≤ nNormMin radix t + radix - 1 := by omega
  have hxNumUpperReal :
      (x.Fnum : ℝ) ≤ ((nNormMin radix t + radix - 1 : Int) : ℝ) := by
    exact_mod_cast hxNumUpper
  have hmulUpper := mul_le_mul_of_nonneg_right hxNumUpperReal
    (le_of_lt (zpow_pos hradixPos x.Fexp))
  have hnormProd :
      (radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
          (radix : ℝ) ^ x.Fexp =
        (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) := by
    rw [← zpow_add₀ hradixNe]
    congr 1
    omega
  have hradixProd :
      (radix : ℝ) * (radix : ℝ) ^ x.Fexp =
        (radix : ℝ) ^ (1 + x.Fexp) := by
    calc
      (radix : ℝ) * (radix : ℝ) ^ x.Fexp =
          (radix : ℝ) ^ (1 : Int) * (radix : ℝ) ^ x.Fexp := by
            rw [zpow_one]
      _ = (radix : ℝ) ^ (1 + x.Fexp) := (zpow_add₀ hradixNe _ _).symm
  have hxUpper :
      _root_.F2R (beta:=radix) x ≤
        (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) +
          (radix : ℝ) ^ (1 + x.Fexp) -
          (radix : ℝ) ^ x.Fexp := by
    calc
      _root_.F2R (beta:=radix) x =
          (x.Fnum : ℝ) * (radix : ℝ) ^ x.Fexp := by rfl
      _ ≤ ((nNormMin radix t + radix - 1 : Int) : ℝ) *
          (radix : ℝ) ^ x.Fexp := hmulUpper
      _ = (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) +
          (radix : ℝ) ^ (1 + x.Fexp) -
          (radix : ℝ) ^ x.Fexp := by
            rw [Int.cast_sub, Int.cast_add, Int.cast_one, hnormMinCast]
            rw [sub_mul, add_mul, one_mul, hnormProd, hradixProd]
  have hpowOneLtS :
      (radix : ℝ) ^ (1 + x.Fexp) <
        (radix : ℝ) ^ (x.Fexp + (s : Int)) :=
    zpow_lt_zpow_right₀ hradixOneLt (by omega)
  have hpowXPos : 0 < (radix : ℝ) ^ x.Fexp := zpow_pos hradixPos _
  have hxLtTail :
      _root_.F2R (beta:=radix) x <
        (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) +
          (radix : ℝ) ^ (x.Fexp + (s : Int)) := by
    linarith
  have hgLtOppInput :
      _root_.F2R (beta:=radix) g <
        -(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) := by
    rw [hgValue]
    linarith [hpLower, hxLtTail]
  have hMono :
      MonotoneP_float (Closest (beta:=radix) b (radix : ℝ)) := by
    have h := ClosestMonotone (beta:=radix) b (radix : ℝ)
    simpa only [wp, PostCond.noThrow, pure, ClosestMonotone_check,
      Id.run, ULift.up_down] using h trivial
  have hgProject : Closest (beta:=radix) b (radix : ℝ)
      (_root_.F2R (beta:=radix) g) g := by
    constructor
    · exact hgBound
    · intro f _hfBounded
      rw [sub_self, abs_zero]
      exact abs_nonneg _
  have hOppQ : Closest (beta:=radix) b (radix : ℝ)
      (-(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p))
      (Fopp (beta:=radix) q) := by
    have h := ClosestOpp (beta:=radix) b (radix : ℝ) q
      (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p)
    simpa only [wp, PostCond.noThrow, pure, ClosestOpp_check,
      Id.run, ULift.up_down] using h hqDef
  have hLower :
      _root_.F2R (beta:=radix) g ≤
        _root_.F2R (beta:=radix) (Fopp (beta:=radix) q) :=
    hMono _ _ g (Fopp (beta:=radix) q) hgLtOppInput hgProject hOppQ
  exact eqGe_of_min_le_opp (beta:=radix) b radix s t x q rfl hradix
    hvNum htPos hxBound hqNormal (by simpa only [g] using hLower)

private theorem eqGe_large {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hxNumLarge : nNormMin radix t + radix ≤ x.Fnum) :
    (s : Int) + x.Fexp ≤ q.Fexp := by
  subst beta
  have htPos : 0 < t := by omega
  have htNe : t ≠ 0 := Nat.ne_of_gt htPos
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixOneLe : (1 : ℝ) ≤ (radix : ℝ) := by
    exact_mod_cast (le_of_lt hradix)
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  let g : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨nNormMin radix t, (s : Int) + x.Fexp⟩
  have hnormMinCast :
      (nNormMin radix t : ℝ) =
        (radix : ℝ) ^ (((t - 1 : Nat) : Int)) := by
    unfold nNormMin
    rw [Int.cast_pow, ← zpow_natCast]
  have hgValue :
      _root_.F2R (beta:=radix) g =
        (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int) - 1) := by
    dsimp [g, _root_.F2R, FloatSpec.Core.Defs.F2R]
    rw [hnormMinCast, ← zpow_add₀ hradixNe]
    congr 1
    omega
  have hpUlp :
      2 * |(_root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1)) -
          _root_.F2R (beta:=radix) p| ≤
        Fulp (beta:=radix) b radix t p := by
    have h := ClosestUlp (beta:=radix) b radix t
      (_root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1)) p
    simpa only [wp, PostCond.noThrow, pure, ClosestUlp_check,
      Id.run, ULift.up_down] using h ⟨hpDef, rfl, hradix, htNe, hvNum⟩
  have hpErr :
      2 * |(_root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1)) -
          _root_.F2R (beta:=radix) p| ≤
        (radix : ℝ) ^ p.Fexp := by
    have h := ClosestExp (beta:=radix) b radix t
      (_root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1)) p
    simpa only [wp, PostCond.noThrow, pure, ClosestExp_check,
      Id.run, ULift.up_down] using h ⟨hpDef, hpUlp, rfl, hradix⟩
  have hqUlp :
      2 * |(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
          _root_.F2R (beta:=radix) q| ≤
        Fulp (beta:=radix) b radix t q := by
    have h := ClosestUlp (beta:=radix) b radix t
      (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) q
    simpa only [wp, PostCond.noThrow, pure, ClosestUlp_check,
      Id.run, ULift.up_down] using h ⟨hqDef, rfl, hradix, htNe, hvNum⟩
  have hqErr :
      2 * |(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
          _root_.F2R (beta:=radix) q| ≤
        (radix : ℝ) ^ q.Fexp := by
    have h := ClosestExp (beta:=radix) b radix t
      (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) q
    simpa only [wp, PostCond.noThrow, pure, ClosestExp_check,
      Id.run, ULift.up_down] using h ⟨hqDef, hqUlp, rfl, hradix⟩
  have hqExpLeP : q.Fexp ≤ p.Fexp :=
    eqLeep (beta:=radix) b radix s t x p q rfl hradix hvNum hxBound
      hpDef hqDef hxPos hpNormal hqNormal
  have hpExpLe : p.Fexp ≤ (s : Int) + 1 + x.Fexp :=
    epLe (beta:=radix) b radix s t x p rfl hradix hvNum hpDef hxPos
      hpNormal hxNormal hsGe
  have hpPowLeTop :
      (radix : ℝ) ^ p.Fexp ≤
        (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) :=
    zpow_le_zpow_right₀ hradixOneLe hpExpLe
  have hqPowLeTop :
      (radix : ℝ) ^ q.Fexp ≤
        (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) :=
    zpow_le_zpow_right₀ hradixOneLe (le_trans hqExpLeP hpExpLe)
  have hpAbsBound :
      |(_root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1)) -
          _root_.F2R (beta:=radix) p| ≤
        (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) / 2 := by
    nlinarith
  have hqAbsBound :
      |(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
          _root_.F2R (beta:=radix) q| ≤
        (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) / 2 := by
    nlinarith
  have hxNumLargeReal :
      ((nNormMin radix t + radix : Int) : ℝ) ≤ (x.Fnum : ℝ) := by
    exact_mod_cast hxNumLarge
  have hmulLarge := mul_le_mul_of_nonneg_right hxNumLargeReal
    (le_of_lt (zpow_pos hradixPos (x.Fexp + (s : Int))))
  have hnormProd :
      (radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
          (radix : ℝ) ^ (x.Fexp + (s : Int)) =
        (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int) - 1) := by
    rw [← zpow_add₀ hradixNe]
    congr 1
    omega
  have hradixProd :
      (radix : ℝ) * (radix : ℝ) ^ (x.Fexp + (s : Int)) =
        (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) := by
    calc
      (radix : ℝ) * (radix : ℝ) ^ (x.Fexp + (s : Int)) =
          (radix : ℝ) ^ (1 : Int) *
            (radix : ℝ) ^ (x.Fexp + (s : Int)) := by rw [zpow_one]
      _ = (radix : ℝ) ^ (1 + (x.Fexp + (s : Int))) :=
        (zpow_add₀ hradixNe _ _).symm
      _ = (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) := by
        congr 1
        ring
  have hxScaled :
      _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (s : Int) =
        (x.Fnum : ℝ) * (radix : ℝ) ^ (x.Fexp + (s : Int)) := by
    dsimp [_root_.F2R, FloatSpec.Core.Defs.F2R]
    rw [zpow_add₀ hradixNe]
    ring
  have hscaleLower :
      _root_.F2R (beta:=radix) g +
          (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) ≤
        _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (s : Int) := by
    rw [hgValue, hxScaled]
    calc
      (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int) - 1) +
          (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) =
        ((nNormMin radix t + radix : Int) : ℝ) *
          (radix : ℝ) ^ (x.Fexp + (s : Int)) := by
            rw [Int.cast_add, hnormMinCast, add_mul, hnormProd, hradixProd]
      _ ≤ (x.Fnum : ℝ) *
          (radix : ℝ) ^ (x.Fexp + (s : Int)) := hmulLarge
  have hpRoundLower :
      _root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1) -
          (radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) / 2 ≤
        _root_.F2R (beta:=radix) p := by
    have hneg := neg_abs_le
      (_root_.F2R (beta:=radix) p -
        _root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1))
    rw [abs_sub_comm] at hneg
    nlinarith
  have hqResidualLower :
      -((radix : ℝ) ^ ((s : Int) + 1 + x.Fexp) / 2) ≤
        (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
          _root_.F2R (beta:=radix) q := by
    exact le_trans (neg_le_neg hqAbsBound) (neg_abs_le _)
  have hFoppQ :
      _root_.F2R (beta:=radix) (Fopp (beta:=radix) q) =
        -_root_.F2R (beta:=radix) q := by
    have h := (FloatSpec.Calc.Operations.F2R_opp (beta:=radix) q) trivial
    simpa [Fopp, _root_.F2R] using h
  have hLower :
      _root_.F2R (beta:=radix) g ≤
        _root_.F2R (beta:=radix) (Fopp (beta:=radix) q) := by
    rw [hFoppQ]
    nlinarith [hpRoundLower, hqResidualLower, hscaleLower]
  exact eqGe_of_min_le_opp (beta:=radix) b radix s t x q rfl hradix
    hvNum htPos hxBound hqNormal (by simpa only [g] using hLower)

private theorem eqGe_exact_min {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNumExact : x.Fnum = nNormMin radix t) :
    (s : Int) + x.Fexp ≤ q.Fexp := by
  subst beta
  have htPos : 0 < t := by omega
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  let g : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨nNormMin radix t, (s : Int) + x.Fexp⟩
  have hgExpBound : -b.dExp ≤ (s : Int) + x.Fexp := by
    exact le_trans hxBound.2 (by omega)
  have hgNormal : Fnormal (beta:=radix) radix b g :=
    FnormalNnormMin (beta:=radix) radix b t ((s : Int) + x.Fexp)
      hradix htPos hvNum hgExpBound
  let jp : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨Zpower_nat radix s + 1, x.Fexp + (t : Int) - 1⟩
  have hpowSPos : 0 < radix ^ s := pow_pos hradixPosInt _
  have hpowPredPos : 0 < radix ^ (t - 1) := pow_pos hradixPosInt _
  have hsLtPred : s < t - 1 := by omega
  have hpowSLtPred : radix ^ s < radix ^ (t - 1) :=
    pow_lt_pow_right₀ hradix hsLtPred
  have honeLtPred : 1 < radix ^ (t - 1) := by
    have h := pow_lt_pow_right₀ hradix (by omega : 0 < t - 1)
    simpa using h
  have hsumLtTwoPred : radix ^ s + 1 < 2 * radix ^ (t - 1) := by
    omega
  have htwoLeRadix : (2 : Int) ≤ radix := by omega
  have htwoPredLe :
      2 * radix ^ (t - 1) ≤ radix * radix ^ (t - 1) :=
    mul_le_mul_of_nonneg_right htwoLeRadix (le_of_lt hpowPredPos)
  have hpowT : radix * radix ^ (t - 1) = radix ^ t := by
    conv_rhs => rw [show t = (t - 1) + 1 by omega, pow_succ]
    ring
  have hjpBound : Fbounded (beta:=radix) b jp := by
    constructor
    · dsimp [jp, Zpower_nat]
      rw [abs_of_pos (by omega : 0 < radix ^ s + 1), hvNum, Zpower_nat]
      exact lt_of_lt_of_le hsumLtTwoPred (by simpa [hpowT] using htwoPredLe)
    · dsimp [jp]
      exact le_trans hxBound.2 (by omega)
  have hpowSCast :
      (Zpower_nat radix s : ℝ) = (radix : ℝ) ^ (s : Int) := by
    have h := Zpower_nat_Z_powerRZ radix s
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hnormMinCast :
      (nNormMin radix t : ℝ) =
        (radix : ℝ) ^ (((t - 1 : Nat) : Int)) := by
    unfold nNormMin
    rw [Int.cast_pow, ← zpow_natCast]
  have hnormProd :
      (radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
          (radix : ℝ) ^ x.Fexp =
        (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) := by
    rw [← zpow_add₀ hradixNe]
    congr 1
    omega
  have hxValue :
      _root_.F2R (beta:=radix) x =
        (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) := by
    dsimp [_root_.F2R, FloatSpec.Core.Defs.F2R]
    rw [hxNumExact, hnormMinCast, hnormProd]
  have hjpValue :
      _root_.F2R (beta:=radix) jp =
        _root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1) := by
    change ((Zpower_nat radix s + 1 : Int) : ℝ) *
        (radix : ℝ) ^ (x.Fexp + (t : Int) - 1) =
      _root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1)
    rw [Int.cast_add, Int.cast_one, hpowSCast, hxValue]
    ring
  have hpValue :
      _root_.F2R (beta:=radix) p =
        _root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1) := by
    have hdist := hpDef.2 jp hjpBound
    rw [hjpValue, sub_self, abs_zero] at hdist
    have habsZero :
        |_root_.F2R (beta:=radix) p -
          _root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1)| = 0 :=
      le_antisymm hdist (abs_nonneg _)
    exact sub_eq_zero.mp (abs_eq_zero.mp habsZero)
  have hgValue :
      _root_.F2R (beta:=radix) g =
        (radix : ℝ) ^ (x.Fexp + (t : Int) + (s : Int) - 1) := by
    dsimp [g, _root_.F2R, FloatSpec.Core.Defs.F2R]
    rw [hnormMinCast, ← zpow_add₀ hradixNe]
    congr 1
    omega
  have hxScaleValue :
      _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (s : Int) =
        _root_.F2R (beta:=radix) g := by
    rw [hxValue, hgValue, ← zpow_add₀ hradixNe]
    congr 1
    ring
  have hResidual :
      _root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p =
        -_root_.F2R (beta:=radix) g := by
    rw [hpValue]
    nlinarith [hxScaleValue]
  let q0 : FloatSpec.Core.Defs.FlocqFloat radix := Fopp (beta:=radix) g
  have hq0Normal : Fnormal (beta:=radix) radix b q0 := by
    have h := FnormalFop (beta:=radix) b radix g
    simpa only [wp, PostCond.noThrow, pure, FnormalFop_check,
      Id.run, ULift.up_down, q0] using h hgNormal
  have hq0Value :
      _root_.F2R (beta:=radix) q0 = -_root_.F2R (beta:=radix) g := by
    have h := (FloatSpec.Calc.Operations.F2R_opp (beta:=radix) g) trivial
    simpa [q0, Fopp, _root_.F2R] using h
  have hqValue :
      _root_.F2R (beta:=radix) q = _root_.F2R (beta:=radix) q0 := by
    have hdist := hqDef.2 q0 hq0Normal.1
    rw [hResidual] at hdist
    have hdist' :
        |_root_.F2R (beta:=radix) q - _root_.F2R (beta:=radix) q0| ≤ 0 := by
      simpa [hq0Value] using hdist
    have habsZero :
        |_root_.F2R (beta:=radix) q - _root_.F2R (beta:=radix) q0| = 0 :=
      le_antisymm hdist' (abs_nonneg _)
    exact sub_eq_zero.mp (abs_eq_zero.mp habsZero)
  have hFoppQ :
      _root_.F2R (beta:=radix) (Fopp (beta:=radix) q) =
        -_root_.F2R (beta:=radix) q := by
    have h := (FloatSpec.Calc.Operations.F2R_opp (beta:=radix) q) trivial
    simpa [Fopp, _root_.F2R] using h
  have hLower :
      _root_.F2R (beta:=radix) g ≤
        _root_.F2R (beta:=radix) (Fopp (beta:=radix) q) := by
    rw [hFoppQ, hqValue, hq0Value]
    linarith
  exact eqGe_of_min_le_opp (beta:=radix) b radix s t x q rfl hradix
    hvNum htPos hxBound hqNormal (by simpa only [g] using hLower)

/-! Coq Veltkamp local lemma `eqGe`.

The second rounded residual cannot have exponent below `s + Fexp x`.  The
proof follows the upstream three-way mantissa split: a two-error estimate for
large mantissas, a monotone closest-rounding comparison in the middle range,
and exact representability at the minimal normal mantissa. -/
theorem eqGe {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x) :
    (s : Int) + x.Fexp ≤ q.Fexp := by
  subst beta
  by_cases hxLarge : nNormMin radix t + radix ≤ x.Fnum
  · exact eqGe_large (beta:=radix) b radix s t x p q rfl hradix hvNum
      hsGe hsLe hxBound hpDef hqDef hxPos hpNormal hqNormal hxNormal hxLarge
  by_cases hxMiddle : nNormMin radix t + 1 ≤ x.Fnum
  · exact eqGe_middle (beta:=radix) b radix s t x p q rfl hradix hvNum
      hsGe hsLe hxBound hpDef hqDef hqNormal hxMiddle (by omega)
  have htNe : t ≠ 0 := by omega
  have hxNumPos : 0 < x.Fnum :=
    FloatSpec.Core.Float_prop.gt_0_F2R (beta:=radix) x hradix hxPos
  have hxNumMin : nNormMin radix t ≤ x.Fnum := by
    have h := pNormal_absolu_min (beta:=radix) radix b t x
    have hAbs : nNormMin radix t ≤ |x.Fnum| := by
      simpa only [wp, PostCond.noThrow, pure, pNormal_absolu_min_check,
        Id.run, ULift.up_down] using
        h ⟨hxNormal, hxNormal, htNe, hradix, hvNum⟩
    simpa [abs_of_pos hxNumPos] using hAbs
  have hxNumExact : x.Fnum = nNormMin radix t := by omega
  exact eqGe_exact_min (beta:=radix) b radix s t x p q rfl hradix hvNum
    hsGe hsLe hxBound hpDef hqDef hqNormal hxNumExact

/-! Coq Veltkamp local lemma `eqEqual`.

Combines the exact public `eqLe` disjunction with the exact public `eqGe`
lower exponent bound, preserving the negative minimal-normal boundary and
half-ulp residual payload from the second `eqLe` branch. -/
theorem eqEqual {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x) :
    q.Fexp = (s : Int) + x.Fexp ∨
      (_root_.F2R (beta:=beta) q =
          -(radix : ℝ) ^ ((t : Int) + (s : Int) + x.Fexp) ∧
        |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) hx| ≤
          (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2) := by
  have hle := eqLe (beta:=beta) b radix s t x p q hx hbeta hradix hvNum
    hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hxNormal
  have hge := eqGe (beta:=beta) b radix s t x p q hx hbeta hradix hvNum
    hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hxNormal
  rcases hle with hle | hboundary
  · exact Or.inl (le_antisymm hle hge)
  · exact Or.inr hboundary

private theorem Veltkamp_aux_aux_low {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hxNumLow : (x.Fnum : ℝ) <
      (radix : ℝ) ^ (((t - 1 : Nat) : Int)) +
        (radix : ℝ) ^ (s : Int) / 2) :
    _root_.F2R (beta:=beta) hx =
      (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) := by
  subst beta
  have htPos : 0 < t := by omega
  have htNe : t ≠ 0 := Nat.ne_of_gt htPos
  have htGtOne : 1 < t := by omega
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hradixTwo : (2 : ℝ) ≤ (radix : ℝ) := by
    exact_mod_cast (by omega : (2 : Int) ≤ radix)
  have hradixOne : (1 : ℝ) ≤ (radix : ℝ) := le_trans (by norm_num) hradixTwo
  have hxNumPos : 0 < x.Fnum :=
    FloatSpec.Core.Float_prop.gt_0_F2R (beta:=radix) x hradix hxPos
  have hxNumMin : nNormMin radix t ≤ x.Fnum := by
    have h := pNormal_absolu_min (beta:=radix) radix b t x
    have hAbs : nNormMin radix t ≤ |x.Fnum| := by
      simpa only [wp, PostCond.noThrow, pure, pNormal_absolu_min_check,
        Id.run, ULift.up_down] using
        h ⟨hxNormal, hxNormal, htNe, hradix, hvNum⟩
    simpa [abs_of_pos hxNumPos] using hAbs
  let eps : Int := x.Fnum - Zpower_nat radix (t - 1)
  have hepsNonneg : 0 ≤ eps := by
    dsimp [eps, nNormMin, Zpower_nat] at hxNumMin ⊢
    exact sub_nonneg.mpr hxNumMin
  have hpredCast :
      (Zpower_nat radix (t - 1) : ℝ) =
        (radix : ℝ) ^ (((t - 1 : Nat) : Int)) := by
    have h := Zpower_nat_Z_powerRZ radix (t - 1)
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hpowSCast :
      (Zpower_nat radix s : ℝ) = (radix : ℝ) ^ (s : Int) := by
    have h := Zpower_nat_Z_powerRZ radix s
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hepsCast :
      (eps : ℝ) = (x.Fnum : ℝ) -
        (radix : ℝ) ^ (((t - 1 : Nat) : Int)) := by
    dsimp [eps]
    rw [Int.cast_sub, hpredCast]
  have hepsLtHalf : (eps : ℝ) < (radix : ℝ) ^ (s : Int) / 2 := by
    rw [hepsCast]
    linarith
  have hpowSPos : 0 < (radix : ℝ) ^ (s : Int) := zpow_pos hradixPos _
  have hepsLtPowReal : (eps : ℝ) < (radix : ℝ) ^ (s : Int) := by
    linarith
  have hepsLtPow : eps < Zpower_nat radix s := by
    exact_mod_cast (show (eps : ℝ) < (Zpower_nat radix s : ℝ) by
      simpa only [hpowSCast] using hepsLtPowReal)
  have hxNumDecomp : x.Fnum = Zpower_nat radix (t - 1) + eps := by
    dsimp [eps]
    omega
  let yp : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨Zpower_nat radix (t - 1) + Zpower_nat radix (t - s - 1) + eps,
      (s : Int) + x.Fexp⟩
  let yq : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨Zpower_nat radix (t - 1) + eps, (s : Int) + x.Fexp⟩
  have hpowPredPos : 0 < Zpower_nat radix (t - 1) := by
    exact pow_pos hradixPosInt _
  have hpowSmallPos : 0 < Zpower_nat radix (t - s - 1) := by
    exact pow_pos hradixPosInt _
  have hsmallExpLe : t - s - 1 ≤ t - 2 := by omega
  have hpowSmallLe :
      Zpower_nat radix (t - s - 1) ≤ Zpower_nat radix (t - 2) := by
    exact pow_le_pow_right₀ (by omega : (1 : Int) ≤ radix) hsmallExpLe
  have hpowSLe : Zpower_nat radix s ≤ Zpower_nat radix (t - 2) := by
    exact pow_le_pow_right₀ (by omega : (1 : Int) ≤ radix) (by omega)
  have htailLt :
      Zpower_nat radix (t - s - 1) + eps <
        2 * Zpower_nat radix (t - 2) := by
    omega
  have htwoSmallLePred :
      2 * Zpower_nat radix (t - 2) ≤ Zpower_nat radix (t - 1) := by
    have htwoLe : (2 : Int) ≤ radix := by omega
    have hpowNonneg : 0 ≤ Zpower_nat radix (t - 2) :=
      le_of_lt (pow_pos hradixPosInt _)
    have hmul := mul_le_mul_of_nonneg_right htwoLe hpowNonneg
    calc
      2 * Zpower_nat radix (t - 2) ≤
          radix * Zpower_nat radix (t - 2) := hmul
      _ = Zpower_nat radix (t - 1) := by
        dsimp [Zpower_nat]
        rw [show t - 1 = (t - 2) + 1 by omega, pow_succ]
        ring
  have htwoPredLePowT :
      2 * Zpower_nat radix (t - 1) ≤ Zpower_nat radix t := by
    have htwoLe : (2 : Int) ≤ radix := by omega
    have hpowNonneg : 0 ≤ Zpower_nat radix (t - 1) :=
      le_of_lt hpowPredPos
    have hmul := mul_le_mul_of_nonneg_right htwoLe hpowNonneg
    have hpowSucc :
        Zpower_nat radix t = Zpower_nat radix (t - 1) * radix := by
      dsimp [Zpower_nat]
      conv_lhs => rw [show t = (t - 1) + 1 by omega, pow_succ]
    calc
      2 * Zpower_nat radix (t - 1) ≤
          radix * Zpower_nat radix (t - 1) := hmul
      _ = Zpower_nat radix (t - 1) * radix := by ring
      _ = Zpower_nat radix t := hpowSucc.symm
  have hypNumPos :
      0 < Zpower_nat radix (t - 1) +
        Zpower_nat radix (t - s - 1) + eps := by omega
  have hypNumLt :
      Zpower_nat radix (t - 1) +
          Zpower_nat radix (t - s - 1) + eps < Zpower_nat radix t := by
    omega
  have hExpBound : -b.dExp ≤ (s : Int) + x.Fexp := by
    exact le_trans hxBound.2 (by omega)
  have hypBound : Fbounded (beta:=radix) b yp := by
    constructor
    · dsimp [yp]
      rw [abs_of_pos hypNumPos, hvNum]
      exact hypNumLt
    · simpa only [yp] using hExpBound
  have hyqNum : Zpower_nat radix (t - 1) + eps = x.Fnum := by
    omega
  have hyqBound : Fbounded (beta:=radix) b yq := by
    constructor
    · dsimp [yq]
      rw [hyqNum]
      exact hxBound.1
    · simpa only [yq] using hExpBound
  have hypNumGeX :
      x.Fnum ≤ Zpower_nat radix (t - 1) +
        Zpower_nat radix (t - s - 1) + eps := by
    rw [hxNumDecomp]
    omega
  have hxProdPos : 0 < radix * x.Fnum := mul_pos hradixPosInt hxNumPos
  have hypProdPos :
      0 < radix * (Zpower_nat radix (t - 1) +
        Zpower_nat radix (t - s - 1) + eps) :=
    mul_pos hradixPosInt hypNumPos
  have hypNormal : Fnormal (beta:=radix) radix b yp := by
    refine ⟨hypBound, ?_⟩
    dsimp [yp]
    rw [abs_of_pos hypProdPos]
    have hnormal := hxNormal.2
    rw [abs_of_pos hxProdPos] at hnormal
    exact le_trans hnormal
      (mul_le_mul_of_nonneg_left hypNumGeX (le_of_lt hradixPosInt))
  have hyqNormal : Fnormal (beta:=radix) radix b yq := by
    refine ⟨hyqBound, ?_⟩
    dsimp [yq]
    rw [hyqNum]
    exact hxNormal.2
  let A : ℝ := (radix : ℝ) ^ (((t - 1 : Nat) : Int))
  let B : ℝ := (radix : ℝ) ^ (s : Int)
  let E : ℝ := (radix : ℝ) ^ x.Fexp
  let D : ℝ := (eps : ℝ)
  have hApos : 0 < A := by dsimp [A]; exact zpow_pos hradixPos _
  have hBpos : 0 < B := by dsimp [B]; exact zpow_pos hradixPos _
  have hEpos : 0 < E := by dsimp [E]; exact zpow_pos hradixPos _
  have hDnonneg : 0 ≤ D := by
    dsimp [D]
    exact_mod_cast hepsNonneg
  have hDltHalf : D < B / 2 := by simpa only [D, B] using hepsLtHalf
  have hBgeFour : (4 : ℝ) ≤ B := by
    have hpowTwoLe : (radix : ℝ) ^ (2 : Int) ≤ B := by
      dsimp [B]
      exact zpow_le_zpow_right₀ hradixOne (by omega)
    have hfourLe : (4 : ℝ) ≤ (radix : ℝ) ^ (2 : Int) := by
      rw [zpow_ofNat]
      nlinarith
    exact le_trans hfourLe hpowTwoLe
  have hAgeTwoB : 2 * B ≤ A := by
    have hpowSuccLe : (radix : ℝ) ^ ((s : Int) + 1) ≤ A := by
      dsimp [A]
      exact zpow_le_zpow_right₀ hradixOne (by omega)
    have htwoBLe : 2 * B ≤ (radix : ℝ) * B := by
      nlinarith [hBpos]
    have hsucc : (radix : ℝ) ^ ((s : Int) + 1) = (radix : ℝ) * B := by
      dsimp [B]
      rw [zpow_add₀ hradixNe, zpow_one]
      ring
    rw [hsucc] at hpowSuccLe
    exact le_trans htwoBLe hpowSuccLe
  have hpCoeffUpper : (A + D) * (B + 1) ≤ 2 * A * B := by
    have hBminus : 0 ≤ B - 1 := by linarith
    have hBplus : 0 ≤ B + 1 := by linarith
    have hDterm : D * (B + 1) ≤ (B / 2) * (B + 1) :=
      mul_le_mul_of_nonneg_right (le_of_lt hDltHalf) hBplus
    have hpoly : (B / 2) * (B + 1) ≤ 2 * B * (B - 1) := by
      nlinarith
    have hAterm : 2 * B * (B - 1) ≤ A * (B - 1) :=
      mul_le_mul_of_nonneg_right hAgeTwoB hBminus
    nlinarith
  have htwoABLeRadix : 2 * A * B ≤ (radix : ℝ) * A * B := by
    nlinarith [mul_pos hApos hBpos]
  have hsmallCast :
      (Zpower_nat radix (t - s - 1) : ℝ) =
        (radix : ℝ) ^ (((t - s - 1 : Nat) : Int)) := by
    have h := Zpower_nat_Z_powerRZ radix (t - s - 1)
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hsmallMulB :
      (radix : ℝ) ^ (((t - s - 1 : Nat) : Int)) * B = A := by
    dsimp [A, B]
    rw [← zpow_add₀ hradixNe]
    congr 1
    omega
  have hxValue : _root_.F2R (beta:=radix) x = E * (A + D) := by
    dsimp [E, A, D, _root_.F2R, FloatSpec.Core.Defs.F2R]
    rw [hxNumDecomp, Int.cast_add, hpredCast]
    ring
  have hypValue :
      _root_.F2R (beta:=radix) yp = E * (A * B + A + D * B) := by
    dsimp [yp, E, A, B, D, _root_.F2R, FloatSpec.Core.Defs.F2R]
    rw [Int.cast_add, Int.cast_add, hpredCast, hsmallCast]
    rw [zpow_add₀ hradixNe]
    have hsmallMul :
        (radix : ℝ) ^ (((t - s - 1 : Nat) : Int)) *
            (radix : ℝ) ^ (s : Int) =
          (radix : ℝ) ^ (((t - 1 : Nat) : Int)) := by
      simpa only [A, B] using hsmallMulB
    rw [show
      ((radix : ℝ) ^ (((t - 1 : Nat) : Int)) +
          (radix : ℝ) ^ (((t - s - 1 : Nat) : Int)) + (eps : ℝ)) *
          ((radix : ℝ) ^ (s : Int) * (radix : ℝ) ^ x.Fexp) =
        (radix : ℝ) ^ x.Fexp *
          ((radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
              (radix : ℝ) ^ (s : Int) +
            (radix : ℝ) ^ (((t - s - 1 : Nat) : Int)) *
              (radix : ℝ) ^ (s : Int) +
            (eps : ℝ) * (radix : ℝ) ^ (s : Int)) by ring,
      hsmallMul]
  have hyqValue :
      _root_.F2R (beta:=radix) yq = E * (A * B + D * B) := by
    dsimp [yq, E, A, B, D, _root_.F2R, FloatSpec.Core.Defs.F2R]
    rw [Int.cast_add, hpredCast]
    rw [zpow_add₀ hradixNe]
    ring
  have hLowerPow :
      (radix : ℝ) ^ ((s : Int) + x.Fexp + (t : Int) - 1) =
        E * (A * B) := by
    calc
      (radix : ℝ) ^ ((s : Int) + x.Fexp + (t : Int) - 1) =
          (radix : ℝ) ^
            (x.Fexp + (((t - 1 : Nat) : Int)) + (s : Int)) := by
              congr 1
              omega
      _ = (radix : ℝ) ^ x.Fexp *
            (radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
              (radix : ℝ) ^ (s : Int) := by
                rw [zpow_add₀ hradixNe, zpow_add₀ hradixNe]
      _ = E * (A * B) := by
        dsimp [E, A, B]
        ring
  have hUpperPow :
      (radix : ℝ) ^ ((s : Int) + x.Fexp + (t : Int)) =
        E * ((radix : ℝ) * A * B) := by
    calc
      (radix : ℝ) ^ ((s : Int) + x.Fexp + (t : Int)) =
          (radix : ℝ) ^
            (x.Fexp + (((t - 1 : Nat) : Int)) + 1 + (s : Int)) := by
              congr 1
              omega
      _ = (radix : ℝ) ^ x.Fexp *
            (radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
              (radix : ℝ) ^ (1 : Int) * (radix : ℝ) ^ (s : Int) := by
                rw [zpow_add₀ hradixNe, zpow_add₀ hradixNe,
                  zpow_add₀ hradixNe]
      _ = E * ((radix : ℝ) * A * B) := by
        rw [zpow_one]
        ring
  have hpInputValue :
      _root_.F2R (beta:=radix) x * (B + 1) =
        E * ((A + D) * (B + 1)) := by
    rw [hxValue]
    ring
  have hpInputLower :
      (radix : ℝ) ^ ((s : Int) + x.Fexp + (t : Int) - 1) ≤
        _root_.F2R (beta:=radix) x * (B + 1) := by
    rw [hLowerPow, hpInputValue]
    apply mul_le_mul_of_nonneg_left _ (le_of_lt hEpos)
    have hDBnonneg : 0 ≤ D * B := mul_nonneg hDnonneg (le_of_lt hBpos)
    nlinarith only [hApos, hDnonneg, hDBnonneg]
  have hpInputUpper :
      _root_.F2R (beta:=radix) x * (B + 1) ≤
        (radix : ℝ) ^ ((s : Int) + x.Fexp + (t : Int)) := by
    rw [hUpperPow, hpInputValue]
    exact mul_le_mul_of_nonneg_left
      (le_trans hpCoeffUpper htwoABLeRadix) (le_of_lt hEpos)
  have hypLower :
      (radix : ℝ) ^ ((s : Int) + x.Fexp + (t : Int) - 1) ≤
        _root_.F2R (beta:=radix) yp := by
    rw [hLowerPow, hypValue]
    apply mul_le_mul_of_nonneg_left _ (le_of_lt hEpos)
    have hDBnonneg : 0 ≤ D * B := mul_nonneg hDnonneg (le_of_lt hBpos)
    linarith only [hApos, hDBnonneg]
  have hscalePow :
      (radix : ℝ) ^ ((s : Int) + x.Fexp) = E * B := by
    dsimp [E, B]
    rw [show (s : Int) + x.Fexp = x.Fexp + (s : Int) by ring,
      zpow_add₀ hradixNe]
  have hpDist :
      |_root_.F2R (beta:=radix) x * (B + 1) -
          _root_.F2R (beta:=radix) yp| <
        (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2 := by
    rw [hpInputValue, hypValue, hscalePow]
    have hdiff :
        E * ((A + D) * (B + 1)) - E * (A * B + A + D * B) = E * D := by
      ring
    rw [hdiff, abs_of_nonneg (mul_nonneg (le_of_lt hEpos) hDnonneg)]
    have hmul := mul_lt_mul_of_pos_left hDltHalf hEpos
    calc
      E * D < E * (B / 2) := hmul
      _ = E * B / 2 := by ring
  have hpUnique :
      ∀ g : FloatSpec.Core.Defs.FlocqFloat radix,
        Closest (beta:=radix) b (radix : ℝ)
          (_root_.F2R (beta:=radix) x * (B + 1)) g →
          _root_.F2R (beta:=radix) yp = _root_.F2R (beta:=radix) g := by
    have h := ImplyClosestStrict (beta:=radix) b radix t
      (_root_.F2R (beta:=radix) x * (B + 1)) yp
      ((s : Int) + x.Fexp)
    simpa only [wp, PostCond.noThrow, pure, ImplyClosestStrict_check,
      Id.run] using h ⟨hypBound, Or.inl hypNormal, hpInputLower, hpInputUpper,
        hypLower, hExpBound, rfl, hradix, htGtOne, hvNum, hpDist⟩
  have hpValue : _root_.F2R (beta:=radix) p = _root_.F2R (beta:=radix) yp := by
    exact (hpUnique p (by simpa only [B] using hpDef)).symm
  have hqInputValue :
      -(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) =
        E * (A * B + D * B - D) := by
    rw [hxValue, hpValue, hypValue]
    ring
  have hqInputLower :
      (radix : ℝ) ^ ((s : Int) + x.Fexp + (t : Int) - 1) ≤
        -(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) := by
    rw [hLowerPow, hqInputValue]
    have hBminus : 0 ≤ B - 1 := by linarith
    have htailNonneg : 0 ≤ D * (B - 1) := mul_nonneg hDnonneg hBminus
    apply mul_le_mul_of_nonneg_left _ (le_of_lt hEpos)
    calc
      A * B ≤ A * B + D * (B - 1) := le_add_of_nonneg_right htailNonneg
      _ = A * B + D * B - D := by ring
  have hqCoeffUpper : A * B + D * B - D ≤ 2 * A * B := by
    have hpExpanded : (A + D) * (B + 1) = A * B + A + D * B + D := by ring
    rw [hpExpanded] at hpCoeffUpper
    exact le_trans (by nlinarith only [hApos, hDnonneg]) hpCoeffUpper
  have hqInputUpper :
      -(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) ≤
        (radix : ℝ) ^ ((s : Int) + x.Fexp + (t : Int)) := by
    rw [hUpperPow, hqInputValue]
    exact mul_le_mul_of_nonneg_left
      (le_trans hqCoeffUpper htwoABLeRadix) (le_of_lt hEpos)
  have hyqLower :
      (radix : ℝ) ^ ((s : Int) + x.Fexp + (t : Int) - 1) ≤
        _root_.F2R (beta:=radix) yq := by
    rw [hLowerPow, hyqValue]
    apply mul_le_mul_of_nonneg_left _ (le_of_lt hEpos)
    exact le_add_of_nonneg_right (mul_nonneg hDnonneg (le_of_lt hBpos))
  have hqDist :
      |-(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
          _root_.F2R (beta:=radix) yq| <
        (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2 := by
    rw [hqInputValue, hyqValue, hscalePow]
    have hdiff :
        E * (A * B + D * B - D) - E * (A * B + D * B) = -(E * D) := by
      ring
    rw [hdiff, abs_neg, abs_of_nonneg (mul_nonneg (le_of_lt hEpos) hDnonneg)]
    have hmul := mul_lt_mul_of_pos_left hDltHalf hEpos
    calc
      E * D < E * (B / 2) := hmul
      _ = E * B / 2 := by ring
  have hqUnique :
      ∀ g : FloatSpec.Core.Defs.FlocqFloat radix,
        Closest (beta:=radix) b (radix : ℝ)
          (-(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p)) g →
          _root_.F2R (beta:=radix) yq = _root_.F2R (beta:=radix) g := by
    have h := ImplyClosestStrict (beta:=radix) b radix t
      (-(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p)) yq
      ((s : Int) + x.Fexp)
    simpa only [wp, PostCond.noThrow, pure, ImplyClosestStrict_check,
      Id.run] using h ⟨hyqBound, Or.inl hyqNormal, hqInputLower, hqInputUpper,
        hyqLower, hExpBound, rfl, hradix, htGtOne, hvNum, hqDist⟩
  have hOppQ :
      Closest (beta:=radix) b (radix : ℝ)
        (-(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p))
        (Fopp (beta:=radix) q) := by
    have h := ClosestOpp (beta:=radix) b (radix : ℝ) q
      (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p)
    simpa only [wp, PostCond.noThrow, pure, ClosestOpp_check,
      Id.run, ULift.up_down] using h hqDef
  have hyqOppValue :
      _root_.F2R (beta:=radix) yq =
        _root_.F2R (beta:=radix) (Fopp (beta:=radix) q) :=
    hqUnique (Fopp (beta:=radix) q) hOppQ
  have hFoppQ :
      _root_.F2R (beta:=radix) (Fopp (beta:=radix) q) =
        -_root_.F2R (beta:=radix) q := by
    have h := (FloatSpec.Calc.Operations.F2R_opp (beta:=radix) q) trivial
    simpa [Fopp, _root_.F2R] using h
  have hqValue : _root_.F2R (beta:=radix) q =
      -_root_.F2R (beta:=radix) yq := by
    linarith
  have hhxValue := hxExact (beta:=radix) b radix s t x p q hx rfl hradix
    htNe hvNum hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hsGe hsLe
  rw [hhxValue, hpValue, hqValue, hypValue, hyqValue]
  have hthreshold :
      (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) = E * A := by
    calc
      (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) =
          (radix : ℝ) ^
            (x.Fexp + (((t - 1 : Nat) : Int))) := by
              congr 1
              omega
      _ = E * A := by
        dsimp [E, A]
        rw [zpow_add₀ hradixNe]
  rw [hthreshold]
  ring

/-! Coq Veltkamp local lemma `Veltkamp_aux_aux`.

Any canonical representative of the reconstructed high part under the reduced
`t - s` bound that stays within the half-ulp residual window is at least the
lower endpoint of `x`'s binade.  The low-mantissa branch reconstructs the high
part exactly; the complementary branch follows directly from the residual
bound. -/
theorem Veltkamp_aux_aux {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (v : FloatSpec.Core.Defs.FlocqFloat beta)
    (hvValue : _root_.F2R (beta:=beta) v = _root_.F2R (beta:=beta) hx)
    (hvCanonic : Fcanonic (beta:=beta) radix
      (Veltkamp_reducedBound radix b s t) v)
    (hvResidual :
      |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) v| ≤
        (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2) :
    (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) ≤
      _root_.F2R (beta:=beta) v := by
  subst beta
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hEpos : 0 < (radix : ℝ) ^ x.Fexp := zpow_pos hradixPos _
  by_cases hlarge :
      (radix : ℝ) ^ (((t - 1 : Nat) : Int)) +
          (radix : ℝ) ^ (s : Int) / 2 ≤ (x.Fnum : ℝ)
  · have hlargeMul :=
      mul_le_mul_of_nonneg_right hlarge (le_of_lt hEpos)
    have hxValue :
        _root_.F2R (beta:=radix) x =
          (x.Fnum : ℝ) * (radix : ℝ) ^ x.Fexp := by rfl
    have hthreshold :
        (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) =
          (radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
            (radix : ℝ) ^ x.Fexp := by
      calc
        (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) =
            (radix : ℝ) ^
              ((((t - 1 : Nat) : Int)) + x.Fexp) := by
                congr 1
                omega
        _ = (radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
              (radix : ℝ) ^ x.Fexp := zpow_add₀ hradixNe _ _
    have hhalfScale :
        (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2 =
          ((radix : ℝ) ^ (s : Int) / 2) *
            (radix : ℝ) ^ x.Fexp := by
      rw [zpow_add₀ hradixNe]
      ring
    have hsumLeX :
        (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) +
            (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2 ≤
          _root_.F2R (beta:=radix) x := by
      rw [hthreshold, hhalfScale, hxValue]
      nlinarith only [hlargeMul]
    have hresidualOneSided :
        _root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) v ≤
          (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2 :=
      le_trans (le_abs_self _) hvResidual
    linarith only [hsumLeX, hresidualOneSided]
  · have hxNumLow : (x.Fnum : ℝ) <
        (radix : ℝ) ^ (((t - 1 : Nat) : Int)) +
          (radix : ℝ) ^ (s : Int) / 2 := lt_of_not_ge hlarge
    have hhxValue := Veltkamp_aux_aux_low (beta:=radix) b radix s t x p q hx
      rfl hradix hvNum hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal
      hqNormal hxNormal hxNumLow
    rw [hvValue, hhxValue]

private theorem Veltkamp_aux_residual {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x) :
    |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) hx| ≤
      (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2 := by
  subst beta
  have htNe : t ≠ 0 := by omega
  have heq := eqEqual (beta:=radix) b radix s t x p q hx rfl hradix
    hvNum hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hxNormal
  rcases heq with hqExp | hboundary
  · have hqUlp :
        2 * |(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
            _root_.F2R (beta:=radix) q| ≤
          Fulp (beta:=radix) b radix t q := by
      have h := ClosestUlp (beta:=radix) b radix t
        (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) q
      simpa only [wp, PostCond.noThrow, pure, ClosestUlp_check,
        Id.run, ULift.up_down] using
        h ⟨hqDef, rfl, hradix, htNe, hvNum⟩
    have hqError :
        2 * |(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
            _root_.F2R (beta:=radix) q| ≤
          (radix : ℝ) ^ q.Fexp := by
      have h := ClosestExp (beta:=radix) b radix t
        (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) q
      simpa only [wp, PostCond.noThrow, pure, ClosestExp_check,
        Id.run, ULift.up_down] using h ⟨hqDef, hqUlp, rfl, hradix⟩
    have hhxValue := hxExact (beta:=radix) b radix s t x p q hx rfl hradix
      htNe hvNum hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hsGe hsLe
    calc
      |_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) hx| =
          |(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) -
            _root_.F2R (beta:=radix) q| := by rw [hhxValue]; congr 1 <;> ring
      _ ≤ (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2 := by
        rw [← hqExp]
        nlinarith
  · exact hboundary.2

private theorem Veltkamp_aux_reduced_rep {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hResidual :
      |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) hx| ≤
        (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2) :
    ∃ v : FloatSpec.Core.Defs.FlocqFloat beta,
      _root_.F2R (beta:=beta) v = _root_.F2R (beta:=beta) hx ∧
        Fcanonic (beta:=beta) radix (Veltkamp_reducedBound radix b s t) v := by
  subst beta
  let u : Nat := t - s
  let e : Int := (s : Int) + x.Fexp
  let sum : FloatSpec.Core.Defs.FlocqFloat radix := Fplus (beta:=radix) p q
  let rb : Fbound_skel := Veltkamp_reducedBound radix b s t
  have htNe : t ≠ 0 := by omega
  have huPos : 0 < u := by dsimp [u]; omega
  have huNe : u ≠ 0 := Nat.ne_of_gt huPos
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hradixOne : (1 : ℝ) ≤ (radix : ℝ) := by
    exact_mod_cast (le_of_lt hradix)
  have hsumValue :
      _root_.F2R (beta:=radix) sum =
        _root_.F2R (beta:=radix) p + _root_.F2R (beta:=radix) q := by
    have h := Fplus_correct (beta:=radix) p q
    simpa only [wp, PostCond.noThrow, pure, Fplus_correct_check,
      Id.run, ULift.up_down, sum] using h hradix
  have hhxValue := hxExact (beta:=radix) b radix s t x p q hx rfl hradix
    htNe hvNum hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hsGe hsLe
  have hsumHx :
      _root_.F2R (beta:=radix) sum = _root_.F2R (beta:=radix) hx := by
    rw [hsumValue, hhxValue]
  have hsumExpMin : sum.Fexp = min p.Fexp q.Fexp := by
    cases p with
    | mk pm pe =>
      cases q with
      | mk qm qe =>
        by_cases hle : pe ≤ qe
        · simp [sum, Fplus, FloatSpec.Calc.Operations.Fplus,
            FloatSpec.Calc.Operations.Falign, hle, min_eq_left hle]
        · have hqe : qe ≤ pe := le_of_lt (lt_of_not_ge hle)
          simp [sum, Fplus, FloatSpec.Calc.Operations.Fplus,
            FloatSpec.Calc.Operations.Falign, hle, min_eq_right hqe]
  have hqLeP : q.Fexp ≤ p.Fexp :=
    eqLeep (beta:=radix) b radix s t x p q rfl hradix hvNum hxBound
      hpDef hqDef hxPos hpNormal hqNormal
  have hsumExp : sum.Fexp = q.Fexp := by
    rw [hsumExpMin, min_eq_right hqLeP]
  have heLeQ : e ≤ q.Fexp := by
    simpa only [e] using
      (eqGe (beta:=radix) b radix s t x p q hx rfl hradix hvNum hsGe hsLe
        hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hxNormal)
  have heLeSum : e ≤ sum.Fexp := by rw [hsumExp]; exact heLeQ
  have hxNumPos : 0 < x.Fnum :=
    FloatSpec.Core.Float_prop.gt_0_F2R (beta:=radix) x hradix hxPos
  have hxNumLt : x.Fnum < Zpower_nat radix t := by
    have h := hxBound.1
    rw [abs_of_pos hxNumPos, hvNum] at h
    exact h
  have hpowTCast :
      (Zpower_nat radix t : ℝ) = (radix : ℝ) ^ (t : Int) := by
    have h := Zpower_nat_Z_powerRZ radix t
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hxNumRealLt : (x.Fnum : ℝ) < (radix : ℝ) ^ (t : Int) := by
    rw [← hpowTCast]
    exact_mod_cast hxNumLt
  have hxPowPos : 0 < (radix : ℝ) ^ x.Fexp := zpow_pos hradixPos _
  have hxTop :
      _root_.F2R (beta:=radix) x <
        (radix : ℝ) ^ ((t : Int) + x.Fexp) := by
    calc
      _root_.F2R (beta:=radix) x =
          (x.Fnum : ℝ) * (radix : ℝ) ^ x.Fexp := rfl
      _ < (radix : ℝ) ^ (t : Int) * (radix : ℝ) ^ x.Fexp :=
        mul_lt_mul_of_pos_right hxNumRealLt hxPowPos
      _ = (radix : ℝ) ^ ((t : Int) + x.Fexp) := by
        rw [zpow_add₀ hradixNe]
  have hhxAbsUpper :
      |_root_.F2R (beta:=radix) hx| <
        (radix : ℝ) ^ ((t : Int) + x.Fexp) +
          (radix : ℝ) ^ e / 2 := by
    have htri :
        |_root_.F2R (beta:=radix) hx| ≤
          |_root_.F2R (beta:=radix) x| +
            |_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) hx| := by
      calc
        |_root_.F2R (beta:=radix) hx| =
            |_root_.F2R (beta:=radix) x -
              (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) hx)| := by
                congr 1 <;> ring
        _ ≤ |_root_.F2R (beta:=radix) x| +
              |_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) hx| :=
            abs_sub _ _
    rw [abs_of_pos hxPos] at htri
    simpa only [e] using
      (lt_of_le_of_lt htri (add_lt_add_of_lt_of_le hxTop hResidual))
  have huCast : (u : Int) = (t : Int) - (s : Int) := by
    dsimp [u]
    omega
  have htopFactor :
      (radix : ℝ) ^ ((t : Int) + x.Fexp) =
        (radix : ℝ) ^ e * (radix : ℝ) ^ (u : Int) := by
    rw [← zpow_add₀ hradixNe]
    congr 1
    dsimp [e]
    omega
  have hsumScale :
      (radix : ℝ) ^ e ≤ (radix : ℝ) ^ sum.Fexp :=
    zpow_le_zpow_right₀ hradixOne heLeSum
  have hcoeffPos :
      0 < (radix : ℝ) ^ (u : Int) + 1 / 2 := by
    positivity
  have hhxAbsScaled :
      |_root_.F2R (beta:=radix) hx| <
        (radix : ℝ) ^ sum.Fexp *
          ((radix : ℝ) ^ (u : Int) + 1 / 2) := by
    rw [htopFactor] at hhxAbsUpper
    have hfactor :
        (radix : ℝ) ^ e * ((radix : ℝ) ^ (u : Int) + 1 / 2) ≤
          (radix : ℝ) ^ sum.Fexp *
            ((radix : ℝ) ^ (u : Int) + 1 / 2) :=
      mul_le_mul_of_nonneg_right hsumScale (le_of_lt hcoeffPos)
    apply lt_of_lt_of_le _ hfactor
    nlinarith [hhxAbsUpper]
  have hsumPowPos : 0 < (radix : ℝ) ^ sum.Fexp := zpow_pos hradixPos _
  have hsumAbsValue :
      |_root_.F2R (beta:=radix) sum| =
        |(sum.Fnum : ℝ)| * (radix : ℝ) ^ sum.Fexp := by
    simp [_root_.F2R, FloatSpec.Core.Defs.F2R, abs_mul,
      abs_of_pos hsumPowPos]
  have hsumNumRealLt :
      |(sum.Fnum : ℝ)| < (radix : ℝ) ^ (u : Int) + 1 / 2 := by
    rw [← hsumHx, hsumAbsValue] at hhxAbsScaled
    nlinarith
  have hsumNumRealLtSucc :
      |(sum.Fnum : ℝ)| < (radix : ℝ) ^ (u : Int) + 1 := by
    linarith
  have hpowUCast :
      (Zpower_nat radix u : ℝ) = (radix : ℝ) ^ (u : Int) := by
    have h := Zpower_nat_Z_powerRZ radix u
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hsumNumLtSucc : |sum.Fnum| < Zpower_nat radix u + 1 := by
    exact_mod_cast (show (|sum.Fnum| : ℝ) < (Zpower_nat radix u : ℝ) + 1 by
      simpa only [Int.cast_abs, hpowUCast, Int.cast_add, Int.cast_one] using
        hsumNumRealLtSucc)
  have hsumNumBound : |sum.Fnum| ≤ Zpower_nat radix u := by omega
  have hsumExpBound : -rb.dExp ≤ sum.Fexp := by
    dsimp [rb, Veltkamp_reducedBound]
    exact le_trans hxBound.2 (le_trans (by dsimp [e]; omega) heLeSum)
  have hrvNum : rb.vNum = Zpower_nat radix u := by
    dsimp [rb, u]
    exact p'GivesBound radix b s t
  have hmb := FboundedMbound (beta:=radix) rb radix u sum.Fexp sum.Fnum
  rcases (by
    simpa only [wp, PostCond.noThrow, pure, FboundedMbound_check,
      Id.run, ULift.up_down] using
      hmb ⟨rfl, hradix, huPos, hrvNum, hsumNumBound, hsumExpBound⟩) with
    ⟨c, hcBound, hcValue⟩
  have hcHx : _root_.F2R (beta:=radix) c = _root_.F2R (beta:=radix) hx := by
    rw [hcValue, ← hsumHx]
    rfl
  let v : FloatSpec.Core.Defs.FlocqFloat radix :=
    Fnormalize (beta:=radix) radix rb u c
  have hvValue :
      _root_.F2R (beta:=radix) v = _root_.F2R (beta:=radix) hx := by
    have h := FnormalizeCorrect (beta:=radix) radix rb u c
    have hvc : _root_.F2R (beta:=radix) v = _root_.F2R (beta:=radix) c := by
      simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
        Id.run, ULift.up_down, v] using h ⟨rfl, hradix⟩
    exact hvc.trans hcHx
  have hvCan : Fcanonic (beta:=radix) radix rb v := by
    have h := FnormalizeCanonic (beta:=radix) radix rb u c
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCanonic_check,
      Id.run, ULift.up_down, Fbounded', v] using
      h ⟨hcBound, hcBound, huNe, hradix, hrvNum⟩
  exact ⟨v, hvValue, hvCan⟩

private theorem VeltkampEven1_candidate {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hEvenRadix : Even radix)
    (hResidual :
      |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) hx| ≤
        (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2) :
    ∃ v : FloatSpec.Core.Defs.FlocqFloat beta,
      _root_.F2R (beta:=beta) v = _root_.F2R (beta:=beta) hx ∧
        Fcanonic (beta:=beta) radix
          (Veltkamp_reducedBound radix b s t) v ∧
        (FNeven (beta:=beta) (Veltkamp_reducedBound radix b s t)
            (radix : ℝ) (t - s) v ∨
          v.Fexp ≤ (s : Int) + x.Fexp) := by
  subst beta
  let u : Nat := t - s
  let e : Int := (s : Int) + x.Fexp
  let rb : Fbound_skel := Veltkamp_reducedBound radix b s t
  let sum : FloatSpec.Core.Defs.FlocqFloat radix := Fplus (beta:=radix) p q
  have htNe : t ≠ 0 := by omega
  have huGtOne : 1 < u := by dsimp [u]; omega
  have huPos : 0 < u := lt_trans Nat.zero_lt_one huGtOne
  have huNe : u ≠ 0 := Nat.ne_of_gt huPos
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hsumValue :
      _root_.F2R (beta:=radix) sum =
        _root_.F2R (beta:=radix) p + _root_.F2R (beta:=radix) q := by
    have h := Fplus_correct (beta:=radix) p q
    simpa only [wp, PostCond.noThrow, pure, Fplus_correct_check,
      Id.run, ULift.up_down, sum] using h hradix
  have hhxValue := hxExact (beta:=radix) b radix s t x p q hx rfl hradix
    htNe hvNum hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hsGe hsLe
  have hsumHx :
      _root_.F2R (beta:=radix) sum = _root_.F2R (beta:=radix) hx := by
    rw [hsumValue, hhxValue]
  have hsumExpMin : sum.Fexp = min p.Fexp q.Fexp := by
    cases p with
    | mk pm pe =>
      cases q with
      | mk qm qe =>
        by_cases hle : pe ≤ qe
        · simp [sum, Fplus, FloatSpec.Calc.Operations.Fplus,
            FloatSpec.Calc.Operations.Falign, hle, min_eq_left hle]
        · have hqe : qe ≤ pe := le_of_lt (lt_of_not_ge hle)
          simp [sum, Fplus, FloatSpec.Calc.Operations.Fplus,
            FloatSpec.Calc.Operations.Falign, hle, min_eq_right hqe]
  have hqLeP : q.Fexp ≤ p.Fexp :=
    eqLeep (beta:=radix) b radix s t x p q rfl hradix hvNum hxBound
      hpDef hqDef hxPos hpNormal hqNormal
  have hsumExp : sum.Fexp = q.Fexp := by
    rw [hsumExpMin, min_eq_right hqLeP]
  have heLeSum : e ≤ sum.Fexp := by
    rw [hsumExp]
    simpa only [e] using
      (eqGe (beta:=radix) b radix s t x p q hx rfl hradix hvNum hsGe hsLe
        hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hxNormal)
  let k : Nat := Int.toNat (sum.Fexp - e)
  let m : Int := sum.Fnum * Zpower_nat radix k
  have hdiffNonneg : 0 ≤ sum.Fexp - e := sub_nonneg.mpr heLeSum
  have hkCast : (k : Int) = sum.Fexp - e := by
    simpa [k] using Int.toNat_of_nonneg hdiffNonneg
  have hpowKCast :
      (Zpower_nat radix k : ℝ) =
        (radix : ℝ) ^ (sum.Fexp - e) := by
    have h := Zpower_nat_Z_powerRZ radix k
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down, hkCast] using h trivial
  have hsumPowSplit :
      (radix : ℝ) ^ sum.Fexp =
        (radix : ℝ) ^ (sum.Fexp - e) * (radix : ℝ) ^ e := by
    calc
      (radix : ℝ) ^ sum.Fexp =
          (radix : ℝ) ^ ((sum.Fexp - e) + e) := by congr 1 <;> ring
      _ = (radix : ℝ) ^ (sum.Fexp - e) * (radix : ℝ) ^ e :=
        zpow_add₀ hradixNe _ _
  have hmRepr :
      _root_.F2R (beta:=radix) hx =
        (m : ℝ) * (radix : ℝ) ^ e := by
    rw [← hsumHx]
    dsimp [_root_.F2R, FloatSpec.Core.Defs.F2R, m]
    rw [Int.cast_mul, hpowKCast, hsumPowSplit]
    ring
  have hxNumPos : 0 < x.Fnum :=
    FloatSpec.Core.Float_prop.gt_0_F2R (beta:=radix) x hradix hxPos
  have hxNumLt : x.Fnum < Zpower_nat radix t := by
    have h := hxBound.1
    rw [abs_of_pos hxNumPos, hvNum] at h
    exact h
  have hpowTCast :
      (Zpower_nat radix t : ℝ) = (radix : ℝ) ^ (t : Int) := by
    have h := Zpower_nat_Z_powerRZ radix t
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hxNumRealLt : (x.Fnum : ℝ) < (radix : ℝ) ^ (t : Int) := by
    rw [← hpowTCast]
    exact_mod_cast hxNumLt
  have hxPowPos : 0 < (radix : ℝ) ^ x.Fexp := zpow_pos hradixPos _
  have hxTop :
      _root_.F2R (beta:=radix) x <
        (radix : ℝ) ^ ((t : Int) + x.Fexp) := by
    calc
      _root_.F2R (beta:=radix) x =
          (x.Fnum : ℝ) * (radix : ℝ) ^ x.Fexp := rfl
      _ < (radix : ℝ) ^ (t : Int) * (radix : ℝ) ^ x.Fexp :=
        mul_lt_mul_of_pos_right hxNumRealLt hxPowPos
      _ = (radix : ℝ) ^ ((t : Int) + x.Fexp) := by
        rw [zpow_add₀ hradixNe]
  have hhxAbsUpper :
      |_root_.F2R (beta:=radix) hx| <
        (radix : ℝ) ^ ((t : Int) + x.Fexp) +
          (radix : ℝ) ^ e / 2 := by
    have htri :
        |_root_.F2R (beta:=radix) hx| ≤
          |_root_.F2R (beta:=radix) x| +
            |_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) hx| := by
      calc
        |_root_.F2R (beta:=radix) hx| =
            |_root_.F2R (beta:=radix) x -
              (_root_.F2R (beta:=radix) x -
                _root_.F2R (beta:=radix) hx)| := by congr 1 <;> ring
        _ ≤ |_root_.F2R (beta:=radix) x| +
              |_root_.F2R (beta:=radix) x -
                _root_.F2R (beta:=radix) hx| := abs_sub _ _
    rw [abs_of_pos hxPos] at htri
    simpa only [e] using
      (lt_of_le_of_lt htri (add_lt_add_of_lt_of_le hxTop hResidual))
  have htopFactor :
      (radix : ℝ) ^ ((t : Int) + x.Fexp) =
        (radix : ℝ) ^ e * (radix : ℝ) ^ (u : Int) := by
    rw [← zpow_add₀ hradixNe]
    congr 1
    dsimp [e, u]
    omega
  have hePowPos : 0 < (radix : ℝ) ^ e := zpow_pos hradixPos _
  have hmAbsRealLt :
      (|m| : ℝ) < (radix : ℝ) ^ (u : Int) + 1 / 2 := by
    rw [hmRepr, abs_mul, abs_of_pos hePowPos, htopFactor] at hhxAbsUpper
    have hmul :
        (radix : ℝ) ^ e * |(m : ℝ)| <
          (radix : ℝ) ^ e * ((radix : ℝ) ^ (u : Int) + 1 / 2) := by
      nlinarith [hhxAbsUpper]
    simpa only [Int.cast_abs] using
      (lt_of_mul_lt_mul_left hmul hePowPos.le)
  have hpowUCast :
      (Zpower_nat radix u : ℝ) = (radix : ℝ) ^ (u : Int) := by
    have h := Zpower_nat_Z_powerRZ radix u
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hmLtSucc : |m| < Zpower_nat radix u + 1 := by
    exact_mod_cast (show (|m| : ℝ) < (Zpower_nat radix u : ℝ) + 1 by
      rw [hpowUCast]
      linarith)
  have hmBound : |m| ≤ Zpower_nat radix u := by omega
  have heBound : -rb.dExp ≤ e := by
    dsimp [rb, Veltkamp_reducedBound, e]
    exact le_trans hxBound.2 (by omega)
  have hrvNum : rb.vNum = Zpower_nat radix u := by
    dsimp [rb, u]
    exact p'GivesBound radix b s t
  by_cases hmStrict : |m| < Zpower_nat radix u
  · let c : FloatSpec.Core.Defs.FlocqFloat radix := ⟨m, e⟩
    have hcBound : Fbounded (beta:=radix) rb c := by
      exact ⟨by simpa only [c, hrvNum] using hmStrict,
        by simpa only [c] using heBound⟩
    let v : FloatSpec.Core.Defs.FlocqFloat radix :=
      Fnormalize (beta:=radix) radix rb u c
    have hvValue :
        _root_.F2R (beta:=radix) v = _root_.F2R (beta:=radix) hx := by
      have h := FnormalizeCorrect (beta:=radix) radix rb u c
      have hvc :
          _root_.F2R (beta:=radix) v = _root_.F2R (beta:=radix) c := by
        simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
          Id.run, ULift.up_down, v] using h ⟨rfl, hradix⟩
      calc
        _root_.F2R (beta:=radix) v =
            _root_.F2R (beta:=radix) c := hvc
        _ = (m : ℝ) * (radix : ℝ) ^ e := rfl
        _ = _root_.F2R (beta:=radix) hx := hmRepr.symm
    have hvCan : Fcanonic (beta:=radix) radix rb v := by
      have h := FnormalizeCanonic (beta:=radix) radix rb u c
      simpa only [wp, PostCond.noThrow, pure, FnormalizeCanonic_check,
        Id.run, ULift.up_down, Fbounded', v] using
        h ⟨hcBound, hcBound, huNe, hradix, hrvNum⟩
    have hvExp : v.Fexp ≤ e := by
      dsimp [v, Fnormalize]
      by_cases hmZero : m = 0
      · simp [c, hmZero, heBound]
      · simp [c, hmZero, Fshift]
    exact ⟨v, hvValue, hvCan, Or.inr (by simpa only [e] using hvExp)⟩
  · have hmEq : |m| = Zpower_nat radix u := by omega
    let base : FloatSpec.Core.Defs.FlocqFloat radix :=
      ⟨nNormMin radix u, e + 1⟩
    have hbaseCan : Fcanonic (beta:=radix) radix rb base := by
      exact FcanonicNnormMin (beta:=radix) radix rb u (e + 1) hradix huPos
        hrvNum (by omega)
    have hbaseValue :
        _root_.F2R (beta:=radix) base =
          (Zpower_nat radix u : ℝ) * (radix : ℝ) ^ e := by
      have hpredPow :
          ((radix ^ (u - 1) : Int) : ℝ) =
            (radix : ℝ) ^ (((u - 1 : Nat) : Int)) := by
        rw [Int.cast_pow]
        exact (zpow_ofNat (radix : ℝ) (u - 1)).symm
      have huPow :
          ((radix ^ u : Int) : ℝ) = (radix : ℝ) ^ (u : Int) := by
        rw [Int.cast_pow]
        exact (zpow_ofNat (radix : ℝ) u).symm
      dsimp [base, _root_.F2R, FloatSpec.Core.Defs.F2R, nNormMin,
        Zpower_nat]
      rw [hpredPow, huPow]
      have huPredCast : ((u - 1 : Nat) : Int) = (u : Int) - 1 := by omega
      rw [huPredCast]
      rw [← zpow_add₀ hradixNe, ← zpow_add₀ hradixNe]
      congr 1
      omega
    have hbaseEven :
        FNeven (beta:=radix) rb (radix : ℝ) u base := by
      have hnorm : Fnormalize (beta:=radix) radix rb u base = base := by
        have h := FcanonicFnormalizeEq (beta:=radix) radix rb u base
        simpa only [wp, PostCond.noThrow, pure, FcanonicFnormalizeEq_check,
          Id.run, ULift.up_down] using
          h ⟨hbaseCan, rfl, hradix, huNe, hrvNum⟩
      unfold FNeven Feven
      rw [hnorm]
      dsimp [base, nNormMin]
      exact hEvenRadix.pow_of_ne_zero (by omega)
    by_cases hmNonneg : 0 ≤ m
    · have hmPosEq : m = Zpower_nat radix u := by
        simpa [abs_of_nonneg hmNonneg] using hmEq
      have hvalue :
          _root_.F2R (beta:=radix) base =
            _root_.F2R (beta:=radix) hx := by
        rw [hbaseValue, hmRepr, hmPosEq]
      exact ⟨base, hvalue, hbaseCan, Or.inl hbaseEven⟩
    · have hmNeg : m < 0 := lt_of_not_ge hmNonneg
      have hmNegEq : m = -Zpower_nat radix u := by
        have h := hmEq
        rw [abs_of_neg hmNeg] at h
        omega
      let v : FloatSpec.Core.Defs.FlocqFloat radix := Fopp (beta:=radix) base
      have hvCan : Fcanonic (beta:=radix) radix rb v := by
        have h := FcanonicFopp (beta:=radix) radix rb base
        simpa only [wp, PostCond.noThrow, pure, FcanonicFopp_check,
          Id.run, ULift.up_down, v] using h hbaseCan
      have hvValue :
          _root_.F2R (beta:=radix) v = _root_.F2R (beta:=radix) hx := by
        have hopp :
            _root_.F2R (beta:=radix) v =
              -_root_.F2R (beta:=radix) base := by
          have h := (FloatSpec.Calc.Operations.F2R_opp (beta:=radix) base) trivial
          simpa [v, Fopp, _root_.F2R] using h
        rw [hopp, hbaseValue, hmRepr, hmNegEq]
        norm_num [Int.cast_neg]
      have hvEven : FNeven (beta:=radix) rb (radix : ℝ) u v := by
        have h := FNevenFop (beta:=radix) rb (radix : ℝ) u base
        simpa only [wp, PostCond.noThrow, pure, FNevenFop_check,
          Id.run, ULift.up_down, v] using h hbaseEven
      exact ⟨v, hvValue, hvCan, Or.inl hvEven⟩

private theorem VeltkampEven1_tie_even {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx v : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hpDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hEvenRadix : Even radix)
    (hvValue : _root_.F2R (beta:=beta) v = _root_.F2R (beta:=beta) hx)
    (hvCan : Fcanonic (beta:=beta) radix
      (Veltkamp_reducedBound radix b s t) v)
    (hvExp : v.Fexp = (s : Int) + x.Fexp)
    (hTie :
      |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) v| =
        (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2) :
    FNeven (beta:=beta) (Veltkamp_reducedBound radix b s t)
      (radix : ℝ) (t - s) v := by
  subst beta
  let e : Int := (s : Int) + x.Fexp
  let rb : Fbound_skel := Veltkamp_reducedBound radix b s t
  let u : Nat := t - s
  have htGtOne : 1 < t := by omega
  have htNe : t ≠ 0 := by omega
  have huGtOne : 1 < u := by dsimp [u]; omega
  have huNe : u ≠ 0 := by omega
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hePowPos : 0 < (radix : ℝ) ^ e := zpow_pos hradixPos _
  have hvExpE : v.Fexp = e := by simpa only [e] using hvExp
  have hvExpanded :
      _root_.F2R (beta:=radix) v =
        (v.Fnum : ℝ) * (radix : ℝ) ^ e := by
    simp only [_root_.F2R, FloatSpec.Core.Defs.F2R, hvExpE]
  have hmid :
      ∃ eps : ℝ, (eps = 1 ∨ eps = -1) ∧
        _root_.F2R (beta:=radix) x =
          _root_.F2R (beta:=radix) v + eps * (radix : ℝ) ^ e / 2 := by
    by_cases hdiff : 0 ≤
        _root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) v
    · refine ⟨1, Or.inl rfl, ?_⟩
      rw [abs_of_nonneg hdiff] at hTie
      simpa only [e, one_mul] using (by linarith [hTie])
    · have hdiffNeg :
          _root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) v < 0 :=
        lt_of_not_ge hdiff
      refine ⟨-1, Or.inr rfl, ?_⟩
      rw [abs_of_neg hdiffNeg] at hTie
      simpa only [e, neg_mul, one_mul] using (by linarith [hTie])
  rcases hmid with ⟨eps, heps, hxMid⟩
  have heLeQ : e ≤ q.Fexp := by
    simpa only [e] using
      (eqGe (beta:=radix) b radix s t x p q hx rfl hradix hvNum hsGe hsLe
        hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hxNormal)
  have hqLeP : q.Fexp ≤ p.Fexp :=
    eqLeep (beta:=radix) b radix s t x p q rfl hradix hvNum hxBound
      hpDef hqDef hxPos hpNormal hqNormal
  have hpLe : p.Fexp ≤ e + 1 := by
    have h := epLe (beta:=radix) b radix s t x p rfl hradix hvNum hpDef
      hxPos hpNormal hxNormal hsGe
    dsimp [e]
    omega
  have hpCases : p.Fexp = e ∨ p.Fexp = e + 1 := by omega
  have hqCases : q.Fexp = e ∨ q.Fexp = e + 1 := by omega
  let mp : Int := if p.Fexp = e then p.Fnum else p.Fnum * radix
  let mq : Int := if q.Fexp = e then q.Fnum else q.Fnum * radix
  have hsuccPow :
      (radix : ℝ) ^ (e + 1) =
        (radix : ℝ) * (radix : ℝ) ^ e := by
    rw [zpow_add₀ hradixNe, zpow_one]
    ring
  have hpCoeffValue :
      _root_.F2R (beta:=radix) p =
        (mp : ℝ) * (radix : ℝ) ^ e := by
    rcases hpCases with hpEq | hpEq
    · simp [mp, hpEq, _root_.F2R, FloatSpec.Core.Defs.F2R]
    · have hpNe : p.Fexp ≠ e := by omega
      rw [show mp = p.Fnum * radix by simp [mp, hpNe]]
      simp only [_root_.F2R, FloatSpec.Core.Defs.F2R, Int.cast_mul, hpEq,
        hsuccPow]
      ring
  have hqCoeffValue :
      _root_.F2R (beta:=radix) q =
        (mq : ℝ) * (radix : ℝ) ^ e := by
    rcases hqCases with hqEq | hqEq
    · simp [mq, hqEq, _root_.F2R, FloatSpec.Core.Defs.F2R]
    · have hqNe : q.Fexp ≠ e := by omega
      rw [show mq = q.Fnum * radix by simp [mq, hqNe]]
      simp only [_root_.F2R, FloatSpec.Core.Defs.F2R, Int.cast_mul, hqEq,
        hsuccPow]
      ring
  have hhxValue := hxExact (beta:=radix) b radix s t x p q hx rfl hradix
    htNe hvNum hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hsGe hsLe
  have hvSum :
      _root_.F2R (beta:=radix) v =
        _root_.F2R (beta:=radix) p + _root_.F2R (beta:=radix) q := by
    rw [hvValue, hhxValue]
  have hvNumEq : v.Fnum = mp + mq := by
    rw [hvExpanded, hpCoeffValue, hqCoeffValue] at hvSum
    have hcast : (v.Fnum : ℝ) = (mp + mq : Int) := by
      norm_num
      nlinarith [hvSum, hePowPos]
    exact_mod_cast hcast
  have hpowSCast :
      (Zpower_nat radix s : ℝ) = (radix : ℝ) ^ (s : Int) := by
    have h := Zpower_nat_Z_powerRZ radix s
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hhalfPow :
      ∃ half : Int, (half : ℝ) = (radix : ℝ) ^ (s : Int) / 2 := by
    rcases hEvenRadix with ⟨r, hr⟩
    let half : Int := r * Zpower_nat radix (s - 1)
    refine ⟨half, ?_⟩
    have hsSucc : Nat.succ (s - 1) = s := by omega
    have hpowPredCast :
        (Zpower_nat radix (s - 1) : ℝ) =
          (radix : ℝ) ^ (((s - 1 : Nat) : Int)) := by
      have h := Zpower_nat_Z_powerRZ radix (s - 1)
      simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
        Id.run, ULift.up_down] using h trivial
    have hsPredCast : ((s - 1 : Nat) : Int) = (s : Int) - 1 := by omega
    dsimp [half]
    rw [Int.cast_mul, hpowPredCast, hsPredCast]
    have hradixCast : (radix : ℝ) = (r : ℝ) + (r : ℝ) := by
      exact_mod_cast hr
    rw [show (radix : ℝ) ^ (s : Int) =
        (radix : ℝ) ^ ((s : Int) - 1) * (radix : ℝ) by
      calc
        (radix : ℝ) ^ (s : Int) =
            (radix : ℝ) ^ (((s : Int) - 1) + 1) := by congr 1 <;> omega
        _ = (radix : ℝ) ^ ((s : Int) - 1) * (radix : ℝ) ^ (1 : Int) :=
          zpow_add₀ hradixNe _ _
        _ = _ := by rw [zpow_one]]
    rw [hradixCast]
    ring
  have hpNonneg : 0 ≤ _root_.F2R (beta:=radix) p :=
    pPos (beta:=radix) b radix s t x p hradix hvNum hxPos hpDef
  have hmpEven : Even mp := by
    by_cases hpExpEq : p.Fexp = e
    · let pmid : ℝ :=
        (v.Fnum : ℝ) * (radix : ℝ) ^ (s : Int) + (v.Fnum : ℝ) +
          eps * (radix : ℝ) ^ (s : Int) / 2 + (eps - 1) / 2
      have hpInputMid :
          _root_.F2R (beta:=radix) x *
              ((radix : ℝ) ^ (s : Int) + 1) =
            (radix : ℝ) ^ p.Fexp * (pmid + 1 / 2) := by
        rw [hpExpEq, hxMid, hvExpanded]
        dsimp [pmid]
        ring
      have hpmidInt : ∃ n : Int, (n : ℝ) = pmid := by
        rcases hhalfPow with ⟨half, hhalf⟩
        rcases heps with hepsPos | hepsNeg
        · refine ⟨v.Fnum * Zpower_nat radix s + v.Fnum + half, ?_⟩
          dsimp [pmid]
          rw [hepsPos, Int.cast_add, Int.cast_add, Int.cast_mul,
            hpowSCast, hhalf]
          norm_num
        · refine ⟨v.Fnum * Zpower_nat radix s + v.Fnum - half - 1, ?_⟩
          dsimp [pmid]
          rw [hepsNeg, Int.cast_sub, Int.cast_sub, Int.cast_add,
            Int.cast_mul, hpowSCast, hhalf]
          norm_num
          ring
      have hpFN : FNeven (beta:=radix) b (radix : ℝ) t p := by
        have h := ClosestImplyEven_int (beta:=radix) b radix t
          (_root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1))
          pmid p
        simpa only [wp, PostCond.noThrow, pure, ClosestImplyEven_int_check,
          Id.run, ULift.up_down] using
          h ⟨hEvenRadix, hpDefEven, Or.inl hpNormal, hpNonneg, hpInputMid,
            hpmidInt, rfl, hradix, htGtOne, hvNum⟩
      have hpNorm : Fnormalize (beta:=radix) radix b t p = p := by
        have h := FcanonicFnormalizeEq (beta:=radix) radix b t p
        simpa only [wp, PostCond.noThrow, pure, FcanonicFnormalizeEq_check,
          Id.run, ULift.up_down] using
          h ⟨Or.inl hpNormal, rfl, hradix, htNe, hvNum⟩
      unfold FNeven Feven at hpFN
      rw [hpNorm] at hpFN
      simpa [mp, hpExpEq] using hpFN
    · have hpSucc : p.Fexp = e + 1 := hpCases.resolve_left hpExpEq
      have hprod : Even (p.Fnum * radix) := hEvenRadix.mul_left p.Fnum
      simpa [mp, hpExpEq] using hprod
  have hqNonpos : _root_.F2R (beta:=radix) q ≤ 0 :=
    qNeg (beta:=radix) b radix s t x p q hradix hvNum hxBound hxPos
      hpDef hqDef
  have hmqEven : Even mq := by
    by_cases hqExpEq : q.Fexp = e
    · have hsym :
          SymmetricP (EvenClosest (beta:=radix) b (radix : ℝ) t) := by
        have h := EvenClosestSymmetric (beta:=radix) b (radix : ℝ) t
        simpa only [wp, PostCond.noThrow, pure, EvenClosestSymmetric_check,
          Id.run, ULift.up_down] using h trivial
      have hqOppEven :
          EvenClosest (beta:=radix) b (radix : ℝ) t
            (-(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p))
            (Fopp (beta:=radix) q) := hsym _ q hqDefEven
      have hqOppCan :
          Fcanonic (beta:=radix) radix b (Fopp (beta:=radix) q) := by
        have h := FcanonicFopp (beta:=radix) radix b q
        simpa only [wp, PostCond.noThrow, pure, FcanonicFopp_check,
          Id.run, ULift.up_down] using h (Or.inl hqNormal)
      have hqOppNonneg :
          0 ≤ _root_.F2R (beta:=radix) (Fopp (beta:=radix) q) := by
        have h := (FloatSpec.Calc.Operations.F2R_opp (beta:=radix) q) trivial
        have hopp :
            _root_.F2R (beta:=radix) (Fopp (beta:=radix) q) =
              -_root_.F2R (beta:=radix) q := by
          simpa [Fopp, _root_.F2R] using h
        rw [hopp]
        linarith
      let qmid : ℝ := (mp : ℝ) - (v.Fnum : ℝ) - (eps + 1) / 2
      have hqInputMid :
          -(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) =
            (radix : ℝ) ^ (Fopp (beta:=radix) q).Fexp * (qmid + 1 / 2) := by
        rw [show (Fopp (beta:=radix) q).Fexp = q.Fexp by rfl, hqExpEq,
          hpCoeffValue, hxMid, hvExpanded]
        dsimp [qmid]
        ring
      have hqmidInt : ∃ n : Int, (n : ℝ) = qmid := by
        rcases heps with hepsPos | hepsNeg
        · refine ⟨mp - v.Fnum - 1, ?_⟩
          dsimp [qmid]
          rw [hepsPos, Int.cast_sub, Int.cast_sub]
          norm_num
        · refine ⟨mp - v.Fnum, ?_⟩
          dsimp [qmid]
          rw [hepsNeg, Int.cast_sub]
          norm_num
      have hqOppFN :
          FNeven (beta:=radix) b (radix : ℝ) t (Fopp (beta:=radix) q) := by
        have h := ClosestImplyEven_int (beta:=radix) b radix t
          (-(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p))
          qmid (Fopp (beta:=radix) q)
        simpa only [wp, PostCond.noThrow, pure, ClosestImplyEven_int_check,
          Id.run, ULift.up_down] using
          h ⟨hEvenRadix, hqOppEven, hqOppCan, hqOppNonneg, hqInputMid,
            hqmidInt, rfl, hradix, htGtOne, hvNum⟩
      have hqFN : FNeven (beta:=radix) b (radix : ℝ) t q := by
        have h := FNevenFop (beta:=radix) b (radix : ℝ) t
          (Fopp (beta:=radix) q)
        have hback :
            FNeven (beta:=radix) b (radix : ℝ) t
              (Fopp (beta:=radix) (Fopp (beta:=radix) q)) := by
          simpa only [wp, PostCond.noThrow, pure, FNevenFop_check,
            Id.run, ULift.up_down] using h hqOppFN
        simpa [Fopp, FloatSpec.Calc.Operations.Fopp] using hback
      have hqNorm : Fnormalize (beta:=radix) radix b t q = q := by
        have h := FcanonicFnormalizeEq (beta:=radix) radix b t q
        simpa only [wp, PostCond.noThrow, pure, FcanonicFnormalizeEq_check,
          Id.run, ULift.up_down] using
          h ⟨Or.inl hqNormal, rfl, hradix, htNe, hvNum⟩
      unfold FNeven Feven at hqFN
      rw [hqNorm] at hqFN
      simpa [mq, hqExpEq] using hqFN
    · have hqSucc : q.Fexp = e + 1 := hqCases.resolve_left hqExpEq
      have hprod : Even (q.Fnum * radix) := hEvenRadix.mul_left q.Fnum
      simpa [mq, hqExpEq] using hprod
  have hvNumEven : Even v.Fnum := by
    rw [hvNumEq]
    exact hmpEven.add hmqEven
  have hrvNum : rb.vNum = Zpower_nat radix u := by
    dsimp [rb, u]
    exact p'GivesBound radix b s t
  have hvNorm : Fnormalize (beta:=radix) radix rb u v = v := by
    have h := FcanonicFnormalizeEq (beta:=radix) radix rb u v
    simpa only [wp, PostCond.noThrow, pure, FcanonicFnormalizeEq_check,
      Id.run, ULift.up_down] using h ⟨hvCan, rfl, hradix, huNe, hrvNum⟩
  unfold FNeven Feven
  rw [hvNorm]
  exact hvNumEven

/-! Coq Veltkamp local lemma `Veltkamp_aux`.

The reconstructed high part is within half an ulp at exponent `s + Fexp x`
and has a canonical representative in the reduced `t - s` format.  That
representative is a closest rounding of `x`, and its exponent is no smaller
than the residual exponent. -/
theorem Veltkamp_aux {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x) :
    |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) hx| ≤
        (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2 ∧
      ∃ hx' : FloatSpec.Core.Defs.FlocqFloat beta,
        _root_.F2R (beta:=beta) hx' = _root_.F2R (beta:=beta) hx ∧
          Closest (beta:=beta) (Veltkamp_reducedBound radix b s t)
            (radix : ℝ) (_root_.F2R (beta:=beta) x) hx' ∧
          (s : Int) + x.Fexp ≤ hx'.Fexp := by
  subst beta
  let u : Nat := t - s
  let e : Int := (s : Int) + x.Fexp
  let rb : Fbound_skel := Veltkamp_reducedBound radix b s t
  have htPos : 0 < t := by omega
  have htNe : t ≠ 0 := Nat.ne_of_gt htPos
  have huGtOne : 1 < u := by dsimp [u]; omega
  have huPos : 0 < u := lt_trans Nat.zero_lt_one huGtOne
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hResidual := Veltkamp_aux_residual (beta:=radix) b radix s t x p q hx
    rfl hradix hvNum hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal
    hqNormal hxNormal
  rcases Veltkamp_aux_reduced_rep (beta:=radix) b radix s t x p q hx rfl
      hradix hvNum hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal
      hqNormal hxNormal hResidual with
    ⟨v, hvValue, hvCan⟩
  have hvBound : Fbounded (beta:=radix) rb v := by
    have h := FcanonicBound (beta:=radix) radix rb v
    simpa only [wp, PostCond.noThrow, pure, FcanonicBound_check,
      Id.run, ULift.up_down, rb] using h hvCan
  have hvResidual :
      |_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) v| ≤
        (radix : ℝ) ^ e / 2 := by
    rw [hvValue]
    simpa only [e] using hResidual
  have hxNumPos : 0 < x.Fnum :=
    FloatSpec.Core.Float_prop.gt_0_F2R (beta:=radix) x hradix hxPos
  have hxNumMin : nNormMin radix t ≤ x.Fnum := by
    have h := pNormal_absolu_min (beta:=radix) radix b t x
    have hAbs : nNormMin radix t ≤ |x.Fnum| := by
      simpa only [wp, PostCond.noThrow, pure, pNormal_absolu_min_check,
        Id.run, ULift.up_down] using
        h ⟨hxNormal, hxNormal, htNe, hradix, hvNum⟩
    simpa [abs_of_pos hxNumPos] using hAbs
  have hpowPredCast :
      (Zpower_nat radix (t - 1) : ℝ) =
        (radix : ℝ) ^ (((t - 1 : Nat) : Int)) := by
    have h := Zpower_nat_Z_powerRZ radix (t - 1)
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hxNumMinReal :
      (radix : ℝ) ^ (((t - 1 : Nat) : Int)) ≤ (x.Fnum : ℝ) := by
    rw [← hpowPredCast]
    exact_mod_cast (show Zpower_nat radix (t - 1) ≤ x.Fnum by
      simpa only [nNormMin] using hxNumMin)
  have hxPowPos : 0 < (radix : ℝ) ^ x.Fexp := zpow_pos hradixPos _
  have hxLower :
      (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) ≤
        _root_.F2R (beta:=radix) x := by
    calc
      (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) =
          (radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
            (radix : ℝ) ^ x.Fexp := by
              rw [← zpow_add₀ hradixNe]
              congr 1
              omega
      _ ≤ (x.Fnum : ℝ) * (radix : ℝ) ^ x.Fexp :=
        mul_le_mul_of_nonneg_right hxNumMinReal (le_of_lt hxPowPos)
      _ = _root_.F2R (beta:=radix) x := rfl
  have hxNumLt : x.Fnum < Zpower_nat radix t := by
    have h := hxBound.1
    rw [abs_of_pos hxNumPos, hvNum] at h
    exact h
  have hpowTCast :
      (Zpower_nat radix t : ℝ) = (radix : ℝ) ^ (t : Int) := by
    have h := Zpower_nat_Z_powerRZ radix t
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hxNumRealLt : (x.Fnum : ℝ) < (radix : ℝ) ^ (t : Int) := by
    rw [← hpowTCast]
    exact_mod_cast hxNumLt
  have hxUpper :
      _root_.F2R (beta:=radix) x ≤
        (radix : ℝ) ^ ((t : Int) + x.Fexp) := by
    apply le_of_lt
    calc
      _root_.F2R (beta:=radix) x =
          (x.Fnum : ℝ) * (radix : ℝ) ^ x.Fexp := rfl
      _ < (radix : ℝ) ^ (t : Int) * (radix : ℝ) ^ x.Fexp :=
        mul_lt_mul_of_pos_right hxNumRealLt hxPowPos
      _ = (radix : ℝ) ^ ((t : Int) + x.Fexp) := by
        rw [zpow_add₀ hradixNe]
  have hvLower :
      (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) ≤
        _root_.F2R (beta:=radix) v :=
    Veltkamp_aux_aux (beta:=radix) b radix s t x p q hx rfl hradix hvNum
      hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hxNormal v
      hvValue hvCan hvResidual
  have heBound : -rb.dExp ≤ e := by
    dsimp [rb, Veltkamp_reducedBound, e]
    exact le_trans hxBound.2 (by omega)
  have hrvNum : rb.vNum = Zpower_nat radix u := by
    dsimp [rb, u]
    exact p'GivesBound radix b s t
  have hLowerExp :
      e + (u : Int) - 1 = (t : Int) - 1 + x.Fexp := by
    dsimp [e, u]
    omega
  have hUpperExp : e + (u : Int) = (t : Int) + x.Fexp := by
    dsimp [e, u]
    omega
  have hvClosest :
      Closest (beta:=radix) rb (radix : ℝ)
        (_root_.F2R (beta:=radix) x) v := by
    have h := ImplyClosest (beta:=radix) rb radix u
      (_root_.F2R (beta:=radix) x) v e
    simpa only [wp, PostCond.noThrow, pure, ImplyClosest_check,
      Id.run, rb] using h ⟨hvBound, hvCan, by simpa only [hLowerExp] using hxLower,
        by simpa only [hUpperExp] using hxUpper,
        by simpa only [hLowerExp] using hvLower, heBound, rfl, hradix,
        huGtOne, hrvNum, hvResidual⟩
  let lower : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨nNormMin radix u, e⟩
  have hlowerCan : Fcanonic (beta:=radix) radix rb lower := by
    exact FcanonicNnormMin (beta:=radix) radix rb u e hradix huPos hrvNum heBound
  have hlowerValue :
      _root_.F2R (beta:=radix) lower =
        (radix : ℝ) ^ (e + (u : Int) - 1) := by
    dsimp [lower, _root_.F2R, FloatSpec.Core.Defs.F2R, nNormMin]
    have hpowNat :
        ((radix ^ (u - 1) : Int) : ℝ) =
          (radix : ℝ) ^ ((u - 1 : Nat) : Int) := by
      simp [Int.cast_pow]
    rw [hpowNat]
    have huCast : ((u - 1 : Nat) : Int) = (u : Int) - 1 := by omega
    rw [huCast]
    calc
      (radix : ℝ) ^ ((u : Int) - 1) * (radix : ℝ) ^ e =
          (radix : ℝ) ^ (((u : Int) - 1) + e) := by
            exact (zpow_add₀ hradixNe ((u : Int) - 1) e).symm
      _ = (radix : ℝ) ^ (e + (u : Int) - 1) := by
            congr 1
            ring
  have hlowerNonneg : 0 ≤ _root_.F2R (beta:=radix) lower := by
    rw [hlowerValue]
    exact le_of_lt (zpow_pos hradixPos _)
  have hvNonneg : 0 ≤ _root_.F2R (beta:=radix) v := by
    rw [← hLowerExp] at hvLower
    exact le_trans (by simpa [hlowerValue] using hlowerNonneg) hvLower
  have habsLower :
      |_root_.F2R (beta:=radix) lower| ≤
        |_root_.F2R (beta:=radix) v| := by
    rw [abs_of_nonneg hlowerNonneg, abs_of_nonneg hvNonneg, hlowerValue,
      hLowerExp]
    exact hvLower
  have heLeV : e ≤ v.Fexp := by
    have h := Fcanonic_Rle_Zle (beta:=radix) radix rb lower v hradix rfl
    have hle : lower.Fexp ≤ v.Fexp := by
      simpa only [wp, PostCond.noThrow, pure, Fcanonic_Rle_Zle_check,
        Id.run, ULift.up_down, Fcanonic', lower, rb] using
        h ⟨hlowerCan, hvCan, habsLower⟩
    simpa only [lower] using hle
  refine ⟨hResidual, v, hvValue, ?_, ?_⟩
  · simpa only [rb] using hvClosest
  · simpa only [e] using heLeV

/-! Coq Veltkamp local lemma `VeltkampEven1`.

For an even radix, even-closest rounding of the two Veltkamp split stages
forces the reconstructed high part to be the even-closest reduced-precision
rounding of `x`. -/
theorem VeltkampEven1 {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hpDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hEvenRadix : Even radix) :
    ∃ hx' : FloatSpec.Core.Defs.FlocqFloat beta,
      _root_.F2R (beta:=beta) hx' = _root_.F2R (beta:=beta) hx ∧
        EvenClosest (beta:=beta) (Veltkamp_reducedBound radix b s t)
          (radix : ℝ) (t - s) (_root_.F2R (beta:=beta) x) hx' := by
  subst beta
  let u : Nat := t - s
  let e : Int := (s : Int) + x.Fexp
  let rb : Fbound_skel := Veltkamp_reducedBound radix b s t
  have htPos : 0 < t := by omega
  have htNe : t ≠ 0 := Nat.ne_of_gt htPos
  have huGtOne : 1 < u := by dsimp [u]; omega
  have huPos : 0 < u := lt_trans Nat.zero_lt_one huGtOne
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  rcases Veltkamp_aux (beta:=radix) b radix s t x p q hx rfl hradix hvNum
      hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hxNormal with
    ⟨hResidual, w, hwValue, hwClosest, hwExp⟩
  rcases VeltkampEven1_candidate (beta:=radix) b radix s t x p q hx rfl
      hradix hvNum hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal
      hqNormal hxNormal hEvenRadix hResidual with
    ⟨v, hvValue, hvCan, hvEvenOrExp⟩
  have hvBound : Fbounded (beta:=radix) rb v := by
    have h := FcanonicBound (beta:=radix) radix rb v
    simpa only [wp, PostCond.noThrow, pure, FcanonicBound_check,
      Id.run, ULift.up_down] using h hvCan
  have hvClosest :
      Closest (beta:=radix) rb (radix : ℝ)
        (_root_.F2R (beta:=radix) x) v := by
    constructor
    · exact hvBound
    · intro g hg
      have h := hwClosest.2 g (by simpa only [rb] using hg)
      simpa only [hvValue, hwValue] using h
  have hvResidual :
      |_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) v| ≤
        (radix : ℝ) ^ e / 2 := by
    rw [hvValue]
    simpa only [e] using hResidual
  have hxNumPos : 0 < x.Fnum :=
    FloatSpec.Core.Float_prop.gt_0_F2R (beta:=radix) x hradix hxPos
  have hxNumMin : nNormMin radix t ≤ x.Fnum := by
    have h := pNormal_absolu_min (beta:=radix) radix b t x
    have hAbs : nNormMin radix t ≤ |x.Fnum| := by
      simpa only [wp, PostCond.noThrow, pure, pNormal_absolu_min_check,
        Id.run, ULift.up_down] using
        h ⟨hxNormal, hxNormal, htNe, hradix, hvNum⟩
    simpa [abs_of_pos hxNumPos] using hAbs
  have hpowPredCast :
      (Zpower_nat radix (t - 1) : ℝ) =
        (radix : ℝ) ^ (((t - 1 : Nat) : Int)) := by
    have h := Zpower_nat_Z_powerRZ radix (t - 1)
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hxNumMinReal :
      (radix : ℝ) ^ (((t - 1 : Nat) : Int)) ≤ (x.Fnum : ℝ) := by
    rw [← hpowPredCast]
    exact_mod_cast (show Zpower_nat radix (t - 1) ≤ x.Fnum by
      simpa only [nNormMin] using hxNumMin)
  have hxPowPos : 0 < (radix : ℝ) ^ x.Fexp := zpow_pos hradixPos _
  have hxLower :
      (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) ≤
        _root_.F2R (beta:=radix) x := by
    calc
      (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) =
          (radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
            (radix : ℝ) ^ x.Fexp := by
              rw [← zpow_add₀ hradixNe]
              congr 1
              omega
      _ ≤ (x.Fnum : ℝ) * (radix : ℝ) ^ x.Fexp :=
        mul_le_mul_of_nonneg_right hxNumMinReal (le_of_lt hxPowPos)
      _ = _root_.F2R (beta:=radix) x := rfl
  have hxNumLt : x.Fnum < Zpower_nat radix t := by
    have h := hxBound.1
    rw [abs_of_pos hxNumPos, hvNum] at h
    exact h
  have hpowTCast :
      (Zpower_nat radix t : ℝ) = (radix : ℝ) ^ (t : Int) := by
    have h := Zpower_nat_Z_powerRZ radix t
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hxNumRealLt : (x.Fnum : ℝ) < (radix : ℝ) ^ (t : Int) := by
    rw [← hpowTCast]
    exact_mod_cast hxNumLt
  have hxUpper :
      _root_.F2R (beta:=radix) x ≤
        (radix : ℝ) ^ ((t : Int) + x.Fexp) := by
    apply le_of_lt
    calc
      _root_.F2R (beta:=radix) x =
          (x.Fnum : ℝ) * (radix : ℝ) ^ x.Fexp := rfl
      _ < (radix : ℝ) ^ (t : Int) * (radix : ℝ) ^ x.Fexp :=
        mul_lt_mul_of_pos_right hxNumRealLt hxPowPos
      _ = (radix : ℝ) ^ ((t : Int) + x.Fexp) := by
        rw [zpow_add₀ hradixNe]
  have hvLower :
      (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) ≤
        _root_.F2R (beta:=radix) v :=
    Veltkamp_aux_aux (beta:=radix) b radix s t x p q hx rfl hradix hvNum
      hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hxNormal v
      hvValue hvCan hvResidual
  have heBound : -rb.dExp ≤ e := by
    dsimp [rb, Veltkamp_reducedBound, e]
    exact le_trans hxBound.2 (by omega)
  have hrvNum : rb.vNum = Zpower_nat radix u := by
    dsimp [rb, u]
    exact p'GivesBound radix b s t
  have hLowerExp :
      e + (u : Int) - 1 = (t : Int) - 1 + x.Fexp := by
    dsimp [e, u]
    omega
  have hUpperExp : e + (u : Int) = (t : Int) + x.Fexp := by
    dsimp [e, u]
    omega
  let lower : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨nNormMin radix u, e⟩
  have hlowerCan : Fcanonic (beta:=radix) radix rb lower := by
    exact FcanonicNnormMin (beta:=radix) radix rb u e hradix huPos hrvNum
      heBound
  have hlowerValue :
      _root_.F2R (beta:=radix) lower =
        (radix : ℝ) ^ (e + (u : Int) - 1) := by
    dsimp [lower, _root_.F2R, FloatSpec.Core.Defs.F2R, nNormMin]
    have hpowNat :
        ((radix ^ (u - 1) : Int) : ℝ) =
          (radix : ℝ) ^ ((u - 1 : Nat) : Int) := by
      simp [Int.cast_pow]
    rw [hpowNat]
    have huCast : ((u - 1 : Nat) : Int) = (u : Int) - 1 := by omega
    rw [huCast]
    calc
      (radix : ℝ) ^ ((u : Int) - 1) * (radix : ℝ) ^ e =
          (radix : ℝ) ^ (((u : Int) - 1) + e) := by
            exact (zpow_add₀ hradixNe ((u : Int) - 1) e).symm
      _ = (radix : ℝ) ^ (e + (u : Int) - 1) := by
        congr 1
        ring
  have hlowerNonneg : 0 ≤ _root_.F2R (beta:=radix) lower := by
    rw [hlowerValue]
    exact le_of_lt (zpow_pos hradixPos _)
  have hvNonneg : 0 ≤ _root_.F2R (beta:=radix) v := by
    rw [← hLowerExp] at hvLower
    exact le_trans (by simpa [hlowerValue] using hlowerNonneg) hvLower
  have habsLower :
      |_root_.F2R (beta:=radix) lower| ≤
        |_root_.F2R (beta:=radix) v| := by
    rw [abs_of_nonneg hlowerNonneg, abs_of_nonneg hvNonneg, hlowerValue,
      hLowerExp]
    exact hvLower
  have heLeV : e ≤ v.Fexp := by
    have h := Fcanonic_Rle_Zle (beta:=radix) radix rb lower v hradix rfl
    have hle : lower.Fexp ≤ v.Fexp := by
      simpa only [wp, PostCond.noThrow, pure, Fcanonic_Rle_Zle_check,
        Id.run, ULift.up_down, Fcanonic', lower, rb] using
        h ⟨hlowerCan, hvCan, habsLower⟩
    simpa only [lower] using hle
  refine ⟨v, hvValue, ?_⟩
  rcases hvEvenOrExp with hvEven | hvExpLe
  · exact ⟨hvClosest, Or.inl (by simpa only [rb, u] using hvEven)⟩
  · have hvExpEq : v.Fexp = e := le_antisymm hvExpLe heLeV
    by_cases hStrict :
        |_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) v| <
          (radix : ℝ) ^ e / 2
    · have h := ImplyClosestStrict2 (beta:=radix) rb radix u
        (_root_.F2R (beta:=radix) x) v e
      have hstrictResult :
          Closest (beta:=radix) rb (radix : ℝ)
              (_root_.F2R (beta:=radix) x) v ∧
            ∀ g : FloatSpec.Core.Defs.FlocqFloat radix,
              Closest (beta:=radix) rb (radix : ℝ)
                  (_root_.F2R (beta:=radix) x) g →
                _root_.F2R (beta:=radix) v = _root_.F2R (beta:=radix) g := by
        simpa only [wp, PostCond.noThrow, pure, ImplyClosestStrict2_check,
          Id.run] using
          h ⟨hvBound, hvCan, by simpa only [hLowerExp] using hxLower,
            by simpa only [hUpperExp] using hxUpper,
            by simpa only [hLowerExp] using hvLower, heBound, rfl, hradix,
            huGtOne, hrvNum, hStrict⟩
      refine ⟨hvClosest, Or.inr ?_⟩
      intro g hg
      exact (hstrictResult.2 g hg).symm
    · have hTie :
          |_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) v| =
            (radix : ℝ) ^ e / 2 :=
        le_antisymm hvResidual (le_of_not_gt hStrict)
      have hvEven := VeltkampEven1_tie_even (beta:=radix) b radix s t
        x p q hx v rfl hradix hvNum hsGe hsLe hxBound hpDef hqDef hhxDef
        hxPos hpNormal hqNormal hxNormal hpDefEven hqDefEven hEvenRadix
        hvValue hvCan (by simpa only [e] using hvExpEq)
        (by simpa only [e] using hTie)
      exact ⟨hvClosest, Or.inl (by simpa only [rb, u] using hvEven)⟩

private theorem VeltkampEven2_no_tie {beta : Int}
    (radix : Int) (s : Nat)
    (x v : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hsGe : 2 ≤ s) (hOddRadix : Odd radix)
    (hvExp : (s : Int) + x.Fexp ≤ v.Fexp)
    (hTie :
      |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) v| =
        (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2) : False := by
  subst beta
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  let k : Nat := Int.toNat (v.Fexp - x.Fexp)
  let m : Int := x.Fnum - v.Fnum * Zpower_nat radix k
  have hdiffNonneg : 0 ≤ v.Fexp - x.Fexp := by omega
  have hkCast : (k : Int) = v.Fexp - x.Fexp := by
    simpa [k] using Int.toNat_of_nonneg hdiffNonneg
  have hpowKCast :
      (Zpower_nat radix k : ℝ) =
        (radix : ℝ) ^ (v.Fexp - x.Fexp) := by
    have h := Zpower_nat_Z_powerRZ radix k
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down, hkCast] using h trivial
  have hvPowSplit :
      (radix : ℝ) ^ v.Fexp =
        (radix : ℝ) ^ (v.Fexp - x.Fexp) *
          (radix : ℝ) ^ x.Fexp := by
    calc
      (radix : ℝ) ^ v.Fexp =
          (radix : ℝ) ^ ((v.Fexp - x.Fexp) + x.Fexp) := by
            congr 1
            ring
      _ = (radix : ℝ) ^ (v.Fexp - x.Fexp) *
            (radix : ℝ) ^ x.Fexp := zpow_add₀ hradixNe _ _
  have hmRepr :
      _root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) v =
        (m : ℝ) * (radix : ℝ) ^ x.Fexp := by
    dsimp [_root_.F2R, FloatSpec.Core.Defs.F2R, m]
    rw [Int.cast_sub, Int.cast_mul, hpowKCast, hvPowSplit]
    ring
  have hsPowSplit :
      (radix : ℝ) ^ ((s : Int) + x.Fexp) =
        (radix : ℝ) ^ (s : Int) * (radix : ℝ) ^ x.Fexp :=
    zpow_add₀ hradixNe _ _
  have hxPowPos : 0 < (radix : ℝ) ^ x.Fexp := zpow_pos hradixPos _
  rw [hmRepr, abs_mul, abs_of_pos hxPowPos, hsPowSplit] at hTie
  have hrealEq :
      (radix : ℝ) ^ (s : Int) = 2 * |(m : ℝ)| := by
    nlinarith [hTie, hxPowPos]
  have hpowSCast :
      (Zpower_nat radix s : ℝ) = (radix : ℝ) ^ (s : Int) := by
    have h := Zpower_nat_Z_powerRZ radix s
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hintEq : Zpower_nat radix s = 2 * |m| := by
    exact_mod_cast (show (Zpower_nat radix s : ℝ) = (2 * |m| : Int) by
      rw [hpowSCast, Int.cast_mul, Int.cast_ofNat, Int.cast_abs]
      exact hrealEq)
  have hEvenPow : Even (Zpower_nat radix s) := by
    refine ⟨|m|, ?_⟩
    rw [hintEq]
    ring
  have hOddPow : Odd (Zpower_nat radix s) := by
    simpa only [Zpower_nat] using hOddRadix.pow
  exact (Int.not_even_iff_odd.mpr hOddPow) hEvenPow

/-! Coq Veltkamp local lemma `VeltkampEven2`.

For an odd radix, an exact reduced-format midpoint is impossible: after
scaling by the exponent of `x`, it would make `radix^s` even.  The resulting
strict closestness supplies the unique-value branch of `EvenClosest`. -/
theorem VeltkampEven2 {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxBound : Fbounded (beta:=beta) b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpNormal : Fnormal (beta:=beta) radix b p)
    (hqNormal : Fnormal (beta:=beta) radix b q)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hpDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx)
    (hOddRadix : Odd radix) :
    ∃ hx' : FloatSpec.Core.Defs.FlocqFloat beta,
      _root_.F2R (beta:=beta) hx' = _root_.F2R (beta:=beta) hx ∧
        EvenClosest (beta:=beta) (Veltkamp_reducedBound radix b s t)
          (radix : ℝ) (t - s) (_root_.F2R (beta:=beta) x) hx' := by
  subst beta
  let u : Nat := t - s
  let e : Int := (s : Int) + x.Fexp
  let rb : Fbound_skel := Veltkamp_reducedBound radix b s t
  have htPos : 0 < t := by omega
  have htNe : t ≠ 0 := Nat.ne_of_gt htPos
  have huGtOne : 1 < u := by dsimp [u]; omega
  have huPos : 0 < u := lt_trans Nat.zero_lt_one huGtOne
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  rcases Veltkamp_aux (beta:=radix) b radix s t x p q hx rfl hradix hvNum
      hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hxNormal with
    ⟨hResidual, w, hwValue, hwClosest, hwExp⟩
  rcases Veltkamp_aux_reduced_rep (beta:=radix) b radix s t x p q hx rfl
      hradix hvNum hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal
      hqNormal hxNormal hResidual with
    ⟨v, hvValue, hvCan⟩
  have hvBound : Fbounded (beta:=radix) rb v := by
    have h := FcanonicBound (beta:=radix) radix rb v
    simpa only [wp, PostCond.noThrow, pure, FcanonicBound_check,
      Id.run, ULift.up_down] using h hvCan
  have hvResidual :
      |_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) v| ≤
        (radix : ℝ) ^ e / 2 := by
    rw [hvValue]
    simpa only [e] using hResidual
  have hxNumPos : 0 < x.Fnum :=
    FloatSpec.Core.Float_prop.gt_0_F2R (beta:=radix) x hradix hxPos
  have hxNumMin : nNormMin radix t ≤ x.Fnum := by
    have h := pNormal_absolu_min (beta:=radix) radix b t x
    have hAbs : nNormMin radix t ≤ |x.Fnum| := by
      simpa only [wp, PostCond.noThrow, pure, pNormal_absolu_min_check,
        Id.run, ULift.up_down] using
        h ⟨hxNormal, hxNormal, htNe, hradix, hvNum⟩
    simpa [abs_of_pos hxNumPos] using hAbs
  have hpowPredCast :
      (Zpower_nat radix (t - 1) : ℝ) =
        (radix : ℝ) ^ (((t - 1 : Nat) : Int)) := by
    have h := Zpower_nat_Z_powerRZ radix (t - 1)
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hxNumMinReal :
      (radix : ℝ) ^ (((t - 1 : Nat) : Int)) ≤ (x.Fnum : ℝ) := by
    rw [← hpowPredCast]
    exact_mod_cast (show Zpower_nat radix (t - 1) ≤ x.Fnum by
      simpa only [nNormMin] using hxNumMin)
  have hxPowPos : 0 < (radix : ℝ) ^ x.Fexp := zpow_pos hradixPos _
  have hxLower :
      (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) ≤
        _root_.F2R (beta:=radix) x := by
    calc
      (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) =
          (radix : ℝ) ^ (((t - 1 : Nat) : Int)) *
            (radix : ℝ) ^ x.Fexp := by
              rw [← zpow_add₀ hradixNe]
              congr 1
              omega
      _ ≤ (x.Fnum : ℝ) * (radix : ℝ) ^ x.Fexp :=
        mul_le_mul_of_nonneg_right hxNumMinReal (le_of_lt hxPowPos)
      _ = _root_.F2R (beta:=radix) x := rfl
  have hxNumLt : x.Fnum < Zpower_nat radix t := by
    have h := hxBound.1
    rw [abs_of_pos hxNumPos, hvNum] at h
    exact h
  have hpowTCast :
      (Zpower_nat radix t : ℝ) = (radix : ℝ) ^ (t : Int) := by
    have h := Zpower_nat_Z_powerRZ radix t
    simpa only [wp, PostCond.noThrow, pure, Zpower_nat_Z_powerRZ_check,
      Id.run, ULift.up_down] using h trivial
  have hxNumRealLt : (x.Fnum : ℝ) < (radix : ℝ) ^ (t : Int) := by
    rw [← hpowTCast]
    exact_mod_cast hxNumLt
  have hxUpper :
      _root_.F2R (beta:=radix) x ≤
        (radix : ℝ) ^ ((t : Int) + x.Fexp) := by
    apply le_of_lt
    calc
      _root_.F2R (beta:=radix) x =
          (x.Fnum : ℝ) * (radix : ℝ) ^ x.Fexp := rfl
      _ < (radix : ℝ) ^ (t : Int) * (radix : ℝ) ^ x.Fexp :=
        mul_lt_mul_of_pos_right hxNumRealLt hxPowPos
      _ = (radix : ℝ) ^ ((t : Int) + x.Fexp) := by
        rw [zpow_add₀ hradixNe]
  have hvLower :
      (radix : ℝ) ^ ((t : Int) - 1 + x.Fexp) ≤
        _root_.F2R (beta:=radix) v :=
    Veltkamp_aux_aux (beta:=radix) b radix s t x p q hx rfl hradix hvNum
      hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hxNormal v
      hvValue hvCan hvResidual
  have heBound : -rb.dExp ≤ e := by
    dsimp [rb, Veltkamp_reducedBound, e]
    exact le_trans hxBound.2 (by omega)
  have hrvNum : rb.vNum = Zpower_nat radix u := by
    dsimp [rb, u]
    exact p'GivesBound radix b s t
  have hLowerExp :
      e + (u : Int) - 1 = (t : Int) - 1 + x.Fexp := by
    dsimp [e, u]
    omega
  have hUpperExp : e + (u : Int) = (t : Int) + x.Fexp := by
    dsimp [e, u]
    omega
  let lower : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨nNormMin radix u, e⟩
  have hlowerCan : Fcanonic (beta:=radix) radix rb lower := by
    exact FcanonicNnormMin (beta:=radix) radix rb u e hradix huPos hrvNum
      heBound
  have hlowerValue :
      _root_.F2R (beta:=radix) lower =
        (radix : ℝ) ^ (e + (u : Int) - 1) := by
    dsimp [lower, _root_.F2R, FloatSpec.Core.Defs.F2R, nNormMin]
    have hpowNat :
        ((radix ^ (u - 1) : Int) : ℝ) =
          (radix : ℝ) ^ ((u - 1 : Nat) : Int) := by
      simp [Int.cast_pow]
    rw [hpowNat]
    have huCast : ((u - 1 : Nat) : Int) = (u : Int) - 1 := by omega
    rw [huCast]
    calc
      (radix : ℝ) ^ ((u : Int) - 1) * (radix : ℝ) ^ e =
          (radix : ℝ) ^ (((u : Int) - 1) + e) := by
            exact (zpow_add₀ hradixNe ((u : Int) - 1) e).symm
      _ = (radix : ℝ) ^ (e + (u : Int) - 1) := by
        congr 1
        ring
  have hlowerNonneg : 0 ≤ _root_.F2R (beta:=radix) lower := by
    rw [hlowerValue]
    exact le_of_lt (zpow_pos hradixPos _)
  have hvNonneg : 0 ≤ _root_.F2R (beta:=radix) v := by
    rw [← hLowerExp] at hvLower
    exact le_trans (by simpa [hlowerValue] using hlowerNonneg) hvLower
  have habsLower :
      |_root_.F2R (beta:=radix) lower| ≤
        |_root_.F2R (beta:=radix) v| := by
    rw [abs_of_nonneg hlowerNonneg, abs_of_nonneg hvNonneg, hlowerValue,
      hLowerExp]
    exact hvLower
  have heLeV : e ≤ v.Fexp := by
    have h := Fcanonic_Rle_Zle (beta:=radix) radix rb lower v hradix rfl
    have hle : lower.Fexp ≤ v.Fexp := by
      simpa only [wp, PostCond.noThrow, pure, Fcanonic_Rle_Zle_check,
        Id.run, ULift.up_down, Fcanonic', lower, rb] using
        h ⟨hlowerCan, hvCan, habsLower⟩
    simpa only [lower] using hle
  have hStrict :
      |_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) v| <
        (radix : ℝ) ^ e / 2 := by
    by_contra hnot
    have hTie :
        |_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) v| =
          (radix : ℝ) ^ e / 2 :=
      le_antisymm hvResidual (le_of_not_gt hnot)
    exact VeltkampEven2_no_tie (beta:=radix) radix s x v rfl hradix hsGe
      hOddRadix (by simpa only [e] using heLeV) (by simpa only [e] using hTie)
  have h := ImplyClosestStrict2 (beta:=radix) rb radix u
    (_root_.F2R (beta:=radix) x) v e
  have hstrictResult :
      Closest (beta:=radix) rb (radix : ℝ)
          (_root_.F2R (beta:=radix) x) v ∧
        ∀ g : FloatSpec.Core.Defs.FlocqFloat radix,
          Closest (beta:=radix) rb (radix : ℝ)
              (_root_.F2R (beta:=radix) x) g →
            _root_.F2R (beta:=radix) v = _root_.F2R (beta:=radix) g := by
    simpa only [wp, PostCond.noThrow, pure, ImplyClosestStrict2_check,
      Id.run] using
      h ⟨hvBound, hvCan, by simpa only [hLowerExp] using hxLower,
        by simpa only [hUpperExp] using hxUpper,
        by simpa only [hLowerExp] using hvLower, heBound, rfl, hradix,
        huGtOne, hrvNum, hStrict⟩
  refine ⟨v, hvValue, hstrictResult.1, Or.inr ?_⟩
  intro g hg
  exact (hstrictResult.2 g hg).symm

private theorem Veltkamp_pos_normal_of_first_lt
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (z : ℝ) (f : FloatSpec.Core.Defs.FlocqFloat radix)
    (hradix : 1 < radix) (hprecision : 1 < precision)
    (hvNum : b.vNum = Zpower_nat radix precision)
    (hfCan : Fcanonic (beta:=radix) radix b f)
    (hfClosest : Closest (beta:=radix) b (radix : ℝ) z f)
    (hFirstLt :
      _root_.F2R (beta:=radix)
          (firstNormalPos (beta:=radix) radix b precision) < z) :
    Fnormal (beta:=radix) radix b f := by
  rcases hfCan with hfNormal | hfSubnormal
  · exact hfNormal
  · have hfirstNormal :
        Fnormal (beta:=radix) radix b
          (firstNormalPos (beta:=radix) radix b precision) := by
      have h := firstNormalPosNormal (beta:=radix) radix b precision
      simpa only [wp, PostCond.noThrow, pure, firstNormalPosNormal_check,
        Id.run, ULift.up_down] using h ⟨hradix, hprecision, hvNum⟩
    have hfirstClosest :
        Closest (beta:=radix) b (radix : ℝ)
          (_root_.F2R (beta:=radix)
            (firstNormalPos (beta:=radix) radix b precision))
          (firstNormalPos (beta:=radix) radix b precision) := by
      constructor
      · exact hfirstNormal.1
      · intro g _hg
        rw [sub_self, abs_zero]
        exact abs_nonneg _
    have hmono :
        MonotoneP_float (Closest (beta:=radix) b (radix : ℝ)) := by
      have h := ClosestMonotone (beta:=radix) b (radix : ℝ)
      simpa only [wp, PostCond.noThrow, pure, ClosestMonotone_check,
        Id.run, ULift.up_down] using h trivial
    have hfirstLeF :
        _root_.F2R (beta:=radix)
            (firstNormalPos (beta:=radix) radix b precision) ≤
          _root_.F2R (beta:=radix) f :=
      hmono _ _ _ _ hFirstLt hfirstClosest hfClosest
    have hradixPosInt : (0 : Int) < radix := by omega
    have hradixPos : (0 : ℝ) < (radix : ℝ) := by
      exact_mod_cast hradixPosInt
    have hnormMinPos : 0 < nNormMin radix precision := by
      unfold nNormMin
      exact pow_pos hradixPosInt _
    have hfirstPos :
        0 < _root_.F2R (beta:=radix)
          (firstNormalPos (beta:=radix) radix b precision) := by
      change 0 < (nNormMin radix precision : ℝ) *
        (radix : ℝ) ^ (-b.dExp)
      exact mul_pos (by exact_mod_cast hnormMinPos) (zpow_pos hradixPos _)
    have hfNonneg : 0 ≤ _root_.F2R (beta:=radix) f :=
      le_trans (le_of_lt hfirstPos) hfirstLeF
    have hfLtFirst :
        _root_.F2R (beta:=radix) f <
          _root_.F2R (beta:=radix)
            (firstNormalPos (beta:=radix) radix b precision) :=
      (FsubnormalLtFirstNormalPos (beta:=radix) radix b precision f)
        ⟨hfSubnormal, hfSubnormal, Nat.ne_of_gt (lt_trans Nat.zero_lt_one
          hprecision), rfl, hradix, hvNum, hfNonneg⟩
    exfalso
    exact (not_lt_of_ge hfirstLeF) hfLtFirst

/-! Coq positive-input Veltkamp wrapper `Veltkamp_pos`.

Normality of the two rounded intermediates follows from monotonicity and the
normal/subnormal separation at `firstNormalPos`; the exact residual and
reduced-format witness then come from `Veltkamp_aux`. -/
theorem Veltkamp_pos {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hpCan : Fcanonic (beta:=beta) radix b p)
    (hqCan : Fcanonic (beta:=beta) radix b q)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx) :
    |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) hx| ≤
        (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2 ∧
      ∃ hx' : FloatSpec.Core.Defs.FlocqFloat beta,
        _root_.F2R (beta:=beta) hx' = _root_.F2R (beta:=beta) hx ∧
          Closest (beta:=beta) (Veltkamp_reducedBound radix b s t)
            (radix : ℝ) (_root_.F2R (beta:=beta) x) hx' ∧
          (s : Int) + x.Fexp ≤ hx'.Fexp := by
  subst beta
  have htGtOne : 1 < t := by omega
  have htNe : t ≠ 0 := Nat.ne_of_gt (lt_trans Nat.zero_lt_one htGtOne)
  have hxBound : Fbounded (beta:=radix) b x := hxNormal.1
  have hfirstLeX :
      _root_.F2R (beta:=radix)
          (firstNormalPos (beta:=radix) radix b t) ≤
        _root_.F2R (beta:=radix) x :=
    (FnormalLtFirstNormalPos (beta:=radix) radix b t x)
      ⟨hxNormal, hxNormal, htNe, rfl, hradix, hvNum, le_of_lt hxPos⟩
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hpowSPos : 0 < (radix : ℝ) ^ (s : Int) :=
    zpow_pos hradixPos _
  have hxLtScaled :
      _root_.F2R (beta:=radix) x <
        _root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1) := by
    nlinarith
  have hfirstLtScaled :
      _root_.F2R (beta:=radix)
          (firstNormalPos (beta:=radix) radix b t) <
        _root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1) :=
    lt_of_le_of_lt hfirstLeX hxLtScaled
  have hpNormal : Fnormal (beta:=radix) radix b p :=
    Veltkamp_pos_normal_of_first_lt b radix t
      (_root_.F2R (beta:=radix) x *
        ((radix : ℝ) ^ (s : Int) + 1)) p
      hradix htGtOne hvNum hpCan hpDef hfirstLtScaled
  have hmono :
      MonotoneP_float (Closest (beta:=radix) b (radix : ℝ)) := by
    have h := ClosestMonotone (beta:=radix) b (radix : ℝ)
    simpa only [wp, PostCond.noThrow, pure, ClosestMonotone_check,
      Id.run, ULift.up_down] using h trivial
  let xShift : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨x.Fnum, x.Fexp + 2⟩
  have hxShiftBound : Fbounded (beta:=radix) b xShift := by
    constructor
    · simpa only [xShift] using hxBound.1
    · dsimp [xShift]
      exact le_trans hxBound.2 (by omega)
  have hxShiftValue :
      _root_.F2R (beta:=radix) xShift =
        _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (2 : Int) := by
    dsimp [xShift, _root_.F2R, FloatSpec.Core.Defs.F2R]
    rw [zpow_add₀ hradixNe]
    ring
  have hxShiftClosest :
      Closest (beta:=radix) b (radix : ℝ)
        (_root_.F2R (beta:=radix) xShift) xShift := by
    constructor
    · exact hxShiftBound
    · intro g _hg
      rw [sub_self, abs_zero]
      exact abs_nonneg _
  have hradixOneLe : (1 : ℝ) ≤ (radix : ℝ) := by
    exact_mod_cast (le_of_lt hradix)
  have hpowTwoLeS :
      (radix : ℝ) ^ (2 : Int) ≤ (radix : ℝ) ^ (s : Int) :=
    zpow_le_zpow_right₀ hradixOneLe (by omega)
  have hxShiftLtScaled :
      _root_.F2R (beta:=radix) xShift <
        _root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1) := by
    rw [hxShiftValue]
    calc
      _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (2 : Int) ≤
          _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (s : Int) :=
        mul_le_mul_of_nonneg_left hpowTwoLeS (le_of_lt hxPos)
      _ < _root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1) := by nlinarith
  have hxShiftLeP :
      _root_.F2R (beta:=radix) xShift ≤
        _root_.F2R (beta:=radix) p :=
    hmono _ _ xShift p hxShiftLtScaled hxShiftClosest hpDef
  have hradixTwoLe : (2 : ℝ) ≤ (radix : ℝ) := by
    exact_mod_cast (by omega : (2 : Int) ≤ radix)
  have hpowTwoGeFour :
      (4 : ℝ) ≤ (radix : ℝ) ^ (2 : Int) := by
    norm_num [zpow_ofNat]
    nlinarith
  have hpowTwoGtTwo : (2 : ℝ) < (radix : ℝ) ^ (2 : Int) :=
    lt_of_lt_of_le (by norm_num) hpowTwoGeFour
  have htwoXLtShift :
      2 * _root_.F2R (beta:=radix) x <
        _root_.F2R (beta:=radix) xShift := by
    rw [hxShiftValue]
    have h := mul_lt_mul_of_pos_left hpowTwoGtTwo hxPos
    nlinarith
  have htwoXLtP :
      2 * _root_.F2R (beta:=radix) x <
        _root_.F2R (beta:=radix) p :=
    lt_of_lt_of_le htwoXLtShift hxShiftLeP
  have hfirstLtOppInput :
      _root_.F2R (beta:=radix)
          (firstNormalPos (beta:=radix) radix b t) <
        -(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) := by
    have hxLtOppInput :
        _root_.F2R (beta:=radix) x <
          -(_root_.F2R (beta:=radix) x -
            _root_.F2R (beta:=radix) p) := by
      nlinarith
    exact lt_of_le_of_lt hfirstLeX hxLtOppInput
  have hqOppCan :
      Fcanonic (beta:=radix) radix b (Fopp (beta:=radix) q) := by
    have h := FcanonicFopp (beta:=radix) radix b q
    simpa only [wp, PostCond.noThrow, pure, FcanonicFopp_check,
      Id.run, ULift.up_down] using h hqCan
  have hqOppClosest :
      Closest (beta:=radix) b (radix : ℝ)
        (-(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p))
        (Fopp (beta:=radix) q) := by
    have h := ClosestOpp (beta:=radix) b (radix : ℝ) q
      (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p)
    simpa only [wp, PostCond.noThrow, pure, ClosestOpp_check,
      Id.run, ULift.up_down] using h hqDef
  have hqOppNormal :
      Fnormal (beta:=radix) radix b (Fopp (beta:=radix) q) :=
    Veltkamp_pos_normal_of_first_lt b radix t
      (-(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p))
      (Fopp (beta:=radix) q) hradix htGtOne hvNum hqOppCan hqOppClosest
      hfirstLtOppInput
  have hqNormal : Fnormal (beta:=radix) radix b q := by
    have h := FnormalFop (beta:=radix) b radix (Fopp (beta:=radix) q)
    have hdouble :
        Fnormal (beta:=radix) radix b
          (Fopp (beta:=radix) (Fopp (beta:=radix) q)) := by
      simpa only [wp, PostCond.noThrow, pure, FnormalFop_check,
        Id.run, ULift.up_down] using h hqOppNormal
    simpa [Fopp, FloatSpec.Calc.Operations.Fopp] using hdouble
  exact Veltkamp_aux (beta:=radix) b radix s t x p q hx rfl hradix hvNum
    hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal hxNormal

/-! Coq sign-symmetric Veltkamp wrapper `VeltkampN_aux`.

The positive branch is `Veltkamp_pos`.  For a negative normal input, negate
all four floats, apply the positive theorem, and negate its reduced witness
back; normality excludes the remaining zero case. -/
theorem VeltkampN_aux {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hpCan : Fcanonic (beta:=beta) radix b p)
    (hqCan : Fcanonic (beta:=beta) radix b q)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx) :
    |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) hx| ≤
        (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2 ∧
      ∃ hx' : FloatSpec.Core.Defs.FlocqFloat beta,
        _root_.F2R (beta:=beta) hx' = _root_.F2R (beta:=beta) hx ∧
          Closest (beta:=beta) (Veltkamp_reducedBound radix b s t)
            (radix : ℝ) (_root_.F2R (beta:=beta) x) hx' ∧
          (s : Int) + x.Fexp ≤ hx'.Fexp := by
  subst beta
  have hradixPosInt : (0 : Int) < radix := by omega
  have hvNumPos : 0 < b.vNum := by
    rw [hvNum, Zpower_nat]
    exact pow_pos hradixPosInt _
  have hxNumNe : x.Fnum ≠ 0 := by
    intro hxNumZero
    have hnormalMant := hxNormal.2
    rw [hxNumZero, mul_zero, abs_zero] at hnormalMant
    omega
  have hxValueNe : _root_.F2R (beta:=radix) x ≠ 0 :=
    FloatSpec.Core.Float_prop.F2R_neq_0 (beta:=radix) x hradix hxNumNe
  by_cases hxNonneg : 0 ≤ _root_.F2R (beta:=radix) x
  · have hxPos : 0 < _root_.F2R (beta:=radix) x :=
      lt_of_le_of_ne hxNonneg hxValueNe.symm
    exact Veltkamp_pos (beta:=radix) b radix s t x p q hx rfl hradix
      hvNum hsGe hsLe hxNormal hpCan hqCan hxPos hpDef hqDef hhxDef
  · have hxNeg : _root_.F2R (beta:=radix) x < 0 := lt_of_not_ge hxNonneg
    have hoppValue (f : FloatSpec.Core.Defs.FlocqFloat radix) :
        _root_.F2R (beta:=radix) (Fopp (beta:=radix) f) =
          -_root_.F2R (beta:=radix) f := by
      have h := (FloatSpec.Calc.Operations.F2R_opp (beta:=radix) f) trivial
      simpa [Fopp, _root_.F2R] using h
    have hxOppNormal :
        Fnormal (beta:=radix) radix b (Fopp (beta:=radix) x) := by
      have h := FnormalFop (beta:=radix) b radix x
      simpa only [wp, PostCond.noThrow, pure, FnormalFop_check,
        Id.run, ULift.up_down] using h hxNormal
    have hpOppCan :
        Fcanonic (beta:=radix) radix b (Fopp (beta:=radix) p) := by
      have h := FcanonicFopp (beta:=radix) radix b p
      simpa only [wp, PostCond.noThrow, pure, FcanonicFopp_check,
        Id.run, ULift.up_down] using h hpCan
    have hqOppCan :
        Fcanonic (beta:=radix) radix b (Fopp (beta:=radix) q) := by
      have h := FcanonicFopp (beta:=radix) radix b q
      simpa only [wp, PostCond.noThrow, pure, FcanonicFopp_check,
        Id.run, ULift.up_down] using h hqCan
    have hxOppPos :
        0 < _root_.F2R (beta:=radix) (Fopp (beta:=radix) x) := by
      rw [hoppValue]
      linarith
    have hpOppDef :
        Closest (beta:=radix) b (radix : ℝ)
          (_root_.F2R (beta:=radix) (Fopp (beta:=radix) x) *
            ((radix : ℝ) ^ (s : Int) + 1))
          (Fopp (beta:=radix) p) := by
      have h := ClosestOpp (beta:=radix) b (radix : ℝ) p
        (_root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1))
      have hOpp :
          Closest (beta:=radix) b (radix : ℝ)
            (-(_root_.F2R (beta:=radix) x *
              ((radix : ℝ) ^ (s : Int) + 1)))
            (Fopp (beta:=radix) p) := by
        simpa only [wp, PostCond.noThrow, pure, ClosestOpp_check,
          Id.run, ULift.up_down] using h hpDef
      rw [hoppValue]
      convert hOpp using 1 <;> ring
    have hqOppDef :
        Closest (beta:=radix) b (radix : ℝ)
          (_root_.F2R (beta:=radix) (Fopp (beta:=radix) x) -
            _root_.F2R (beta:=radix) (Fopp (beta:=radix) p))
          (Fopp (beta:=radix) q) := by
      have h := ClosestOpp (beta:=radix) b (radix : ℝ) q
        (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p)
      have hOpp :
          Closest (beta:=radix) b (radix : ℝ)
            (-(_root_.F2R (beta:=radix) x -
              _root_.F2R (beta:=radix) p))
            (Fopp (beta:=radix) q) := by
        simpa only [wp, PostCond.noThrow, pure, ClosestOpp_check,
          Id.run, ULift.up_down] using h hqDef
      rw [hoppValue, hoppValue]
      convert hOpp using 1 <;> ring
    have hhxOppDef :
        Closest (beta:=radix) b (radix : ℝ)
          (_root_.F2R (beta:=radix) (Fopp (beta:=radix) q) +
            _root_.F2R (beta:=radix) (Fopp (beta:=radix) p))
          (Fopp (beta:=radix) hx) := by
      have h := ClosestOpp (beta:=radix) b (radix : ℝ) hx
        (_root_.F2R (beta:=radix) q + _root_.F2R (beta:=radix) p)
      have hOpp :
          Closest (beta:=radix) b (radix : ℝ)
            (-(_root_.F2R (beta:=radix) q +
              _root_.F2R (beta:=radix) p))
            (Fopp (beta:=radix) hx) := by
        simpa only [wp, PostCond.noThrow, pure, ClosestOpp_check,
          Id.run, ULift.up_down] using h hhxDef
      rw [hoppValue, hoppValue]
      convert hOpp using 1 <;> ring
    rcases Veltkamp_pos (beta:=radix) b radix s t
        (Fopp (beta:=radix) x) (Fopp (beta:=radix) p)
        (Fopp (beta:=radix) q) (Fopp (beta:=radix) hx)
        rfl hradix hvNum hsGe hsLe hxOppNormal hpOppCan hqOppCan hxOppPos
        hpOppDef hqOppDef hhxOppDef with
      ⟨hResidual, v, hvValue, hvClosest, hvExp⟩
    have hResidual' :
        |_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) hx| ≤
          (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2 := by
      have hAbs :
          |_root_.F2R (beta:=radix) (Fopp (beta:=radix) x) -
              _root_.F2R (beta:=radix) (Fopp (beta:=radix) hx)| =
            |_root_.F2R (beta:=radix) x -
              _root_.F2R (beta:=radix) hx| := by
        rw [hoppValue, hoppValue]
        have harg :
            -_root_.F2R (beta:=radix) x -
                -_root_.F2R (beta:=radix) hx =
              -(_root_.F2R (beta:=radix) x -
                _root_.F2R (beta:=radix) hx) := by
          ring
        rw [harg, abs_neg]
      rw [← hAbs]
      simpa [Fopp, FloatSpec.Calc.Operations.Fopp] using hResidual
    refine ⟨hResidual', Fopp (beta:=radix) v, ?_, ?_, ?_⟩
    · rw [hoppValue, hvValue, hoppValue]
      ring
    · have h := ClosestOpp (beta:=radix)
          (Veltkamp_reducedBound radix b s t) (radix : ℝ) v
          (_root_.F2R (beta:=radix) (Fopp (beta:=radix) x))
      have hOpp :
          Closest (beta:=radix) (Veltkamp_reducedBound radix b s t)
            (radix : ℝ)
            (-_root_.F2R (beta:=radix) (Fopp (beta:=radix) x))
            (Fopp (beta:=radix) v) := by
        simpa only [wp, PostCond.noThrow, pure, ClosestOpp_check,
          Id.run, ULift.up_down] using h hvClosest
      rw [hoppValue] at hOpp
      simpa using hOpp
    · simpa [Fopp, FloatSpec.Calc.Operations.Fopp] using hvExp

/-! Coq normalized Veltkamp wrapper `VeltkampN`.

The closest-rounding premises already make `p` and `q` bounded.  Normalize
them into canonical representatives with unchanged real values, transfer the
three closestness hypotheses, and apply `VeltkampN_aux`. -/
theorem VeltkampN {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx) :
    |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) hx| ≤
        (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2 ∧
      ∃ hx' : FloatSpec.Core.Defs.FlocqFloat beta,
        _root_.F2R (beta:=beta) hx' = _root_.F2R (beta:=beta) hx ∧
          Closest (beta:=beta) (Veltkamp_reducedBound radix b s t)
            (radix : ℝ) (_root_.F2R (beta:=beta) x) hx' ∧
          (s : Int) + x.Fexp ≤ hx'.Fexp := by
  subst beta
  have htNe : t ≠ 0 := by omega
  let np : FloatSpec.Core.Defs.FlocqFloat radix :=
    Fnormalize (beta:=radix) radix b t p
  let nq : FloatSpec.Core.Defs.FlocqFloat radix :=
    Fnormalize (beta:=radix) radix b t q
  have hpBound : Fbounded (beta:=radix) b p := hpDef.1
  have hqBound : Fbounded (beta:=radix) b q := hqDef.1
  have hnpValue :
      _root_.F2R (beta:=radix) np = _root_.F2R (beta:=radix) p := by
    have h := FnormalizeCorrect (beta:=radix) radix b t p
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
      Id.run, ULift.up_down, np] using h ⟨rfl, hradix⟩
  have hnqValue :
      _root_.F2R (beta:=radix) nq = _root_.F2R (beta:=radix) q := by
    have h := FnormalizeCorrect (beta:=radix) radix b t q
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
      Id.run, ULift.up_down, nq] using h ⟨rfl, hradix⟩
  have hnpBound : Fbounded (beta:=radix) b np := by
    have h := FnormalizeBounded (beta:=radix) radix b t p
    simpa only [wp, PostCond.noThrow, pure, FnormalizeBounded_check,
      Id.run, ULift.up_down, np] using
      h ⟨hpBound, hpBound, htNe, hradix, hvNum⟩
  have hnqBound : Fbounded (beta:=radix) b nq := by
    have h := FnormalizeBounded (beta:=radix) radix b t q
    simpa only [wp, PostCond.noThrow, pure, FnormalizeBounded_check,
      Id.run, ULift.up_down, nq] using
      h ⟨hqBound, hqBound, htNe, hradix, hvNum⟩
  have hnpCan : Fcanonic (beta:=radix) radix b np := by
    have h := FnormalizeCanonic (beta:=radix) radix b t p
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCanonic_check,
      Id.run, ULift.up_down, np] using
      h ⟨hpBound, hpBound, htNe, hradix, hvNum⟩
  have hnqCan : Fcanonic (beta:=radix) radix b nq := by
    have h := FnormalizeCanonic (beta:=radix) radix b t q
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCanonic_check,
      Id.run, ULift.up_down, nq] using
      h ⟨hqBound, hqBound, htNe, hradix, hvNum⟩
  have hnpClosest :
      Closest (beta:=radix) b (radix : ℝ)
        (_root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1)) np := by
    constructor
    · exact hnpBound
    · intro g hg
      rw [hnpValue]
      exact hpDef.2 g hg
  have hnqClosest :
      Closest (beta:=radix) b (radix : ℝ)
        (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) np) nq := by
    constructor
    · exact hnqBound
    · intro g hg
      rw [hnpValue, hnqValue]
      exact hqDef.2 g hg
  have hhxClosest :
      Closest (beta:=radix) b (radix : ℝ)
        (_root_.F2R (beta:=radix) nq + _root_.F2R (beta:=radix) np) hx := by
    rw [hnqValue, hnpValue]
    exact hhxDef
  exact VeltkampN_aux (beta:=radix) b radix s t x np nq hx rfl hradix
    hvNum hsGe hsLe hxNormal hnpCan hnqCan hnpClosest hnqClosest hhxClosest

private theorem Veltkamp_pos_q_normal
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q : FloatSpec.Core.Defs.FlocqFloat radix)
    (hradix : 1 < radix) (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxNormal : Fnormal (beta:=radix) radix b x)
    (hqCan : Fcanonic (beta:=radix) radix b q)
    (hxPos : 0 < _root_.F2R (beta:=radix) x)
    (hpDef : Closest (beta:=radix) b (radix : ℝ)
      (_root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=radix) b (radix : ℝ)
      (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) q) :
    Fnormal (beta:=radix) radix b q := by
  have htGtOne : 1 < t := by omega
  have htNe : t ≠ 0 := Nat.ne_of_gt (lt_trans Nat.zero_lt_one htGtOne)
  have hxBound : Fbounded (beta:=radix) b x := hxNormal.1
  have hfirstLeX :
      _root_.F2R (beta:=radix)
          (firstNormalPos (beta:=radix) radix b t) ≤
        _root_.F2R (beta:=radix) x :=
    (FnormalLtFirstNormalPos (beta:=radix) radix b t x)
      ⟨hxNormal, hxNormal, htNe, rfl, hradix, hvNum, le_of_lt hxPos⟩
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hmono :
      MonotoneP_float (Closest (beta:=radix) b (radix : ℝ)) := by
    have h := ClosestMonotone (beta:=radix) b (radix : ℝ)
    simpa only [wp, PostCond.noThrow, pure, ClosestMonotone_check,
      Id.run, ULift.up_down] using h trivial
  let xShift : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨x.Fnum, x.Fexp + 2⟩
  have hxShiftBound : Fbounded (beta:=radix) b xShift := by
    constructor
    · simpa only [xShift] using hxBound.1
    · dsimp [xShift]
      exact le_trans hxBound.2 (by omega)
  have hxShiftValue :
      _root_.F2R (beta:=radix) xShift =
        _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (2 : Int) := by
    dsimp [xShift, _root_.F2R, FloatSpec.Core.Defs.F2R]
    rw [zpow_add₀ hradixNe]
    ring
  have hxShiftClosest :
      Closest (beta:=radix) b (radix : ℝ)
        (_root_.F2R (beta:=radix) xShift) xShift := by
    constructor
    · exact hxShiftBound
    · intro g _hg
      rw [sub_self, abs_zero]
      exact abs_nonneg _
  have hradixOneLe : (1 : ℝ) ≤ (radix : ℝ) := by
    exact_mod_cast (le_of_lt hradix)
  have hpowTwoLeS :
      (radix : ℝ) ^ (2 : Int) ≤ (radix : ℝ) ^ (s : Int) :=
    zpow_le_zpow_right₀ hradixOneLe (by omega)
  have hxShiftLtScaled :
      _root_.F2R (beta:=radix) xShift <
        _root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1) := by
    rw [hxShiftValue]
    calc
      _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (2 : Int) ≤
          _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (s : Int) :=
        mul_le_mul_of_nonneg_left hpowTwoLeS (le_of_lt hxPos)
      _ < _root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1) := by nlinarith
  have hxShiftLeP :
      _root_.F2R (beta:=radix) xShift ≤
        _root_.F2R (beta:=radix) p :=
    hmono _ _ xShift p hxShiftLtScaled hxShiftClosest hpDef
  have hradixTwoLe : (2 : ℝ) ≤ (radix : ℝ) := by
    exact_mod_cast (by omega : (2 : Int) ≤ radix)
  have hpowTwoGeFour :
      (4 : ℝ) ≤ (radix : ℝ) ^ (2 : Int) := by
    norm_num [zpow_ofNat]
    nlinarith
  have hpowTwoGtTwo : (2 : ℝ) < (radix : ℝ) ^ (2 : Int) :=
    lt_of_lt_of_le (by norm_num) hpowTwoGeFour
  have htwoXLtShift :
      2 * _root_.F2R (beta:=radix) x <
        _root_.F2R (beta:=radix) xShift := by
    rw [hxShiftValue]
    have h := mul_lt_mul_of_pos_left hpowTwoGtTwo hxPos
    nlinarith
  have htwoXLtP :
      2 * _root_.F2R (beta:=radix) x <
        _root_.F2R (beta:=radix) p :=
    lt_of_lt_of_le htwoXLtShift hxShiftLeP
  have hfirstLtOppInput :
      _root_.F2R (beta:=radix)
          (firstNormalPos (beta:=radix) radix b t) <
        -(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) := by
    have hxLtOppInput :
        _root_.F2R (beta:=radix) x <
          -(_root_.F2R (beta:=radix) x -
            _root_.F2R (beta:=radix) p) := by
      nlinarith
    exact lt_of_le_of_lt hfirstLeX hxLtOppInput
  have hqOppCan :
      Fcanonic (beta:=radix) radix b (Fopp (beta:=radix) q) := by
    have h := FcanonicFopp (beta:=radix) radix b q
    simpa only [wp, PostCond.noThrow, pure, FcanonicFopp_check,
      Id.run, ULift.up_down] using h hqCan
  have hqOppClosest :
      Closest (beta:=radix) b (radix : ℝ)
        (-(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p))
        (Fopp (beta:=radix) q) := by
    have h := ClosestOpp (beta:=radix) b (radix : ℝ) q
      (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p)
    simpa only [wp, PostCond.noThrow, pure, ClosestOpp_check,
      Id.run, ULift.up_down] using h hqDef
  have hqOppNormal :
      Fnormal (beta:=radix) radix b (Fopp (beta:=radix) q) :=
    Veltkamp_pos_normal_of_first_lt b radix t
      (-(_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p))
      (Fopp (beta:=radix) q) hradix htGtOne hvNum hqOppCan hqOppClosest
      hfirstLtOppInput
  have h := FnormalFop (beta:=radix) b radix (Fopp (beta:=radix) q)
  have hdouble :
      Fnormal (beta:=radix) radix b
        (Fopp (beta:=radix) (Fopp (beta:=radix) q)) := by
    simpa only [wp, PostCond.noThrow, pure, FnormalFop_check,
      Id.run, ULift.up_down] using h hqOppNormal
  simpa [Fopp, FloatSpec.Calc.Operations.Fopp] using hdouble

/-! Coq positive-input even-rounding wrapper `VeltkampEven_pos`.

The `Closest` components yield normal intermediates.  Even radix then uses
`VeltkampEven1`; odd radix uses the no-midpoint theorem `VeltkampEven2`. -/
theorem VeltkampEven_pos {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hpCan : Fcanonic (beta:=beta) radix b p)
    (hqCan : Fcanonic (beta:=beta) radix b q)
    (hxPos : 0 < _root_.F2R (beta:=beta) x)
    (hpDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx) :
    ∃ hx' : FloatSpec.Core.Defs.FlocqFloat beta,
      _root_.F2R (beta:=beta) hx' = _root_.F2R (beta:=beta) hx ∧
        EvenClosest (beta:=beta) (Veltkamp_reducedBound radix b s t)
          (radix : ℝ) (t - s) (_root_.F2R (beta:=beta) x) hx' := by
  subst beta
  have hpDef := hpDefEven.1
  have hqDef := hqDefEven.1
  have hhxDef := hhxDefEven.1
  have htGtOne : 1 < t := by omega
  have htNe : t ≠ 0 := Nat.ne_of_gt (lt_trans Nat.zero_lt_one htGtOne)
  have hfirstLeX :
      _root_.F2R (beta:=radix)
          (firstNormalPos (beta:=radix) radix b t) ≤
        _root_.F2R (beta:=radix) x :=
    (FnormalLtFirstNormalPos (beta:=radix) radix b t x)
      ⟨hxNormal, hxNormal, htNe, rfl, hradix, hvNum, le_of_lt hxPos⟩
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hpowSPos : 0 < (radix : ℝ) ^ (s : Int) :=
    zpow_pos hradixPos _
  have hxLtScaled :
      _root_.F2R (beta:=radix) x <
        _root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1) := by
    nlinarith
  have hpNormal : Fnormal (beta:=radix) radix b p :=
    Veltkamp_pos_normal_of_first_lt b radix t
      (_root_.F2R (beta:=radix) x *
        ((radix : ℝ) ^ (s : Int) + 1)) p
      hradix htGtOne hvNum hpCan hpDef
      (lt_of_le_of_lt hfirstLeX hxLtScaled)
  have hqNormal : Fnormal (beta:=radix) radix b q :=
    Veltkamp_pos_q_normal b radix s t x p q hradix hvNum hsGe hsLe hxNormal
      hqCan hxPos hpDef hqDef
  have hxBound : Fbounded (beta:=radix) b x := hxNormal.1
  rcases Int.even_or_odd radix with hEvenRadix | hOddRadix
  · exact VeltkampEven1 (beta:=radix) b radix s t x p q hx rfl hradix
      hvNum hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal
      hxNormal hpDefEven hqDefEven hhxDefEven hEvenRadix
  · exact VeltkampEven2 (beta:=radix) b radix s t x p q hx rfl hradix
      hvNum hsGe hsLe hxBound hpDef hqDef hhxDef hxPos hpNormal hqNormal
      hxNormal hpDefEven hqDefEven hhxDefEven hOddRadix

/-! Coq sign-symmetric even-rounding wrapper `VeltkampEvenN_aux`.

The positive branch is `VeltkampEven_pos`. For a negative normal input, negate
all four floats, transport the three even-closest premises by symmetry, apply
the positive theorem, and negate its reduced witness back. -/
theorem VeltkampEvenN_aux {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hpCan : Fcanonic (beta:=beta) radix b p)
    (hqCan : Fcanonic (beta:=beta) radix b q)
    (hpDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx) :
    ∃ hx' : FloatSpec.Core.Defs.FlocqFloat beta,
      _root_.F2R (beta:=beta) hx' = _root_.F2R (beta:=beta) hx ∧
        EvenClosest (beta:=beta) (Veltkamp_reducedBound radix b s t)
          (radix : ℝ) (t - s) (_root_.F2R (beta:=beta) x) hx' := by
  subst beta
  have hradixPosInt : (0 : Int) < radix := by omega
  have hvNumPos : 0 < b.vNum := by
    rw [hvNum, Zpower_nat]
    exact pow_pos hradixPosInt _
  have hxNumNe : x.Fnum ≠ 0 := by
    intro hxNumZero
    have hnormalMant := hxNormal.2
    rw [hxNumZero, mul_zero, abs_zero] at hnormalMant
    omega
  have hxValueNe : _root_.F2R (beta:=radix) x ≠ 0 :=
    FloatSpec.Core.Float_prop.F2R_neq_0 (beta:=radix) x hradix hxNumNe
  by_cases hxNonneg : 0 ≤ _root_.F2R (beta:=radix) x
  · have hxPos : 0 < _root_.F2R (beta:=radix) x :=
      lt_of_le_of_ne hxNonneg hxValueNe.symm
    exact VeltkampEven_pos (beta:=radix) b radix s t x p q hx rfl hradix
      hvNum hsGe hsLe hxNormal hpCan hqCan hxPos hpDefEven hqDefEven hhxDefEven
  · have hxNeg : _root_.F2R (beta:=radix) x < 0 := lt_of_not_ge hxNonneg
    have hoppValue (f : FloatSpec.Core.Defs.FlocqFloat radix) :
        _root_.F2R (beta:=radix) (Fopp (beta:=radix) f) =
          -_root_.F2R (beta:=radix) f := by
      have h := (FloatSpec.Calc.Operations.F2R_opp (beta:=radix) f) trivial
      simpa [Fopp, _root_.F2R] using h
    have hxOppNormal :
        Fnormal (beta:=radix) radix b (Fopp (beta:=radix) x) := by
      have h := FnormalFop (beta:=radix) b radix x
      simpa only [wp, PostCond.noThrow, pure, FnormalFop_check,
        Id.run, ULift.up_down] using h hxNormal
    have hpOppCan :
        Fcanonic (beta:=radix) radix b (Fopp (beta:=radix) p) := by
      have h := FcanonicFopp (beta:=radix) radix b p
      simpa only [wp, PostCond.noThrow, pure, FcanonicFopp_check,
        Id.run, ULift.up_down] using h hpCan
    have hqOppCan :
        Fcanonic (beta:=radix) radix b (Fopp (beta:=radix) q) := by
      have h := FcanonicFopp (beta:=radix) radix b q
      simpa only [wp, PostCond.noThrow, pure, FcanonicFopp_check,
        Id.run, ULift.up_down] using h hqCan
    have hxOppPos :
        0 < _root_.F2R (beta:=radix) (Fopp (beta:=radix) x) := by
      rw [hoppValue]
      linarith
    have hsym :
        SymmetricP (EvenClosest (beta:=radix) b (radix : ℝ) t) := by
      have h := EvenClosestSymmetric (beta:=radix) b (radix : ℝ) t
      simpa only [wp, PostCond.noThrow, pure, EvenClosestSymmetric_check,
        Id.run, ULift.up_down] using h trivial
    have hpOppDefEven :
        EvenClosest (beta:=radix) b (radix : ℝ) t
          (_root_.F2R (beta:=radix) (Fopp (beta:=radix) x) *
            ((radix : ℝ) ^ (s : Int) + 1))
          (Fopp (beta:=radix) p) := by
      have hOpp := hsym
        (_root_.F2R (beta:=radix) x * ((radix : ℝ) ^ (s : Int) + 1))
        p hpDefEven
      rw [hoppValue]
      convert hOpp using 1 <;> ring
    have hqOppDefEven :
        EvenClosest (beta:=radix) b (radix : ℝ) t
          (_root_.F2R (beta:=radix) (Fopp (beta:=radix) x) -
            _root_.F2R (beta:=radix) (Fopp (beta:=radix) p))
          (Fopp (beta:=radix) q) := by
      have hOpp := hsym
        (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p)
        q hqDefEven
      rw [hoppValue, hoppValue]
      convert hOpp using 1 <;> ring
    have hhxOppDefEven :
        EvenClosest (beta:=radix) b (radix : ℝ) t
          (_root_.F2R (beta:=radix) (Fopp (beta:=radix) q) +
            _root_.F2R (beta:=radix) (Fopp (beta:=radix) p))
          (Fopp (beta:=radix) hx) := by
      have hOpp := hsym
        (_root_.F2R (beta:=radix) q + _root_.F2R (beta:=radix) p)
        hx hhxDefEven
      rw [hoppValue, hoppValue]
      convert hOpp using 1 <;> ring
    rcases VeltkampEven_pos (beta:=radix) b radix s t
        (Fopp (beta:=radix) x) (Fopp (beta:=radix) p)
        (Fopp (beta:=radix) q) (Fopp (beta:=radix) hx)
        rfl hradix hvNum hsGe hsLe hxOppNormal hpOppCan hqOppCan hxOppPos
        hpOppDefEven hqOppDefEven hhxOppDefEven with
      ⟨v, hvValue, hvEven⟩
    refine ⟨Fopp (beta:=radix) v, ?_, ?_⟩
    · rw [hoppValue, hvValue, hoppValue]
      ring
    · have hsymReduced :
          SymmetricP (EvenClosest (beta:=radix)
            (Veltkamp_reducedBound radix b s t) (radix : ℝ) (t - s)) := by
        have h := EvenClosestSymmetric (beta:=radix)
          (Veltkamp_reducedBound radix b s t) (radix : ℝ) (t - s)
        simpa only [wp, PostCond.noThrow, pure, EvenClosestSymmetric_check,
          Id.run, ULift.up_down] using h trivial
      have hOpp := hsymReduced
        (_root_.F2R (beta:=radix) (Fopp (beta:=radix) x)) v hvEven
      rw [hoppValue] at hOpp
      simpa using hOpp

/-! Coq normalized nearest-even Veltkamp wrapper `VeltkampEvenN`.

Normalize the rounded intermediates into canonical representatives, preserve
both branches of each `EvenClosest` premise, and apply `VeltkampEvenN_aux`. -/
theorem VeltkampEvenN {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxNormal : Fnormal (beta:=beta) radix b x)
    (hpDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx) :
    ∃ hx' : FloatSpec.Core.Defs.FlocqFloat beta,
      _root_.F2R (beta:=beta) hx' = _root_.F2R (beta:=beta) hx ∧
        EvenClosest (beta:=beta) (Veltkamp_reducedBound radix b s t)
          (radix : ℝ) (t - s) (_root_.F2R (beta:=beta) x) hx' := by
  subst beta
  have htNe : t ≠ 0 := by omega
  let np : FloatSpec.Core.Defs.FlocqFloat radix :=
    Fnormalize (beta:=radix) radix b t p
  let nq : FloatSpec.Core.Defs.FlocqFloat radix :=
    Fnormalize (beta:=radix) radix b t q
  have hpBound : Fbounded (beta:=radix) b p := hpDefEven.1.1
  have hqBound : Fbounded (beta:=radix) b q := hqDefEven.1.1
  have hnpValue :
      _root_.F2R (beta:=radix) np = _root_.F2R (beta:=radix) p := by
    have h := FnormalizeCorrect (beta:=radix) radix b t p
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
      Id.run, ULift.up_down, np] using h ⟨rfl, hradix⟩
  have hnqValue :
      _root_.F2R (beta:=radix) nq = _root_.F2R (beta:=radix) q := by
    have h := FnormalizeCorrect (beta:=radix) radix b t q
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
      Id.run, ULift.up_down, nq] using h ⟨rfl, hradix⟩
  have hnpBound : Fbounded (beta:=radix) b np := by
    have h := FnormalizeBounded (beta:=radix) radix b t p
    simpa only [wp, PostCond.noThrow, pure, FnormalizeBounded_check,
      Id.run, ULift.up_down, np] using
      h ⟨hpBound, hpBound, htNe, hradix, hvNum⟩
  have hnqBound : Fbounded (beta:=radix) b nq := by
    have h := FnormalizeBounded (beta:=radix) radix b t q
    simpa only [wp, PostCond.noThrow, pure, FnormalizeBounded_check,
      Id.run, ULift.up_down, nq] using
      h ⟨hqBound, hqBound, htNe, hradix, hvNum⟩
  have hnpCan : Fcanonic (beta:=radix) radix b np := by
    have h := FnormalizeCanonic (beta:=radix) radix b t p
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCanonic_check,
      Id.run, ULift.up_down, np] using
      h ⟨hpBound, hpBound, htNe, hradix, hvNum⟩
  have hnqCan : Fcanonic (beta:=radix) radix b nq := by
    have h := FnormalizeCanonic (beta:=radix) radix b t q
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCanonic_check,
      Id.run, ULift.up_down, nq] using
      h ⟨hqBound, hqBound, htNe, hradix, hvNum⟩
  have hnpNorm : Fnormalize (beta:=radix) radix b t np = np := by
    have h := FcanonicFnormalizeEq (beta:=radix) radix b t np
    simpa only [wp, PostCond.noThrow, pure, FcanonicFnormalizeEq_check,
      Id.run, ULift.up_down] using h ⟨hnpCan, rfl, hradix, htNe, hvNum⟩
  have hnqNorm : Fnormalize (beta:=radix) radix b t nq = nq := by
    have h := FcanonicFnormalizeEq (beta:=radix) radix b t nq
    simpa only [wp, PostCond.noThrow, pure, FcanonicFnormalizeEq_check,
      Id.run, ULift.up_down] using h ⟨hnqCan, rfl, hradix, htNe, hvNum⟩
  have hnpClosest :
      Closest (beta:=radix) b (radix : ℝ)
        (_root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1)) np := by
    constructor
    · exact hnpBound
    · intro g hg
      rw [hnpValue]
      exact hpDefEven.1.2 g hg
  have hnqClosest :
      Closest (beta:=radix) b (radix : ℝ)
        (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) np) nq := by
    constructor
    · exact hnqBound
    · intro g hg
      rw [hnpValue, hnqValue]
      exact hqDefEven.1.2 g hg
  have hnpEven :
      EvenClosest (beta:=radix) b (radix : ℝ) t
        (_root_.F2R (beta:=radix) x *
          ((radix : ℝ) ^ (s : Int) + 1)) np := by
    refine ⟨hnpClosest, ?_⟩
    rcases hpDefEven.2 with hpEven | hpUnique
    · left
      unfold FNeven at hpEven ⊢
      rw [hnpNorm]
      simpa only [np] using hpEven
    · right
      intro g hg
      calc
        _root_.F2R (beta:=radix) g = _root_.F2R (beta:=radix) p :=
          hpUnique g hg
        _ = _root_.F2R (beta:=radix) np := hnpValue.symm
  have hnqEven :
      EvenClosest (beta:=radix) b (radix : ℝ) t
        (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) np) nq := by
    refine ⟨hnqClosest, ?_⟩
    rcases hqDefEven.2 with hqEven | hqUnique
    · left
      unfold FNeven at hqEven ⊢
      rw [hnqNorm]
      simpa only [nq] using hqEven
    · right
      intro g hg
      have hg' :
          Closest (beta:=radix) b (radix : ℝ)
            (_root_.F2R (beta:=radix) x - _root_.F2R (beta:=radix) p) g := by
        simpa only [hnpValue] using hg
      calc
        _root_.F2R (beta:=radix) g = _root_.F2R (beta:=radix) q :=
          hqUnique g hg'
        _ = _root_.F2R (beta:=radix) nq := hnqValue.symm
  have hhxEven :
      EvenClosest (beta:=radix) b (radix : ℝ) t
        (_root_.F2R (beta:=radix) nq + _root_.F2R (beta:=radix) np) hx := by
    rw [hnqValue, hnpValue]
    exact hhxDefEven
  exact VeltkampEvenN_aux (beta:=radix) b radix s t x np nq hx rfl hradix
    hvNum hsGe hsLe hxNormal hnpCan hnqCan hnpEven hnqEven hhxEven

/-! Coq Veltkamp bound-extension lemma `Closestbbplus`.

Competitors newly admitted by `plusExp` have exponent below the original
minimum and magnitude below the first interior radix threshold. Inside that
threshold the exact float has an exact original-bound representative; outside
it, the threshold float on the same side is no farther from the exact value. -/
theorem Closestbbplus {beta : Int}
    (b0 : Fbound_skel) (radix : Int) (t n : Nat)
    (fext f : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b0.vNum = Zpower_nat radix n) (hn : 1 < n)
    (hfextExp : -b0.dExp ≤ fext.Fexp)
    (hfClosest : Closest (beta:=beta) b0 (radix : ℝ)
      (_root_.F2R (beta:=beta) fext) f) :
    Closest (beta:=beta) (plusExp b0 t) (radix : ℝ)
      (_root_.F2R (beta:=beta) fext) f := by
  subst beta
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixOne : (1 : ℝ) ≤ (radix : ℝ) := by
    exact_mod_cast (le_of_lt hradix)
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hnPredCast : ((n - 1 : Nat) : Int) = (n : Int) - 1 := by
    omega
  let mantissaThreshold : Int := Zpower_nat radix (n - 1)
  let threshold : ℝ :=
    (radix : ℝ) ^ ((n : Int) - 1 - b0.dExp)
  have hmantissaThresholdPos : 0 < mantissaThreshold := by
    dsimp [mantissaThreshold, Zpower_nat]
    exact pow_pos hradixPosInt _
  have hmantissaThresholdLt : mantissaThreshold < b0.vNum := by
    rw [hvNum]
    dsimp [mantissaThreshold, Zpower_nat]
    exact pow_lt_pow_right₀ hradix (by omega)
  have hthresholdPos : 0 < threshold := by
    exact zpow_pos hradixPos _
  let upper : FloatSpec.Core.Defs.FlocqFloat radix :=
    ⟨mantissaThreshold, -b0.dExp⟩
  let lower : FloatSpec.Core.Defs.FlocqFloat radix :=
    Fopp (beta:=radix) upper
  have hupperBound : Fbounded (beta:=radix) b0 upper := by
    constructor
    · dsimp [upper]
      rw [abs_of_pos hmantissaThresholdPos]
      exact hmantissaThresholdLt
    · simp [upper]
  have hlowerBound : Fbounded (beta:=radix) b0 lower := by
    simpa [lower, Fbounded, Fopp, FloatSpec.Calc.Operations.Fopp, abs_neg]
      using hupperBound
  have hthresholdScale :
      threshold = (mantissaThreshold : ℝ) * (radix : ℝ) ^ (-b0.dExp) := by
    dsimp [threshold, mantissaThreshold, Zpower_nat]
    rw [Int.cast_pow, ← zpow_natCast, hnPredCast]
    rw [← zpow_add₀ hradixNe]
    congr 1
  have hupperValue :
      _root_.F2R (beta:=radix) upper = threshold := by
    dsimp [upper, _root_.F2R, FloatSpec.Core.Defs.F2R]
    rw [hthresholdScale]
  have hlowerValue :
      _root_.F2R (beta:=radix) lower = -threshold := by
    have h := (FloatSpec.Calc.Operations.F2R_opp (beta:=radix) upper) trivial
    calc
      _root_.F2R (beta:=radix) lower =
          -_root_.F2R (beta:=radix) upper := by
        simpa [lower, Fopp, _root_.F2R] using h
      _ = -threshold := by rw [hupperValue]
  constructor
  · rcases hfClosest.1 with ⟨hfNum, hfExp⟩
    constructor
    · simpa [plusExp] using hfNum
    · dsimp [plusExp]
      have htNonneg : (0 : Int) ≤ ((t - 1 : Nat) : Int) :=
        Int.natCast_nonneg _
      omega
  · intro g hgPlus
    by_cases hgOldExp : -b0.dExp ≤ g.Fexp
    · apply hfClosest.2 g
      constructor
      · simpa [plusExp] using hgPlus.1
      · exact hgOldExp
    · have hgExpLe : g.Fexp ≤ -b0.dExp - 1 := by omega
      have hgNumInt : |g.Fnum| < Zpower_nat radix n := by
        simpa [plusExp, hvNum] using hgPlus.1
      have hgNumRealCast :
          ((|g.Fnum| : Int) : ℝ) < ((Zpower_nat radix n : Int) : ℝ) := by
        exact_mod_cast hgNumInt
      have hgNumReal : |(g.Fnum : ℝ)| < (radix : ℝ) ^ n := by
        simpa [Int.cast_abs, Zpower_nat, Int.cast_pow] using hgNumRealCast
      have hgPowPos : 0 < (radix : ℝ) ^ g.Fexp :=
        zpow_pos hradixPos _
      have hgPowLe :
          (radix : ℝ) ^ g.Fexp ≤
            (radix : ℝ) ^ (-b0.dExp - 1) :=
        zpow_le_zpow_right₀ hradixOne hgExpLe
      have hgAbsValue :
          |_root_.F2R (beta:=radix) g| =
            |(g.Fnum : ℝ)| * (radix : ℝ) ^ g.Fexp := by
        simp [_root_.F2R, FloatSpec.Core.Defs.F2R, abs_mul,
          abs_of_pos hgPowPos]
      have hgMagnitudeLt :
          |_root_.F2R (beta:=radix) g| < threshold := by
        rw [hgAbsValue]
        calc
          |(g.Fnum : ℝ)| * (radix : ℝ) ^ g.Fexp <
              (radix : ℝ) ^ n * (radix : ℝ) ^ g.Fexp :=
            mul_lt_mul_of_pos_right hgNumReal hgPowPos
          _ ≤ (radix : ℝ) ^ n *
              (radix : ℝ) ^ (-b0.dExp - 1) :=
            mul_le_mul_of_nonneg_left hgPowLe (by positivity)
          _ = threshold := by
            dsimp [threshold]
            rw [← zpow_natCast, ← zpow_add₀ hradixNe]
            congr 1
            ring
      let shift : Nat := (fext.Fexp + b0.dExp).toNat
      have hshiftCast : (shift : Int) = fext.Fexp + b0.dExp := by
        dsimp [shift]
        rw [Int.toNat_of_nonneg]
        omega
      let exactMantissa : Int := fext.Fnum * radix ^ shift
      let exactFloat : FloatSpec.Core.Defs.FlocqFloat radix :=
        ⟨exactMantissa, -b0.dExp⟩
      have hexactValue :
          _root_.F2R (beta:=radix) exactFloat =
            _root_.F2R (beta:=radix) fext := by
        dsimp [exactFloat, exactMantissa, _root_.F2R,
          FloatSpec.Core.Defs.F2R]
        rw [Int.cast_mul, Int.cast_pow, ← zpow_natCast]
        calc
          (fext.Fnum : ℝ) * (radix : ℝ) ^ (shift : Int) *
              (radix : ℝ) ^ (-b0.dExp) =
              (fext.Fnum : ℝ) *
                ((radix : ℝ) ^ (shift : Int) *
                  (radix : ℝ) ^ (-b0.dExp)) := by ring
          _ = (fext.Fnum : ℝ) *
                (radix : ℝ) ^ ((shift : Int) + (-b0.dExp)) := by
              rw [zpow_add₀ hradixNe]
          _ = (fext.Fnum : ℝ) * (radix : ℝ) ^ fext.Fexp := by
              rw [hshiftCast]
              congr 2
              ring
      by_cases hzInside :
          |_root_.F2R (beta:=radix) fext| < threshold
      · have hscalePos : 0 < (radix : ℝ) ^ (-b0.dExp) :=
          zpow_pos hradixPos _
        have hexactAbs :
            |_root_.F2R (beta:=radix) exactFloat| =
              |(exactMantissa : ℝ)| * (radix : ℝ) ^ (-b0.dExp) := by
          dsimp [exactFloat, _root_.F2R, FloatSpec.Core.Defs.F2R]
          rw [abs_mul, abs_of_pos hscalePos]
        have hexactMantissaRealLt :
            |(exactMantissa : ℝ)| < (mantissaThreshold : ℝ) := by
          rw [← hexactValue] at hzInside
          rw [hexactAbs, hthresholdScale] at hzInside
          exact lt_of_mul_lt_mul_right hzInside (le_of_lt hscalePos)
        have hexactMantissaIntLt :
            |exactMantissa| < mantissaThreshold := by
          exact_mod_cast (show
            ((|exactMantissa| : Int) : ℝ) < (mantissaThreshold : ℝ) by
              simpa [Int.cast_abs] using hexactMantissaRealLt)
        have hexactBound : Fbounded (beta:=radix) b0 exactFloat := by
          constructor
          · dsimp [exactFloat]
            exact lt_trans hexactMantissaIntLt hmantissaThresholdLt
          · simp [exactFloat]
        have hzeroError := hfClosest.2 exactFloat hexactBound
        rw [hexactValue, sub_self, abs_zero] at hzeroError
        exact le_trans hzeroError (abs_nonneg _)
      · have hthresholdLeAbs :
            threshold ≤ |_root_.F2R (beta:=radix) fext| :=
          le_of_not_gt hzInside
        by_cases hzNonneg : 0 ≤ _root_.F2R (beta:=radix) fext
        · have hthresholdLeZ :
              threshold ≤ _root_.F2R (beta:=radix) fext := by
            simpa [abs_of_nonneg hzNonneg] using hthresholdLeAbs
          have hgLtZ :
              _root_.F2R (beta:=radix) g <
                _root_.F2R (beta:=radix) fext :=
            lt_of_le_of_lt (le_abs_self _) (lt_of_lt_of_le
              hgMagnitudeLt hthresholdLeZ)
          have hgLtThreshold :
              _root_.F2R (beta:=radix) g < threshold :=
            lt_of_le_of_lt (le_abs_self _) hgMagnitudeLt
          have hupperErrorLe :
              |_root_.F2R (beta:=radix) upper -
                  _root_.F2R (beta:=radix) fext| ≤
                |_root_.F2R (beta:=radix) g -
                  _root_.F2R (beta:=radix) fext| := by
            rw [hupperValue, abs_of_nonpos (by linarith),
              abs_of_nonpos (by linarith)]
            linarith
          exact le_trans (hfClosest.2 upper hupperBound) hupperErrorLe
        · have hzNeg : _root_.F2R (beta:=radix) fext < 0 :=
            lt_of_not_ge hzNonneg
          have hzLeNegThreshold :
              _root_.F2R (beta:=radix) fext ≤ -threshold := by
            rw [abs_of_neg hzNeg] at hthresholdLeAbs
            linarith
          have hzLtG :
              _root_.F2R (beta:=radix) fext <
                _root_.F2R (beta:=radix) g := by
            have hnegAbsLeG :
                -|_root_.F2R (beta:=radix) g| ≤
                  _root_.F2R (beta:=radix) g := neg_abs_le _
            linarith
          have hlowerErrorLe :
              |_root_.F2R (beta:=radix) lower -
                  _root_.F2R (beta:=radix) fext| ≤
                |_root_.F2R (beta:=radix) g -
                  _root_.F2R (beta:=radix) fext| := by
            rw [hlowerValue, abs_of_nonneg (by linarith),
              abs_of_nonneg (by linarith)]
            have hnegThresholdLeG :
                -threshold ≤ _root_.F2R (beta:=radix) g := by
              have hnegAbsLeG :
                  -|_root_.F2R (beta:=radix) g| ≤
                    _root_.F2R (beta:=radix) g := neg_abs_le _
              linarith
            linarith
          exact le_trans (hfClosest.2 lower hlowerBound) hlowerErrorLe

/-! Coq nearest-even bound-restriction lemma `EvenClosestbplusb`.

When normalization under the original bound is normal, canonical uniqueness
transfers normalized parity from `plusExp`. In the subnormal case, the rounding
error is an integer multiple of the minimum radix unit, while `ClosestUlp`
bounds twice that error by one unit, forcing exactness and uniqueness. -/
theorem EvenClosestbplusb {beta : Int}
    (b0 : Fbound_skel) (radix : Int) (t n : Nat)
    (fext f : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b0.vNum = Zpower_nat radix n) (hn : 1 < n)
    (hfextExp : -b0.dExp ≤ fext.Fexp)
    (hEvenPlus : EvenClosest (beta:=beta) (plusExp b0 t) (radix : ℝ) n
      (_root_.F2R (beta:=beta) fext) f)
    (hfBound : Fbounded (beta:=beta) b0 f) :
    EvenClosest (beta:=beta) b0 (radix : ℝ) n
      (_root_.F2R (beta:=beta) fext) f := by
  subst beta
  have hnNe : n ≠ 0 := by omega
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hvNumPlus : (plusExp b0 t).vNum = Zpower_nat radix n := by
    simpa [plusExp] using hvNum
  have hClosest :
      Closest (beta:=radix) b0 (radix : ℝ)
        (_root_.F2R (beta:=radix) fext) f :=
    Closestbplusb b0 (radix : ℝ) t
      (_root_.F2R (beta:=radix) fext) f hEvenPlus.1 hfBound
  let nf : FloatSpec.Core.Defs.FlocqFloat radix :=
    Fnormalize (beta:=radix) radix b0 n f
  have hnfCan : Fcanonic (beta:=radix) radix b0 nf := by
    have h := FnormalizeCanonic (beta:=radix) radix b0 n f
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCanonic_check,
      Id.run, ULift.up_down, nf] using
      h ⟨hfBound, hfBound, hnNe, hradix, hvNum⟩
  have hnfValue :
      _root_.F2R (beta:=radix) nf = _root_.F2R (beta:=radix) f := by
    have h := FnormalizeCorrect (beta:=radix) radix b0 n f
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
      Id.run, ULift.up_down, nf] using h ⟨rfl, hradix⟩
  refine ⟨hClosest, ?_⟩
  rcases hnfCan with hnfNormal | hnfSubnormal
  · rcases hEvenPlus.2 with hEven | hUnique
    · left
      let nfPlus : FloatSpec.Core.Defs.FlocqFloat radix :=
        Fnormalize (beta:=radix) radix (plusExp b0 t) n f
      have hnfNormalPlus :
          Fnormal (beta:=radix) radix (plusExp b0 t) nf := by
        constructor
        · rcases hnfNormal.1 with ⟨hnum, hexp⟩
          constructor
          · simpa [plusExp] using hnum
          · dsimp [plusExp]
            have htNonneg : (0 : Int) ≤ ((t - 1 : Nat) : Int) :=
              Int.natCast_nonneg _
            omega
        · simpa [plusExp] using hnfNormal.2
      have hnfPlusCan :
          Fcanonic (beta:=radix) radix (plusExp b0 t) nfPlus := by
        have h := FnormalizeCanonic (beta:=radix) radix (plusExp b0 t) n f
        simpa only [wp, PostCond.noThrow, pure, FnormalizeCanonic_check,
          Id.run, ULift.up_down, nfPlus] using
          h ⟨hEvenPlus.1.1, hEvenPlus.1.1, hnNe, hradix, hvNumPlus⟩
      have hnfPlusValue :
          _root_.F2R (beta:=radix) nfPlus =
            _root_.F2R (beta:=radix) f := by
        have h := FnormalizeCorrect (beta:=radix) radix (plusExp b0 t) n f
        simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
          Id.run, ULift.up_down, nfPlus] using h ⟨rfl, hradix⟩
      have hnfEq : nfPlus = nf := by
        have h := FcanonicUnique (beta:=radix) radix (plusExp b0 t)
          nfPlus nf hradix rfl
        simpa only [wp, PostCond.noThrow, pure, FcanonicUnique_check,
          ULift.down_up, Fcanonic'] using
          h ⟨hnfPlusCan, Or.inl hnfNormalPlus,
            hnfPlusValue.trans hnfValue.symm⟩
      unfold FNeven at hEven ⊢
      simpa only [nfPlus, nf, hnfEq] using hEven
    · right
      intro q hq
      have hqPlus :
          Closest (beta:=radix) (plusExp b0 t) (radix : ℝ)
            (_root_.F2R (beta:=radix) fext) q :=
        Closestbbplus b0 radix t n fext q rfl hradix hvNum hn
          hfextExp hq
      exact hUnique q hqPlus
  · right
    intro q hq
    have hdeltaPos : 0 < (radix : ℝ) ^ (-b0.dExp) :=
      zpow_pos hradixPos _
    have herrorUlp :
        2 * |_root_.F2R (beta:=radix) fext -
            _root_.F2R (beta:=radix) f| ≤
          Fulp (beta:=radix) b0 radix n f := by
      have h := ClosestUlp (beta:=radix) b0 radix n
        (_root_.F2R (beta:=radix) fext) f
      simpa only [wp, PostCond.noThrow, pure, ClosestUlp_check,
        Id.run, ULift.up_down] using
        h ⟨hClosest, rfl, hradix, hnNe, hvNum⟩
    have herrorLe :
        2 * |_root_.F2R (beta:=radix) fext -
            _root_.F2R (beta:=radix) f| ≤
          (radix : ℝ) ^ (-b0.dExp) := by
      simpa [Fulp, nf, hnfSubnormal.2.1] using herrorUlp
    let shift : Nat := (fext.Fexp + b0.dExp).toNat
    have hshiftCast : (shift : Int) = fext.Fexp + b0.dExp := by
      dsimp [shift]
      rw [Int.toNat_of_nonneg]
      omega
    let exactMantissa : Int := fext.Fnum * radix ^ shift
    have hfextScale :
        _root_.F2R (beta:=radix) fext =
          (exactMantissa : ℝ) * (radix : ℝ) ^ (-b0.dExp) := by
      dsimp [exactMantissa, _root_.F2R, FloatSpec.Core.Defs.F2R]
      rw [Int.cast_mul, Int.cast_pow, ← zpow_natCast]
      calc
        (fext.Fnum : ℝ) * (radix : ℝ) ^ fext.Fexp =
            (fext.Fnum : ℝ) *
              (radix : ℝ) ^ ((shift : Int) + (-b0.dExp)) := by
          rw [hshiftCast]
          congr 2
          ring
        _ = (fext.Fnum : ℝ) *
              ((radix : ℝ) ^ (shift : Int) *
                (radix : ℝ) ^ (-b0.dExp)) := by
          rw [zpow_add₀ hradixNe]
        _ = ((fext.Fnum : ℝ) * (radix : ℝ) ^ (shift : Int)) *
              (radix : ℝ) ^ (-b0.dExp) := by ring
    have hfScale :
        _root_.F2R (beta:=radix) f =
          (nf.Fnum : ℝ) * (radix : ℝ) ^ (-b0.dExp) := by
      rw [← hnfValue]
      simp [_root_.F2R, FloatSpec.Core.Defs.F2R, hnfSubnormal.2.1]
    have herrorScale :
        |_root_.F2R (beta:=radix) fext -
            _root_.F2R (beta:=radix) f| =
          |((exactMantissa - nf.Fnum : Int) : ℝ)| *
            (radix : ℝ) ^ (-b0.dExp) := by
      rw [hfextScale, hfScale]
      have hfactor :
          (exactMantissa : ℝ) * (radix : ℝ) ^ (-b0.dExp) -
              (nf.Fnum : ℝ) * (radix : ℝ) ^ (-b0.dExp) =
            ((exactMantissa - nf.Fnum : Int) : ℝ) *
              (radix : ℝ) ^ (-b0.dExp) := by
        push_cast
        ring
      rw [hfactor, abs_mul, abs_of_pos hdeltaPos]
    have hdiffZero : exactMantissa - nf.Fnum = 0 := by
      by_contra hdiffNe
      have hdiffInt : (1 : Int) ≤ |exactMantissa - nf.Fnum| :=
        Int.one_le_abs hdiffNe
      have hdiffReal :
          (1 : ℝ) ≤ |((exactMantissa - nf.Fnum : Int) : ℝ)| := by
        exact_mod_cast (show
          (1 : Int) ≤ |exactMantissa - nf.Fnum| from hdiffInt)
      have hdeltaLeError :
          (radix : ℝ) ^ (-b0.dExp) ≤
            |_root_.F2R (beta:=radix) fext -
              _root_.F2R (beta:=radix) f| := by
        rw [herrorScale]
        simpa using mul_le_mul_of_nonneg_right hdiffReal
          (le_of_lt hdeltaPos)
      nlinarith
    have hfExact :
        _root_.F2R (beta:=radix) f =
          _root_.F2R (beta:=radix) fext := by
      rw [hfScale, hfextScale]
      have hmantissaEq : exactMantissa = nf.Fnum := by omega
      rw [hmantissaEq]
    have hqError := hq.2 f hfBound
    rw [hfExact, sub_self, abs_zero] at hqError
    have hqDiffZero :
        _root_.F2R (beta:=radix) q -
            _root_.F2R (beta:=radix) fext = 0 := by
      exact abs_eq_zero.mp
        (le_antisymm hqError (abs_nonneg _))
    linarith

private lemma FSucc_exp_le_add_one {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (x : FloatSpec.Core.Defs.FlocqFloat beta) :
    (FSucc (beta:=beta) b radix precision x).Fexp ≤ x.Fexp + 1 := by
  unfold FSucc
  split_ifs <;> simp <;> omega

/-! Coq closest-exponent separation lemma `ClosestClosest`.

After taking absolute values, normalize the lower-exponent result and place its
normalized successor strictly between the two closest values. That successor is
bounded, so one of the two original closestness inequalities is contradicted,
depending on which side of the successor contains the exact value. -/
theorem ClosestClosest {beta : Int}
    (b0 : Fbound_skel) (radix : Int) (n : Nat) (z : ℝ)
    (f1 f2 : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b0.vNum = Zpower_nat radix n) (hn : 1 < n)
    (hf1 : Closest (beta:=beta) b0 (radix : ℝ) z f1)
    (hf2 : Closest (beta:=beta) b0 (radix : ℝ) z f2)
    (hf2Normal : Fnormal (beta:=beta) radix b0 f2)
    (hExp : f1.Fexp ≤ f2.Fexp - 2) : False := by
  subst beta
  have hnNe : n ≠ 0 := by omega
  have hradixPosInt : (0 : Int) < radix := by omega
  have hvNumPos : 0 < b0.vNum := by
    rw [hvNum, Zpower_nat]
    exact pow_pos hradixPosInt _
  have hf1Abs :
      Closest (beta:=radix) b0 (radix : ℝ) |z| (Fabs f1) := by
    have h := ClosestFabs (beta:=radix) b0 (radix : ℝ) f1 z
    simpa only [wp, PostCond.noThrow, pure, ClosestFabs_check,
      Id.run, ULift.up_down] using h ⟨hradix, hf1⟩
  have hf2Abs :
      Closest (beta:=radix) b0 (radix : ℝ) |z| (Fabs f2) := by
    have h := ClosestFabs (beta:=radix) b0 (radix : ℝ) f2 z
    simpa only [wp, PostCond.noThrow, pure, ClosestFabs_check,
      Id.run, ULift.up_down] using h ⟨hradix, hf2⟩
  let nf1 : FloatSpec.Core.Defs.FlocqFloat radix :=
    Fnormalize (beta:=radix) radix b0 n (Fabs f1)
  let af2 : FloatSpec.Core.Defs.FlocqFloat radix := Fabs f2
  have hnf1Can : Fcanonic (beta:=radix) radix b0 nf1 := by
    have h := FnormalizeCanonic (beta:=radix) radix b0 n (Fabs f1)
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCanonic_check,
      Id.run, ULift.up_down, nf1] using
      h ⟨hf1Abs.1, hf1Abs.1, hnNe, hradix, hvNum⟩
  have hnf1Value :
      _root_.F2R (beta:=radix) nf1 =
        _root_.F2R (beta:=radix) (Fabs f1) := by
    have h := FnormalizeCorrect (beta:=radix) radix b0 n (Fabs f1)
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
      Id.run, ULift.up_down, nf1] using h ⟨rfl, hradix⟩
  have haf2Normal : Fnormal (beta:=radix) radix b0 af2 := by
    constructor
    · have h := absFBounded (beta:=radix) b0 f2
      simpa only [wp, PostCond.noThrow, pure, absFBounded_check,
        Id.run, ULift.up_down, af2] using h hf2Normal.1
    · simpa [af2, Fabs, FloatSpec.Calc.Operations.Fabs,
        Int.natCast_natAbs, abs_mul] using hf2Normal.2
  have haf2Can : Fcanonic (beta:=radix) radix b0 af2 :=
    Or.inl haf2Normal
  have hnf1Nonneg : 0 ≤ _root_.F2R (beta:=radix) nf1 := by
    rw [hnf1Value]
    have h := FloatSpec.Calc.Operations.F2R_abs (beta:=radix) f1 hradix
    rw [show _root_.F2R (beta:=radix) (Fabs f1) =
        |_root_.F2R (beta:=radix) f1| by simpa [Fabs, _root_.F2R] using h]
    exact abs_nonneg _
  have haf2Nonneg : 0 ≤ _root_.F2R (beta:=radix) af2 := by
    have h := FloatSpec.Calc.Operations.F2R_abs (beta:=radix) f2 hradix
    rw [show _root_.F2R (beta:=radix) af2 =
        |_root_.F2R (beta:=radix) f2| by
          simpa [af2, Fabs, _root_.F2R] using h]
    exact abs_nonneg _
  have hnf1ExpLe : nf1.Fexp ≤ (Fabs f1).Fexp := by
    have h := FcanonicLeastExp (beta:=radix) radix b0 (Fabs f1) nf1
      hradix rfl hvNumPos
    simpa only [wp, PostCond.noThrow, pure, FcanonicLeastExp_check,
      ULift.down_up, Fbounded', Fcanonic', nf1] using
      h ⟨hnf1Value.symm, hf1Abs.1, hnf1Can⟩
  have hnf1ExpGap : nf1.Fexp ≤ af2.Fexp - 2 := by
    have hfabs1Exp : (Fabs f1).Fexp = f1.Fexp := by
      simp [Fabs, FloatSpec.Calc.Operations.Fabs]
    have hfabs2Exp : af2.Fexp = f2.Fexp := by
      simp [af2, Fabs, FloatSpec.Calc.Operations.Fabs]
    rw [hfabs1Exp] at hnf1ExpLe
    rw [hfabs2Exp]
    omega
  let succ : FloatSpec.Core.Defs.FlocqFloat radix :=
    FNSucc (beta:=radix) b0 (radix : ℝ) n (Fabs f1)
  have hsuccCan : Fcanonic (beta:=radix) radix b0 succ := by
    have h := FNSuccCanonic (beta:=radix) b0 (radix : ℝ) n (Fabs f1)
    simpa only [wp, PostCond.noThrow, pure, FNSuccCanonic_check,
      Id.run, ULift.up_down, succ] using
      h ⟨hf1Abs.1, hradix, hnNe, hvNum⟩
  have hsuccBound : Fbounded (beta:=radix) b0 succ :=
    (FcanonicBound (beta:=radix) radix b0 succ) hsuccCan
  have hnf1LtSucc :
      _root_.F2R (beta:=radix) nf1 <
        _root_.F2R (beta:=radix) succ := by
    have h := FNSuccLt (beta:=radix) b0 (radix : ℝ) n (Fabs f1)
    have h' :
        _root_.F2R (beta:=radix) (Fabs f1) <
          _root_.F2R (beta:=radix) succ := by
      simpa only [wp, PostCond.noThrow, pure, FNSuccLt_check,
        Id.run, ULift.up_down, succ] using h ⟨hradix, hnNe, hvNum⟩
    simpa [hnf1Value] using h'
  have hsuccNonneg : 0 ≤ _root_.F2R (beta:=radix) succ :=
    le_trans hnf1Nonneg (le_of_lt hnf1LtSucc)
  have hsuccExpLe : succ.Fexp ≤ nf1.Fexp + 1 := by
    simpa [succ, FNSucc, nf1] using
      (FSucc_exp_le_add_one (beta:=radix) b0 radix n nf1)
  have hsuccExpLt : succ.Fexp < af2.Fexp := by omega
  have hsuccLtAf2 :
      _root_.F2R (beta:=radix) succ <
        _root_.F2R (beta:=radix) af2 := by
    have h := FcanonicPosFexpRlt (beta:=radix) radix b0 succ af2 hradix rfl
    simpa only [wp, PostCond.noThrow, pure, FcanonicPosFexpRlt_check,
      ULift.down_up, Fcanonic'] using
      h ⟨hsuccCan, haf2Can, hsuccNonneg, haf2Nonneg, hsuccExpLt⟩
  have hf1Dist := hf1Abs.2 succ hsuccBound
  have hf2Dist := hf2Abs.2 succ hsuccBound
  by_cases hzLe : |z| ≤ _root_.F2R (beta:=radix) succ
  · have hsuccDiffNonneg :
        0 ≤ _root_.F2R (beta:=radix) succ - |z| := by linarith
    have haf2DiffNonneg :
        0 ≤ _root_.F2R (beta:=radix) af2 - |z| := by linarith
    rw [abs_of_nonneg haf2DiffNonneg, abs_of_nonneg hsuccDiffNonneg] at hf2Dist
    exact (not_le_of_gt hsuccLtAf2) (by linarith)
  · have hzGt : _root_.F2R (beta:=radix) succ < |z| := lt_of_not_ge hzLe
    have hnf1DiffNonpos :
        _root_.F2R (beta:=radix) nf1 - |z| ≤ 0 := by linarith
    have hsuccDiffNonpos :
        _root_.F2R (beta:=radix) succ - |z| ≤ 0 := by linarith
    rw [← hnf1Value] at hf1Dist
    rw [abs_of_nonpos hnf1DiffNonpos, abs_of_nonpos hsuccDiffNonpos] at hf1Dist
    exact (not_le_of_gt hnf1LtSucc) (by linarith)

/-! Coq nearest-even bound-extension lemma `EvenClosestbbplus`.

Above the original minimum exponent, parity and uniqueness transfer to the
enlarged bound; a newly admitted lower-exponent competitor is excluded by
`ClosestClosest`. At the original minimum exponent, the exact input and rounded
result lie on the same minimum-unit lattice, so the closestness bound forces an
exact result and hence uniqueness under the enlarged bound. -/
theorem EvenClosestbbplus {beta : Int}
    (b0 : Fbound_skel) (radix : Int) (t n : Nat)
    (fext f : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b0.vNum = Zpower_nat radix n) (hn : 1 < n)
    (hfextExp : -b0.dExp ≤ fext.Fexp)
    (hEven0 : EvenClosest (beta:=beta) b0 (radix : ℝ) n
      (_root_.F2R (beta:=beta) fext) f) :
    EvenClosest (beta:=beta) (plusExp b0 t) (radix : ℝ) n
      (_root_.F2R (beta:=beta) fext) f := by
  subst beta
  have hnNe : n ≠ 0 := by omega
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixNe : (radix : ℝ) ≠ 0 := ne_of_gt hradixPos
  have hvNumPlus : (plusExp b0 t).vNum = Zpower_nat radix n := by
    simpa [plusExp] using hvNum
  have hClosest0 := hEven0.1
  have hClosestPlus :
      Closest (beta:=radix) (plusExp b0 t) (radix : ℝ)
        (_root_.F2R (beta:=radix) fext) f :=
    Closestbbplus b0 radix t n fext f rfl hradix hvNum hn
      hfextExp hClosest0
  let nf : FloatSpec.Core.Defs.FlocqFloat radix :=
    Fnormalize (beta:=radix) radix b0 n f
  have hnfBound0 : Fbounded (beta:=radix) b0 nf := by
    have h := FnormalizeBounded (beta:=radix) radix b0 n f
    simpa only [wp, PostCond.noThrow, pure, FnormalizeBounded_check,
      Id.run, ULift.up_down, Fbounded', nf] using
      h ⟨hClosest0.1, hClosest0.1, hnNe, hradix, hvNum⟩
  have hnfCan0 : Fcanonic (beta:=radix) radix b0 nf := by
    have h := FnormalizeCanonic (beta:=radix) radix b0 n f
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCanonic_check,
      Id.run, ULift.up_down, nf] using
      h ⟨hClosest0.1, hClosest0.1, hnNe, hradix, hvNum⟩
  have hnfValue :
      _root_.F2R (beta:=radix) nf = _root_.F2R (beta:=radix) f := by
    have h := FnormalizeCorrect (beta:=radix) radix b0 n f
    simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
      Id.run, ULift.up_down, nf] using h ⟨rfl, hradix⟩
  have hnfBoundPlus : Fbounded (beta:=radix) (plusExp b0 t) nf := by
    rcases hnfBound0 with ⟨hnum, hexp⟩
    constructor
    · simpa [plusExp] using hnum
    · dsimp [plusExp]
      have htNonneg : (0 : Int) ≤ ((t - 1 : Nat) : Int) :=
        Int.natCast_nonneg _
      omega
  have hnfClosestPlus :
      Closest (beta:=radix) (plusExp b0 t) (radix : ℝ)
        (_root_.F2R (beta:=radix) fext) nf := by
    constructor
    · exact hnfBoundPlus
    · intro g hg
      simpa [hnfValue] using hClosestPlus.2 g hg
  refine ⟨hClosestPlus, ?_⟩
  by_cases hnfAbove : -b0.dExp < nf.Fexp
  · have hnfNormal0 : Fnormal (beta:=radix) radix b0 nf := by
      rcases hnfCan0 with hnormal | hsubnormal
      · exact hnormal
      · exfalso
        have hnfAtMin := hsubnormal.2.1
        omega
    have hnfNormalPlus :
        Fnormal (beta:=radix) radix (plusExp b0 t) nf := by
      constructor
      · exact hnfBoundPlus
      · simpa [plusExp] using hnfNormal0.2
    rcases hEven0.2 with hEven | hUnique
    · left
      let nfPlus : FloatSpec.Core.Defs.FlocqFloat radix :=
        Fnormalize (beta:=radix) radix (plusExp b0 t) n f
      have hnfPlusCan :
          Fcanonic (beta:=radix) radix (plusExp b0 t) nfPlus := by
        have h := FnormalizeCanonic (beta:=radix) radix (plusExp b0 t) n f
        simpa only [wp, PostCond.noThrow, pure, FnormalizeCanonic_check,
          Id.run, ULift.up_down, nfPlus] using
          h ⟨hClosestPlus.1, hClosestPlus.1, hnNe, hradix, hvNumPlus⟩
      have hnfPlusValue :
          _root_.F2R (beta:=radix) nfPlus =
            _root_.F2R (beta:=radix) f := by
        have h := FnormalizeCorrect (beta:=radix) radix (plusExp b0 t) n f
        simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
          Id.run, ULift.up_down, nfPlus] using h ⟨rfl, hradix⟩
      have hnfEq : nfPlus = nf := by
        have h := FcanonicUnique (beta:=radix) radix (plusExp b0 t)
          nfPlus nf hradix rfl
        simpa only [wp, PostCond.noThrow, pure, FcanonicUnique_check,
          ULift.down_up, Fcanonic'] using
          h ⟨hnfPlusCan, Or.inl hnfNormalPlus,
            hnfPlusValue.trans hnfValue.symm⟩
      unfold FNeven at hEven ⊢
      simpa only [nfPlus, nf, hnfEq] using hEven
    · right
      intro q hqPlus
      by_cases hqExp : -b0.dExp ≤ q.Fexp
      · have hqBound0 : Fbounded (beta:=radix) b0 q := by
          exact ⟨by simpa [plusExp] using hqPlus.1.1, hqExp⟩
        have hq0 :
            Closest (beta:=radix) b0 (radix : ℝ)
              (_root_.F2R (beta:=radix) fext) q :=
          Closestbplusb b0 (radix : ℝ) t
            (_root_.F2R (beta:=radix) fext) q hqPlus hqBound0
        exact hUnique q hq0
      · have hqGap : q.Fexp ≤ nf.Fexp - 2 := by omega
        exact False.elim (ClosestClosest (beta:=radix)
          (plusExp b0 t) radix n
          (_root_.F2R (beta:=radix) fext) q nf rfl hradix
          hvNumPlus hn hqPlus hnfClosestPlus hnfNormalPlus hqGap)
  · have hnfExpEq : nf.Fexp = -b0.dExp := by
      have hnfExpBound := hnfBound0.2
      omega
    right
    intro q hqPlus
    have herrorUlp :
        2 * |_root_.F2R (beta:=radix) fext -
            _root_.F2R (beta:=radix) f| ≤
          Fulp (beta:=radix) b0 radix n f := by
      have h := ClosestUlp (beta:=radix) b0 radix n
        (_root_.F2R (beta:=radix) fext) f
      simpa only [wp, PostCond.noThrow, pure, ClosestUlp_check,
        Id.run, ULift.up_down] using
        h ⟨hClosest0, rfl, hradix, hnNe, hvNum⟩
    have herrorLe :
        2 * |_root_.F2R (beta:=radix) fext -
            _root_.F2R (beta:=radix) f| ≤
          (radix : ℝ) ^ (-b0.dExp) := by
      simpa [Fulp, nf, hnfExpEq] using herrorUlp
    let shift : Nat := (fext.Fexp + b0.dExp).toNat
    have hshiftCast : (shift : Int) = fext.Fexp + b0.dExp := by
      dsimp [shift]
      rw [Int.toNat_of_nonneg]
      omega
    let exactMantissa : Int := fext.Fnum * radix ^ shift
    have hfextScale :
        _root_.F2R (beta:=radix) fext =
          (exactMantissa : ℝ) * (radix : ℝ) ^ (-b0.dExp) := by
      dsimp [exactMantissa, _root_.F2R, FloatSpec.Core.Defs.F2R]
      rw [Int.cast_mul, Int.cast_pow, ← zpow_natCast]
      calc
        (fext.Fnum : ℝ) * (radix : ℝ) ^ fext.Fexp =
            (fext.Fnum : ℝ) *
              (radix : ℝ) ^ ((shift : Int) + (-b0.dExp)) := by
          rw [hshiftCast]
          congr 2
          ring
        _ = (fext.Fnum : ℝ) *
              ((radix : ℝ) ^ (shift : Int) *
                (radix : ℝ) ^ (-b0.dExp)) := by
          rw [zpow_add₀ hradixNe]
        _ = ((fext.Fnum : ℝ) * (radix : ℝ) ^ (shift : Int)) *
              (radix : ℝ) ^ (-b0.dExp) := by ring
    have hfScale :
        _root_.F2R (beta:=radix) f =
          (nf.Fnum : ℝ) * (radix : ℝ) ^ (-b0.dExp) := by
      rw [← hnfValue]
      simp [_root_.F2R, FloatSpec.Core.Defs.F2R, hnfExpEq]
    have hdeltaPos : 0 < (radix : ℝ) ^ (-b0.dExp) :=
      zpow_pos hradixPos _
    have herrorScale :
        |_root_.F2R (beta:=radix) fext -
            _root_.F2R (beta:=radix) f| =
          |((exactMantissa - nf.Fnum : Int) : ℝ)| *
            (radix : ℝ) ^ (-b0.dExp) := by
      rw [hfextScale, hfScale]
      have hfactor :
          (exactMantissa : ℝ) * (radix : ℝ) ^ (-b0.dExp) -
              (nf.Fnum : ℝ) * (radix : ℝ) ^ (-b0.dExp) =
            ((exactMantissa - nf.Fnum : Int) : ℝ) *
              (radix : ℝ) ^ (-b0.dExp) := by
        push_cast
        ring
      rw [hfactor, abs_mul, abs_of_pos hdeltaPos]
    have hdiffZero : exactMantissa - nf.Fnum = 0 := by
      by_contra hdiffNe
      have hdiffInt : (1 : Int) ≤ |exactMantissa - nf.Fnum| :=
        Int.one_le_abs hdiffNe
      have hdiffReal :
          (1 : ℝ) ≤ |((exactMantissa - nf.Fnum : Int) : ℝ)| := by
        exact_mod_cast (show
          (1 : Int) ≤ |exactMantissa - nf.Fnum| from hdiffInt)
      have hdeltaLeError :
          (radix : ℝ) ^ (-b0.dExp) ≤
            |_root_.F2R (beta:=radix) fext -
              _root_.F2R (beta:=radix) f| := by
        rw [herrorScale]
        simpa using mul_le_mul_of_nonneg_right hdiffReal
          (le_of_lt hdeltaPos)
      nlinarith
    have hfExact :
        _root_.F2R (beta:=radix) f =
          _root_.F2R (beta:=radix) fext := by
      rw [hfScale, hfextScale]
      have hmantissaEq : exactMantissa = nf.Fnum := by omega
      rw [hmantissaEq]
    have hqError := hqPlus.2 f hClosestPlus.1
    rw [hfExact, sub_self, abs_zero] at hqError
    have hqDiffZero :
        _root_.F2R (beta:=radix) q -
            _root_.F2R (beta:=radix) fext = 0 := by
      exact abs_eq_zero.mp
        (le_antisymm hqError (abs_nonneg _))
    linarith

private lemma Fplus_exp_eq_min {beta : Int}
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) :
    (Fplus (beta:=beta) x y).Fexp = min x.Fexp y.Fexp := by
  cases x with
  | mk xm xe =>
    cases y with
    | mk ym ye =>
      by_cases hle : xe ≤ ye
      · simp [Fplus, FloatSpec.Calc.Operations.Fplus,
          FloatSpec.Calc.Operations.Falign, hle, min_eq_left hle]
      · have hge : ye ≤ xe := le_of_lt (lt_of_not_ge hle)
        simp [Fplus, FloatSpec.Calc.Operations.Fplus,
          FloatSpec.Calc.Operations.Falign, hle, min_eq_right hge]

private lemma Fminus_exp_eq_min {beta : Int}
    (x y : FloatSpec.Core.Defs.FlocqFloat beta) :
    (Fminus (beta:=beta) x y).Fexp = min x.Fexp y.Fexp := by
  unfold Fminus FloatSpec.Calc.Operations.Fminus
  simpa [Fopp, FloatSpec.Calc.Operations.Fopp] using
    (Fplus_exp_eq_min x (Fopp (beta:=beta) y))

/-! Coq subnormal Veltkamp lemma `VeltkampS`.

Normalize a nonzero subnormal input under the enlarged exponent bound, apply
`VeltkampN`, and then move the reduced-bound closest witness back to the
original exponent range. The zero case is represented directly. -/
theorem VeltkampS {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxSub : Fsubnormal (beta:=beta) radix b x)
    (hpDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDef : Closest (beta:=beta) b (radix : ℝ)
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx) :
    |_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) hx| ≤
        (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2 ∧
      ∃ hx' : FloatSpec.Core.Defs.FlocqFloat beta,
        _root_.F2R (beta:=beta) hx' = _root_.F2R (beta:=beta) hx ∧
          Closest (beta:=beta) (Veltkamp_reducedBound radix b s t)
            (radix : ℝ) (_root_.F2R (beta:=beta) x) hx' := by
  subst beta
  have htGtOne : 1 < t := by omega
  have htNe : t ≠ 0 := by omega
  have hredPrecNe : t - s ≠ 0 := by omega
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hradixGeOne : (1 : ℝ) ≤ (radix : ℝ) := by
    exact_mod_cast (show (1 : Int) ≤ radix from le_of_lt hradix)
  have hvNumPos : 0 < b.vNum := by
    rw [hvNum, Zpower_nat]
    exact pow_pos hradixPosInt _
  let bRed : Fbound_skel := Veltkamp_reducedBound radix b s t
  let bPlus : Fbound_skel := plusExp b t
  let bRedPlus : Fbound_skel := Veltkamp_reducedBound radix bPlus s t
  have hvNumPlus : bPlus.vNum = Zpower_nat radix t := by
    simpa [bPlus, plusExp] using hvNum
  have hvNumRed : bRed.vNum = Zpower_nat radix (t - s) := by
    simp [bRed, Veltkamp_reducedBound]
  have hvNumRedPlus : bRedPlus.vNum = Zpower_nat radix (t - s) := by
    simp [bRedPlus, bPlus, Veltkamp_reducedBound]
  have hvNumRedPos : 0 < bRed.vNum := by
    rw [hvNumRed, Zpower_nat]
    exact pow_pos hradixPosInt _
  have hvNumRedPlusGt : 1 < bRedPlus.vNum := by
    rw [hvNumRedPlus, Zpower_nat]
    exact one_lt_pow₀ hradix hredPrecNe
  by_cases hxZero : _root_.F2R (beta:=radix) x = 0
  · let z0 : FloatSpec.Core.Defs.FlocqFloat radix := ⟨0, -b.dExp⟩
    have hz0Bound : Fbounded (beta:=radix) b z0 := by
      exact ⟨by simpa [z0] using hvNumPos, by simp [z0]⟩
    have hz0Value : _root_.F2R (beta:=radix) z0 = 0 := by
      simp [z0, _root_.F2R, FloatSpec.Core.Defs.F2R]
    have hpError := hpDef.2 z0 hz0Bound
    have hpZero : _root_.F2R (beta:=radix) p = 0 := by
      have hle : |_root_.F2R (beta:=radix) p| ≤ 0 := by
        simpa [hxZero, hz0Value] using hpError
      exact abs_eq_zero.mp (le_antisymm hle (abs_nonneg _))
    have hqError := hqDef.2 z0 hz0Bound
    have hqZero : _root_.F2R (beta:=radix) q = 0 := by
      have hle : |_root_.F2R (beta:=radix) q| ≤ 0 := by
        simpa [hxZero, hpZero, hz0Value] using hqError
      exact abs_eq_zero.mp (le_antisymm hle (abs_nonneg _))
    have hhxError := hhxDef.2 z0 hz0Bound
    have hhxZero : _root_.F2R (beta:=radix) hx = 0 := by
      have hle : |_root_.F2R (beta:=radix) hx| ≤ 0 := by
        simpa [hqZero, hpZero, hz0Value] using hhxError
      exact abs_eq_zero.mp (le_antisymm hle (abs_nonneg _))
    constructor
    · rw [hxZero, hhxZero, sub_self, abs_zero]
      positivity
    · let zRed : FloatSpec.Core.Defs.FlocqFloat radix := ⟨0, -bRed.dExp⟩
      have hzRedBound : Fbounded (beta:=radix) bRed zRed := by
        exact ⟨by simpa [zRed] using hvNumRedPos, by simp [zRed]⟩
      have hzRedValue : _root_.F2R (beta:=radix) zRed = 0 := by
        simp [zRed, _root_.F2R, FloatSpec.Core.Defs.F2R]
      refine ⟨zRed, ?_, ?_⟩
      · rw [hzRedValue, hhxZero]
      · constructor
        · exact hzRedBound
        · intro g hg
          simp [hzRedValue, hxZero]
  · rcases bimplybplusNorm (beta:=radix) b radix s t x rfl hradix
        hvNum hsGe hsLe hxSub.1 hxZero with
      ⟨xn, hxnValue, hxnNormal⟩
    have hxBoundPlus : Fbounded (beta:=radix) bPlus x := by
      rcases hxSub.1 with ⟨hnum, hexp⟩
      constructor
      · simpa [bPlus, plusExp] using hnum
      · dsimp [bPlus, plusExp]
        have htNonneg : (0 : Int) ≤ ((t - 1 : Nat) : Int) :=
          Int.natCast_nonneg _
        omega
    have hxnExpLe : xn.Fexp ≤ x.Fexp := by
      have h := FcanonicLeastExp (beta:=radix) radix bPlus x xn
        hradix rfl (by simpa [bPlus, plusExp] using hvNumPos)
      simpa only [wp, PostCond.noThrow, pure, FcanonicLeastExp_check,
        ULift.down_up, Fbounded', Fcanonic'] using
        h ⟨hxnValue.symm, hxBoundPlus, Or.inl hxnNormal⟩
    let xs : FloatSpec.Core.Defs.FlocqFloat radix :=
      ⟨x.Fnum, x.Fexp + (s : Int)⟩
    have hxsValue :
        _root_.F2R (beta:=radix) xs =
          _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (s : Int) := by
      simp only [xs, _root_.F2R, FloatSpec.Core.Defs.F2R,
        FloatSpec.Core.Defs.FlocqFloat.Fnum,
        FloatSpec.Core.Defs.FlocqFloat.Fexp]
      rw [zpow_add₀ (ne_of_gt hradixPos)]
      ring
    let pin : FloatSpec.Core.Defs.FlocqFloat radix := Fplus x xs
    have hpinValue :
        _root_.F2R (beta:=radix) pin =
          _root_.F2R (beta:=radix) x *
            ((radix : ℝ) ^ (s : Int) + 1) := by
      have h := Fplus_correct (beta:=radix) x xs
      have h' : _root_.F2R (beta:=radix) pin =
          _root_.F2R (beta:=radix) x +
            _root_.F2R (beta:=radix) xs := by
        simpa only [wp, PostCond.noThrow, pure, Fplus_correct_check,
          Id.run, ULift.up_down, pin] using h hradix
      rw [h', hxsValue]
      ring
    have hpinExp : -b.dExp ≤ pin.Fexp := by
      have hmin := Fplus_exp_eq_min x xs
      have hxLeXs : x.Fexp ≤ xs.Fexp := by simp [xs]
      rw [hmin, min_eq_left hxLeXs]
      exact hxSub.1.2
    have hpPin :
        Closest (beta:=radix) b (radix : ℝ)
          (_root_.F2R (beta:=radix) pin) p := by
      simpa [hpinValue] using hpDef
    have hpPlus :
        Closest (beta:=radix) bPlus (radix : ℝ)
          (_root_.F2R (beta:=radix) xn *
            ((radix : ℝ) ^ (s : Int) + 1)) p := by
      have h := Closestbbplus b radix t t pin p rfl hradix hvNum
        htGtOne hpinExp hpPin
      simpa [bPlus, hpinValue, hxnValue] using h
    let qin : FloatSpec.Core.Defs.FlocqFloat radix := Fminus x p
    have hqinValue :
        _root_.F2R (beta:=radix) qin =
          _root_.F2R (beta:=radix) x -
            _root_.F2R (beta:=radix) p := by
      have h := Fminus_correct (beta:=radix) x p
      simpa only [wp, PostCond.noThrow, pure, Fminus_correct_check,
        Id.run, ULift.up_down, qin] using h hradix
    have hqinExp : -b.dExp ≤ qin.Fexp := by
      have hmin := Fminus_exp_eq_min x p
      rw [hmin]
      exact le_min hxSub.1.2 hpDef.1.2
    have hqQin :
        Closest (beta:=radix) b (radix : ℝ)
          (_root_.F2R (beta:=radix) qin) q := by
      simpa [hqinValue] using hqDef
    have hqPlus :
        Closest (beta:=radix) bPlus (radix : ℝ)
          (_root_.F2R (beta:=radix) xn -
            _root_.F2R (beta:=radix) p) q := by
      have h := Closestbbplus b radix t t qin q rfl hradix hvNum
        htGtOne hqinExp hqQin
      simpa [bPlus, hqinValue, hxnValue] using h
    let hxin : FloatSpec.Core.Defs.FlocqFloat radix := Fplus q p
    have hhxinValue :
        _root_.F2R (beta:=radix) hxin =
          _root_.F2R (beta:=radix) q +
            _root_.F2R (beta:=radix) p := by
      have h := Fplus_correct (beta:=radix) q p
      simpa only [wp, PostCond.noThrow, pure, Fplus_correct_check,
        Id.run, ULift.up_down, hxin] using h hradix
    have hhxinExp : -b.dExp ≤ hxin.Fexp := by
      have hmin := Fplus_exp_eq_min q p
      rw [hmin]
      exact le_min hqDef.1.2 hpDef.1.2
    have hhxHxin :
        Closest (beta:=radix) b (radix : ℝ)
          (_root_.F2R (beta:=radix) hxin) hx := by
      simpa [hhxinValue] using hhxDef
    have hhxPlus :
        Closest (beta:=radix) bPlus (radix : ℝ)
          (_root_.F2R (beta:=radix) q +
            _root_.F2R (beta:=radix) p) hx := by
      have h := Closestbbplus b radix t t hxin hx rfl hradix hvNum
        htGtOne hhxinExp hhxHxin
      simpa [bPlus, hhxinValue] using h
    rcases VeltkampN (beta:=radix) bPlus radix s t xn p q hx
        rfl hradix hvNumPlus hsGe hsLe hxnNormal hpPlus hqPlus hhxPlus with
      ⟨hResidual, w, hwValue, hwClosest, hwExp⟩
    have hwClosestX :
        Closest (beta:=radix) bRedPlus (radix : ℝ)
          (_root_.F2R (beta:=radix) x) w := by
      simpa [bRedPlus, bPlus, hxnValue] using hwClosest
    constructor
    · calc
        |_root_.F2R (beta:=radix) x -
            _root_.F2R (beta:=radix) hx| =
            |_root_.F2R (beta:=radix) xn -
              _root_.F2R (beta:=radix) hx| := by rw [hxnValue]
        _ ≤ (radix : ℝ) ^ ((s : Int) + xn.Fexp) / 2 := hResidual
        _ ≤ (radix : ℝ) ^ ((s : Int) + x.Fexp) / 2 := by
          exact div_le_div_of_nonneg_right
            (zpow_le_zpow_right₀ hradixGeOne (by omega)) (by norm_num)
    · have hwClosestPlus :
          Closest (beta:=radix) (plusExp bRed t) (radix : ℝ)
            (_root_.F2R (beta:=radix) x) w := by
        simpa [bRed, bPlus, bRedPlus, Veltkamp_reducedBound, plusExp] using
          hwClosestX
      by_cases hwExpOld : -b.dExp ≤ w.Fexp
      · have hwBoundRed : Fbounded (beta:=radix) bRed w := by
          constructor
          · simpa [bRed, bPlus, bRedPlus, Veltkamp_reducedBound] using
              hwClosest.1.1
          · simpa [bRed, Veltkamp_reducedBound] using hwExpOld
        refine ⟨w, hwValue, ?_⟩
        exact Closestbplusb bRed (radix : ℝ) t
          (_root_.F2R (beta:=radix) x) w hwClosestPlus hwBoundRed
      · have hMinMax :
            MinOrMaxP_float (beta:=radix) bRedPlus radix
              (Closest (beta:=radix) bRedPlus (radix : ℝ)) := by
          have h := ClosestMinOrMax (beta:=radix) bRedPlus radix (radix : ℝ)
          simpa only [wp, PostCond.noThrow, pure, ClosestMinOrMax_check,
            Id.run, ULift.up_down] using h trivial
        have hRep : ∃ m : Int,
            _root_.F2R (beta:=radix) w =
              _root_.F2R (beta:=radix) ⟨m, x.Fexp⟩ := by
          rcases hMinMax (_root_.F2R (beta:=radix) x) w hwClosestX with
            hMin | hMax
          · have h := FminRep (beta:=radix) bRedPlus radix (t - s) x w
            simpa only [wp, PostCond.noThrow, pure, FminRep_check,
              Id.run, ULift.up_down] using
              h ⟨rfl, hradix, hredPrecNe, hvNumRedPlus, hMin⟩
          · have h := FmaxRep (beta:=radix) bRedPlus radix (t - s) x w
            simpa only [wp, PostCond.noThrow, pure, FmaxRep_check,
              Id.run, ULift.up_down] using
              h ⟨rfl, hradix, hredPrecNe, hvNumRedPlus, hMax⟩
        rcases hRep with ⟨m, hm⟩
        let g : FloatSpec.Core.Defs.FlocqFloat radix := ⟨m, x.Fexp⟩
        have hwExpLeG : w.Fexp ≤ g.Fexp := by
          dsimp [g]
          have hxAtMin := hxSub.2.1
          omega
        have hgBoundPlus : Fbounded (beta:=radix) bRedPlus g := by
          have h := FboundedEqExp (beta:=radix) bRedPlus w g
          simpa only [wp, PostCond.noThrow, pure, FboundedEqExp_check,
            Id.run, ULift.up_down] using
            h ⟨hradix, hwClosestX.1, by simpa [g] using hm, hwExpLeG⟩
        have hgBoundRed : Fbounded (beta:=radix) bRed g := by
          constructor
          · simpa [bRed, bRedPlus, bPlus, Veltkamp_reducedBound] using
              hgBoundPlus.1
          · dsimp [g, bRed, Veltkamp_reducedBound]
            rw [hxSub.2.1]
        have hgClosestPlusRed :
            Closest (beta:=radix) (plusExp bRed t) (radix : ℝ)
              (_root_.F2R (beta:=radix) x) g := by
          constructor
          · simpa [bRed, bRedPlus, bPlus, Veltkamp_reducedBound, plusExp] using
              hgBoundPlus
          · intro y hy
            have hy' : Fbounded (beta:=radix) bRedPlus y := by
              simpa [bRed, bRedPlus, bPlus, Veltkamp_reducedBound, plusExp] using
                hy
            have hdist := hwClosestX.2 y hy'
            simpa [g, hm] using hdist
        refine ⟨g, ?_, ?_⟩
        · have hgValueW :
              _root_.F2R (beta:=radix) g =
                _root_.F2R (beta:=radix) w := by
              simpa [g] using hm.symm
          exact hgValueW.trans hwValue
        · exact Closestbplusb bRed (radix : ℝ) t
            (_root_.F2R (beta:=radix) x) g hgClosestPlusRed hgBoundRed

/-! Coq subnormal nearest-even Veltkamp lemma `VeltkampEvenS`.

Normalize a nonzero subnormal input under the enlarged exponent bound, apply
`VeltkampEvenN`, and transfer its nearest-even reduced-bound witness back to
the original exponent range. The zero case uses a normalized-even zero
representative directly. -/
theorem VeltkampEvenS {beta : Int}
    (b : Fbound_skel) (radix : Int) (s t : Nat)
    (x p q hx : FloatSpec.Core.Defs.FlocqFloat beta)
    (hbeta : beta = radix) (hradix : 1 < radix)
    (hvNum : b.vNum = Zpower_nat radix t)
    (hsGe : 2 ≤ s) (hsLe : s ≤ t - 2)
    (hxSub : Fsubnormal (beta:=beta) radix b x)
    (hpDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) x * ((radix : ℝ) ^ (s : Int) + 1)) p)
    (hqDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) x - _root_.F2R (beta:=beta) p) q)
    (hhxDefEven : EvenClosest (beta:=beta) b (radix : ℝ) t
      (_root_.F2R (beta:=beta) q + _root_.F2R (beta:=beta) p) hx) :
    ∃ hx' : FloatSpec.Core.Defs.FlocqFloat beta,
      _root_.F2R (beta:=beta) hx' = _root_.F2R (beta:=beta) hx ∧
        EvenClosest (beta:=beta) (Veltkamp_reducedBound radix b s t)
          (radix : ℝ) (t - s) (_root_.F2R (beta:=beta) x) hx' := by
  subst beta
  have htGtOne : 1 < t := by omega
  have hredPrecNe : t - s ≠ 0 := by omega
  have hredPrecGtOne : 1 < t - s := by omega
  have hradixPosInt : (0 : Int) < radix := by omega
  have hradixPos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast hradixPosInt
  have hvNumPos : 0 < b.vNum := by
    rw [hvNum, Zpower_nat]
    exact pow_pos hradixPosInt _
  let bRed : Fbound_skel := Veltkamp_reducedBound radix b s t
  let bPlus : Fbound_skel := plusExp b t
  let bRedPlus : Fbound_skel := Veltkamp_reducedBound radix bPlus s t
  have hvNumPlus : bPlus.vNum = Zpower_nat radix t := by
    simpa [bPlus, plusExp] using hvNum
  have hvNumRed : bRed.vNum = Zpower_nat radix (t - s) := by
    simp [bRed, Veltkamp_reducedBound]
  have hvNumRedPlus : bRedPlus.vNum = Zpower_nat radix (t - s) := by
    simp [bRedPlus, bPlus, Veltkamp_reducedBound]
  have hvNumRedPos : 0 < bRed.vNum := by
    rw [hvNumRed, Zpower_nat]
    exact pow_pos hradixPosInt _
  have hxExpRed : -bRed.dExp ≤ x.Fexp := by
    simpa [bRed, Veltkamp_reducedBound] using hxSub.1.2
  by_cases hxZero : _root_.F2R (beta:=radix) x = 0
  · let z0 : FloatSpec.Core.Defs.FlocqFloat radix := ⟨0, -b.dExp⟩
    have hz0Bound : Fbounded (beta:=radix) b z0 := by
      exact ⟨by simpa [z0] using hvNumPos, by simp [z0]⟩
    have hz0Value : _root_.F2R (beta:=radix) z0 = 0 := by
      simp [z0, _root_.F2R, FloatSpec.Core.Defs.F2R]
    have hpError := hpDefEven.1.2 z0 hz0Bound
    have hpZero : _root_.F2R (beta:=radix) p = 0 := by
      have hle : |_root_.F2R (beta:=radix) p| ≤ 0 := by
        simpa [hxZero, hz0Value] using hpError
      exact abs_eq_zero.mp (le_antisymm hle (abs_nonneg _))
    have hqError := hqDefEven.1.2 z0 hz0Bound
    have hqZero : _root_.F2R (beta:=radix) q = 0 := by
      have hle : |_root_.F2R (beta:=radix) q| ≤ 0 := by
        simpa [hxZero, hpZero, hz0Value] using hqError
      exact abs_eq_zero.mp (le_antisymm hle (abs_nonneg _))
    have hhxError := hhxDefEven.1.2 z0 hz0Bound
    have hhxZero : _root_.F2R (beta:=radix) hx = 0 := by
      have hle : |_root_.F2R (beta:=radix) hx| ≤ 0 := by
        simpa [hqZero, hpZero, hz0Value] using hhxError
      exact abs_eq_zero.mp (le_antisymm hle (abs_nonneg _))
    let zRed : FloatSpec.Core.Defs.FlocqFloat radix := ⟨0, -bRed.dExp⟩
    have hzRedBound : Fbounded (beta:=radix) bRed zRed := by
      exact ⟨by simpa [zRed] using hvNumRedPos, by simp [zRed]⟩
    have hzRedValue : _root_.F2R (beta:=radix) zRed = 0 := by
      simp [zRed, _root_.F2R, FloatSpec.Core.Defs.F2R]
    have hzRedClosest :
        Closest (beta:=radix) bRed (radix : ℝ)
          (_root_.F2R (beta:=radix) x) zRed := by
      constructor
      · exact hzRedBound
      · intro g hg
        simp [hzRedValue, hxZero]
    have hzRedEven :
        FNeven (beta:=radix) bRed (radix : ℝ) (t - s) zRed := by
      have h := FnormalizeCorrect (beta:=radix) radix bRed (t - s) zRed
      have hnormValue :
          _root_.F2R (beta:=radix)
              (Fnormalize (beta:=radix) radix bRed (t - s) zRed) =
            _root_.F2R (beta:=radix) zRed := by
        simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
          Id.run, ULift.up_down] using h ⟨rfl, hradix⟩
      exact FNeven_of_Fnormalize_F2R_zero bRed (radix : ℝ) (t - s) zRed
        hradixPosInt (by simpa [hzRedValue] using hnormValue)
    exact ⟨zRed, by simpa [hzRedValue] using hhxZero.symm,
      hzRedClosest, Or.inl hzRedEven⟩
  · rcases bimplybplusNorm (beta:=radix) b radix s t x rfl hradix
        hvNum hsGe hsLe hxSub.1 hxZero with
      ⟨xn, hxnValue, hxnNormal⟩
    let xs : FloatSpec.Core.Defs.FlocqFloat radix :=
      ⟨x.Fnum, x.Fexp + (s : Int)⟩
    have hxsValue :
        _root_.F2R (beta:=radix) xs =
          _root_.F2R (beta:=radix) x * (radix : ℝ) ^ (s : Int) := by
      simp only [xs, _root_.F2R, FloatSpec.Core.Defs.F2R]
      rw [zpow_add₀ (ne_of_gt hradixPos)]
      ring
    let pin : FloatSpec.Core.Defs.FlocqFloat radix := Fplus x xs
    have hpinValue :
        _root_.F2R (beta:=radix) pin =
          _root_.F2R (beta:=radix) x *
            ((radix : ℝ) ^ (s : Int) + 1) := by
      have h := Fplus_correct (beta:=radix) x xs
      have h' : _root_.F2R (beta:=radix) pin =
          _root_.F2R (beta:=radix) x +
            _root_.F2R (beta:=radix) xs := by
        simpa only [wp, PostCond.noThrow, pure, Fplus_correct_check,
          Id.run, ULift.up_down, pin] using h hradix
      rw [h', hxsValue]
      ring
    have hpinExp : -b.dExp ≤ pin.Fexp := by
      have hmin := Fplus_exp_eq_min x xs
      have hxLeXs : x.Fexp ≤ xs.Fexp := by simp [xs]
      rw [hmin, min_eq_left hxLeXs]
      exact hxSub.1.2
    have hpPin :
        EvenClosest (beta:=radix) b (radix : ℝ) t
          (_root_.F2R (beta:=radix) pin) p := by
      simpa [hpinValue] using hpDefEven
    have hpPlus :
        EvenClosest (beta:=radix) bPlus (radix : ℝ) t
          (_root_.F2R (beta:=radix) xn *
            ((radix : ℝ) ^ (s : Int) + 1)) p := by
      have h := EvenClosestbbplus b radix t t pin p rfl hradix hvNum
        htGtOne hpinExp hpPin
      simpa [bPlus, hpinValue, hxnValue] using h
    let qin : FloatSpec.Core.Defs.FlocqFloat radix := Fminus x p
    have hqinValue :
        _root_.F2R (beta:=radix) qin =
          _root_.F2R (beta:=radix) x -
            _root_.F2R (beta:=radix) p := by
      have h := Fminus_correct (beta:=radix) x p
      simpa only [wp, PostCond.noThrow, pure, Fminus_correct_check,
        Id.run, ULift.up_down, qin] using h hradix
    have hqinExp : -b.dExp ≤ qin.Fexp := by
      have hmin := Fminus_exp_eq_min x p
      rw [hmin]
      exact le_min hxSub.1.2 hpDefEven.1.1.2
    have hqQin :
        EvenClosest (beta:=radix) b (radix : ℝ) t
          (_root_.F2R (beta:=radix) qin) q := by
      simpa [hqinValue] using hqDefEven
    have hqPlus :
        EvenClosest (beta:=radix) bPlus (radix : ℝ) t
          (_root_.F2R (beta:=radix) xn -
            _root_.F2R (beta:=radix) p) q := by
      have h := EvenClosestbbplus b radix t t qin q rfl hradix hvNum
        htGtOne hqinExp hqQin
      simpa [bPlus, hqinValue, hxnValue] using h
    let hxin : FloatSpec.Core.Defs.FlocqFloat radix := Fplus q p
    have hhxinValue :
        _root_.F2R (beta:=radix) hxin =
          _root_.F2R (beta:=radix) q +
            _root_.F2R (beta:=radix) p := by
      have h := Fplus_correct (beta:=radix) q p
      simpa only [wp, PostCond.noThrow, pure, Fplus_correct_check,
        Id.run, ULift.up_down, hxin] using h hradix
    have hhxinExp : -b.dExp ≤ hxin.Fexp := by
      have hmin := Fplus_exp_eq_min q p
      rw [hmin]
      exact le_min hqDefEven.1.1.2 hpDefEven.1.1.2
    have hhxHxin :
        EvenClosest (beta:=radix) b (radix : ℝ) t
          (_root_.F2R (beta:=radix) hxin) hx := by
      simpa [hhxinValue] using hhxDefEven
    have hhxPlus :
        EvenClosest (beta:=radix) bPlus (radix : ℝ) t
          (_root_.F2R (beta:=radix) q +
            _root_.F2R (beta:=radix) p) hx := by
      have h := EvenClosestbbplus b radix t t hxin hx rfl hradix hvNum
        htGtOne hhxinExp hhxHxin
      simpa [bPlus, hhxinValue] using h
    rcases VeltkampEvenN (beta:=radix) bPlus radix s t xn p q hx
        rfl hradix hvNumPlus hsGe hsLe hxnNormal hpPlus hqPlus hhxPlus with
      ⟨w, hwValue, hwEven⟩
    have hwEvenX :
        EvenClosest (beta:=radix) bRedPlus (radix : ℝ) (t - s)
          (_root_.F2R (beta:=radix) x) w := by
      simpa [bRedPlus, bPlus, hxnValue] using hwEven
    have hwEvenPlusRed :
        EvenClosest (beta:=radix) (plusExp bRed t) (radix : ℝ) (t - s)
          (_root_.F2R (beta:=radix) x) w := by
      simpa [bRed, bPlus, bRedPlus, Veltkamp_reducedBound, plusExp] using
        hwEvenX
    by_cases hwExpOld : -b.dExp ≤ w.Fexp
    · have hwBoundRed : Fbounded (beta:=radix) bRed w := by
        constructor
        · simpa [bRed, bPlus, bRedPlus, Veltkamp_reducedBound] using
            hwEven.1.1.1
        · simpa [bRed, Veltkamp_reducedBound] using hwExpOld
      refine ⟨w, hwValue, ?_⟩
      exact EvenClosestbplusb bRed radix t (t - s) x w rfl hradix
        hvNumRed hredPrecGtOne hxExpRed hwEvenPlusRed hwBoundRed
    · have hMinMax :
          MinOrMaxP_float (beta:=radix) bRedPlus radix
            (EvenClosest (beta:=radix) bRedPlus (radix : ℝ) (t - s)) := by
        have h := EvenClosestMinOrMax (beta:=radix) bRedPlus radix
          (radix : ℝ) (t - s)
        simpa only [wp, PostCond.noThrow, pure, EvenClosestMinOrMax_check,
          Id.run, ULift.up_down] using h trivial
      have hRep : ∃ m : Int,
          _root_.F2R (beta:=radix) w =
            _root_.F2R (beta:=radix) ⟨m, x.Fexp⟩ := by
        rcases hMinMax (_root_.F2R (beta:=radix) x) w hwEvenX with
          hMin | hMax
        · have h := FminRep (beta:=radix) bRedPlus radix (t - s) x w
          simpa only [wp, PostCond.noThrow, pure, FminRep_check,
            Id.run, ULift.up_down] using
            h ⟨rfl, hradix, hredPrecNe, hvNumRedPlus, hMin⟩
        · have h := FmaxRep (beta:=radix) bRedPlus radix (t - s) x w
          simpa only [wp, PostCond.noThrow, pure, FmaxRep_check,
            Id.run, ULift.up_down] using
            h ⟨rfl, hradix, hredPrecNe, hvNumRedPlus, hMax⟩
      rcases hRep with ⟨m, hm⟩
      let g : FloatSpec.Core.Defs.FlocqFloat radix := ⟨m, x.Fexp⟩
      have hwValueG :
          _root_.F2R (beta:=radix) w =
            _root_.F2R (beta:=radix) g := by
        simpa [g] using hm
      have hwExpLeG : w.Fexp ≤ g.Fexp := by
        dsimp [g]
        have hxAtMin := hxSub.2.1
        omega
      have hgBoundPlus : Fbounded (beta:=radix) bRedPlus g := by
        have h := FboundedEqExp (beta:=radix) bRedPlus w g
        simpa only [wp, PostCond.noThrow, pure, FboundedEqExp_check,
          Id.run, ULift.up_down] using
          h ⟨hradix, hwEvenX.1.1, hwValueG, hwExpLeG⟩
      have hgBoundRed : Fbounded (beta:=radix) bRed g := by
        constructor
        · simpa [bRed, bRedPlus, bPlus, Veltkamp_reducedBound] using
            hgBoundPlus.1
        · dsimp [g, bRed, Veltkamp_reducedBound]
          rw [hxSub.2.1]
      have hgClosestPlus :
          Closest (beta:=radix) bRedPlus (radix : ℝ)
            (_root_.F2R (beta:=radix) x) g := by
        constructor
        · exact hgBoundPlus
        · intro y hy
          have hdist := hwEvenX.1.2 y hy
          simpa [hwValueG] using hdist
      have hgEvenPlus :
          EvenClosest (beta:=radix) bRedPlus (radix : ℝ) (t - s)
            (_root_.F2R (beta:=radix) x) g := by
        refine ⟨hgClosestPlus, ?_⟩
        rcases hwEvenX.2 with hwParity | hwUnique
        · left
          let nw : FloatSpec.Core.Defs.FlocqFloat radix :=
            Fnormalize (beta:=radix) radix bRedPlus (t - s) w
          let ng : FloatSpec.Core.Defs.FlocqFloat radix :=
            Fnormalize (beta:=radix) radix bRedPlus (t - s) g
          have hnwCan : Fcanonic (beta:=radix) radix bRedPlus nw := by
            have h := FnormalizeCanonic (beta:=radix) radix bRedPlus
              (t - s) w
            simpa only [wp, PostCond.noThrow, pure, FnormalizeCanonic_check,
              Id.run, ULift.up_down, nw] using
              h ⟨hwEvenX.1.1, hwEvenX.1.1, hredPrecNe, hradix, hvNumRedPlus⟩
          have hngCan : Fcanonic (beta:=radix) radix bRedPlus ng := by
            have h := FnormalizeCanonic (beta:=radix) radix bRedPlus
              (t - s) g
            simpa only [wp, PostCond.noThrow, pure, FnormalizeCanonic_check,
              Id.run, ULift.up_down, ng] using
              h ⟨hgBoundPlus, hgBoundPlus, hredPrecNe, hradix, hvNumRedPlus⟩
          have hnwValue :
              _root_.F2R (beta:=radix) nw =
                _root_.F2R (beta:=radix) w := by
            have h := FnormalizeCorrect (beta:=radix) radix bRedPlus
              (t - s) w
            simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
              Id.run, ULift.up_down, nw] using h ⟨rfl, hradix⟩
          have hngValue :
              _root_.F2R (beta:=radix) ng =
                _root_.F2R (beta:=radix) g := by
            have h := FnormalizeCorrect (beta:=radix) radix bRedPlus
              (t - s) g
            simpa only [wp, PostCond.noThrow, pure, FnormalizeCorrect_check,
              Id.run, ULift.up_down, ng] using h ⟨rfl, hradix⟩
          have hnEq : nw = ng := by
            have h := FcanonicUnique (beta:=radix) radix bRedPlus nw ng
              hradix rfl
            simpa only [wp, PostCond.noThrow, pure, FcanonicUnique_check,
              ULift.down_up, Fcanonic'] using
              h ⟨hnwCan, hngCan,
                hnwValue.trans (hwValueG.trans hngValue.symm)⟩
          unfold FNeven at hwParity ⊢
          simpa only [nw, ng, hnEq] using hwParity
        · right
          intro y hy
          exact (hwUnique y hy).trans hwValueG
      have hgEvenPlusRed :
          EvenClosest (beta:=radix) (plusExp bRed t) (radix : ℝ) (t - s)
            (_root_.F2R (beta:=radix) x) g := by
        simpa [bRed, bPlus, bRedPlus, Veltkamp_reducedBound, plusExp] using
          hgEvenPlus
      refine ⟨g, ?_, ?_⟩
      · exact hwValueG.symm.trans hwValue
      · exact EvenClosestbplusb bRed radix t (t - s) x g rfl hradix
          hvNumRed hredPrecGtOne hxExpRed hgEvenPlusRed hgBoundRed

noncomputable def ClosestRoundeGeNormal_check {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (z : ℝ) (f : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `ClosestRoundeGeNormal`.

A closest rounded normal float bounds the exact real input by the usual
`1 + radix^(1 - precision) / 2` relative factor. -/
theorem ClosestRoundeGeNormal {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (z : ℝ) (f : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ 3 ≤ precision ∧
        b.vNum = Zpower_nat radix precision ∧
        Closest (beta:=beta) b (radix : ℝ) z f ∧
        Fnormal (beta:=beta) radix b f⌝⦄
    (pure (ClosestRoundeGeNormal_check (beta:=beta) b radix precision z f) :
      Id Unit)
    ⦃⇓_ => ⌜|z| ≤ |_root_.F2R (beta:=beta) f| *
        (1 + (radix : ℝ) ^ (1 - (precision : Int)) / 2)⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix, hprecision, hvNum, hClosest, hnormal⟩
  simp only [wp, PostCond.noThrow, pure, ClosestRoundeGeNormal_check,
    Id.run, ULift.up_down]
  have hprecision_ne : precision ≠ 0 := by omega
  exact RleRRounded (beta:=beta) b radix precision f z hbeta hradix
    hprecision_ne hvNum hnormal hClosest

noncomputable def ClosestRoundeLeNormal_check {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (z : ℝ) (f : FloatSpec.Core.Defs.FlocqFloat beta) : Unit :=
  ()

/-- Coq: `ClosestRoundeLeNormal`.

A closest rounded normal float is bounded by the exact input divided by
`1 - radix^(1 - precision) / 2`. -/
theorem ClosestRoundeLeNormal {beta : Int}
    (b : Fbound_skel) (radix : Int) (precision : Nat)
    (z : ℝ) (f : FloatSpec.Core.Defs.FlocqFloat beta) :
    ⦃⌜beta = radix ∧ 1 < radix ∧ 3 ≤ precision ∧
        b.vNum = Zpower_nat radix precision ∧
        Closest (beta:=beta) b (radix : ℝ) z f ∧
        Fnormal (beta:=beta) radix b f⌝⦄
    (pure (ClosestRoundeLeNormal_check (beta:=beta) b radix precision z f) :
      Id Unit)
    ⦃⇓_ => ⌜|_root_.F2R (beta:=beta) f| ≤
        |z| / (1 - (radix : ℝ) ^ (1 - (precision : Int)) / 2)⌝⦄ := by
  intro h
  rcases h with ⟨hbeta, hradix, hprecision, hvNum, hClosest, hnormal⟩
  simp only [wp, PostCond.noThrow, pure, ClosestRoundeLeNormal_check,
    Id.run, ULift.up_down]
  let F : ℝ := _root_.F2R (beta:=beta) f
  let eps : ℝ := (radix : ℝ) ^ (1 - (precision : Int))
  have hprecision_ne : precision ≠ 0 := by omega
  have hNormEq :
      Fnormalize (beta:=beta) radix b precision f = f := by
    have h := FcanonicFnormalizeEq (beta:=beta) radix b precision f
    simpa only [wp, PostCond.noThrow, pure, FcanonicFnormalizeEq_check,
      Id.run, ULift.up_down] using
      h ⟨Or.inl hnormal, hbeta, hradix, hprecision_ne, hvNum⟩
  have hNormalNorm :
      Fnormal (beta:=beta) radix b
        (Fnormalize (beta:=beta) radix b precision f) := by
    simpa [hNormEq] using hnormal
  have hdist :
      |z - F| ≤ |F| * ((1 / 2 : ℝ) * eps) := by
    have h := ClosestErrorBoundNormal (beta:=beta) b radix precision f z
    simpa only [wp, PostCond.noThrow, pure, ClosestErrorBoundNormal_check,
      Id.run, ULift.up_down, F, eps] using
      h ⟨hbeta, hradix, hprecision_ne, hvNum, hnormal.1, hNormalNorm, hClosest⟩
  have htri : |F| ≤ |z| + |z - F| := by
    calc
      |F| = |z + (F - z)| := by ring_nf
      _ ≤ |z| + |F - z| := abs_add_le _ _
      _ = |z| + |z - F| := by rw [abs_sub_comm]
  have hden_pos : 0 < 1 - eps / 2 := by
    have hradix_pos : (0 : ℝ) < (radix : ℝ) := by
      exact_mod_cast (lt_trans Int.zero_lt_one hradix)
    have hradix_one_le : (1 : ℝ) ≤ (radix : ℝ) := by
      exact_mod_cast (le_of_lt hradix)
    have hpow_le_one : eps ≤ 1 := by
      dsimp [eps]
      exact zpow_le_one_of_nonpos₀ hradix_one_le (by omega)
    have hpow_pos : 0 < eps := by
      dsimp [eps]
      exact zpow_pos hradix_pos _
    linarith
  have hmul : |F| * (1 - eps / 2) ≤ |z| := by
    nlinarith
  have hresult : |F| ≤ |z| / (1 - eps / 2) :=
    (le_div_iff₀ hden_pos).2 hmul
  simpa [F, eps] using hresult

/-- Coq generic Dekker local lemma `x2y2Le`.

If both low parts are bounded by half of their radix-scaled magnitudes, their
product is bounded by one quarter of the combined scale. -/
theorem x2y2Le (radix : Int) (s : Nat) (ex ey : Int) (x2 y2 : ℝ)
    (hradix : 1 < radix)
    (hx2Le : |x2| ≤ (radix : ℝ) ^ ((s : Int) + ex) / 2)
    (hy2Le : |y2| ≤ (radix : ℝ) ^ ((s : Int) + ey) / 2) :
    |x2 * y2| ≤
      (radix : ℝ) ^ (2 * (s : Int) + ex + ey) / 4 := by
  have hradix_pos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast (lt_trans Int.zero_lt_one hradix)
  have hradix_ne : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos
  have hx_bound_nonneg :
      0 ≤ (radix : ℝ) ^ ((s : Int) + ex) / 2 := by
    positivity
  have hmul_bound :
      |x2| * |y2| ≤
        ((radix : ℝ) ^ ((s : Int) + ex) / 2) *
          ((radix : ℝ) ^ ((s : Int) + ey) / 2) := by
    exact mul_le_mul hx2Le hy2Le (abs_nonneg y2) hx_bound_nonneg
  have hpow_mul :
      (radix : ℝ) ^ ((s : Int) + ex) *
          (radix : ℝ) ^ ((s : Int) + ey) =
        (radix : ℝ) ^ (2 * (s : Int) + ex + ey) := by
    rw [← zpow_add₀ hradix_ne]
    congr 1
    ring
  calc
    |x2 * y2| = |x2| * |y2| := abs_mul x2 y2
    _ ≤ ((radix : ℝ) ^ ((s : Int) + ex) / 2) *
          ((radix : ℝ) ^ ((s : Int) + ey) / 2) := hmul_bound
    _ = ((radix : ℝ) ^ ((s : Int) + ex) *
          (radix : ℝ) ^ ((s : Int) + ey)) / 4 := by ring
    _ = (radix : ℝ) ^ (2 * (s : Int) + ex + ey) / 4 := by rw [hpow_mul]

/-- Coq generic Dekker local lemma `x2y1Le`.

This is the real-inequality core of the Flocq local proof.  The magnitude
bound on `y` is the premise Flocq derives from `Fnormal`. -/
theorem x2y1Le (radix : Int) (s t : Nat) (ex ey : Int) (x2 y y1 y2 : ℝ)
    (hradix : 1 < radix)
    (hyEq : y = y1 + y2)
    (hx2Le : |x2| ≤ (radix : ℝ) ^ ((s : Int) + ex) / 2)
    (hyAbs : |y| < (radix : ℝ) ^ ((t : Int) + ey))
    (hx2y2Le :
      |x2 * y2| ≤ (radix : ℝ) ^ (2 * (s : Int) + ex + ey) / 4) :
    |x2 * y1| <
      (radix : ℝ) ^ ((t : Int) + (s : Int) + ex + ey) / 2 +
        (radix : ℝ) ^ (2 * (s : Int) + ex + ey) / 4 := by
  have hradix_pos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast (lt_trans Int.zero_lt_one hradix)
  have hradix_ne : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos
  have hrewrite : x2 * y1 = x2 * y + -(x2 * y2) := by
    rw [hyEq]
    ring
  have htri :
      |x2 * y1| ≤ |x2 * y| + |x2 * y2| := by
    rw [hrewrite]
    simpa [abs_neg] using abs_add_le (x2 * y) (-(x2 * y2))
  have hx_bound_pos :
      0 < (radix : ℝ) ^ ((s : Int) + ex) / 2 := by
    have hpow : 0 < (radix : ℝ) ^ ((s : Int) + ex) := zpow_pos hradix_pos _
    linarith
  have hxy :
      |x2 * y| <
        ((radix : ℝ) ^ ((s : Int) + ex) / 2) *
          (radix : ℝ) ^ ((t : Int) + ey) := by
    calc
      |x2 * y| = |x2| * |y| := abs_mul x2 y
      _ < ((radix : ℝ) ^ ((s : Int) + ex) / 2) *
            (radix : ℝ) ^ ((t : Int) + ey) :=
          mul_lt_mul_of_le_of_lt_of_nonneg_of_pos hx2Le hyAbs
            (abs_nonneg y) hx_bound_pos
  have hpow_mul :
      (radix : ℝ) ^ ((s : Int) + ex) *
          (radix : ℝ) ^ ((t : Int) + ey) =
        (radix : ℝ) ^ ((t : Int) + (s : Int) + ex + ey) := by
    rw [← zpow_add₀ hradix_ne]
    congr 1
    ring
  have hxy' :
      |x2 * y| <
        (radix : ℝ) ^ ((t : Int) + (s : Int) + ex + ey) / 2 := by
    calc
      |x2 * y| <
          ((radix : ℝ) ^ ((s : Int) + ex) / 2) *
            (radix : ℝ) ^ ((t : Int) + ey) := hxy
      _ = (radix : ℝ) ^ ((t : Int) + (s : Int) + ex + ey) / 2 := by
          rw [← hpow_mul]
          ring
  exact lt_of_le_of_lt htri <|
    lt_of_lt_of_le
      (add_lt_add_left hxy' |x2 * y2|)
      (add_le_add_right hx2y2Le
        ((radix : ℝ) ^ ((t : Int) + (s : Int) + ex + ey) / 2))

/-- Coq generic Dekker local lemma `x1y2Le`.

Symmetric counterpart of `x2y1Le`; the magnitude bound on `x` is the premise
Flocq derives from `Fnormal`. -/
theorem x1y2Le (radix : Int) (s t : Nat) (ex ey : Int) (x x1 x2 y2 : ℝ)
    (hradix : 1 < radix)
    (hxEq : x = x1 + x2)
    (hxAbs : |x| < (radix : ℝ) ^ ((t : Int) + ex))
    (hy2Le : |y2| ≤ (radix : ℝ) ^ ((s : Int) + ey) / 2)
    (hx2y2Le :
      |x2 * y2| ≤ (radix : ℝ) ^ (2 * (s : Int) + ex + ey) / 4) :
    |x1 * y2| <
      (radix : ℝ) ^ ((t : Int) + (s : Int) + ex + ey) / 2 +
        (radix : ℝ) ^ (2 * (s : Int) + ex + ey) / 4 := by
  have hradix_pos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast (lt_trans Int.zero_lt_one hradix)
  have hradix_ne : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos
  have hrewrite : x1 * y2 = x * y2 + -(x2 * y2) := by
    rw [hxEq]
    ring
  have htri :
      |x1 * y2| ≤ |x * y2| + |x2 * y2| := by
    rw [hrewrite]
    simpa [abs_neg] using abs_add_le (x * y2) (-(x2 * y2))
  have hy_bound_pos :
      0 < (radix : ℝ) ^ ((s : Int) + ey) / 2 := by
    have hpow : 0 < (radix : ℝ) ^ ((s : Int) + ey) := zpow_pos hradix_pos _
    linarith
  have hxy :
      |x * y2| <
        (radix : ℝ) ^ ((t : Int) + ex) *
          ((radix : ℝ) ^ ((s : Int) + ey) / 2) := by
    calc
      |x * y2| = |x| * |y2| := abs_mul x y2
      _ ≤ |x| * ((radix : ℝ) ^ ((s : Int) + ey) / 2) :=
          mul_le_mul_of_nonneg_left hy2Le (abs_nonneg x)
      _ < (radix : ℝ) ^ ((t : Int) + ex) *
            ((radix : ℝ) ^ ((s : Int) + ey) / 2) :=
          mul_lt_mul_of_pos_right hxAbs hy_bound_pos
  have hpow_mul :
      (radix : ℝ) ^ ((t : Int) + ex) *
          (radix : ℝ) ^ ((s : Int) + ey) =
        (radix : ℝ) ^ ((t : Int) + (s : Int) + ex + ey) := by
    rw [← zpow_add₀ hradix_ne]
    congr 1
    ring
  have hxy' :
      |x * y2| <
        (radix : ℝ) ^ ((t : Int) + (s : Int) + ex + ey) / 2 := by
    calc
      |x * y2| <
          (radix : ℝ) ^ ((t : Int) + ex) *
            ((radix : ℝ) ^ ((s : Int) + ey) / 2) := hxy
      _ = (radix : ℝ) ^ ((t : Int) + (s : Int) + ex + ey) / 2 := by
          rw [← hpow_mul]
          ring
  exact lt_of_le_of_lt htri <|
    lt_of_lt_of_le
      (add_lt_add_left hxy' |x2 * y2|)
      (add_le_add_right hx2y2Le
        ((radix : ℝ) ^ ((t : Int) + (s : Int) + ex + ey) / 2))

/-- Coq generic Dekker local lemma `powerRZSumRle`.

For radix at least two, the sum of two powers is bounded by the successor power
of the larger exponent. -/
theorem powerRZSumRle (radix : Int) (e1 e2 : Int)
    (hradix : 1 < radix) (he : e2 ≤ e1) :
    (radix : ℝ) ^ e1 + (radix : ℝ) ^ e2 ≤
      (radix : ℝ) ^ (e1 + 1) := by
  have hradix_pos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast (lt_trans Int.zero_lt_one hradix)
  have hradix_ne : (radix : ℝ) ≠ 0 := ne_of_gt hradix_pos
  have hradix_one_le : (1 : ℝ) ≤ (radix : ℝ) := by
    exact_mod_cast (le_of_lt hradix)
  have hpow_mono :
      (radix : ℝ) ^ e2 ≤ (radix : ℝ) ^ e1 :=
    zpow_le_zpow_right₀ hradix_one_le he
  have htwo_le_radix : (2 : ℝ) ≤ (radix : ℝ) := by
    exact_mod_cast (by omega : (2 : Int) ≤ radix)
  have hpow_nonneg : 0 ≤ (radix : ℝ) ^ e1 := le_of_lt (zpow_pos hradix_pos e1)
  calc
    (radix : ℝ) ^ e1 + (radix : ℝ) ^ e2
        ≤ (radix : ℝ) ^ e1 + (radix : ℝ) ^ e1 := by
          exact add_le_add (le_refl _) hpow_mono
    _ = (radix : ℝ) ^ e1 * 2 := by ring
    _ ≤ (radix : ℝ) ^ e1 * (radix : ℝ) := by
          exact mul_le_mul_of_nonneg_left htwo_le_radix hpow_nonneg
    _ = (radix : ℝ) ^ (e1 + 1) := by
          rw [zpow_add₀ hradix_ne]
          simp

/-- Coq Dekker local lemma `SLe` for `s = t - Nat.div2 t`. -/
theorem SLe (t : Nat) (pGe : 4 ≤ t) :
    (2 : Int) ≤ (t : Int) - (Nat.div2 t : Int) := by
  rw [Nat.div2_val]
  have hmul : (t / 2) * 2 ≤ t := Nat.div_mul_le_self t 2
  omega

/-- Coq Dekker local lemma `SGe` for `s = t - Nat.div2 t`. -/
theorem SGe (t : Nat) (pGe : 4 ≤ t) :
    (t : Int) - (Nat.div2 t : Int) ≤ (t : Int) - 2 := by
  rw [Nat.div2_val]
  have hdiv_ge : 2 ≤ t / 2 :=
    (Nat.le_div_iff_mul_le (by decide : 0 < 2)).2 pGe
  omega

/-- Coq Dekker local lemma `s2Ge`: `t <= s + s`. -/
theorem s2Ge (t : Nat) :
    (t : Int) ≤
      ((t : Int) - (Nat.div2 t : Int)) +
        ((t : Int) - (Nat.div2 t : Int)) := by
  rw [Nat.div2_val]
  have hmul : (t / 2) * 2 ≤ t := Nat.div_mul_le_self t 2
  omega

/-- Coq Dekker local lemma `s2Le`: `s + s <= t + 1`. -/
theorem s2Le (t : Nat) :
    ((t : Int) - (Nat.div2 t : Int)) +
        ((t : Int) - (Nat.div2 t : Int)) ≤
      (t : Int) + 1 := by
  rw [Nat.div2_val]
  have hmod : t = 2 * (t / 2) + t % 2 := (Nat.div_add_mod t 2).symm
  have hmod_lt : t % 2 < 2 := Nat.mod_lt t (by decide : 0 < 2)
  omega

/-- Coq generic FMA local lemma `UnMoinsPos`.

For precision at least three, the factor
`1 - radix^(1 - precision) / 2` is positive. -/
theorem UnMoinsPos (radix : Int) (precision : Nat)
    (hradix : 1 < radix) (hprecision : 3 ≤ precision) :
    0 < 1 - (radix : ℝ) ^ (1 - (precision : Int)) / 2 := by
  have hradix_pos : (0 : ℝ) < (radix : ℝ) := by
    exact_mod_cast (lt_trans Int.zero_lt_one hradix)
  have hradix_one_le : (1 : ℝ) ≤ (radix : ℝ) := by
    exact_mod_cast (le_of_lt hradix)
  have hpow_le_one :
      (radix : ℝ) ^ (1 - (precision : Int)) ≤ 1 :=
    zpow_le_one_of_nonpos₀ hradix_one_le (by omega)
  have hpow_pos : 0 < (radix : ℝ) ^ (1 - (precision : Int)) :=
    zpow_pos hradix_pos _
  linarith

/-- Coq generic FMA local lemma `abeLeab`.

This is the real-inequality payload of the Flocq proof after the upstream
context has derived `|e| <= |a + b| / 4` from the ulp bound. -/
theorem abeLeab (a b e : ℝ)
    (he : |e| ≤ |a + b| / 4) :
    |a + b| ≤ |a + b + e| * 4 / 3 := by
  have htri : |a + b| ≤ |a + b + e| + |e| := by
    calc
      |a + b| = |(a + b + e) + (-e)| := by ring_nf
      _ ≤ |a + b + e| + |-e| := abs_add_le _ _
      _ = |a + b + e| + |e| := by rw [abs_neg]
  have hmain : |a + b| ≤ |a + b + e| + |a + b| / 4 := by
    exact le_trans htri (add_le_add_right he _)
  nlinarith [abs_nonneg (a + b)]

noncomputable def RoundLeNormal_check {beta : Int}
    (b : Fbound_skel) (precision : Nat)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) (r : ℝ) : Unit :=
  ()

/-- Coq discriminant helper `RoundLeNormal`.

For radix two, a closest rounded normal float cannot be much larger than the
exact real input.  The denominator positivity side condition is kept explicit;
upstream derives it from `3 <= precision`. -/
theorem RoundLeNormal {beta : Int}
    (b : Fbound_skel) (precision : Nat)
    (f : FloatSpec.Core.Defs.FlocqFloat beta) (r : ℝ) :
    ⦃⌜Closest (beta:=beta) b (2 : ℝ) r f ∧
        Fnormal (beta:=beta) 2 b f ∧
        beta = 2 ∧ precision ≠ 0 ∧
        b.vNum = Zpower_nat 2 precision ∧
        0 < 1 - (2 : ℝ) ^ (-(precision : Int))⌝⦄
    (pure (RoundLeNormal_check (beta:=beta) b precision f r) : Id Unit)
    ⦃⇓_ => ⌜|_root_.F2R (beta:=beta) f| ≤
        |r| / (1 - (2 : ℝ) ^ (-(precision : Int)))⌝⦄ := by
  intro hpre
  rcases hpre with ⟨hClosest, hnormal, hbeta, hprecision, hvNum, hden_pos⟩
  simp only [wp, PostCond.noThrow, pure, RoundLeNormal_check, Id.run, ULift.up_down]
  let F : ℝ := _root_.F2R (beta:=beta) f
  let eps : ℝ := (2 : ℝ) ^ (-(precision : Int))
  have hradix : (1 : Int) < 2 := by decide
  have hClosestUlp :
      2 * |r - F| ≤ Fulp (beta:=beta) b 2 precision f := by
    have h := ClosestUlp (beta:=beta) b 2 precision r f
    simpa only [wp, PostCond.noThrow, pure, ClosestUlp_check,
      Id.run, ULift.up_down, F] using
      h ⟨hClosest, hbeta, hradix, hprecision, hvNum⟩
  have hNormEq :
      Fnormalize (beta:=beta) 2 b precision f = f := by
    have h := FcanonicFnormalizeEq (beta:=beta) 2 b precision f
    simpa only [wp, PostCond.noThrow, pure, FcanonicFnormalizeEq_check,
      Id.run, ULift.up_down] using
      h ⟨Or.inl hnormal, hbeta, hradix, hprecision, hvNum⟩
  have hNormalNorm :
      Fnormal (beta:=beta) 2 b (Fnormalize (beta:=beta) 2 b precision f) := by
    simpa [hNormEq] using hnormal
  have hFulpRel :
      Fulp (beta:=beta) b 2 precision f ≤
        |F| * (2 : ℝ) ^ (1 - (precision : Int)) := by
    have h := FulpLe2 (beta:=beta) 2 b precision f
    simpa only [wp, PostCond.noThrow, pure, FulpLe2_check,
      Id.run, ULift.up_down, F] using
      h ⟨hnormal.1, hNormalNorm, hbeta, hradix, hprecision, hvNum⟩
  have hpow :
      (2 : ℝ) ^ (1 - (precision : Int)) = 2 * eps := by
    have htwo_ne : (2 : ℝ) ≠ 0 := by norm_num
    have hexp : (1 - (precision : Int)) = 1 + (-(precision : Int)) := by ring
    rw [hexp, zpow_add₀ htwo_ne, zpow_one]
  have hFulpRel' :
      Fulp (beta:=beta) b 2 precision f ≤ |F| * (2 * eps) := by
    simpa [hpow] using hFulpRel
  have hdist : |r - F| ≤ |F| * eps := by
    nlinarith
  have htri : |F| ≤ |r| + |r - F| := by
    calc
      |F| = |r + (F - r)| := by ring_nf
      _ ≤ |r| + |F - r| := abs_add_le _ _
      _ = |r| + |r - F| := by rw [abs_sub_comm]
  have hmul : (1 - eps) * |F| ≤ |r| := by
    nlinarith
  have hden_pos_eps : 0 < 1 - eps := by
    simpa [eps] using hden_pos
  have hmul' : |F| * (1 - eps) ≤ |r| := by
    nlinarith
  have hresult : |F| ≤ |r| / (1 - eps) :=
    (le_div_iff₀ hden_pos_eps).2 hmul'
  simpa [F, eps] using hresult

